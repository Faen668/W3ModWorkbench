<Window x:Class="W3ModWorkbench.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:W3ModWorkbench.ViewModels"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="W3 Mod Workbench"
        Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1240" Height="780" MinWidth="860" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown" Deactivated="Window_Deactivated" Closing="Window_Closing">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="DimCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <!-- File grid cells: a soft accent tint marks the selection and the text keeps its normal colour.
             OverridesDefaultStyle keeps the fallback theme's cell style out, which turns selected text white
             and outlines the focused cell. -->
        <Style x:Key="FileGridCell" TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Rectangle x:Name="Highlight" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <DockPanel Grid.Row="0" Margin="14,12,14,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <Button x:Name="OpenBundlesButton" Click="OpenBundles_Click" ToolTip="Open .bundle or .rsblob files (Ctrl+O)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="Open files" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,0" Click="OpenFolder_Click" ToolTip="Open every .bundle and .rsblob file in a folder and its subfolders">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="Open folder" />
                    </StackPanel>
                </Button>
                <Button x:Name="ProjectButton" Margin="6,0,0,0" Click="Project_Click"
                        ToolTip="New project, open a project (Ctrl+Shift+O), project properties, add files to the project">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE821;" Margin="0,1,0,0" />
                        <TextBlock x:Name="ProjectButtonText" Margin="8,0,0,0" Text="Project" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="8,2,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="CloseAllButton" Margin="6,0,0,0" Click="CloseAll_Click" IsEnabled="False" ToolTip="Close the project and everything else that's open">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE894;" Margin="0,2,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="Close all" />
                    </StackPanel>
                </Button>
                <Button x:Name="ToolsButton" Margin="6,0,0,0" Click="Tools_Click"
                        ToolTip="Find in files, browse the game's scripts and mods, search the game's strings, generate stubs, build a mod menu, compare mods">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE90F;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="Tools" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="8,2,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <Button x:Name="AboutButton" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,6" Click="About_Click"
                    ToolTip="About W3 Mod Workbench">
                <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" />
            </Button>
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Click="Help_Click" ToolTip="How everything works (F1)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE897;" Margin="0,2,0,0" />
                    <TextBlock Margin="8,0,0,0" Text="Help" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Margin="6,0,0,0" Click="Settings_Click" ToolTip="Settings (Ctrl+,)">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" Margin="0,1,0,0" />
                    <TextBlock Margin="8,0,0,0" Text="Settings" />
                </StackPanel>
            </Button>
            <Grid DockPanel.Dock="Right" Width="340">
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="34,6,30,6"
                         TextChanged="SearchBox_TextChanged" ToolTip="Words must all appear in the path. Use * and ? to match file names, e.g. *.redswf" />
                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" Margin="12,0,0,0" Opacity="0.6"
                           HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchPlaceholder" Text="Search files  (Ctrl+F)" Margin="35,0,0,0" Opacity="0.55"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
                <Button x:Name="ClearSearchButton" HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3"
                        Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="Clear search">
                    <TextBlock Style="{StaticResource IconText}" FontSize="11" Text="&#xE711;" />
                </Button>
            </Grid>
        </DockPanel>

        <!-- Content -->
        <Grid Grid.Row="1" Margin="14,0,14,0">
            <Grid x:Name="BrowserPanel" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" MinWidth="180" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="2,6">
                    <TreeView x:Name="FolderTree" BorderThickness="0" Background="Transparent"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              SelectedItemChanged="FolderTree_SelectedItemChanged"
                              PreviewMouseRightButtonDown="FolderTree_PreviewMouseRightButtonDown">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Icon" Style="{StaticResource IconText}" Text="{Binding Glyph}" Margin="0,0,8,0" />
                                    <!-- script projects carry a badge and the accent colour, so they stand apart from the read-only archives -->
                                    <Border x:Name="ProjectBadge" Visibility="Collapsed" CornerRadius="3" Padding="5,0,5,1" Margin="0,0,7,0"
                                            VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}">
                                        <TextBlock Text="PROJECT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Border>
                                    <TextBlock x:Name="NameText" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Detail, StringFormat='  {0}'}" Opacity="0.65" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding TotalFiles, StringFormat='  {0:N0}'}" Opacity="0.5" VerticalAlignment="Center" />
                                </StackPanel>
                                <HierarchicalDataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsProject}" Value="True">
                                        <Setter TargetName="ProjectBadge" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </HierarchicalDataTemplate.Triggers>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                        <TreeView.ContextMenu>
                            <ContextMenu Opened="TreeMenu_Opened">
                                <MenuItem x:Name="TreeCreateProjectItem" Header="Create a project from these scripts…" Click="TreeCreateProject_Click" Visibility="Collapsed">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE821;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="TreeProjectPropertiesItem" Header="Project properties…" Click="ProjectProperties_Click" Visibility="Collapsed">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE713;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="TreeAddFilesItem" Header="Add files to the project…" Click="ProjectAddFiles_Click" Visibility="Collapsed" />
                                <MenuItem x:Name="TreeRefreshItem" Header="Refresh the project" Click="ProjectRefresh_Click" Visibility="Collapsed" />
                                <MenuItem x:Name="TreeRevealItem" Header="Open the project folder" Click="ProjectReveal_Click" Visibility="Collapsed" />
                                <Separator x:Name="TreeProjectSeparator" Visibility="Collapsed" />
                                <MenuItem Header="Extract this folder" Click="TreeExtract_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE896;" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Check all in folder" Click="TreeCheck_Click" />
                                <MenuItem Header="Uncheck all in folder" Click="TreeUncheck_Click" />
                                <Separator />
                                <MenuItem x:Name="TreeCloseItem" Header="Close bundle" Click="TreeCloseBundle_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE711;" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </TreeView.ContextMenu>
                    </TreeView>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

                <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                    <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                              SelectionMode="Extended" SelectionUnit="FullRow" CanUserResizeRows="False" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              CellStyle="{StaticResource FileGridCell}"
                              MouseDoubleClick="FileGrid_MouseDoubleClick" ContextMenuOpening="FileGrid_ContextMenuOpening">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="44" CanUserResize="False" CanUserSort="False">
                                <DataGridTemplateColumn.Header>
                                    <CheckBox x:Name="HeaderCheck" Click="HeaderCheck_Click" ToolTip="Check or uncheck every file shown"
                                              MinWidth="0" Padding="0" HorizontalAlignment="Center" />
                                </DataGridTemplateColumn.Header>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate DataType="{x:Type vm:EntryItem}">
                                        <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  MinWidth="0" Padding="0" HorizontalAlignment="Center" Focusable="False" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" MinWidth="140" ElementStyle="{StaticResource CellText}" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" MinWidth="120" ElementStyle="{StaticResource DimCellText}" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightText}" />
                            <DataGridTextColumn Header="Packed" Binding="{Binding PackedText}" SortMemberPath="PackedSize" Width="90" ElementStyle="{StaticResource RightText}" />
                            <DataGridTextColumn Header="Format" Binding="{Binding CompressionText}" Width="110" ElementStyle="{StaticResource DimCellText}" />
                            <DataGridTextColumn Header="Source" Binding="{Binding BundleName}" Width="170" ElementStyle="{StaticResource DimCellText}" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Preview" InputGestureText="Enter" Click="GridPreview_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8A1;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="GridXmlItem" Header="Open in XML editor" Click="GridXmlEditor_Click" Visibility="Collapsed">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE70F;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="GridAddToProjectItem" Header="Add to project" Click="GridAddToProject_Click" Visibility="Collapsed">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE710;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="GridRemoveFromProjectItem" Header="Remove from project" Click="GridRemoveFromProject_Click" Visibility="Collapsed">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE738;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="GridExternalItem" Header="Open in external editor" Click="GridExternal_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Extract highlighted" Click="GridExtract_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE896;" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="Check highlighted" InputGestureText="Space" Click="GridCheck_Click" />
                                <MenuItem Header="Uncheck highlighted" Click="GridUncheck_Click" />
                                <Separator />
                                <MenuItem Header="Copy path" InputGestureText="Ctrl+C" Click="GridCopyPath_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                </Border>

                <!-- Shown over the grid when the search matches nothing -->
                <TextBlock x:Name="NoMatchesText" Grid.Column="2" Text="No files match the search." Opacity="0.6"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" IsHitTestVisible="False" />
            </Grid>

            <!-- Empty state -->
            <Border x:Name="EmptyState" Style="{StaticResource Card}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,0">
                    <Image Source="pack://application:,,,/W3ModWorkbench;component/Assets/icon.png" Width="200" Height="200"
                           VerticalAlignment="Center" Margin="0,0,48,0" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center" Width="520">
                        <TextBlock Text="W3 Mod Workbench" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Text="Open a project, or Witcher 3 bundles, scripts, strings or XML" FontSize="16" Opacity="0.85" TextWrapping="Wrap" Margin="0,6,0,14" />
                        <TextBlock TextWrapping="Wrap" Opacity="0.7"
                                   Text="Drop .bundle, .rsblob, .w3strings or .xml files, or a folder, anywhere on this window. Compiled scripts (precompiled.rsblob) open as decompiled WitcherScript, and strings (.w3strings, or a strings .csv) open in an editor you can save from, as do XML files (with a builder for mod menus). Tools has a search of the game's own strings and a stub generator. Opening a folder loads everything inside it, such as the game's content or a mod. To edit and compile a mod's scripts, make it a project: a .w3bench file that keeps the mod's scripts folder, its other files and where it compiles to." />
                        <TextBlock Margin="0,18,0,0" Opacity="0.8">
                            <Run Text="New here?" />
                            <Hyperlink Click="Help_Click">Read the guide</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Loading overlay -->
            <Border x:Name="LoadingOverlay" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="360">
                    <TextBlock x:Name="LoadingText" Text="Loading…" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,0,12" />
                    <ProgressBar x:Name="LoadingProgress" Height="4" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Extract bar -->
        <Border Grid.Row="2" Margin="14,10,14,0" Padding="14,10" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Extract to" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Grid Grid.Column="1">
                    <TextBox x:Name="OutputBox" VerticalContentAlignment="Center" Padding="8,6,40,6" />
                    <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                            Click="BrowseOutput_Click" ToolTip="Choose the output folder">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8DA;" />
                    </Button>
                </Grid>
                <StackPanel Grid.Column="2" Orientation="Vertical" Margin="16,0,8,0" VerticalAlignment="Center">
                    <CheckBox x:Name="KeepStructureCheck" Content="Keep folder structure" MinHeight="0" Padding="6,0,0,0"
                              ToolTip="Recreate the bundle's paths, e.g. gameplay\gui_new\swf\…" />
                    <CheckBox x:Name="OpenWhenDoneCheck" Content="Open folder when done" MinHeight="0" Padding="6,0,0,0" Margin="0,4,0,0" />
                </StackPanel>
                <Button x:Name="ExtractShownButton" Grid.Column="3" Margin="8,0,0,0" Padding="14,7" Click="ExtractShown_Click"
                        IsEnabled="False" ToolTip="Extract every file in the list">
                    <TextBlock x:Name="ExtractShownText" Text="Extract shown" />
                </Button>
                <Button x:Name="ExtractCheckedButton" Grid.Column="4" Margin="8,0,0,0" Padding="14,7" Click="ExtractChecked_Click"
                        IsEnabled="False" ToolTip="Extract every checked file, in all open bundles (Ctrl+E)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" />
                        <TextBlock x:Name="ExtractCheckedText" Margin="8,0,0,0" Text="Extract checked" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="3" Margin="16,8,16,10" MinHeight="26">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Opacity="0.8" Text="Ready" />
            <TextBlock x:Name="AboutText" Grid.Column="3" VerticalAlignment="Center" Margin="20,0,0,0" Opacity="0.55"
                       ToolTip="Free and open source under the MIT Licence" />
            <TextBlock x:Name="CheckedText" Grid.Column="1" VerticalAlignment="Center" Opacity="0.8" Margin="16,0,0,0" />
            <StackPanel x:Name="ProgressPanel" Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0" Visibility="Collapsed">
                <ProgressBar x:Name="ExtractProgressBar" Width="220" Height="4" VerticalAlignment="Center" />
                <Button Margin="10,0,0,0" Padding="10,2" Click="Cancel_Click" Content="Cancel" />
            </StackPanel>
        </Grid>

        <!-- About: opens from the i button, under it, and stays until you click elsewhere, press Esc or click the button again -->
        <Popup x:Name="AboutPopup" PlacementTarget="{Binding ElementName=AboutButton}" Placement="Relative"
               AllowsTransparency="True" StaysOpen="True" PopupAnimation="Fade" Focusable="False">
            <Border Margin="12,0,12,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35" />
                </Border.Effect>
                <Border x:Name="AboutCard" Width="460" Padding="20,18" CornerRadius="8" BorderThickness="1"
                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Border.Resources>
                        <Style x:Key="AboutHint" TargetType="TextBlock">
                            <Setter Property="Opacity" Value="0.7" />
                            <Setter Property="TextWrapping" Value="Wrap" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Margin" Value="0,8,0,0" />
                        </Style>
                    </Border.Resources>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/W3ModWorkbench;component/Assets/icon.png" Width="64" Height="64"
                               VerticalAlignment="Top" Margin="0,0,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="W3 Mod Workbench" FontSize="16" FontWeight="SemiBold" />
                            <TextBlock x:Name="AboutVersionText" Opacity="0.7" Margin="0,2,0,0" />
                            <TextBlock TextWrapping="Wrap" Margin="0,8,0,0" Opacity="0.85"
                                       Text="Browse and extract Witcher 3 .bundle archives, open REDkit precompiled.rsblob files as decompiled WitcherScript, edit and compile script projects, and edit strings." />
                            <TextBlock x:Name="AboutCopyrightText" Margin="0,12,0,0" />
                            <TextBlock Margin="0,2,0,0" TextWrapping="Wrap">
                                <Run Text="Free and open source under the MIT Licence." />
                                <Hyperlink Click="AboutLicence_Click">View licence</Hyperlink>
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutHint}"
                                       Text="Developed with AI assistance (Claude, by Anthropic), most of all in reverse-engineering the compiled script format and building the decompiler. The results were checked against real mods and their original source." />
                            <TextBlock Style="{StaticResource AboutHint}">
                                <Run Text="WitcherScript syntax highlighting by WebSpam, from his witcherscript-vscode extension, used with permission. Code view by AvalonEdit. Decompiler gaps filled with help from Aelto's tw3-cahirb, and the built-in compiler is a port of the one WebSpam wrote for it." />
                                <Hyperlink Click="AboutNotices_Click">Third-party notices</Hyperlink>
                            </TextBlock>
                            <TextBlock Style="{StaticResource AboutHint}"
                                       Text="An unofficial fan-made tool, not affiliated with or endorsed by CD PROJEKT RED. The Witcher, REDkit and REDengine are trademarks of CD PROJEKT S.A." />
                            <TextBlock x:Name="AboutSettingsText" Style="{StaticResource AboutHint}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Border>
        </Popup>

        <local:MessageCard x:Name="Message" Grid.RowSpan="4" IsModal="True" />
    </Grid>
</Window>
