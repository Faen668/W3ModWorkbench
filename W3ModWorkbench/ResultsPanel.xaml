<UserControl x:Class="W3ModWorkbench.ResultsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:W3ModWorkbench">
    <UserControl.Resources>
        <Style x:Key="FindToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1,7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <!-- a file, or a group such as "Wrapped by": a chevron to fold it, its name, where it is, and how many -->
        <DataTemplate x:Key="HeaderTemplate" DataType="{x:Type local:ResultRow}">
            <Grid Margin="0,6,0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Chevron}" FontFamily="{StaticResource IconFont}" FontSize="10" Opacity="0.7"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="14"
                           Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Before, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="{Binding Detail, Mode=OneWay}"
                         Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="12.5" />
                </TextBlock>
                <Border Grid.Column="3" Style="{StaticResource Badge}" Margin="10,0,0,0"
                        Visibility="{Binding HasCount, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Count}" FontSize="11.5" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- a line of code: its number, then the line with the match tinted -->
        <DataTemplate x:Key="LineTemplate" DataType="{x:Type local:ResultRow}">
            <Grid Margin="28,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding LineText}" Opacity="0.5" Margin="0,0,12,0" TextAlignment="Right"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                           FontFamily="Cascadia Mono, Consolas" FontSize="12.5">
                    <Run Text="{Binding Before, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" /><Run
                         Text="{Binding Match, Mode=OneWay}" Background="{DynamicResource ResultMatchBrush}" /><Run
                         Text="{Binding After, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBlock>
                <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="10,0,0,0"
                        Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.85" />
                </Border>
            </Grid>
        </DataTemplate>

        <!-- a declaration: what it is on one line, where it is under it -->
        <DataTemplate x:Key="SymbolTemplate" DataType="{x:Type local:ResultRow}">
            <Grid Margin="{Binding IndentMargin}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,2,10,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Before}" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />
                    <TextBlock Text="{Binding Detail}" TextTrimming="CharacterEllipsis" FontSize="12" Margin="0,1,0,0"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <Border Grid.Column="2" Style="{StaticResource Badge}" Margin="10,0,0,0"
                        Visibility="{Binding HasLabel, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Label}" FontSize="11" Opacity="0.85" />
                </Border>
            </Grid>
        </DataTemplate>

        <local:ResultTemplateSelector x:Key="RowTemplates" Header="{StaticResource HeaderTemplate}"
                                      Line="{StaticResource LineTemplate}" Symbol="{StaticResource SymbolTemplate}" />
    </UserControl.Resources>

    <Border CornerRadius="8" BorderThickness="1" Padding="12,10,12,8"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <DockPanel>
            <!-- what the list shows, and the find box when it's a search -->
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8" LastChildFill="True">
                <Button DockPanel.Dock="Right" Width="28" Height="28" MinWidth="0" Padding="0"
                        Background="Transparent" BorderThickness="0" Focusable="False" ToolTip="Close (Esc)" Click="Close_Click">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="10" />
                </Button>
                <Button x:Name="FoldButton" DockPanel.Dock="Right" Width="28" Height="28" MinWidth="0" Padding="0" Margin="0,0,4,0"
                        Background="Transparent" BorderThickness="0" Focusable="False" Click="Fold_Click" Visibility="Collapsed">
                    <TextBlock x:Name="FoldIcon" FontFamily="{StaticResource IconFont}" FontSize="12" />
                </Button>
                <StackPanel x:Name="FindBar" DockPanel.Dock="Right" Orientation="Horizontal" Visibility="Collapsed" Margin="0,0,6,0">
                    <TextBox x:Name="FindBox" Width="260" VerticalContentAlignment="Center" KeyDown="FindBox_KeyDown" />
                    <ToggleButton x:Name="MatchCaseToggle" Style="{StaticResource FindToggle}" Content="Aa" ToolTip="Match case" Margin="6,0,0,0" />
                    <ToggleButton x:Name="WholeWordToggle" Style="{StaticResource FindToggle}" Content="ab" ToolTip="Whole words only" />
                    <ToggleButton x:Name="RegexToggle" Style="{StaticResource FindToggle}" Content=".*" ToolTip="Regular expression" />
                    <Button Margin="6,0,0,0" Click="Find_Click" ToolTip="Search every script (Enter)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="12" />
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleIcon" FontFamily="{StaticResource IconFont}" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    <Border x:Name="SummaryBadge" Style="{StaticResource Badge}" Margin="10,0,0,0" Visibility="Collapsed">
                        <TextBlock x:Name="SummaryText" FontSize="12" />
                    </Border>
                </StackPanel>
            </DockPanel>

            <!-- when the installed mods' scripts aren't searched yet: what that means, and buttons to add them -->
            <Border x:Name="ModsStrip" DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="10,6" CornerRadius="6" Visibility="Collapsed"
                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                <DockPanel>
                    <StackPanel x:Name="ActionBar" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" />
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE946;" FontSize="13" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.8" />
                    <TextBlock x:Name="StripText" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="12.5" Opacity="0.85" />
                </DockPanel>
            </Border>

            <Grid>
                <ListBox x:Name="List" BorderThickness="0" Background="Transparent" Padding="0,0,14,0"
                         ItemTemplateSelector="{StaticResource RowTemplates}"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseUp="List_MouseUp" KeyDown="List_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,4" />
                            <Setter Property="MinHeight" Value="0" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                                            <Rectangle x:Name="Hover" RadiusX="4" RadiusY="4" Fill="{DynamicResource ListBoxItemUnselectedBackgroundPointerOverThemeBrush}" Visibility="Collapsed" />
                                            <Rectangle x:Name="Highlight" RadiusX="4" RadiusY="4" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- while a search runs, or when it found nothing -->
                <StackPanel x:Name="StatusPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal" Visibility="Collapsed">
                    <ProgressBar x:Name="Busy" IsIndeterminate="True" Width="80" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Opacity="0.7" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="560" />
                </StackPanel>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
