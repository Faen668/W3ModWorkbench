<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>W3ModWorkbench</RootNamespace>
    <AssemblyName>W3ModWorkbench</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- WPF0001: the Fluent ThemeMode API is marked experimental in .NET 9 -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- Shown in the exe's Properties > Details tab and the About section -->
  <PropertyGroup>
    <Product>W3 Mod Workbench</Product>
    <AssemblyTitle>W3 Mod Workbench</AssemblyTitle>
    <Description>Browse and extract The Witcher 3 bundles, decompile REDkit compiled scripts, and edit and compile WitcherScript</Description>
    <Authors>Faen90</Authors>
    <Company>Faen90</Company>
    <Copyright>Copyright © 2026 Faen90</Copyright>
    <Version>1.6.0</Version>
    <NeutralLanguage>en</NeutralLanguage>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\icon.png" />
  </ItemGroup>

  <!-- WitcherScript grammar from WebSpam's witcherscript-vscode (MIT), used as-is -->
  <ItemGroup>
    <EmbeddedResource Include="Highlighting\witcherscript.tmLanguage.json" />
    <!-- The engine's native classes and enums for the standalone compiler: REDkit's wcc_lite -dumprtti, slimmed -->
    <!-- the 3D view's pixel shader, compiled when the first view is made, with the Helix Toolkit (MIT) files it includes -->
    <EmbeddedResource Include="Rendering\Shaders\*.hlsl" LogicalName="W3ModWorkbench.Shaders.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Core\Scripts\Standalone\rtti.txt.gz" LogicalName="W3ModWorkbench.Core.Scripts.Standalone.rtti.txt.gz" />
    <!-- The game's script classes and the class each extends, from the vanilla scripts: what an object of a script class is -->
    <EmbeddedResource Include="Core\Cr2w\scriptclasses.txt.gz" LogicalName="W3ModWorkbench.Core.Cr2w.scriptclasses.txt.gz" />
  </ItemGroup>

  <ItemGroup>
    <!-- Code editor control for the preview window (MIT) -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
    <!-- Opus decoder for the voice lines in the game's .w3speech files (BSD) -->
    <PackageReference Include="Concentus" Version="2.2.2" />
    <!-- Direct3D 11 viewport the 3D views draw with: normal maps, per-pixel light, blended hair (MIT) -->
    <PackageReference Include="HelixToolkit.Wpf.SharpDX" Version="3.1.2" />
    <PackageReference Include="NAudio.WinMM" Version="2.2.1" />
  </ItemGroup>

  <!-- Ship the licence, notices and readme next to the exe -->
  <ItemGroup>
    <None Include="..\LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\PRIVACY.md" Link="PRIVACY.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\README.md" Link="README.md" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CHANGELOG.md" Link="CHANGELOG.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
