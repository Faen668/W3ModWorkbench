<Application x:Class="W3ModWorkbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ThemeMode applies the Fluent theme when the app runs; merging it here as well
                 lets the Visual Studio designer show the same styles and resources. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- A tooltip takes the font of what it's on, so one on an icon (drawn in IconFont) would show its text as boxes.
                 Every tooltip uses the ordinary text font instead. -->
            <Style TargetType="ToolTip" BasedOn="{StaticResource {x:Type ToolTip}}">
                <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
