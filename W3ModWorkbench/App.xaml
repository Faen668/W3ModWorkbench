<Application x:Class="W3ModWorkbench.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:W3ModWorkbench"
             ThemeMode="System">
    <Application.Resources>
        <ResourceDictionary>
            <!-- ThemeMode applies the Fluent theme when the app runs; merging it here as well
                 lets the Visual Studio designer show the same styles and resources. -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Every splitter between panes: a faint line down (or across) its middle with a grip, in the accent colour
                 while the mouse is on it or it's being dragged, so it can be found. The splitter itself stays as wide as
                 it's set, all of it something to grab. -->
            <local:SplitterLine x:Key="SplitterLine" />
            <Style TargetType="GridSplitter">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="ToolTip" Value="Drag to resize" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="GridSplitter">
                            <Grid Background="Transparent">
                                <Border x:Name="Down" Width="1" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource SplitterLine}" ConverterParameter="Down">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                </Border>
                                <Border x:Name="Across" Height="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                                        Background="{DynamicResource DividerStrokeColorDefaultBrush}">
                                    <Border.Visibility>
                                        <MultiBinding Converter="{StaticResource SplitterLine}" ConverterParameter="Across">
                                            <Binding Path="ActualWidth" RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Path="ActualHeight" RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </Border.Visibility>
                                </Border>
                                <Border x:Name="GripDown" Width="4" Height="28" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding Visibility, ElementName=Down}" />
                                <Border x:Name="GripAcross" Width="28" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Background="{DynamicResource TextFillColorTertiaryBrush}" Visibility="{Binding Visibility, ElementName=Across}" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Down" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Across" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="GripDown" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="GripAcross" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Trigger>
                                <Trigger Property="IsDragging" Value="True">
                                    <Setter TargetName="Down" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="Across" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="GripDown" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <Setter TargetName="GripAcross" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- Every tooltip as a small card in the theme's colours, following light, dark and the presets.
                 A tooltip takes the font of what it's on, so one on an icon (drawn in IconFont) would show its text as boxes:
                 it uses the ordinary text font instead. -->
            <Style TargetType="ToolTip">
                <Setter Property="FontFamily" Value="{x:Static SystemFonts.MessageFontFamily}" />
                <Setter Property="FontSize" Value="12.5" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Background" Value="{DynamicResource ToolTipBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorFlyoutBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="10,6" />
                <Setter Property="HasDropShadow" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToolTip">
                            <Border Margin="0,0,10,10" MaxWidth="440" CornerRadius="6"
                                    Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}"
                                    TextElement.Foreground="{TemplateBinding Foreground}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.25" />
                                </Border.Effect>
                                <ContentPresenter>
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- A viewer's table, as the scene viewer's are: no grid lines, rows on the card's own background, the row
                 picked in a soft wash of the accent behind ordinary text (not the plain DataGrid's solid highlight and
                 cell borders). Every viewer's DataGrid takes Style="{StaticResource ViewerGrid}". -->
            <Style x:Key="ViewerGridCell" TargetType="DataGridCell">
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Grid SnapsToDevicePixels="True" Background="Transparent">
                                <Rectangle x:Name="Highlight" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                                <ContentPresenter VerticalAlignment="Center" Margin="4,0,4,0" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="ViewerGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="None" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="RowBackground" Value="Transparent" />
                <Setter Property="AlternatingRowBackground" Value="Transparent" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="SelectionUnit" Value="FullRow" />
                <Setter Property="CanUserResizeRows" Value="False" />
                <Setter Property="CellStyle" Value="{StaticResource ViewerGridCell}" />
                <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
                <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
