<Window x:Class="W3ModWorkbench.XmlOverridesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="XML overrides" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1180" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Rectangle x:Name="Wash" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <Rectangle x:Name="Bar" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" Width="3" HorizontalAlignment="Left" Margin="0,6" RadiusX="1.5" RadiusY="1.5" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.07" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.14" />
                                <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="XML overrides" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Opacity="0.65" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Lists the definitions (items, abilities, sets…) that mod.io mods, DLC and mods set in their XML, including bundled XML: which mods touch each one, whether it extends or replaces (on_conflict) or just defines it, and which mod wins each field. Both loose XML files and XML packed inside bundles are read." />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <Button x:Name="ScanButton" DockPanel.Dock="Right" Padding="14,6" Margin="8,0,0,0" Click="Scan_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                        <TextBlock x:Name="ScanLabel" Margin="8,0,0,0" Text="Scan" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Content="Browse…" Click="Browse_Click" />
                <CheckBox x:Name="SharedCheck" IsChecked="True" DockPanel.Dock="Right" Content="Shared or clashing only" MinWidth="0" Margin="12,0,0,0" VerticalAlignment="Center"
                          Click="Filter_Changed" ToolTip="Hide definitions that only one mod touches" />
                <Grid>
                    <TextBox x:Name="FolderBox" Padding="8,6" VerticalContentAlignment="Center" />
                    <TextBlock x:Name="FolderHint" Margin="11,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="The game's mods folder, e.g. C:\Games\The Witcher 3\mods" />
                </Grid>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="400" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                            <TextBox x:Name="SearchBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchHint" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" Text="Search definitions or mods  (Ctrl+F)" />
                        </Grid>
                        <Grid>
                            <ListBox x:Name="GroupList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0" SelectionChanged="GroupList_SelectionChanged"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:OverrideGroupItem}">
                                        <Grid Margin="2,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="22" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource IconText}" Text="{Binding Icon}" Foreground="{Binding IconBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Id}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Id}" />
                                                <TextBlock Text="{Binding Caption}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="320">
                                <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="EmptyText" Opacity="0.65" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" Focusable="False" />

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12" ClipToBounds="True">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Margin="0,0,14,0">
                            <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="DetailSummary" Margin="0,6,0,0" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,14,0,4" Text="MODS THAT SET IT   (first = wins)" />
                            <ItemsControl x:Name="OverrideRows">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:OverrideRow}">
                                        <Border Margin="0,0,0,8" Padding="12,8" CornerRadius="6" BorderThickness="1" Opacity="{Binding Opacity}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                            <DockPanel>
                                                <Button DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" Content="Open file" VerticalAlignment="Top"
                                                        Tag="{Binding}" Click="OpenFile_Click" />
                                                <StackPanel>
                                                    <TextBlock TextWrapping="Wrap">
                                                        <Run Text="{Binding Rank, Mode=OneWay}" />
                                                        <Run Text="{Binding ModName, Mode=OneWay}" FontWeight="SemiBold" />
                                                        <Run Text="{Binding ModeText, Mode=OneWay}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="SemiBold" />
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Location}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                                    <TextBlock Text="{Binding FieldsText}" FontFamily="Cascadia Mono, Consolas" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="ClashCaption" Style="{StaticResource Caption}" Margin="0,10,0,4" Text="FIELDS SET BY MORE THAN ONE MOD" />
                            <TextBox x:Name="ClashText" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                     MaxHeight="220" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                                     Background="Transparent" BorderThickness="0" Padding="0" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

            <DockPanel Grid.Row="3" Margin="2,10,2,0">
                <Button x:Name="CopyButton" DockPanel.Dock="Right" Padding="12,6" Content="Copy list" Click="Copy_Click" IsEnabled="False" ToolTip="Copy the definitions as text" />
                <TextBlock x:Name="StatusText" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
