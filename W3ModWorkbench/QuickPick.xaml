<UserControl x:Class="W3ModWorkbench.QuickPick"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:W3ModWorkbench"
             Width="640" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
    <Border Margin="0,0,0,24" Padding="8" CornerRadius="8" BorderThickness="1"
            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.35" />
        </Border.Effect>
        <DockPanel>
            <Grid DockPanel.Dock="Top">
                <TextBox x:Name="Box" Padding="32,6,8,6" VerticalContentAlignment="Center"
                         TextChanged="Box_TextChanged" PreviewKeyDown="Box_PreviewKeyDown" LostKeyboardFocus="Box_LostKeyboardFocus" />
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Margin="11,0,0,0" Opacity="0.6"
                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock x:Name="Placeholder" Margin="33,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <TextBlock x:Name="Note" DockPanel.Dock="Bottom" Margin="8,6,8,0" FontSize="12" Opacity="0.6" TextWrapping="Wrap" />
            <ListBox x:Name="List" Margin="0,6,0,0" MaxHeight="420" BorderThickness="0" Background="Transparent" Focusable="False"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseLeftButtonUp="List_MouseUp">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="10,5" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid SnapsToDevicePixels="True" Background="Transparent">
                                        <Rectangle x:Name="Hover" Fill="{DynamicResource ListBoxItemUnselectedBackgroundPointerOverThemeBrush}" Visibility="Collapsed" />
                                        <Rectangle x:Name="Highlight" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
                                            <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:QuickPickItem}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="13" Margin="0,2,10,0"
                                       VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
