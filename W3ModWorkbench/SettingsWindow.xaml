<Window x:Class="W3ModWorkbench.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="Settings" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="620" Height="700" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- one part of a row of joined choices -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" CornerRadius="6" Padding="14,6" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{TemplateBinding Tag}" VerticalAlignment="Center" FontSize="13" />
                                <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a theme to pick: its colours, with a ring when it's the one in use -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <Border x:Name="Ring" CornerRadius="11" BorderThickness="2" Padding="2" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" HorizontalAlignment="Center" Margin="0,5,0,0" Opacity="0.8" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Label" Property="Opacity" Value="1" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer x:Name="SettingsScroller" VerticalScrollBarVisibility="Auto" Padding="18,16,18,4">
            <StackPanel>
                <!-- Appearance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,12" Text="Changes show straight away. Cancel puts them back." />

                        <!-- a small preview window in the chosen colours -->
                        <Border x:Name="Sample" CornerRadius="8" BorderThickness="1" Padding="12,10,12,12"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" IsHitTestVisible="False" Focusable="False">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Padding="12,3" Focusable="False">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Margin="6,0,0,0" Text="Save as" FontSize="12" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border CornerRadius="6" BorderThickness="1" Padding="8,3"
                                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                            <Grid>
                                                <TextBlock FontSize="12"><Run FontFamily="{StaticResource IconFont}" Text="&#xE943;" /><Run Text="  r4Player.ws" /></TextBlock>
                                                <Border Height="3" Width="16" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,-5"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock FontSize="12" Opacity="0.7" Margin="12,0,0,0" VerticalAlignment="Center">
                                            <Run FontFamily="{StaticResource IconFont}" Text="&#xE943;" /><Run Text="  playerWitcher.ws" />
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                                <Border CornerRadius="6" BorderThickness="1" Padding="10,8"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                    <ContentControl x:Name="SampleCode" Focusable="False" />
                                </Border>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <CheckBox IsChecked="True" Content="Keep folder structure" Focusable="False" />
                                    <RadioButton IsChecked="True" Content="Tabs" Margin="18,0,0,0" Focusable="False" GroupName="SampleGroup" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Mode" Margin="0,16,0,6" />
                        <Border HorizontalAlignment="Left" CornerRadius="8" BorderThickness="1" Padding="3"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"
                                             Tag="&#xE770;" Content="Windows setting" />
                                <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"
                                             Tag="&#xE706;" Content="Light" />
                                <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"
                                             Tag="&#xE708;" Content="Dark" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Theme" Margin="0,16,0,2" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                   Text="Accent and background colours. Windows uses your Windows accent colour and see-through window background; the others are named after the witcher schools." />
                        <WrapPanel x:Name="PresetPanel" />
                    </StackPanel>
                </Border>

                <!-- Extraction -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Extraction" />
                        <TextBlock Text="Default output folder" Margin="0,0,0,6" />
                        <Grid>
                            <TextBox x:Name="OutputBox" VerticalContentAlignment="Center" Padding="8,6,40,6" />
                            <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                                    Click="BrowseOutput_Click" ToolTip="Choose a folder">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                            </Button>
                        </Grid>
                        <CheckBox x:Name="KeepStructureCheck" Content="Keep folder structure" Margin="0,12,0,0" />
                        <CheckBox x:Name="OpenWhenDoneCheck" Content="Open the folder when extraction finishes" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Preview -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Preview" />
                        <TextBlock Text="Open files in" Margin="0,0,0,6" />
                        <RadioButton x:Name="OpenInTabs" GroupName="OpenIn" Content="Tabs in one preview window" />
                        <RadioButton x:Name="OpenInWindows" GroupName="OpenIn" Content="A separate window for each file" Margin="0,2,0,0" />
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Go to definition follows the same choice. A file that's already open is brought to the front instead of opening twice." />

                        <TextBlock Text="Split view" Margin="0,14,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="SplitRight" GroupName="Split" Content="Side by side" Margin="0,0,20,0" />
                            <RadioButton x:Name="SplitDown" GroupName="Split" Content="Top and bottom" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}"
                                   Text="Split (Ctrl+\) shows a second group of tabs, so you can read two files, or two parts of one, at once. Drag a tab onto the far side of the text to split there, onto another group to move it, or out of the window to give it a window of its own." />

                        <CheckBox x:Name="PeekCheck" Content="Show a name's declaration when the mouse rests on it in a script" Margin="0,14,0,0" />
                    </StackPanel>
                </Border>

                <!-- Compiled scripts -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="Game folder" />
                            <Run Text="(optional)" FontWeight="Normal" FontSize="13" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Where The Witcher 3 is installed. Decompiled scripts use it to show readable names instead of plain numbers:" />

                        <!-- before / after example -->
                        <Border CornerRadius="6" Padding="12,8" Margin="0,10,0,10" BorderThickness="1"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Without it" Opacity="0.65" Margin="0,0,14,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="if (type == 1)" FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock Grid.Row="1" Text="With it" Opacity="0.65" Margin="0,4,14,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="if (type == EACIT_Potion)" FontFamily="Cascadia Mono, Consolas" Margin="0,4,0,0" />
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GameFolderBox" VerticalContentAlignment="Center" Padding="8,6,40,6" />
                            <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                                    Click="BrowseGame_Click" ToolTip="Choose the game folder">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                            </Button>
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="DetectGame_Click"
                                    ToolTip="Look for The Witcher 3 in your Steam and GOG libraries">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                                    <TextBlock Margin="8,0,0,0" Text="Find automatically" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="GameFolderIcon" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock x:Name="GameFolderStatus" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="You can leave this empty if you only open scripts from inside your game's mods folder, because those find the game on their own. Set it if you open scripts from anywhere else, like a mod's release folder or a download." />
                    </StackPanel>
                </Border>

                <!-- Compiling -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="Script compiler" />
                            <Run Text="(optional)" FontWeight="Normal" FontSize="13" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   Text="REDkit's wcc_lite.exe, which compiles a script project into a precompiled.rsblob, the same way publishing from REDkit does. Compile stays off until it's set." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="WccBox" VerticalContentAlignment="Center" Padding="8,6,40,6" />
                            <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                                    Click="BrowseWcc_Click" ToolTip="Choose wcc_lite.exe">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                            </Button>
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="DetectWcc_Click"
                                    ToolTip="Look for REDkit in your Steam and GOG libraries">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                                    <TextBlock Margin="8,0,0,0" Text="Find automatically" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="WccIcon" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock x:Name="WccStatus" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="REDkit is free on Steam and GOG for owners of the game. wcc_lite is in its bin\x64_RedKit folder. Without it you can still edit and save scripts; only compiling needs it." />
                    </StackPanel>
                </Border>


                <!-- Script merger -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="Script merger" />
                            <Run Text="(optional)" FontWeight="Normal" FontSize="13" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Script Merger Remastered by relapse12, which merges mods that change the same scripts or files. The load order analyser suggests it for clashes and opens it from a button." />
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="MergerBox" VerticalContentAlignment="Center" Padding="8,6,40,6" />
                            <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                                    Click="BrowseMerger_Click" ToolTip="Choose the Script Merger program">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                            </Button>
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="DetectMerger_Click"
                                    ToolTip="Look in the game folder, Documents and Downloads">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                                    <TextBlock Margin="8,0,0,0" Text="Find automatically" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="MergerIcon" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock x:Name="MergerStatus" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="It's a separate download (nexusmods.com/witcher3/mods/13076). This app only starts it; it doesn't bundle or change it." />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="18,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="18,6" Click="Cancel_Click" IsCancel="True" />
                <Button Content="Save" Padding="22,6" Margin="8,0,0,0" Click="Save_Click" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Border>

        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
