<UserControl x:Class="W3ModWorkbench.FilePreview"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:W3ModWorkbench"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <UserControl.Resources>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF3A3A3A"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#FF4A4A4A">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </UserControl.Resources>

    <!-- the file highlighted in the list, as a picture, a mesh, a summary or text -->
    <Border CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" ClipToBounds="True">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Border x:Name="PreviewImageHost" Background="{StaticResource Checker}" Visibility="Collapsed">
                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="8" RenderOptions.BitmapScalingMode="HighQuality" />
                </Border>
                <Border x:Name="PreviewMeshHost" Visibility="Collapsed">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF4A4F57" Offset="0" />
                            <GradientStop Color="#FF2A2D32" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <local:MeshView x:Name="PreviewMesh" />
                </Border>
                <avalonEdit:TextEditor x:Name="PreviewText" IsReadOnly="True" BorderThickness="0" Background="Transparent" Visibility="Collapsed"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12" ShowLineNumbers="True" Padding="4,6,14,6"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}"
                                       HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" WordWrap="False" />
                <local:CutsceneSummary x:Name="PreviewCutscene" Visibility="Collapsed" />
                <local:SceneSummary x:Name="PreviewScene" Visibility="Collapsed" />
                <StackPanel x:Name="PreviewEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" MaxWidth="320">
                    <TextBlock x:Name="PreviewEmptyGlyph" FontFamily="{StaticResource IconFont}" Text="&#xE8A5;" FontSize="44" Opacity="0.4" HorizontalAlignment="Center" />
                    <TextBlock x:Name="PreviewEmptyText" Margin="0,12,0,0" Opacity="0.7" TextWrapping="Wrap" TextAlignment="Center" />
                </StackPanel>
            </Grid>
            <StackPanel Grid.Row="1" Margin="14,10,14,12">
                <TextBlock x:Name="PreviewName" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock x:Name="PreviewDetail" Opacity="0.7" TextWrapping="Wrap" Margin="0,3,0,0" FontSize="12" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
