<UserControl x:Class="W3ModWorkbench.PreviewDocument"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
             xmlns:local="clr-namespace:W3ModWorkbench"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit">
    <UserControl.Resources>
        <Style x:Key="SearchIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="SearchToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- the completion list's names: the theme's soft highlight and an accent bar for the picked one, not Windows' blue -->
        <Style x:Key="CompletionItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-7,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- the declaration beside the completion list, as a card like the definition popup -->
        <Style x:Key="CompletionTip" TargetType="ToolTip">
            <Setter Property="HasDropShadow" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Margin="4,0,14,14" Padding="12,8" CornerRadius="8" BorderThickness="1" MaxWidth="560"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" />
                            </Border.Effect>
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- AvalonEdit's search bar, restyled to match the Fluent theme -->
        <Style TargetType="search:SearchPanel">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type search:SearchPanel}">
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,18,0" Padding="6" Cursor="Arrow"
                                CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Name="PART_searchTextBox" Width="230" VerticalContentAlignment="Center"
                                         Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                <ToggleButton Style="{StaticResource SearchToggle}" Content="{l:T Common.Aa}" ToolTip="{l:T Common.MatchCase}"
                                              IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}" Margin="6,0,0,0" />
                                <ToggleButton Style="{StaticResource SearchToggle}" Content="{l:T Common.Ab}" ToolTip="{l:T Common.WholeWordsOnly}"
                                              IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ToggleButton Style="{StaticResource SearchToggle}" Content=".*" ToolTip="{l:T Common.RegularExpression}"
                                              IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Button Style="{StaticResource SearchIconButton}" Command="search:SearchCommands.FindPrevious" ToolTip="{l:T Common.PreviousMatchShiftF3}" Margin="8,0,0,0">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource SearchIconButton}" Command="search:SearchCommands.FindNext" ToolTip="{l:T Common.NextMatchF3}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource SearchIconButton}" Command="search:SearchCommands.CloseSearchPanel" ToolTip="{l:T Common.CloseEsc}">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="11" />
                                </Button>
                                <!-- AvalonEdit looks this part up; the options live in the toggles instead -->
                                <Popup Name="PART_dropdownPopup" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border CornerRadius="8" BorderThickness="1" Padding="0,6,0,0" ClipToBounds="True"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
        <!-- its own adorner layer, so the search bar stays with this file when it's hidden behind another tab or moved -->
        <AdornerDecorator>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- where the caret is: its class and function, each a menu of the others in the file -->
                <Border x:Name="OutlineBar" Visibility="Visible" Padding="10,0,10,4" Margin="0,-2,0,4" BorderThickness="0,0,0,1"
                        BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                    <DockPanel>
                        <ToggleButton x:Name="OutlineToggle" DockPanel.Dock="Right" Padding="8,2" MinHeight="0" BorderThickness="0" Focusable="False"
                                      ToolTip="{l:T PreviewDocument.ShowHideOutlineBeside}" Click="Outline_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" FontSize="12" VerticalAlignment="Center" Margin="0,3,0,0" />
                                <TextBlock Text="{l:T Common.Outline}" Margin="6,0,0,0" FontSize="12.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <StackPanel x:Name="Crumbs" Orientation="Horizontal" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>

                <!-- the text, and the outline beside it for scripts -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="200" />
                        <ColumnDefinition x:Name="OutlineSplitterColumn" Width="0" />
                        <ColumnDefinition x:Name="OutlineColumn" Width="0" />
                    </Grid.ColumnDefinitions>
                    <avalonEdit:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True"
                                           FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}">
                        <!-- only scripts keep this menu: other files get none -->
                        <avalonEdit:TextEditor.ContextMenu>
                            <ContextMenu Opened="ContextMenu_Opened">
                                <MenuItem Header="{l:T PreviewDocument.GoDefinition}" InputGestureText="F12" Click="GoToDefinition_Click" />
                                <MenuItem Header="{l:T PreviewDocument.OpenDefinitionSide}" InputGestureText="Ctrl+F12" Click="GoToDefinitionSide_Click" />
                                <MenuItem Header="{l:T PreviewDocument.FindAllReferences}" InputGestureText="Shift+F12" Click="FindReferences_Click" />
                                <MenuItem Header="{l:T PreviewDocument.WhoElseChanges}" InputGestureText="Ctrl+Shift+F12" Click="Changes_Click"
                                          ToolTip="{l:T PreviewDocument.ModsWrapReplaceOverride}" />
                                <MenuItem Header="{l:T PreviewDocument.ShowTypeHierarchy}" InputGestureText="Shift+Alt+H" Click="Hierarchy_Click" />
                                <MenuItem Header="{l:T PreviewDocument.ShowUsageGraph}" Click="UsageGraph_Click"
                                          ToolTip="{l:T PreviewDocument.GraphWhatUsesFunction}" />
                                <MenuItem Header="{l:T PreviewDocument.CreateWrapReplaceStub}" Click="Stub_Click"
                                          ToolTip="{l:T PreviewDocument.OpensStubGeneratorFunction}" />
                                <Separator />
                                <MenuItem x:Name="RenameMenuItem" Header="{l:T PreviewDocument.Rename}" InputGestureText="F2" Click="Rename_Click"
                                          ToolTip="{l:T PreviewDocument.RenamesFunctionVariableType}" />
                                <MenuItem x:Name="SnippetMenuItem" Header="{l:T PreviewDocument.InsertSnippet}" InputGestureText="Ctrl+J" Click="Snippet_Click"
                                          ToolTip="{l:T PreviewDocument.CommonWitcherScriptPatternsYour}" />
                                <MenuItem x:Name="CompleteMenuItem" Header="{l:T PreviewDocument.CompleteName}" InputGestureText="Ctrl+Space" Click="Complete_Click" />
                                <Separator />
                                <MenuItem x:Name="BackMenuItem" Header="{l:T PreviewDocument.Back}" InputGestureText="Alt+Left" Click="Back_Click" />
                                <MenuItem x:Name="ForwardMenuItem" Header="{l:T PreviewDocument.Forward}" InputGestureText="Alt+Right" Click="Forward_Click" />
                                <MenuItem Header="{l:T PreviewDocument.GoSymbolFile}" Click="GoToSymbolInFile_Click" />
                                <Separator />
                                <MenuItem x:Name="CompareGameMenuItem" Header="{l:T PreviewDocument.CompareGameVersion}" Click="CompareGame_Click" />
                                <MenuItem x:Name="CompareOpenMenuItem" Header="{l:T PreviewDocument.CompareOpenFile}" Click="CompareOpen_Click" />
                                <MenuItem x:Name="NextDiffMenuItem" Header="{l:T PreviewDocument.NextDifference}" InputGestureText="F8" Click="NextDiff_Click" />
                                <MenuItem x:Name="ClearDiffMenuItem" Header="{l:T PreviewDocument.StopComparing}" Click="ClearDiff_Click" />
                                <Separator />
                                <MenuItem Header="{l:T Common.Copy}" Command="ApplicationCommands.Copy" />
                            </ContextMenu>
                        </avalonEdit:TextEditor.ContextMenu>
                    </avalonEdit:TextEditor>

                    <!-- messages and questions, shown over the text next to the name they're about -->
                    <Canvas x:Name="CardLayer">
                        <local:MessageCard x:Name="Card" />
                    </Canvas>

                    <GridSplitter x:Name="OutlineSplitter" Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent"
                                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Focusable="False" Visibility="Collapsed"
                                  DragCompleted="OutlineSplitter_DragCompleted" />
                    <Border x:Name="OutlineHost" Grid.Column="2" Visibility="Collapsed" BorderThickness="1,0,0,0" Padding="0,2,0,0"
                            BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
                        <local:OutlinePanel x:Name="Outline" />
                    </Border>
                </Grid>

                <!-- the declaration of the name under the mouse -->
                <Popup x:Name="PeekPopup" AllowsTransparency="True" Placement="Bottom" StaysOpen="True"
                       Focusable="False" IsHitTestVisible="False" HorizontalOffset="-14" VerticalOffset="2">
                    <Border Margin="2,0,14,14" Padding="12,10" MaxWidth="720" CornerRadius="8" BorderThickness="1"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" />
                        </Border.Effect>
                        <ContentControl x:Name="PeekContent" Focusable="False" />
                    </Border>
                </Popup>

                <!-- the parameters of the call the caret is in, with the one it's on picked out -->
                <Popup x:Name="HintPopup" AllowsTransparency="True" Placement="Top" StaysOpen="True"
                       Focusable="False" IsHitTestVisible="False" HorizontalOffset="-14" VerticalOffset="-2">
                    <Border Margin="2,14,14,2" Padding="10,6" MaxWidth="760" CornerRadius="6" BorderThickness="1"
                            Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                            BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.3" />
                        </Border.Effect>
                        <TextBlock x:Name="HintText" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5" TextWrapping="Wrap" />
                    </Border>
                </Popup>
            </Grid>
        </AdornerDecorator>
    </Border>
</UserControl>
