<UserControl x:Class="W3ModWorkbench.MenuBuilderPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
             xmlns:local="clr-namespace:W3ModWorkbench"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit">
    <UserControl.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="MiniButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style x:Key="CodeBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="CellEdit" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="5,3" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
        <Style x:Key="GridCell" TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Rectangle x:Name="Highlight" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" MinWidth="190" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="320" />
        </Grid.ColumnDefinitions>

        <!-- the pages, and the settings on the page picked -->
        <Grid Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2*" MinHeight="90" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="3*" MinHeight="120" />
            </Grid.RowDefinitions>

            <DockPanel Margin="2,0,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Style="{StaticResource MiniButton}" Click="AddGroup_Click" ToolTip="{l:T MenuBuilderPanel.AddPage}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                    </Button>
                    <Button Style="{StaticResource MiniButton}" Click="RemoveGroup_Click" ToolTip="{l:T MenuBuilderPanel.RemovePage}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                    </Button>
                    <Button Style="{StaticResource MiniButton}" Click="GroupUp_Click" ToolTip="{l:T MenuBuilderPanel.MoveUp}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74A;" />
                    </Button>
                    <Button Style="{StaticResource MiniButton}" Click="GroupDown_Click" ToolTip="{l:T MenuBuilderPanel.MoveDown}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74B;" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{l:T MenuBuilderPanel.Pages}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                <ListBox x:Name="GroupList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0" SelectionChanged="GroupList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Summary}" Margin="4,3" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <DockPanel Grid.Row="2" Margin="2,12,0,6">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="AddVarButton" Style="{StaticResource MiniButton}" Click="AddVar_Click" ToolTip="{l:T MenuBuilderPanel.AddSettingPage}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                    </Button>
                    <Button Style="{StaticResource MiniButton}" Click="RemoveVar_Click" ToolTip="{l:T MenuBuilderPanel.RemoveSetting}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                    </Button>
                    <Button Style="{StaticResource MiniButton}" Click="VarUp_Click" ToolTip="{l:T MenuBuilderPanel.MoveUp}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74A;" />
                    </Button>
                    <Button Style="{StaticResource MiniButton}" Click="VarDown_Click" ToolTip="{l:T MenuBuilderPanel.MoveDown}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74B;" />
                    </Button>
                </StackPanel>
                <TextBlock Text="{l:T Common.Settings}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </DockPanel>
            <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True">
                <ListBox x:Name="VarList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0" SelectionChanged="VarList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="4,3">
                                <TextBlock DockPanel.Dock="Right" Opacity="0.55" FontSize="11.5" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Text="{Binding Kind}" />
                                <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" Focusable="False" />

        <TabControl x:Name="Tabs" Grid.Column="2" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}" SelectionChanged="Tabs_SelectionChanged">
            <TabControl.Template>
                <ControlTemplate TargetType="TabControl">
                    <!-- one row of tabs that never wraps, whatever the width -->
                    <DockPanel>
                        <StackPanel x:Name="HeaderPanel" DockPanel.Dock="Top" Orientation="Horizontal" IsItemsHost="True" Margin="0,0,0,8" />
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </TabControl.Template>
            <TabControl.Resources>
                <!-- compact pill tabs, so all five fit in a row -->
                <Style TargetType="TabItem">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Pill" Padding="12,5" Margin="0,0,4,0" CornerRadius="6" Background="Transparent" Cursor="Hand">
                                    <ContentPresenter ContentSource="Header" TextElement.FontSize="13" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Pill" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.Resources>
            <!-- the page or setting picked -->
            <TabItem Foreground="{DynamicResource TextFillColorPrimaryBrush}" Header="{l:T MenuBuilderPanel.Details}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,0,10,10" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <StackPanel>
                        <TextBlock x:Name="NothingText" Style="{StaticResource Hint}" Margin="0,14,0,0"
                                   Text="{l:T MenuBuilderPanel.PickPageSettingLeft}" />

                        <!-- a page -->
                        <StackPanel x:Name="GroupForm" Visibility="Collapsed">
                            <TextBlock Text="{l:T MenuBuilderPanel.PageId}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="GroupIdBox" Style="{StaticResource CodeBox}" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T MenuBuilderPanel.WhatScriptsCallPage}" />
                            <TextBlock Text="{l:T MenuBuilderPanel.DisplayNameWherePage}" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="GroupNameBox" Style="{StaticResource CodeBox}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T MenuBuilderPanel.DotsMakeLevelsMods}" />
                        </StackPanel>

                        <!-- a setting -->
                        <StackPanel x:Name="VarForm" Visibility="Collapsed">
                            <TextBlock Text="{l:T Common.Type}" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="KindBox" Width="220" HorizontalAlignment="Left" SelectionChanged="KindBox_SelectionChanged" />
                            <StackPanel x:Name="IdFields">
                                <TextBlock Text="{l:T MenuBuilderPanel.SettingId}" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource CodeBox}" Text="{Binding Id, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:T MenuBuilderPanel.WhatScriptsCallSetting}" />
                                <TextBlock Text="{l:T MenuBuilderPanel.DisplayNameKey}" Style="{StaticResource FieldLabel}" />
                                <TextBox Style="{StaticResource CodeBox}" Text="{Binding DisplayName, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock Style="{StaticResource Hint}" Text="{l:T MenuBuilderPanel.KeyTextShownBeside}" />
                            </StackPanel>

                            <StackPanel x:Name="DefaultFields">
                                <TextBlock Text="{l:T MenuBuilderPanel.DefaultValue}" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="DefaultBox" Width="220" HorizontalAlignment="Left" Style="{StaticResource CodeBox}"
                                         Text="{Binding Default, UpdateSourceTrigger=PropertyChanged}" />
                                <TextBlock x:Name="DefaultHint" Style="{StaticResource Hint}" />
                            </StackPanel>

                            <StackPanel x:Name="SliderFields" Visibility="Collapsed">
                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Text="{l:T MenuBuilderPanel.Minimum}" Opacity="0.7" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource CodeBox}" Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="0,0,6,0">
                                        <TextBlock Text="{l:T MenuBuilderPanel.Maximum}" Opacity="0.7" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource CodeBox}" Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{l:T MenuBuilderPanel.Steps}" Opacity="0.7" Margin="0,0,0,4" />
                                        <TextBox Style="{StaticResource CodeBox}" Text="{Binding Steps, UpdateSourceTrigger=PropertyChanged}" />
                                    </StackPanel>
                                </Grid>
                                <Button Margin="0,8,0,0" Padding="10,4" HorizontalAlignment="Left" Click="WholeNumbers_Click"
                                        Content="{l:T MenuBuilderPanel.WholeNumbersStepsMaximum}" />
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{l:T MenuBuilderPanel.WrittenSliderMinMax}" />
                            </StackPanel>

                            <StackPanel x:Name="OptionFields" Visibility="Collapsed">
                                <DockPanel Margin="0,12,0,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Style="{StaticResource MiniButton}" Click="AddOption_Click" ToolTip="{l:T MenuBuilderPanel.AddOption}">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                                        </Button>
                                        <Button Style="{StaticResource MiniButton}" Click="RemoveOption_Click" ToolTip="{l:T MenuBuilderPanel.RemoveSelectedOptions}">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{l:T MenuBuilderPanel.Options}" Opacity="0.7" VerticalAlignment="Center" />
                                </DockPanel>
                                <Border Style="{StaticResource Card}" ClipToBounds="True" Height="230">
                                    <DataGrid x:Name="OptionGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                                              GridLinesVisibility="None" BorderThickness="0" Background="Transparent" SelectionMode="Extended" SelectionUnit="FullRow"
                                              CellStyle="{StaticResource GridCell}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{l:T MenuBuilderPanel.Value}" Width="90" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}" />
                                            <DataGridTextColumn Header="{l:T MenuBuilderPanel.DisplayNameKey}" Width="*" Binding="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                                                ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Border>
                                <TextBlock Style="{StaticResource Hint}"
                                           Text="{l:T MenuBuilderPanel.PickingOptionSetsSetting}" />
                            </StackPanel>

                            <TextBlock x:Name="SeparatorHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                                       Text="{l:T MenuBuilderPanel.ThinLineBetweenSettings}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- named sets of values -->
            <TabItem Foreground="{DynamicResource TextFillColorPrimaryBrush}" Header="{l:T MenuBuilderPanel.Presets}">
                <Grid Margin="4,10,10,10" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="130" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Style="{StaticResource MiniButton}" Click="AddPreset_Click" ToolTip="{l:T MenuBuilderPanel.AddPresetPage}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                            </Button>
                            <Button Style="{StaticResource MiniButton}" Click="RemovePreset_Click" ToolTip="{l:T MenuBuilderPanel.RemovePreset}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="PresetsTitle" Text="{l:T MenuBuilderPanel.PresetsPage}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                        <DataGrid x:Name="PresetGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                  BorderThickness="0" Background="Transparent" SelectionMode="Single" SelectionUnit="FullRow" CellStyle="{StaticResource GridCell}"
                                  SelectionChanged="PresetGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T MenuBuilderPanel.Id}" Width="70" Binding="{Binding Id, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}" />
                                <DataGridTextColumn Header="{l:T MenuBuilderPanel.DisplayNameKey}" Width="*" Binding="{Binding DisplayName, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <DockPanel Grid.Row="2" Margin="0,12,0,6">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Padding="10,4" Margin="4,0,0,0" Click="FillPreset_Click"
                                    ToolTip="{l:T MenuBuilderPanel.GivePresetLineEvery}"
                                    Content="{l:T MenuBuilderPanel.AddMissingSettings}" />
                            <Button Style="{StaticResource MiniButton}" Click="AddEntry_Click" ToolTip="{l:T MenuBuilderPanel.AddLine}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE710;" />
                            </Button>
                            <Button Style="{StaticResource MiniButton}" Click="RemoveEntry_Click" ToolTip="{l:T MenuBuilderPanel.RemoveSelectedLines}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" />
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="EntriesTitle" Text="{l:T MenuBuilderPanel.Values}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True">
                        <DataGrid x:Name="EntryGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                  BorderThickness="0" Background="Transparent" SelectionMode="Extended" SelectionUnit="FullRow" CellStyle="{StaticResource GridCell}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T MenuBuilderPanel.Setting}" Width="*" Binding="{Binding VarId, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}" />
                                <DataGridTextColumn Header="{l:T MenuBuilderPanel.Value}" Width="130" Binding="{Binding Value, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- the text each key needs -->
            <TabItem Foreground="{DynamicResource TextFillColorPrimaryBrush}" Header="{l:T MenuBuilderPanel.Strings}">
                <Grid Margin="4,10,10,10" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="StringsIntro" Style="{StaticResource Hint}" Margin="0,0,0,8"
                               Text="{l:T MenuBuilderPanel.MenuShowsTextKey}" />
                    <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                        <DataGrid x:Name="KeyGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="None"
                                  BorderThickness="0" Background="Transparent" SelectionMode="Extended" SelectionUnit="FullRow" CellStyle="{StaticResource GridCell}"
                                  EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T Common.Key}" Width="210" IsReadOnly="True" Binding="{Binding Key}" ElementStyle="{StaticResource CellText}" />
                                <DataGridTextColumn Header="{l:T Common.Text}" Width="*" Binding="{Binding Text, UpdateSourceTrigger=LostFocus}"
                                                    ElementStyle="{StaticResource CellText}" EditingElementStyle="{StaticResource CellEdit}" />
                                <DataGridTextColumn Header="{l:T MenuBuilderPanel.CSV}" Width="100" IsReadOnly="True" Binding="{Binding InFile}" ElementStyle="{StaticResource CellText}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <StackPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{l:T MenuBuilderPanel.FirstNewID}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
                            <TextBox x:Name="FirstIdBox" Width="130" Style="{StaticResource CodeBox}" />
                            <Button Margin="6,0,0,0" Padding="10,4" Click="FreeBlock_Click" ToolTip="{l:T MenuBuilderPanel.PickBlockIDsGame}"
                                    Content="{l:T MenuBuilderPanel.FindFreeBlock}" />
                        </StackPanel>
                        <WrapPanel Margin="0,8,0,0">
                            <Button Margin="0,0,6,0" Padding="10,4" Click="LoadCsv_Click" Content="{l:T MenuBuilderPanel.LoadTextsCSV}"
                                    ToolTip="{l:T MenuBuilderPanel.FillTextsStringsCSV}" />
                            <Button Margin="0,0,6,0" Padding="10,4" Click="CopyCsv_Click" Content="{l:T MenuBuilderPanel.CopyCSVLines}" />
                            <Button Padding="10,4" Click="AddToCsv_Click" Style="{DynamicResource AccentButtonStyle}" Content="{l:T MenuBuilderPanel.AddCSV}"
                                    ToolTip="{l:T MenuBuilderPanel.AddKeysCSVDoesnt}" />
                        </WrapPanel>
                        <TextBlock x:Name="CsvText" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- the script that reads the settings -->
            <TabItem Foreground="{DynamicResource TextFillColorPrimaryBrush}" Header="{l:T MenuBuilderPanel.Script}">
                <Grid Margin="4,10,10,10" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,8">
                        <Button DockPanel.Dock="Right" Padding="10,4" Click="CopyScript_Click" Content="{l:T Common.Copy}" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,0,10,0"
                                   Text="{l:T MenuBuilderPanel.WitcherScriptReadsEverySetting}" />
                    </DockPanel>
                    <Border Grid.Row="1" BorderThickness="1" CornerRadius="4" Padding="0,6,0,0" ClipToBounds="True"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <avalonEdit:TextEditor x:Name="ScriptBox" IsReadOnly="True" ShowLineNumbers="True"
                                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                               Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Border>
                </Grid>
            </TabItem>

            <!-- what's wrong -->
            <TabItem Foreground="{DynamicResource TextFillColorPrimaryBrush}" Header="{l:T Common.Problems}">
                <Grid Margin="4,10,10,10" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="ProblemsTitle" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                        <ListBox x:Name="ProblemList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0" MouseDoubleClick="ProblemList_MouseDoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="4,3" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
