<Window x:Class="W3ModWorkbench.ModMakerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T ModMaker.Title}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="860" Height="680" MinWidth="600" MinHeight="420"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="PathText" Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" Text="{l:T ModMaker.Explain}" />
                <TextBlock x:Name="ProjectText" Margin="0,6,0,10" TextWrapping="Wrap" Opacity="0.8" />
            </StackPanel>

            <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="ListScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl x:Name="Groups" Margin="14,8,14,10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:MakeGroup}">
                                    <StackPanel Margin="0,6,0,4">
                                        <DockPanel Margin="0,2,0,4">
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Visibility="{Binding FormatVisibility}" Margin="0,0,10,0">
                                                    <TextBlock Text="{l:T ModMaker.As}" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,6,0" />
                                                    <ComboBox Width="84" ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" ToolTip="{l:T ModMaker.FormatTip}" />
                                                </StackPanel>
                                                <Button Padding="8,2" Content="{Binding ToggleText}" Click="ToggleGroup_Click" Tag="{Binding}" Visibility="{Binding ToggleVisibility}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource Caption}" VerticalAlignment="Center" Text="{Binding Title}" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Hint}" Visibility="{Binding HintVisibility}" Opacity="0.65" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4" />
                                        <ItemsControl ItemsSource="{Binding Rows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type local:MakeRow}">
                                                    <Grid Margin="0,2" ToolTip="{Binding Tooltip}" Opacity="{Binding Opacity}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding Picked}" IsEnabled="{Binding CanPick}" MinWidth="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                                                <Run Text="{Binding Becomes, Mode=OneWay}" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                            </TextBlock>
                                                            <TextBlock Text="{Binding Folder}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Detail}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                                                            <Border Style="{StaticResource Badge}" Visibility="{Binding InProjectVisibility}">
                                                                <TextBlock Text="{l:T ModMaker.InProject}" FontSize="11.5" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <StackPanel x:Name="Busy" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
                        <TextBlock x:Name="BusyText" Margin="0,10,0,0" HorizontalAlignment="Center" Opacity="0.75" Text="{l:T ModMaker.Finding}" />
                    </StackPanel>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Padding="14,6" Content="{l:T Common.Cancel}" Click="Cancel_Click" IsCancel="True" />
                    <Button x:Name="CopyButton" Padding="14,6" Margin="8,0,0,0" Click="Copy_Click" IsEnabled="False" IsDefault="True" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" />
                            <TextBlock x:Name="CopyText" Margin="8,0,0,0" Text="{l:T ModMaker.Copy}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <CheckBox x:Name="OpenCheck" DockPanel.Dock="Left" Content="{l:T ModMaker.OpenCopy}" VerticalAlignment="Center" MinWidth="0" Margin="0,0,16,0" />
                <TextBlock x:Name="SummaryText" VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
