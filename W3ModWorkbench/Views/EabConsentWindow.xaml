<Window x:Class="W3ModWorkbench.EabConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        Title="{l:T EabConsentWindow.EasyAssetBrowserTags}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="600" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Point" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="{l:T EabConsentWindow.TurnEasyAssetBrowserTags}" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Point}" Margin="0,10,0,0" Opacity="0.85">
            <Run Text="{l:T EabConsentWindow.EasyAssetBrowserSeparateFanProject}" />
        </TextBlock>

        <TextBlock Style="{StaticResource Point}" Margin="0,14,0,0" FontWeight="SemiBold" Text="{l:T EabConsentWindow.OnlyThingToolGoes}" />
        <TextBlock Style="{StaticResource Point}">
            <Run Text="{l:T EabConsentWindow.ToolDownloadsEasyAssetBrowsersLists}" />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="{l:T EabConsentWindow.AnyDownloadGitHubSees}" />
            <Hyperlink Click="GitHubPrivacy_Click"><Run Text="{l:T EabConsentWindow.GitHubsPrivacyStatement}" /></Hyperlink>
            <Run Text="{l:T EabConsentWindow.CoversNobodyElseTools}" />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="{l:T EabConsentWindow.NothingAboutYouYour}" />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="{l:T EabConsentWindow.ListsKeptYourComputer}" />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="{l:T EabConsentWindow.SuggestingTagsOnlyOpens}" />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="{l:T EabConsentWindow.YouCanTurnOff}" />
        </TextBlock>

        <TextBlock Style="{StaticResource Point}" Margin="0,14,0,0" Opacity="0.75">
            <Hyperlink Click="Privacy_Click"><Run Text="{l:T EabConsentWindow.ReadPrivacyNotice}" /></Hyperlink>
            <Run Text="  ·  " />
            <Hyperlink Click="Site_Click"><Run Text="{l:T EabConsentWindow.EasyAssetBrowsersSite}" /></Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Padding="16,6" Click="NotNow_Click" IsCancel="True" Content="{l:T EabConsentWindow.NotNow}" />
            <Button Margin="8,0,0,0" Padding="16,6" Click="TurnOn_Click" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Content="{l:T EabConsentWindow.Turn}" />
        </StackPanel>
    </StackPanel>
</Window>
