<Window x:Class="W3ModWorkbench.EabConsentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="EasyAssetBrowser tags" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="600" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="Point" TargetType="TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
    </Window.Resources>
    <StackPanel Margin="24,20,24,20">
        <TextBlock Text="Turn on EasyAssetBrowser tags?" FontSize="18" FontWeight="SemiBold" />
        <TextBlock Style="{StaticResource Point}" Margin="0,10,0,0" Opacity="0.85">
            <Run Text="EasyAssetBrowser is a separate fan project by Vincent.02 that sorts the game's assets into categories and tags them for world building (Kaer Morhen, Ruin, Corpses…). It isn't part of W3 Mod Workbench and isn't made by CD PROJEKT RED." />
        </TextBlock>

        <TextBlock Style="{StaticResource Point}" Margin="0,14,0,0" FontWeight="SemiBold" Text="This is the only thing in the tool that goes online. If you turn it on:" />
        <TextBlock Style="{StaticResource Point}">
            <Run Text="•  The tool downloads EasyAssetBrowser's lists (about 12 MB) from GitHub when the Asset Browser opens, at most once a day, and when you ask it to." />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="•  As with any download, GitHub sees your IP address. " />
            <Hyperlink Click="GitHubPrivacy_Click">GitHub's privacy statement</Hyperlink>
            <Run Text=" covers that. Nobody else, the tool's author included, receives anything." />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="•  Nothing about you, your files, your mods or how you use the tool is sent. There's no account, no analytics and no tracking." />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="•  The lists are kept on your computer, so the tags still work offline." />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="•  Suggesting tags only opens your browser at a new GitHub issue. Nothing is posted unless you post it yourself, publicly, with your own GitHub account." />
        </TextBlock>
        <TextBlock Style="{StaticResource Point}">
            <Run Text="•  You can turn it off at any time from the ⓘ button beside the tags, and delete what was downloaded." />
        </TextBlock>

        <TextBlock Style="{StaticResource Point}" Margin="0,14,0,0" Opacity="0.75">
            <Hyperlink Click="Privacy_Click">Read the privacy notice</Hyperlink>
            <Run Text="  ·  " />
            <Hyperlink Click="Site_Click">EasyAssetBrowser's site</Hyperlink>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Padding="16,6" Click="NotNow_Click" IsCancel="True" Content="Not now" />
            <Button Margin="8,0,0,0" Padding="16,6" Click="TurnOn_Click" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Content="Turn on" />
        </StackPanel>
    </StackPanel>
</Window>
