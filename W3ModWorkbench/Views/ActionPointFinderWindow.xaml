<Window x:Class="W3ModWorkbench.ActionPointFinderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T ActionPoints.Title}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1600" Height="980" MinWidth="1100" MinHeight="620"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource WashItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="14,12,14,8">
            <TextBlock Text="{l:T ActionPoints.Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Opacity="0.65" Margin="0,2,0,0" TextWrapping="Wrap" Text="{l:T ActionPoints.Explain}" />
        </StackPanel>

        <Grid x:Name="Body" Grid.Row="1" Margin="14,0,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="380" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="420" />
            </Grid.ColumnDefinitions>

            <!-- the views -->
            <Border Style="{StaticResource Card}" ClipToBounds="True">
                <DockPanel Margin="8">
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBox x:Name="SearchBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" ToolTip="{l:T ActionPoints.FindTip}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock x:Name="SearchHint" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" Text="{l:T ActionPoints.Find}" />
                    </Grid>
                    <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="4,4,4,2" Style="{StaticResource Small}" />
                    <ListBox x:Name="ViewList" BorderThickness="0" Background="Transparent" SelectionChanged="ViewList_SelectionChanged" IsSynchronizedWithCurrentItem="False"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.IsVirtualizingWhenGrouping="True" VirtualizingPanel.VirtualizationMode="Recycling"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Margin="6,10,0,4"
                                                   Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:ActionPointViewRow}">
                                <DockPanel Margin="2,3">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="6,0,0,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False" />

            <!-- the view, and the point picked -->
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <ScrollViewer x:Name="CardScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="Card" Margin="18,14,18,18" />
                    </ScrollViewer>
                    <TextBlock x:Name="CardEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap" TextAlignment="Center"
                               Margin="16" Text="{l:T ActionPoints.PickView}" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False" />

            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="220" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="2*" MinHeight="170" />
                </Grid.RowDefinitions>

                <!-- where they are -->
                <Border Style="{StaticResource Card}">
                    <DockPanel Margin="8">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <ComboBox x:Name="WorldBox" MinWidth="220" SelectionChanged="WorldBox_SelectionChanged" ToolTip="{l:T ActionPoints.WorldTip}" Margin="0,0,10,4" />
                            <CheckBox x:Name="ModsCheck" Content="{l:T LootLocator.WithMods}" MinWidth="0" Margin="0,0,12,4" VerticalAlignment="Center" Click="ModsCheck_Click"
                                      ToolTip="{l:T ActionPoints.WithModsTip}" />
                            <Button Margin="0,0,8,4" Padding="10,3" Click="Fit_Click" ToolTip="{l:T ActionPoints.FitTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T Common.Fit}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportButton" Margin="0,0,0,4" Padding="10,3" Click="Export_Click" IsEnabled="False" ToolTip="{l:T ActionPoints.ExportTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xEDE1;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T LootLocator.Export}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="HoverText" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextTrimming="CharacterEllipsis"
                                   Text="{l:T ActionPoints.MouseHint}" />
                        <Border CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <local:WorldMap x:Name="Map" PointerMoved="Map_PointerMoved" MarkerPicked="Map_MarkerPicked" />
                                <Border x:Name="Legend" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="10,7" CornerRadius="6"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.92" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock Text="{l:T ActionPoints.LegendTitle}" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl x:Name="LegendList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Text}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="MapProgress" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,4" Visibility="Collapsed"
                                           Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                                <TextBlock x:Name="MapEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="420" Padding="12,8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Text="{l:T ActionPoints.PickView}" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False" />

                <!-- the points in the world shown -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel Margin="8,8,8,6">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBox x:Name="FilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" ToolTip="{l:T ActionPoints.FilterTip}" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71C;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="FilterHint" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" Text="{l:T ActionPoints.Filter}" />
                        </Grid>
                        <TextBlock x:Name="PointCountText" DockPanel.Dock="Bottom" Margin="4,4,4,0" Style="{StaticResource Small}" />
                        <DataGrid x:Name="PointGrid" Style="{StaticResource ViewerGrid}" SelectionMode="Single" SelectionChanged="PointGrid_SelectionChanged"
                                  MouseDoubleClick="PointGrid_MouseDoubleClick" EnableRowVirtualization="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T ActionPoints.Kind}" Binding="{Binding KindText}" Width="140" />
                                <DataGridTextColumn Header="{l:T LootLocator.Area}" Binding="{Binding Area}" Width="2*" />
                                <DataGridTextColumn Header="{l:T ActionPoints.Tags}" Binding="{Binding TagsText}" Width="2*" />
                                <DataGridTextColumn Header="{l:T ActionPoints.JobTree}" Binding="{Binding JobTreeText}" Width="2*" />
                                <DataGridTextColumn Header="{l:T LootLocator.Position}" Binding="{Binding PositionText}" Width="150" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <StackPanel x:Name="Busy" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="240" Height="4" />
            <TextBlock x:Name="BusyText" Margin="0,10,0,0" HorizontalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                       Text="{l:T ActionPoints.Reading}" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="18,6,14,8" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="3" IsModal="True" />
    </Grid>
</Window>
