<Window x:Class="W3ModWorkbench.SceneWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:vm="clr-namespace:W3ModWorkbench.ViewModels"
        Title="Scene" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1180" Height="860" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,4,0,8" />
        </Style>
        <!-- a link to another part or a file: accent text, underlined under the mouse -->
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Setter Property="Cursor" Value="Arrow" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- what a section says, a row at a time -->
        <DataTemplate DataType="{x:Type vm:SceneLineRow}">
            <Border x:Name="Mark" CornerRadius="4" Padding="4,2" Margin="-4,1" Background="Transparent">
            <Grid ToolTip="{Binding Tip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Button Style="{StaticResource LinkButton}" Click="PlayLine_Click" Tag="{Binding}" VerticalAlignment="Top" Margin="0,2,10,0"
                        ToolTip="Play this line">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="12" />
                </Button>
                <StackPanel Grid.Column="1" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="{Binding SpeakerBrush}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding To}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <TextBlock Grid.Column="2" Text="{Binding Text}" TextWrapping="Wrap" />
            </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                    <Setter TargetName="Mark" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    <Setter TargetName="Mark" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter TargetName="Mark" Property="BorderThickness" Value="2,0,0,0" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SceneNoteRow}">
            <TextBlock Text="{Binding Text}" FontStyle="{Binding Style}" FontWeight="{Binding Weight}" Opacity="{Binding Opacity}"
                       TextWrapping="Wrap" Margin="0,3" />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SceneOptionRow}">
            <Grid Margin="14,3,0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="▸" Margin="0,0,8,0" Opacity="0.6" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Link_Click" Tag="{Binding Link}" IsEnabled="{Binding Link.CanGo}">
                        <TextBlock Text="{Binding Link.Text}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="220" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- search, language and back -->
            <DockPanel Grid.Row="0" Grid.ColumnSpan="3" Margin="0,0,0,10" LastChildFill="True">
                <Button x:Name="BackButton" DockPanel.Dock="Left" Padding="10,5" Margin="0,0,8,0" Click="Back_Click" IsEnabled="False"
                        ToolTip="Back to where you followed a link from (Alt+Left)">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72B;" />
                </Button>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button x:Name="ReadButton" Padding="12,5" Margin="10,0,0,0" Click="Read_Click"
                            ToolTip="Play the voices from the part picked (or the start), following the flow; stops at a choice or a condition for you to pick a way (R)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ReadIcon" Style="{StaticResource IconText}" Text="&#xE768;" />
                            <TextBlock x:Name="ReadLabel" Margin="8,0,0,0" Text="Read through" />
                        </StackPanel>
                    </Button>
                    <ToggleButton x:Name="PausesToggle" Padding="12,5" Margin="10,0,0,0" Click="Pauses_Click" ToolTip="Show the pauses between lines">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE916;" />
                            <TextBlock Margin="8,0,0,0" Text="Pauses" />
                        </StackPanel>
                    </ToggleButton>
                    <TextBlock Text="Language" VerticalAlignment="Center" Margin="14,0,8,0" Opacity="0.7" />
                    <ComboBox x:Name="LanguageBox" Width="90" SelectionChanged="LanguageBox_SelectionChanged" ToolTip="The language the lines are shown in" />
                </StackPanel>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="32,6,8,6" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="11,0,0,0" Opacity="0.6"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchPlaceholder" Margin="33,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="Search lines, speakers and sections  (Ctrl+F)" />
                </Grid>
            </DockPanel>

            <!-- the flow at a glance, who's in it and the files it uses -->
            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Heading}" Text="Flow" />
                        <ListBox x:Name="FlowList" BorderThickness="0" Background="Transparent" SelectionChanged="FlowList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" PreviewMouseWheel="Nested_PreviewMouseWheel">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SceneNodeItem}">
                                    <Grid Margin="0,1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Number}" Opacity="0.6" FontFamily="Cascadia Mono, Consolas" FontSize="12" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Swatch}" VerticalAlignment="Center" Margin="0,1,7,0" />
                                            <TextBlock TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding Title, Mode=OneWay}" />
                                                <Run Text="{Binding Summary, Mode=OneWay}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" FontSize="11" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Style="{StaticResource Heading}" Text="Actors" Margin="2,16,0,8" />
                        <ItemsControl x:Name="ActorList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:SceneActorItem}">
                                    <StackPanel Margin="0,0,0,6">
                                        <TextBlock TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                            <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="11" />
                                        </TextBlock>
                                        <Button Style="{StaticResource LinkButton}" Click="File_Click" Tag="{Binding Template}" HorizontalAlignment="Left" ToolTip="{Binding Template}">
                                            <TextBlock Text="{Binding TemplateName}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource Heading}" Text="Files it uses" Margin="2,16,0,8" />
                        <ItemsControl x:Name="LinkList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CutsceneLinkItem}">
                                    <StackPanel Margin="0,0,0,6">
                                        <Button Style="{StaticResource LinkButton}" Click="File_Click" Tag="{Binding GamePath}" HorizontalAlignment="Left" ToolTip="{Binding GamePath}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Copy path" Click="CopyPath_Click" Tag="{Binding GamePath}" />
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </Button>
                                        <TextBlock Text="{Binding Role}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Row="1" Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- every part as a card, in flow order -->
            <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource Card}">
                <ListBox x:Name="Cards" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="8,4" />
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Frame" CornerRadius="6" BorderThickness="1.5" BorderBrush="Transparent"
                                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" Padding="12,9">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SceneNodeItem}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding From}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               VerticalAlignment="Center" Margin="12,0,0,0" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Number}" FontFamily="Cascadia Mono, Consolas" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border CornerRadius="4" Background="{Binding Swatch}" Padding="7,1" VerticalAlignment="Center" Margin="0,0,8,0">
                                            <TextBlock Text="{Binding Kind}" FontSize="11" Foreground="Black" />
                                        </Border>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Text="{Binding Detail}" Visibility="{Binding DetailVisibility}" TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Click="File_Click" Tag="{Binding Cutscene}"
                                        Visibility="{Binding CutsceneVisibility}" ToolTip="{Binding Cutscene}">
                                    <TextBlock Text="{Binding CutsceneName, StringFormat=Open {0}}" FontSize="12" />
                                </Button>
                                <ItemsControl ItemsSource="{Binding Rows}" Visibility="{Binding RowsVisibility}" Margin="0,8,0,0" />
                                <ItemsControl ItemsSource="{Binding Next}" Visibility="{Binding NextVisibility}" Margin="0,6,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:SceneLinkItem}">
                                            <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="Link_Click" Tag="{Binding Link}" IsEnabled="{Binding CanGo}" Margin="0,1">
                                                <TextBlock Text="{Binding Text}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="Reading the scene…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />

        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
