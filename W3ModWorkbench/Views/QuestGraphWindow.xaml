<Window x:Class="W3ModWorkbench.QuestGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T QuestGraph.Title}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1600" Height="980" MinWidth="1040" MinHeight="560"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Crumb" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="GuidBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="520" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="430" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="250" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- the graph, with where it is in the file's phases over it -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="8,8,10,4">
                            <Button DockPanel.Dock="Right" Padding="10,5" Margin="6,0,0,0" Click="Fit_Click" ToolTip="{l:T QuestGraph.FitTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T Common.Fit}" />
                                </StackPanel>
                            </Button>
                            <Grid DockPanel.Dock="Right" Width="300" Margin="6,0,0,0" ToolTip="{l:T QuestGraph.FindGuidTip}">
                                <TextBox x:Name="FindGuidBox" Padding="30,5,8,5" VerticalContentAlignment="Center" FontFamily="Consolas" KeyDown="FindGuidBox_KeyDown"
                                         TextChanged="FindGuidBox_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE71E;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="FindGuidPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="{l:T QuestGraph.FindGuidPlaceholder}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Button DockPanel.Dock="Right" Padding="10,5" Margin="6,0,0,0" Click="LiveLog_Click" ToolTip="{l:T QuestLog.OpenTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9D9;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T QuestLog.Short}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CompareButton" DockPanel.Dock="Right" Padding="10,5" Margin="6,0,0,0" Click="Compare_Click" ToolTip="{l:T QuestGraph.CompareTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8F1;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T QuestGraph.Compare}" />
                                </StackPanel>
                            </Button>
                            <Button DockPanel.Dock="Right" Padding="10,5" Margin="6,0,0,0" Click="Json_Click" ToolTip="{l:T QuestGraph.JsonTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE943;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T QuestGraph.Json}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="UpButton" DockPanel.Dock="Left" Padding="8,5" Margin="0,0,6,0" Click="Up_Click" ToolTip="{l:T QuestGraph.UpTip}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE74A;" />
                            </Button>
                            <ItemsControl x:Name="Crumbs" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </DockPanel>
                        <StackPanel Grid.Row="1">
                        <Border x:Name="DuplicateBanner" Margin="10,2,10,4" Padding="12,8" CornerRadius="6" Visibility="Collapsed"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" Margin="0,0,10,0" />
                                <Button DockPanel.Dock="Right" Padding="10,3" Margin="10,0,0,0" Click="ShowDuplicates_Click" Content="{l:T QuestGraph.ShowDuplicates}" />
                                <TextBlock x:Name="DuplicateText" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        <Border x:Name="CompareBanner" Margin="10,2,10,4" Padding="12,8" CornerRadius="6" Visibility="Collapsed"
                                Background="{DynamicResource SystemFillColorAttentionBackgroundBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE8F1;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                                <Button DockPanel.Dock="Right" Padding="10,3" Margin="6,0,0,0" Click="StopCompare_Click" Content="{l:T QuestGraph.StopCompare}" />
                                <Button DockPanel.Dock="Right" Padding="10,3" Margin="10,0,0,0" Click="ShowChanges_Click" Content="{l:T QuestGraph.ShowChanges}" />
                                <TextBlock x:Name="CompareText" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </DockPanel>
                        </Border>
                        </StackPanel>
                        <local:QuestGraphView x:Name="Graph" Grid.Row="2" Margin="1,0,1,0" BlockClicked="Graph_BlockClicked" PhaseOpened="Graph_PhaseOpened" />
                        <TextBlock x:Name="EmptyGraph" Grid.Row="2" Text="{l:T QuestGraph.EmptyGraph}" Style="{StaticResource Hint}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                        <ItemsControl x:Name="Legend" Grid.Row="3" Margin="12,4,12,8">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                        <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" Margin="6,0,0,0" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <!-- every block in the file -->
                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel Margin="10,8,10,6">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock DockPanel.Dock="Left" Text="{l:T QuestGraph.Blocks}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock x:Name="CountText" DockPanel.Dock="Left" Style="{StaticResource Small}" Margin="10,0,12,0" VerticalAlignment="Center" />
                            <Button DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" Click="MakeListener_Click" ToolTip="{l:T QuestGraph.MakeListenerTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE943;" FontSize="13" />
                                    <TextBlock Margin="6,0,0,0" Text="{l:T QuestGraph.MakeListener}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopyGuidsButton" DockPanel.Dock="Right" Padding="10,4" Margin="8,0,0,0" Click="CopyGuids_Click" ToolTip="{l:T QuestGraph.CopyGuidsTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="13" />
                                    <TextBlock x:Name="CopyGuidsText" Margin="6,0,0,0" Text="{l:T QuestGraph.CopyGuids}" />
                                </StackPanel>
                            </Button>
                            <CheckBox x:Name="ThisGraphCheck" DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" Content="{l:T QuestGraph.ThisGraphOnly}"
                                      ToolTip="{l:T QuestGraph.ThisGraphOnlyTip}" Click="Filter_Changed" />
                            <ComboBox x:Name="KindBox" DockPanel.Dock="Right" MinWidth="190" Margin="8,0,0,0" SelectionChanged="Filter_Changed" ToolTip="{l:T QuestGraph.KindTip}" />
                            <Grid>
                                <TextBox x:Name="SearchBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="Filter_Changed" KeyDown="SearchBox_KeyDown" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="SearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="{l:T QuestGraph.SearchPlaceholder}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </DockPanel>
                        <DataGrid x:Name="BlockList" Style="{StaticResource ViewerGrid}" SelectionMode="Extended" SelectionChanged="BlockList_SelectionChanged" MouseDoubleClick="BlockList_MouseDoubleClick"
                                  PreviewKeyDown="BlockList_PreviewKeyDown">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="{l:T QuestGraph.CopyGuids}" InputGestureText="Ctrl+C" Click="CopyGuids_Click" />
                                    <MenuItem Header="{l:T QuestGraph.CopyRedkitGuids}" Click="CopyRedkitGuids_Click" />
                                    <Separator />
                                    <MenuItem Header="{l:T QuestGraph.MakeListener}" Click="MakeListener_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="26" CanUserResize="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="&#xE7BA;" FontFamily="{StaticResource IconFont}" FontSize="12" Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       HorizontalAlignment="Center" ToolTip="{l:T QuestGraph.DuplicateTip}"
                                                       Visibility="{Binding Duplicate, Converter={StaticResource BoolToVisibility}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="{l:T QuestGraph.Col.Kind}" Binding="{Binding Kind}" Width="130" />
                                <DataGridTextColumn Header="{l:T QuestGraph.Col.Name}" Binding="{Binding Title}" Width="200" />
                                <DataGridTextColumn Header="{l:T QuestGraph.Col.Detail}" Binding="{Binding Detail}" Width="240" />
                                <DataGridTextColumn Header="{l:T QuestGraph.Col.Guid}" Binding="{Binding Guid}" Width="270" FontFamily="Consolas" />
                                <DataGridTextColumn Header="{l:T QuestGraph.Col.Outputs}" Binding="{Binding OutputsText}" Width="150" />
                                <DataGridTextColumn Header="{l:T QuestGraph.Col.Phase}" Binding="{Binding Phase}" Width="*" MinWidth="120" />
                                <DataGridTextColumn x:Name="ChangeColumn" Header="{l:T QuestGraph.Col.Change}" Binding="{Binding Change}" Width="200" Visibility="Collapsed" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>
            </Grid>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the block picked, or the file with none -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid Margin="12,10,8,8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" MaxHeight="330" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,4,0">
                        <TextBlock x:Name="BlockTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="BlockDetail" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="BlockComment" TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Visibility="Collapsed" />
                        <!-- the GUID, as Native Quest Hook and REDkit write it -->
                        <StackPanel x:Name="GuidPanel" Margin="0,8,0,0" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0" Click="CopyGuid_Click" ToolTip="{l:T QuestGraph.CopyGuidTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="13" />
                                        <TextBlock Margin="6,0,0,0" Text="{l:T QuestGraph.Copy}" />
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="GuidText" Style="{StaticResource GuidBox}" />
                            </DockPanel>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Padding="10,4" Margin="6,0,0,0" Click="CopyRedkitGuid_Click" ToolTip="{l:T QuestGraph.CopyRedkitGuidTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="13" />
                                        <TextBlock Margin="6,0,0,0" Text="{l:T QuestGraph.Copy}" />
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="RedkitGuidText" Style="{StaticResource GuidBox}" Opacity="0.75" ToolTip="{l:T QuestGraph.RedkitFormTip}" />
                            </DockPanel>
                        </StackPanel>
                        <TextBlock x:Name="NoGuidText" Style="{StaticResource Hint}" Margin="0,8,0,0" Text="{l:T QuestGraph.NoGuid}" Visibility="Collapsed" />
                        <Button x:Name="OpenPhaseButton" HorizontalAlignment="Left" Padding="10,5" Margin="0,8,0,0" Click="OpenPhase_Click" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" FontSize="13" />
                                <TextBlock Margin="8,0,0,0" Text="{l:T QuestGraph.OpenPhase}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- links in and out, or the phase blocks that use this file -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,2,0,0">
                        <StackPanel Margin="0,0,6,0">
                            <TextBlock x:Name="LinksTitle" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="LinksText" TextWrapping="Wrap" LineHeight="20" />
                            <TextBlock x:Name="CompareTitle" Style="{StaticResource SectionTitle}" Visibility="Collapsed" />
                            <TextBlock x:Name="CompareInfo" TextWrapping="Wrap" LineHeight="20" Visibility="Collapsed" />
                            <TextBlock x:Name="CopiesTitle" Style="{StaticResource SectionTitle}" Text="{l:T QuestGraph.WhereGuidIs}" Visibility="Collapsed" />
                            <TextBlock x:Name="CopiesText" TextWrapping="Wrap" LineHeight="20" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel x:Name="PropertiesHeader" Grid.Row="2">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T QuestGraph.Properties}" />
                        <local:SourceNote x:Name="SourceNoteBar" Margin="0,0,0,6" />
                        <Grid Margin="0,0,0,6">
                            <TextBox x:Name="PropertySearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="PropertySearch_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="PropertySearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{l:T Common.FindPropertiesNameValue}" />
                        </Grid>
                    </StackPanel>
                    <local:PropertyListView x:Name="Properties" Grid.Row="3" LinkClicked="Properties_LinkClicked" />
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T QuestGraph.Reading}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <DockPanel Grid.Row="1" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
