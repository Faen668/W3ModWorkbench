<Window x:Class="W3ModWorkbench.StubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{l:T StubWindow.StubGenerator}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1180" Height="740" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{l:T StubWindow.StubGenerator}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText" Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Text="{l:T StubWindow.PickOneGamesFunctions}" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <RadioButton x:Name="WrapRadio" GroupName="Kind" Content="{l:T StubWindow.Wrap}" IsChecked="True" MinWidth="0" Checked="Kind_Changed"
                                 ToolTip="{l:T StubWindow.WrapMethodYourCodeRuns}" />
                    <RadioButton x:Name="ReplaceRadio" GroupName="Kind" Content="{l:T Common.Replace}" Margin="8,0,0,0" MinWidth="0" Checked="Kind_Changed"
                                 ToolTip="{l:T StubWindow.ReplaceMethodYourCodeTakes}" />
                    <RadioButton x:Name="MethodRadio" GroupName="Kind" Content="{l:T StubWindow.AddMethod}" Margin="8,0,0,0" MinWidth="0" Checked="Kind_Changed"
                                 ToolTip="{l:T StubWindow.AddMethodNewFunctionOne}" />
                    <RadioButton x:Name="FieldRadio" GroupName="Kind" Content="{l:T StubWindow.AddField}" Margin="8,0,0,0" MinWidth="0" Checked="Kind_Changed"
                                 ToolTip="{l:T StubWindow.AddFieldNewVariableOne}" />
                </StackPanel>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="32,6,8,6" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="11,0,0,0" Opacity="0.6"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchPlaceholder" Margin="33,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{l:T StubWindow.SearchClassFunctionE}" />
                </Grid>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.3*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <ListBox x:Name="ResultList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0" SelectionChanged="ResultList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:StubItem}">
                                <StackPanel Margin="4,3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis"
                                               FontFamily="Cascadia Mono, Consolas" ToolTip="{Binding Detail}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" Focusable="False" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <WrapPanel x:Name="NameRow" Margin="0,0,0,8" Visibility="Collapsed">
                        <TextBlock Text="{l:T Common.Name}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
                        <TextBox x:Name="NameBox" Width="190" Text="MyMethod" TextChanged="Names_Changed" FontFamily="Cascadia Mono, Consolas" />
                        <TextBlock x:Name="TypeLabel" Text="{l:T Common.Type}" VerticalAlignment="Center" Opacity="0.7" Margin="14,0,8,0" Visibility="Collapsed" />
                        <TextBox x:Name="TypeBox" Width="150" Text="{l:T StubWindow.Bool}" TextChanged="Names_Changed" FontFamily="Cascadia Mono, Consolas" Visibility="Collapsed" />
                    </WrapPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0,6,0,0" ClipToBounds="True">
                        <avalonEdit:TextEditor x:Name="Output" IsReadOnly="True" ShowLineNumbers="True"
                                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                               Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </Border>
                </Grid>
            </Grid>

            <DockPanel Grid.Row="3" Margin="2,10,2,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="CommentCheck" Content="{l:T StubWindow.NoteWhere}" IsChecked="True" MinWidth="0" Margin="0,0,14,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <CheckBox x:Name="BodyCheck" Content="{l:T StubWindow.ReplaceStartOriginalCode}" IsChecked="True" MinWidth="0" Margin="0,0,14,0"
                              Checked="Option_Changed" Unchecked="Option_Changed" />
                    <Button x:Name="CopyButton" Padding="14,6" Click="Copy_Click" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                            <TextBlock Margin="8,0,0,0" Text="{l:T Common.Copy}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="StatusText" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
