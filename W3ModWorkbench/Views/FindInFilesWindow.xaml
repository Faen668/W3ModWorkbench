<Window x:Class="W3ModWorkbench.FindInFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="Find in files" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1100" Height="760" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="FindToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="68" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{StaticResource Card}" Padding="14,12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="10,0,0,0">
                            <Button x:Name="FindButton" Padding="18,6" Click="Find_Click" Style="{DynamicResource AccentButtonStyle}"
                                    ToolTip="Search the files (Enter)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" FontSize="13" VerticalAlignment="Center" />
                                    <TextBlock Text="Find all" Margin="8,0,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Margin="6,0,0,0" Padding="14,6" Content="Stop" Click="Stop_Click" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton x:Name="MatchCaseToggle" Style="{StaticResource FindToggle}" Content="Aa" ToolTip="Match case" />
                            <ToggleButton x:Name="WholeWordToggle" Style="{StaticResource FindToggle}" Content="ab" ToolTip="Whole words only" />
                            <ToggleButton x:Name="RegexToggle" Style="{StaticResource FindToggle}" Content=".*" ToolTip="Regular expression" />
                        </StackPanel>
                        <TextBlock Text="Find what" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="FindBox" VerticalContentAlignment="Center" Padding="8,6" KeyDown="FindBox_KeyDown" />
                    </DockPanel>

                    <DockPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock Text="Filters" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="FiltersBox" Width="210" VerticalContentAlignment="Center" Padding="8,6" KeyDown="FindBox_KeyDown"
                                 ToolTip="File names to search, separated by ; e.g. *.ws; *.xml. Put ! in front to leave files out, e.g. !*.bak. Empty searches every text file." />
                        <TextBlock Text="Look in" Margin="18,0,0,0" Width="60" VerticalAlignment="Center" Opacity="0.8" />
                        <CheckBox x:Name="SubfoldersCheck" DockPanel.Dock="Right" Margin="14,0,0,0" MinWidth="0" Content="Subfolders" IsChecked="True" />
                        <ComboBox x:Name="ScopeBox" HorizontalAlignment="Stretch" SelectionChanged="ScopeBox_SelectionChanged" />
                    </DockPanel>

                    <TextBlock x:Name="ScopeText" Grid.Row="2" Margin="68,6,0,0" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>

            <local:ResultsPanel x:Name="Results" Grid.Row="1" Margin="0,10,0,0" />

            <DockPanel Grid.Row="2" Margin="2,8,2,0">
                <TextBlock x:Name="StatusText" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="Click a line to open it. F4 and Shift+F4 step through the matches." />
            </DockPanel>
        </Grid>
    </Grid>
</Window>
