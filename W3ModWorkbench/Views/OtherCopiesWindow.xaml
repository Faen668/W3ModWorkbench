<Window x:Class="W3ModWorkbench.OtherCopiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T OtherCopiesWindow.OtherCopies}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="820" Height="560" MinWidth="560" MinHeight="360"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="RowButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="16,14,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel>
                <TextBlock x:Name="FileTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="FilePath" Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="Summary" Margin="0,10,0,0" TextWrapping="Wrap" />
            </StackPanel>

            <TextBlock Grid.Row="1" Style="{StaticResource Caption}" Margin="0,16,0,6" Text="{l:T OtherCopiesWindow.CopiesWhatsOpenFirst}" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="CopyRows" Margin="0,0,14,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type local:CopyRow}">
                            <Border x:Name="Card" Margin="0,0,0,8" Padding="14,10" CornerRadius="6" BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource RowButton}" Content="{l:T OtherCopiesWindow.Compare}" Tag="{Binding}" Click="Compare_Click"
                                                Visibility="{Binding CompareVisibility}" ToolTip="{Binding CompareTip}" />
                                        <Button Style="{StaticResource RowButton}" Content="{l:T Common.Open}" Tag="{Binding}" Click="Open_Click" ToolTip="{l:T OtherCopiesWindow.OpenDoubleClickingList}" />
                                        <Button Style="{StaticResource RowButton}" Tag="{Binding}" Click="Reveal_Click" ToolTip="{Binding RevealTip}">
                                            <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                                        </Button>
                                    </StackPanel>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Rank}" Opacity="0.55" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Mod}" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Where}" Opacity="0.6" Margin="8,0,0,0" VerticalAlignment="Center" />
                                            <Border x:Name="WinsBadge" Visibility="Collapsed" CornerRadius="3" Padding="6,0,6,1" Margin="10,0,0,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource AccentFillColorDefaultBrush}">
                                                <TextBlock Text="{l:T OtherCopiesWindow.UsedGame}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                            </Border>
                                            <Border x:Name="ThisBadge" Visibility="Collapsed" CornerRadius="3" Padding="6,0,6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    BorderThickness="1" BorderBrush="{DynamicResource AccentTextFillColorPrimaryBrush}">
                                                <TextBlock Text="{l:T OtherCopiesWindow.Highlighted}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Location}" Opacity="0.6" FontSize="12" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Location}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="{Binding SameGlyph}" Foreground="{Binding SameBrush}" Margin="0,0,6,0" />
                                            <TextBlock Text="{Binding SameText}" FontSize="12" Foreground="{Binding SameBrush}" />
                                            <TextBlock Text="{Binding SizeText}" FontSize="12" Opacity="0.6" Margin="12,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Wins}" Value="True">
                                    <Setter TargetName="WinsBadge" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                    <Setter TargetName="ThisBadge" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="OrderNote" Grid.Row="3" Margin="2,10,2,0" Opacity="0.65" FontSize="12" TextWrapping="Wrap" />
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
