<Window x:Class="W3ModWorkbench.MaterialWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:vm="clr-namespace:W3ModWorkbench.ViewModels"
        Title="Material" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1500" Height="950" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one parameter: a texture's thumbnail, a colour's swatch and channels, a number's slider, and its value as text -->
        <DataTemplate x:Key="ParameterTemplate" DataType="{x:Type vm:MaterialValueRow}">
            <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}" ToolTip="{Binding Tip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- a texture's look -->
                    <Border Width="64" Height="64" Margin="0,0,12,0" CornerRadius="4" ClipToBounds="True" VerticalAlignment="Top" Visibility="{Binding TextureVisibility}"
                            BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource SubtleFillColorTertiaryBrush}">
                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <!-- a colour's swatch: click it for its channels -->
                    <Border Width="44" Height="44" Margin="0,0,12,0" CornerRadius="6" VerticalAlignment="Top" Visibility="{Binding ColourVisibility}" Cursor="Hand"
                            Background="{Binding Swatch}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            MouseLeftButtonUp="Swatch_Click" ToolTip="Click to change its red, green, blue and alpha" />
                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Where}" Style="{StaticResource Small}" Opacity="{Binding WhereOpacity}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <!-- a number's slider -->
                        <DockPanel Margin="0,6,0,0" Visibility="{Binding NumberVisibility}">
                            <TextBox DockPanel.Dock="Right" Width="86" Margin="10,0,0,0" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" KeyDown="ValueBox_KeyDown" FontFamily="Consolas" />
                            <Slider Minimum="{Binding NumberMinimum}" Maximum="{Binding NumberMaximum}" Value="{Binding Number, Mode=TwoWay}" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- any other value as text: a texture's path, a colour, a vector -->
                        <TextBox Margin="0,6,0,0" Text="{Binding Text, UpdateSourceTrigger=LostFocus}" KeyDown="ValueBox_KeyDown" FontFamily="Consolas" FontSize="12" ToolTip="{Binding Text}"
                                 IsReadOnly="{Binding IsEditable, Converter={x:Static local:MaterialWindow.Not}}">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsNumber}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="{Binding Error}" Foreground="#FFE0564B" FontSize="11" TextWrapping="Wrap" Visibility="{Binding ErrorVisibility}" Margin="0,3,0,0" />
                        <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Margin="0,4,0,0" Visibility="{Binding LinkVisibility}"
                                Click="OpenTexture_Click" Tag="{Binding TexturePath}" ToolTip="Open the texture in the texture viewer">
                            <TextBlock Text="Open the texture" FontSize="11.5" />
                        </Button>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                        <Button Padding="8,2" Content="…" Click="PickTexture_Click" Tag="{Binding}" Visibility="{Binding TextureVisibility}" ToolTip="Pick a texture from the game or an open mod" />
                        <Button Padding="6,2" Margin="4,0,0,0" Click="Reset_Click" Tag="{Binding}" Visibility="{Binding ResetVisibility}" ToolTip="Take its own value away, so it takes its base's again">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" FontSize="12" />
                        </Button>
                        <Button Padding="6,2" Margin="4,0,0,0" Click="Reset_Click" Tag="{Binding}" Visibility="{Binding RemoveVisibility}" ToolTip="Remove it: the shader doesn't have it, so it does nothing">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74D;" FontSize="12" />
                        </Button>
                    </StackPanel>
                    <!-- a colour's channels -->
                    <Grid Grid.Row="1" Grid.ColumnSpan="3" Margin="56,8,0,0" Visibility="{Binding ChannelsVisibility}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="R" Foreground="#FFE05A5A" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Slider Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Red, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2" Text="{Binding Red}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Text="G" Foreground="#FF5AC25A" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Green, Mode=TwoWay}" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Green}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Text="B" Foreground="#FF5A8CE0" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Blue, Mode=TwoWay}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding Blue}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Text="A" Opacity="0.75" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="255" Value="{Binding Alpha, Mode=TwoWay}" />
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding Alpha}" FontFamily="Consolas" HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- what it is, and saving -->
        <DockPanel Margin="16,12,16,8">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RevertButton" Padding="12,5" IsEnabled="False" Click="Revert_Click" ToolTip="Undo every change (Ctrl+Z)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE7A7;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Undo changes" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveNewButton" Padding="12,5" Margin="8,0,0,0" Click="SaveNew_Click"
                        ToolTip="Save it, with any changes, as a new material instance (.w2mi) in the open project, based on what this one is based on">
                    <TextBlock Text="Save as new material…" />
                </Button>
                <Button x:Name="SaveButton" Padding="12,5" Margin="8,0,0,0" IsEnabled="False" Click="Save_Click"
                        ToolTip="Save the changes into the open project at this material's game path, so every mesh that uses it changes in the mod (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" FontSize="12" Margin="0,0,6,0" />
                        <TextBlock Text="Save to project" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid x:Name="Body" Grid.Row="1" Margin="14,0,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="600" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- the material on a shape, or on a mesh that uses it -->
            <Border Style="{StaticResource Card}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="Preview on" VerticalAlignment="Center" Opacity="0.75" Margin="2,0,8,0" />
                        <ComboBox x:Name="ShapeBox" MinWidth="180" MaxWidth="360" DisplayMemberPath="Label" SelectionChanged="ShapeBox_SelectionChanged" DropDownOpened="ShapeBox_DropDownOpened"
                                  ToolTip="A sphere, a box, or a mesh that uses the material, drawn with it as the game draws it" />
                        <ToggleButton x:Name="SpinToggle" Margin="10,0,0,0" Padding="10,4" Click="SpinToggle_Click" ToolTip="Turn the preview slowly round (P)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE7AD;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Spin" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Margin="6,0,0,0" Padding="10,4" Click="Fit_Click" ToolTip="Frame it again (F)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Fit" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="PreviewNote" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextWrapping="Wrap" />
                    <Grid>
                        <local:MeshView x:Name="View" />
                        <TextBlock x:Name="ViewMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap"
                                   TextAlignment="Center" MaxWidth="460" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl x:Name="Tabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                    <TabItem x:Name="ParametersTab" Header="Parameters">
                        <DockPanel Margin="0,6,0,0">
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                <CheckBox x:Name="InheritedCheck" DockPanel.Dock="Right" Content="Inherited too" MinWidth="0" IsChecked="True" Margin="10,0,0,0"
                                          VerticalAlignment="Center" Click="Filter_Changed" ToolTip="Show the parameters it takes from its bases and the shader, as well as its own" />
                                <Grid>
                                    <TextBox x:Name="FilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                    <TextBlock x:Name="FilterPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Text="Show only the parameters with these letters  (Ctrl+F)" />
                                </Grid>
                            </DockPanel>
                            <TextBlock x:Name="ParametersNote" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,8" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl x:Name="ParameterList" ItemTemplate="{StaticResource ParameterTemplate}">
                                    <ItemsControl.GroupStyle>
                                        <GroupStyle>
                                            <GroupStyle.HeaderTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" Margin="2,10,0,6" />
                                                </DataTemplate>
                                            </GroupStyle.HeaderTemplate>
                                        </GroupStyle>
                                    </ItemsControl.GroupStyle>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="ChainTab" Header="Based on">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,8"
                                       Text="What the material is built on, nearest first: each base sets what nothing nearer sets, and the shader graph at the end declares every parameter and its default. Click one to open it." />
                            <ItemsControl x:Name="ChainList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="10,8" Margin="0,0,0,6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                                <StackPanel>
                                                    <Button Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Click="OpenLink_Click" Tag="{Binding Path}" IsEnabled="{Binding CanOpen}">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                    </Button>
                                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="UsedByTab" Header="Used by">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="UsedByNote" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,8" />
                            <DataGrid x:Name="UsedByGrid" Style="{StaticResource ViewerGrid}" MouseDoubleClick="UsedByGrid_MouseDoubleClick"
                                      ToolTip="Double-click to open it; right-click to preview the material on it">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Open it" Click="OpenUser_Click" />
                                        <MenuItem Header="Preview the material on it" Click="PreviewOnUser_Click" />
                                        <MenuItem Header="Copy its path" Click="CopyUser_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="File" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="Kind" Binding="{Binding Kind}" />
                                    <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="2*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Properties">
                        <DockPanel Margin="4,8,0,0">
                            <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                            <local:PropertyListView x:Name="FileProperties" LinkClicked="Properties_LinkClicked" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Grid.Row="1" Text="Reading the material…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <TextBlock x:Name="InfoText" Grid.Row="2" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:QuickPick x:Name="Picker" Grid.RowSpan="3" Margin="0,46,0,0" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="3" IsModal="True" />
    </Grid>
</Window>
