<Window x:Class="W3ModWorkbench.LootLocatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T LootLocator.Title}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1500" Height="950" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- compact tabs, as the world viewer's -->
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource WashItem}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <DataTemplate x:Key="FoundRow" DataType="{x:Type local:LootFoundRow}">
            <DockPanel Margin="2,2">
                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="8,0,0,0" />
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE7BA;" FontSize="12" Margin="0,0,6,0"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" Visibility="{Binding WarnVisibility}" ToolTip="{Binding WarnTip}" />
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="14,12,14,8">
            <TextBlock Text="{l:T LootLocator.Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Opacity="0.65" Margin="0,2,0,0" TextWrapping="Wrap" Text="{l:T LootLocator.Explain}" />
        </StackPanel>

        <Grid x:Name="Body" Grid.Row="1" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" MinWidth="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="520" />
            </Grid.ColumnDefinitions>

            <!-- what to look for -->
            <Border Style="{StaticResource Card}" ClipToBounds="True">
                <TabControl x:Name="ModeTabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}"
                            SelectionChanged="ModeTabs_SelectionChanged">
                    <TabItem x:Name="ItemsTab" Header="{l:T LootLocator.Items}">
                        <DockPanel Margin="0,6,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBox x:Name="ItemSearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="Search_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="ItemSearchHint" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" Text="{l:T LootLocator.FindItem}" />
                            </Grid>
                            <ComboBox x:Name="CategoryBox" DockPanel.Dock="Top" Margin="0,0,0,6" HorizontalAlignment="Stretch" ToolTip="{l:T LootLocator.CategoryTip}"
                                      SelectionChanged="CategoryBox_SelectionChanged" />
                            <TextBlock x:Name="ItemCount" DockPanel.Dock="Bottom" Margin="4,4,4,2" Style="{StaticResource Small}" />
                            <ListBox x:Name="ItemList" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource FoundRow}"
                                     SelectionChanged="FoundList_SelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="TablesTab" Header="{l:T LootLocator.Tables}">
                        <DockPanel Margin="0,6,0,0">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBox x:Name="TableSearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="Search_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="TableSearchHint" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" Text="{l:T LootLocator.FindTable}" />
                            </Grid>
                            <CheckBox x:Name="UnusedCheck" DockPanel.Dock="Top" Content="{l:T LootLocator.ShowUnused}" Margin="2,0,0,6" MinWidth="0"
                                      ToolTip="{l:T LootLocator.ShowUnusedTip}" Click="UnusedCheck_Click" />
                            <TextBlock x:Name="TableCount" DockPanel.Dock="Bottom" Margin="4,4,4,2" Style="{StaticResource Small}" />
                            <ListBox x:Name="TableList" BorderThickness="0" Background="Transparent" ItemTemplate="{StaticResource FoundRow}"
                                     SelectionChanged="FoundList_SelectionChanged" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="3*" MinHeight="220" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="2*" MinHeight="170" />
                </Grid.RowDefinitions>

                <!-- the map -->
                <Border Style="{StaticResource Card}">
                    <DockPanel Margin="8">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <ComboBox x:Name="WorldBox" MinWidth="220" SelectionChanged="WorldBox_SelectionChanged" ToolTip="{l:T LootLocator.WorldTip}" Margin="0,0,10,4" />
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,4" ToolTip="{l:T LootLocator.LevelTip}">
                                <TextBlock Text="{l:T LootLocator.Level}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ComboBox x:Name="LevelBox" MinWidth="70" SelectionChanged="LevelBox_SelectionChanged" />
                            </StackPanel>
                            <CheckBox x:Name="ContainersCheck" Content="{l:T LootLocator.Containers}" IsChecked="True" MinWidth="0" Margin="4,0,12,4" VerticalAlignment="Center" Click="Filter_Click" />
                            <CheckBox x:Name="HerbsCheck" Content="{l:T LootLocator.Herbs}" IsChecked="True" MinWidth="0" Margin="0,0,12,4" VerticalAlignment="Center" Click="Filter_Click" />
                            <CheckBox x:Name="BeehivesCheck" Content="{l:T LootLocator.Beehives}" IsChecked="True" MinWidth="0" Margin="0,0,12,4" VerticalAlignment="Center" Click="Filter_Click" />
                            <CheckBox x:Name="MonstersCheck" Content="{l:T LootLocator.Monsters}" IsChecked="True" MinWidth="0" Margin="0,0,12,4" VerticalAlignment="Center" Click="Filter_Click"
                                      ToolTip="{l:T LootLocator.MonstersTip}" />
                            <CheckBox x:Name="OtherCheck" Content="{l:T LootLocator.Other}" IsChecked="True" MinWidth="0" Margin="0,0,12,4" VerticalAlignment="Center" Click="Filter_Click"
                                      ToolTip="{l:T LootLocator.OtherTip}" />
                            <CheckBox x:Name="PredictedCheck" Content="{l:T LootLocator.Predicted}" MinWidth="0" Margin="0,0,12,4" VerticalAlignment="Center" Click="PredictedCheck_Click"
                                      ToolTip="{l:T LootLocator.PredictedTip}" />
                            <CheckBox x:Name="ModsCheck" Content="{l:T LootLocator.WithMods}" MinWidth="0" Margin="0,0,12,4" VerticalAlignment="Center" Click="ModsCheck_Click"
                                      ToolTip="{l:T LootLocator.WithModsTip}" />
                            <Button Margin="0,0,8,4" Padding="10,3" Click="Fit_Click" ToolTip="{l:T LootLocator.FitTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T Common.Fit}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="ExportButton" Margin="0,0,0,4" Padding="10,3" Click="Export_Click" IsEnabled="False" ToolTip="{l:T LootLocator.ExportTip}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xEDE1;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="{l:T LootLocator.Export}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <TextBlock x:Name="HoverText" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextTrimming="CharacterEllipsis"
                                   Text="{l:T LootLocator.MouseHint}" />
                        <Border CornerRadius="6" ClipToBounds="True">
                            <Grid>
                                <local:WorldMap x:Name="Map" PointerMoved="Map_PointerMoved" MarkerPicked="Map_MarkerPicked" />
                                <!-- what the colours mean -->
                                <Border x:Name="Legend" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Padding="10,7" CornerRadius="6"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Opacity="0.92" Visibility="Collapsed">
                                    <StackPanel>
                                        <TextBlock x:Name="LegendTitle" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <ItemsControl x:Name="LegendList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal" Margin="0,1">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Brush}" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Text}" FontSize="11.5" Margin="7,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <StackPanel x:Name="LegendPredicted" Orientation="Horizontal" Margin="0,3,0,0">
                                            <Path Data="M 6,0 L 11,6 L 6,12 L 1,6 Z" Fill="{DynamicResource TextFillColorPrimaryBrush}" Stroke="Black" StrokeThickness="1" VerticalAlignment="Center" />
                                            <TextBlock Text="{l:T LootLocator.LegendPredicted}" FontSize="11.5" Margin="5,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                                <TextBlock x:Name="MapProgress" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,4" Visibility="Collapsed"
                                           Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                                <TextBlock x:Name="MapEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center"
                                           MaxWidth="420" Padding="12,8" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" Text="{l:T LootLocator.PickSomething}" />
                            </Grid>
                        </Border>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False" />

                <!-- the places, the table's items, and the place picked -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="380" MinWidth="260" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <TabControl x:Name="ListTabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                            <TabItem x:Name="PlacesTab" Header="{l:T LootLocator.Places}">
                                <DataGrid x:Name="PlaceGrid" Style="{StaticResource ViewerGrid}" Margin="0,4,0,0" SelectionChanged="PlaceGrid_SelectionChanged" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{l:T LootLocator.Place}" Binding="{Binding Title}" Width="2*" />
                                        <DataGridTextColumn Header="{l:T LootLocator.Area}" Binding="{Binding Area}" Width="2*" />
                                        <DataGridTextColumn Header="{l:T LootLocator.Chance}" Binding="{Binding ChanceText}" SortMemberPath="Chance" Width="80" />
                                        <DataGridTextColumn x:Name="PredictedColumn" Header="{l:T LootLocator.Predicted}" Binding="{Binding PredictedText}" SortMemberPath="PredictedSort" Width="90" />
                                        <DataGridTextColumn Header="{l:T LootLocator.Respawn}" Binding="{Binding RespawnText}" SortMemberPath="Respawn" Width="80" />
                                        <DataGridTextColumn Header="{l:T LootLocator.Position}" Binding="{Binding PositionText}" Width="150" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </TabItem>
                            <TabItem x:Name="TableItemsTab" Header="{l:T LootLocator.TableItems}" Visibility="Collapsed">
                                <DockPanel Margin="0,4,0,0">
                                    <TextBlock x:Name="TableSummary" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="2,0,0,6" />
                                    <DataGrid x:Name="TableItemGrid" Style="{StaticResource ViewerGrid}" SelectionMode="Single" MouseDoubleClick="TableItemGrid_MouseDoubleClick">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{l:T LootLocator.Item}" Binding="{Binding Title}" Width="2*" />
                                            <DataGridTextColumn Header="{l:T LootLocator.ItemName}" Binding="{Binding Name}" Width="2*" />
                                            <DataGridTextColumn Header="{l:T LootLocator.WhenUsed}" Binding="{Binding ChanceText}" SortMemberPath="Chance" Width="90" />
                                            <DataGridTextColumn Header="{l:T LootLocator.Weight}" Binding="{Binding WeightText}" SortMemberPath="Weight" Width="140" />
                                            <DataGridTextColumn Header="{l:T LootLocator.Quantity}" Binding="{Binding QuantityText}" Width="80" />
                                            <DataGridTextColumn Header="{l:T LootLocator.Levels}" Binding="{Binding LevelsText}" Width="80" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                        </TabControl>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Focusable="False" />

                    <Border Grid.Column="2" Style="{StaticResource Card}">
                        <Grid>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="Details" Margin="14,12,14,12" />
                            </ScrollViewer>
                            <TextBlock x:Name="DetailsEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65" TextWrapping="Wrap" TextAlignment="Center"
                                       Margin="16" Text="{l:T LootLocator.PickPlace}" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel x:Name="Busy" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar IsIndeterminate="True" Width="240" Height="4" />
            <TextBlock x:Name="BusyText" Margin="0,10,0,0" HorizontalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520"
                       Text="{l:T LootLocator.Reading}" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="18,6,14,8" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="3" IsModal="True" />
    </Grid>
</Window>
