<Window x:Class="W3ModWorkbench.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        Title="{l:T Settings.Title}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="920" Height="720" MinWidth="680" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>
        <Style x:Key="PageIntro" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="2,0,0,16" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- the folder button inside a path box -->
        <Style x:Key="BrowseButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="PathBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="8,6,40,6" />
        </Style>

        <!-- a section in the list on the left: its icon and name, the accent bar on the one shown -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" CornerRadius="6" Padding="10,8" Background="Transparent">
                            <Grid>
                                <Border x:Name="Bar" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-6,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <ContentPresenter Margin="6,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one part of a row of joined choices -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" CornerRadius="6" Padding="14,6" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Glyph" FontFamily="{StaticResource IconFont}" Text="{TemplateBinding Tag}" VerticalAlignment="Center" FontSize="13" Margin="0,0,8,0" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="{x:Null}">
                                <Setter TargetName="Glyph" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SegmentRow" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="3" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        </Style>

        <!-- a theme to pick: its colours, with a ring when it's the one in use -->
        <Style x:Key="Swatch" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <StackPanel Background="Transparent">
                            <Border x:Name="Ring" CornerRadius="11" BorderThickness="2" Padding="2" BorderBrush="Transparent">
                                <ContentPresenter />
                            </Border>
                            <TextBlock x:Name="Label" Text="{TemplateBinding Tag}" HorizontalAlignment="Center" Margin="0,5,0,0" Opacity="0.8" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Label" Property="Opacity" Value="1" />
                                <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="210" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- the sections -->
        <DockPanel Margin="12,16,4,8">
            <TextBlock DockPanel.Dock="Top" Text="{l:T Settings.Title}" FontSize="13" Opacity="0.6" Margin="12,0,0,8" />
            <ListBox x:Name="Nav" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource NavItem}"
                     SelectionChanged="Nav_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
        </DockPanel>

        <ScrollViewer x:Name="SettingsScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="14,16,20,4">
            <Grid>
                <!-- General -->
                <StackPanel x:Name="GeneralPage">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.General}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="{l:T Settings.General.Intro}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.General.Projects}" />
                            <TextBlock Text="{l:T Settings.General.ProjectsFolder}" Margin="0,4,0,6" />
                            <Grid>
                                <TextBox x:Name="ProjectsBox" Style="{StaticResource PathBox}" />
                                <Button Style="{StaticResource BrowseButton}" Click="BrowseProjects_Click" ToolTip="{l:T Common.ChooseFolder}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="ProjectsStatus" Style="{StaticResource Hint}" />
                            <CheckBox x:Name="ReopenProjectCheck" Content="{l:T Settings.General.ReopenProject}" Margin="0,14,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button x:Name="ClearRecentButton" Padding="12,5" Click="ClearRecent_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE74D;" />
                                        <TextBlock Margin="8,0,0,0" Text="{l:T Settings.General.ClearRecent}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="RecentStatus" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.General.Extracting}" />
                            <TextBlock Text="{l:T Settings.General.OutputFolder}" Margin="0,4,0,6" />
                            <Grid>
                                <TextBox x:Name="OutputBox" Style="{StaticResource PathBox}" />
                                <Button Style="{StaticResource BrowseButton}" Click="BrowseOutput_Click" ToolTip="{l:T Common.ChooseFolder}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                                </Button>
                            </Grid>
                            <CheckBox x:Name="KeepStructureCheck" Content="{l:T Settings.General.KeepStructure}" Margin="0,12,0,0" />
                            <CheckBox x:Name="OpenWhenDoneCheck" Content="{l:T Settings.General.OpenWhenDone}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.General.ExtractHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.General.Recipes}" />
                            <TextBlock Text="{l:T Settings.General.RecipesFolder}" Margin="0,4,0,6" />
                            <Grid>
                                <TextBox x:Name="RecipesBox" Style="{StaticResource PathBox}" />
                                <Button Style="{StaticResource BrowseButton}" Click="BrowseRecipes_Click" ToolTip="{l:T Common.ChooseFolder}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="RecipesHint" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.General.Copies}" />
                            <CheckBox x:Name="AskCopyCheck" Content="{l:T Settings.General.AskCopy}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.General.AskCopyHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Appearance -->
                <StackPanel x:Name="AppearancePage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.Appearance}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="{l:T Settings.Appearance.Intro}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <!-- a small preview window in the chosen colours -->
                            <Border x:Name="Sample" CornerRadius="8" BorderThickness="1" Padding="12,10,12,12"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" IsHitTestVisible="False" Focusable="False">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Padding="12,3" Focusable="False">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" FontSize="12" VerticalAlignment="Center" />
                                                <TextBlock Margin="6,0,0,0" Text="{l:T Settings.Appearance.SampleSaveAs}" FontSize="12" />
                                            </StackPanel>
                                        </Button>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border CornerRadius="6" BorderThickness="1" Padding="8,3"
                                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <Grid>
                                                    <TextBlock FontSize="12"><Run FontFamily="{StaticResource IconFont}" Text="&#xE943;" /><Run Text="  r4Player.ws" /></TextBlock>
                                                    <Border Height="3" Width="16" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,-5"
                                                            Background="{DynamicResource AccentFillColorDefaultBrush}" />
                                                </Grid>
                                            </Border>
                                            <TextBlock FontSize="12" Opacity="0.7" Margin="12,0,0,0" VerticalAlignment="Center">
                                                <Run FontFamily="{StaticResource IconFont}" Text="&#xE943;" /><Run Text="  playerWitcher.ws" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border CornerRadius="6" BorderThickness="1" Padding="10,8"
                                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <ContentControl x:Name="SampleCode" Focusable="False" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <CheckBox IsChecked="True" Content="{l:T Settings.Appearance.SampleKeepStructure}" Focusable="False" />
                                        <RadioButton IsChecked="True" Content="{l:T Settings.Appearance.SampleTabs}" Margin="18,0,0,0" Focusable="False" GroupName="SampleGroup" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{l:T Settings.Appearance.Mode}" Margin="0,16,0,6" />
                            <Border Style="{StaticResource SegmentRow}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ThemeSystem" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"
                                                 Tag="&#xE770;" Content="{l:T Settings.Appearance.ModeSystem}" />
                                    <RadioButton x:Name="ThemeLight" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"
                                                 Tag="&#xE706;" Content="{l:T Settings.Appearance.ModeLight}" />
                                    <RadioButton x:Name="ThemeDark" GroupName="Theme" Style="{StaticResource Segment}" Checked="Theme_Checked"
                                                 Tag="&#xE708;" Content="{l:T Settings.Appearance.ModeDark}" />
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{l:T Settings.Appearance.Theme}" Margin="0,16,0,2" />
                            <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                                       Text="{l:T Settings.Appearance.ThemeHint}" />
                            <WrapPanel x:Name="PresetPanel" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Game and tools -->
                <StackPanel x:Name="GamePage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.Game}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="{l:T Settings.Game.Intro}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Game.GameFolder}" />
                            <TextBlock TextWrapping="Wrap" Text="{l:T Settings.Game.GameFolderAbout}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="GameFolderBox" Style="{StaticResource PathBox}" />
                                <Button Style="{StaticResource BrowseButton}" Click="BrowseGame_Click" ToolTip="{l:T Settings.Game.GameFolderPickTip}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                                </Button>
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="DetectGame_Click"
                                        ToolTip="{l:T Settings.Game.GameFolderFindTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.FindAutomatically}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="GameFolderIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                <TextBlock x:Name="GameFolderStatus" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Game.Documents}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{l:T Settings.Game.DocumentsAbout}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="DocumentsBox" Style="{StaticResource PathBox}" />
                                <Button Style="{StaticResource BrowseButton}" Click="BrowseDocuments_Click" ToolTip="{l:T Settings.Game.DocumentsPickTip}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                                </Button>
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="DefaultDocuments_Click"
                                        ToolTip="{l:T Settings.Game.DocumentsDefaultTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE777;" />
                                        <TextBlock Margin="8,0,0,0" Text="{l:T Settings.Game.DocumentsDefault}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="DocumentsIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                <TextBlock x:Name="DocumentsStatus" TextWrapping="Wrap" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="{l:T Settings.Game.Wcc}" />
                                <Run Text="{l:T Common.Optional}" FontWeight="Normal" FontSize="13" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap"
                                       Text="{l:T Settings.Game.WccAbout}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="WccBox" Style="{StaticResource PathBox}" />
                                <Button Style="{StaticResource BrowseButton}" Click="BrowseWcc_Click" ToolTip="{l:T Settings.Game.WccPickTip}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                                </Button>
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="DetectWcc_Click"
                                        ToolTip="{l:T Settings.Game.WccFindTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.FindAutomatically}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="WccIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                <TextBlock x:Name="WccStatus" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="{l:T Settings.Game.WccHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}">
                                <Run Text="{l:T Settings.Game.Merger}" />
                                <Run Text="{l:T Common.Optional}" FontWeight="Normal" FontSize="13" />
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap"
                                       Text="{l:T Settings.Game.MergerAbout}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="MergerBox" Style="{StaticResource PathBox}" />
                                <Button Style="{StaticResource BrowseButton}" Click="BrowseMerger_Click" ToolTip="{l:T Settings.Game.MergerPickTip}">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                                </Button>
                                <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="DetectMerger_Click"
                                        ToolTip="{l:T Settings.Game.MergerFindTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.FindAutomatically}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <DockPanel Margin="0,8,0,0">
                                <TextBlock x:Name="MergerIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                <TextBlock x:Name="MergerStatus" TextWrapping="Wrap" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                       Text="{l:T Settings.Game.MergerHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Language -->
                <StackPanel x:Name="LanguagePage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.Language}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="{l:T Settings.Language.Intro}" />
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Language.App}" />
                            <WrapPanel x:Name="AppLanguagePanel" Margin="0,6,0,0" />
                            <TextBlock x:Name="AppLanguageStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.Language.AppHint}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Language.Game}" />
                            <TextBlock TextWrapping="Wrap" Text="{l:T Settings.Language.GameIntro}" />
                            <WrapPanel x:Name="LanguagePanel" Margin="0,6,0,0" />
                            <TextBlock x:Name="LanguageStatus" Style="{StaticResource Hint}" Margin="0,8,0,0" />
                            <TextBlock Style="{StaticResource Label}" Text="{l:T Settings.Language.UsedFor}" />
                            <TextBlock TextWrapping="Wrap" LineHeight="21">
                                <Run Text="{l:T Settings.Language.UsedForScenes}" /><LineBreak />
                                <Run Text="{l:T Settings.Language.UsedForCutscenes}" /><LineBreak />
                                <Run Text="{l:T Settings.Language.UsedForStrings}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Scripts -->
                <StackPanel x:Name="ScriptsPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.Scripts}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="{l:T Settings.Scripts.Intro}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Scripts.Compiling}" />
                            <RadioButton x:Name="CompilerAuto" GroupName="Compiler" Content="{l:T Settings.Scripts.CompilerAuto}" Margin="0,4,0,0" />
                            <RadioButton x:Name="CompilerBuiltIn" GroupName="Compiler" Content="{l:T Settings.Scripts.CompilerBuiltIn}" Margin="0,4,0,0" />
                            <TextBlock x:Name="CompilerStatus" Style="{StaticResource Hint}" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T Settings.Scripts.CompilerHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Scripts.OpeningFiles}" />
                            <RadioButton x:Name="OpenInTabs" GroupName="OpenIn" Content="{l:T Settings.Scripts.OpenInTabs}" Margin="0,4,0,0" />
                            <RadioButton x:Name="OpenInWindows" GroupName="OpenIn" Content="{l:T Settings.Scripts.OpenInWindows}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T Settings.Scripts.OpenHint}" />
                            <TextBlock Style="{StaticResource Label}" Text="{l:T Settings.Scripts.Split}" />
                            <Border Style="{StaticResource SegmentRow}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="SplitRight" GroupName="Split" Style="{StaticResource Segment}" Tag="&#xE89F;" Content="{l:T Settings.Scripts.SplitRight}" />
                                    <RadioButton x:Name="SplitDown" GroupName="Split" Style="{StaticResource Segment}" Tag="&#xE8A0;" Content="{l:T Settings.Scripts.SplitDown}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Scripts.Editors}" />
                            <Grid Margin="0,4,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{l:T Settings.Scripts.FontSize}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                <ComboBox x:Name="FontSizeBox" Grid.Column="1" Width="90" SelectionChanged="EditorLook_Changed" />
                                <TextBlock Grid.Column="2" Text="{l:T Settings.Scripts.TabWidth}" VerticalAlignment="Center" Margin="24,0,10,0" />
                                <ComboBox x:Name="TabWidthBox" Grid.Column="3" Width="120" SelectionChanged="EditorLook_Changed" />
                            </Grid>
                            <Border CornerRadius="6" BorderThickness="1" Padding="10,8" Margin="0,12,0,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock x:Name="EditorSample" FontFamily="Cascadia Mono, Consolas, Courier New" xml:space="preserve" />
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.Scripts.EditorsHint}" />
                            <CheckBox x:Name="PeekCheck" Content="{l:T Settings.Scripts.Peek}" Margin="0,14,0,0" />
                            <CheckBox x:Name="CompleteCheck" Content="{l:T Settings.Scripts.Complete}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Scripts.AsYouType}" />
                            <CheckBox x:Name="CheckAsYouTypeCheck" Content="{l:T Settings.Scripts.CheckAsYouType}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.Scripts.CheckAsYouTypeHint}" />
                            <TextBlock Style="{StaticResource Label}" Text="{l:T Settings.Scripts.ParameterHints}" />
                            <Border Style="{StaticResource SegmentRow}">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="HintsOff" GroupName="Hints" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.HintsOff}" />
                                    <RadioButton x:Name="HintsHeld" GroupName="Hints" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.HintsHeld}" />
                                    <RadioButton x:Name="HintsAlways" GroupName="Hints" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.HintsAlways}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.Scripts.ParameterHintsHint}" />
                            <CheckBox x:Name="DimUnusedCheck" Content="{l:T Settings.Scripts.DimUnused}" Margin="0,14,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.Scripts.DimUnusedHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Scripts.Formatting}" />
                            <TextBlock TextWrapping="Wrap" Text="{l:T Settings.Scripts.FormattingIntro}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{l:T Settings.Scripts.FormatIndent}" VerticalAlignment="Center" Margin="0,0,14,6" />
                                <Border Grid.Column="1" Style="{StaticResource SegmentRow}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="IndentTabs" GroupName="FmtIndent" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.FormatTabs}" Checked="Format_Changed" />
                                        <RadioButton x:Name="IndentSpaces" GroupName="FmtIndent" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.FormatSpaces}" Checked="Format_Changed" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="1" Text="{l:T Settings.Scripts.FormatColon}" VerticalAlignment="Center" Margin="0,0,14,6" />
                                <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource SegmentRow}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <!-- loc-ignore -->
                                        <RadioButton x:Name="ColonSpaced" GroupName="FmtColon" Style="{StaticResource Segment}" Content="x : int" FontFamily="Cascadia Mono, Consolas" Checked="Format_Changed" />
                                        <!-- loc-ignore -->
                                        <RadioButton x:Name="ColonCompact" GroupName="FmtColon" Style="{StaticResource Segment}" Content="x: int" FontFamily="Cascadia Mono, Consolas" Checked="Format_Changed" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="2" Text="{l:T Settings.Scripts.FormatBraces}" VerticalAlignment="Center" Margin="0,0,14,6" />
                                <Border Grid.Row="2" Grid.Column="1" Style="{StaticResource SegmentRow}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="BraceOwnLine" GroupName="FmtBrace" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.FormatBraceOwnLine}" Checked="Format_Changed" />
                                        <RadioButton x:Name="BraceSameLine" GroupName="FmtBrace" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.FormatBraceSameLine}" Checked="Format_Changed" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="3" Text="{l:T Settings.Scripts.FormatAnnotations}" VerticalAlignment="Center" Margin="0,0,14,6" />
                                <Border Grid.Row="3" Grid.Column="1" Style="{StaticResource SegmentRow}" Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="AnnotationsAsWritten" GroupName="FmtAnno" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.FormatAsWritten}" Checked="Format_Changed" />
                                        <RadioButton x:Name="AnnotationsOwnLine" GroupName="FmtAnno" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.FormatOwnLine}" Checked="Format_Changed" />
                                        <RadioButton x:Name="AnnotationsSameLine" GroupName="FmtAnno" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.FormatSameLine}" Checked="Format_Changed" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Grid.Row="4" Text="{l:T Settings.Scripts.FormatBrackets}" VerticalAlignment="Center" Margin="0,0,14,0" />
                                <Border Grid.Row="4" Grid.Column="1" Style="{StaticResource SegmentRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton x:Name="ParensAsWritten" GroupName="FmtParen" Style="{StaticResource Segment}" Content="{l:T Settings.Scripts.FormatAsWritten}" Checked="Format_Changed" />
                                        <!-- loc-ignore -->
                                        <RadioButton x:Name="ParensSpaced" GroupName="FmtParen" Style="{StaticResource Segment}" Content="f( a, b )" FontFamily="Cascadia Mono, Consolas" Checked="Format_Changed" />
                                        <!-- loc-ignore -->
                                        <RadioButton x:Name="ParensNone" GroupName="FmtParen" Style="{StaticResource Segment}" Content="f(a, b)" FontFamily="Cascadia Mono, Consolas" Checked="Format_Changed" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <CheckBox x:Name="KeepAlignmentCheck" Content="{l:T Settings.Scripts.FormatKeepAlignment}" Margin="0,12,0,0" Click="Format_Changed" />
                            <CheckBox x:Name="AlignColonsCheck" Content="{l:T Settings.Scripts.FormatAlignColons}" Margin="0,6,0,0" Click="Format_Changed" />
                            <Border CornerRadius="6" BorderThickness="1" Padding="10,8" Margin="0,12,0,0"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <TextBlock x:Name="FormatSample" FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12" xml:space="preserve" />
                            </Border>
                            <CheckBox x:Name="FormatOnSaveCheck" Content="{l:T Settings.Scripts.FormatOnSave}" Margin="0,12,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.Scripts.FormattingHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Viewers -->
                <StackPanel x:Name="ViewersPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.Viewers}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="{l:T Settings.Viewers.Intro}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Viewers.Properties}" />
                            <CheckBox x:Name="RedkitPropsCheck" Content="{l:T Settings.Viewers.RedkitProps}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T Settings.Viewers.RedkitPropsHint}" />
                            <TextBlock x:Name="RedkitPropsStatus" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Viewers.TextureDetail}" />
                            <Border Style="{StaticResource SegmentRow}" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="Detail512" GroupName="Detail" Style="{StaticResource Segment}" Content="{l:T Settings.Viewers.DetailLow}" />
                                    <RadioButton x:Name="Detail1024" GroupName="Detail" Style="{StaticResource Segment}" Content="{l:T Settings.Viewers.DetailMedium}" />
                                    <RadioButton x:Name="Detail2048" GroupName="Detail" Style="{StaticResource Segment}" Content="{l:T Settings.Viewers.DetailHigh}" />
                                    <RadioButton x:Name="DetailFull" GroupName="Detail" Style="{StaticResource Segment}" Content="{l:T Settings.Viewers.DetailFull}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T Settings.Viewers.TextureDetailHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Viewers.Antialiasing}" />
                            <Border Style="{StaticResource SegmentRow}" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="AntialiasOff" GroupName="Antialias" Style="{StaticResource Segment}" Content="{l:T Settings.Viewers.AntialiasingOff}" />
                                    <RadioButton x:Name="Antialias2" GroupName="Antialias" Style="{StaticResource Segment}" Content="{l:T Settings.Viewers.Antialiasing2}" />
                                    <RadioButton x:Name="Antialias4" GroupName="Antialias" Style="{StaticResource Segment}" Content="{l:T Settings.Viewers.Antialiasing4}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T Settings.Viewers.AntialiasingHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Viewers.Cloth}" />
                            <CheckBox x:Name="SimulateClothCheck" Content="{l:T Settings.Viewers.SimulateCloth}" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T Settings.Viewers.SimulateClothHint}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Viewers.MeshExport}" />
                            <Border Style="{StaticResource SegmentRow}" Margin="0,4,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="ExportLodShown" GroupName="ExportLods" Style="{StaticResource Segment}" Content="{l:T Settings.Viewers.ExportLodShown}" />
                                    <RadioButton x:Name="ExportLodAll" GroupName="ExportLods" Style="{StaticResource Segment}" Content="{l:T Settings.Viewers.ExportLodAll}" />
                                </StackPanel>
                            </Border>
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T Settings.Viewers.ExportLodsHint}" />
                            <CheckBox x:Name="ExportTexturesCheck" Content="{l:T Settings.Viewers.ExportTextures}" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="{l:T Settings.Viewers.ExportTexturesHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Privacy -->
                <StackPanel x:Name="PrivacyPage" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource PageTitle}" Text="{l:T Settings.Nav.Privacy}" />
                    <TextBlock Style="{StaticResource PageIntro}" Text="{l:T Settings.Privacy.Intro}" />

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Privacy.Eab}" />
                            <TextBlock TextWrapping="Wrap"
                                       Text="{l:T Settings.Privacy.EabAbout}" />
                            <DockPanel Margin="0,10,0,0">
                                <TextBlock x:Name="EabIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                <TextBlock x:Name="EabStatus" TextWrapping="Wrap" />
                            </DockPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Button x:Name="EabOnButton" Padding="12,5" Margin="0,0,8,0" Click="EabOn_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" />
                                        <TextBlock Margin="8,0,0,0" Text="{l:T Settings.Privacy.EabTurnOn}" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="EabOffButton" Padding="12,5" Margin="0,0,8,0" Click="EabOff_Click" Content="{l:T Settings.Privacy.EabTurnOff}" />
                                <Button x:Name="EabForgetButton" Padding="12,5" Click="EabForget_Click" Content="{l:T Settings.Privacy.EabForget}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T Settings.Privacy.ReadMore}" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button Padding="12,5" Margin="0,0,8,0" Click="Privacy_Click" Content="{l:T Settings.Privacy.Privacy}" />
                                <Button Padding="12,5" Margin="0,0,8,0" Click="Licence_Click" Content="{l:T Settings.Privacy.Licence}" />
                                <Button Padding="12,5" Click="Notices_Click" Content="{l:T Settings.Privacy.Notices}" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource Hint}" Text="{l:T Settings.Privacy.SettingsFile}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1" Grid.ColumnSpan="2" Padding="18,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <Button DockPanel.Dock="Left" Padding="12,6" Click="Help_Click" ToolTip="{l:T Settings.HelpTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE897;" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.Help}" />
                    </StackPanel>
                </Button>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="{l:T Common.Cancel}" Padding="18,6" Click="Cancel_Click" IsCancel="True" />
                    <Button Content="{l:T Common.Save}" Padding="22,6" Margin="8,0,0,0" Click="Save_Click" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <local:MessageCard x:Name="Message" Grid.RowSpan="2" Grid.ColumnSpan="2" IsModal="True" />
    </Grid>
</Window>
