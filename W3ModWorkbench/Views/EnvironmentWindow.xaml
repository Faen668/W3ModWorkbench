<Window x:Class="W3ModWorkbench.EnvironmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T EnvironmentWindow.Environment}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1400" Height="900" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- compact tabs, as the scene viewer's, so every tab fits in a row -->
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <!-- what's in a tab takes its text colour from the tab: the theme's, not the plain black a tab has without the theme's style -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- the time of day everything is read at, as REDkit's fake day cycle -->
            <Border Style="{StaticResource Card}" Padding="12,8" Margin="0,0,0,8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{l:T EnvironmentWindow.TimeOfDay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <Button x:Name="PlayButton" Grid.Column="1" Padding="10,3" Click="PlayButton_Click" ToolTip="{l:T EnvironmentWindow.PlayDaySpace}">
                        <TextBlock x:Name="PlayIcon" Style="{StaticResource IconText}" Text="&#xE768;" FontSize="12" />
                    </Button>
                    <TextBlock x:Name="ClockText" Grid.Column="2" FontFamily="Consolas" FontSize="15" Margin="12,0,12,0" VerticalAlignment="Center" MinWidth="48" />
                    <Slider x:Name="TimeSlider" Grid.Column="3" Minimum="0" Maximum="1" SmallChange="0.0104167" LargeChange="0.0833333" VerticalAlignment="Center"
                            ValueChanged="TimeSlider_ValueChanged" TickFrequency="0.0833333" TickPlacement="BottomRight" IsMoveToPointEnabled="True" />
                    <StackPanel Grid.Column="4" Orientation="Horizontal" Margin="12,0,0,0">
                        <Border x:Name="SunSwatch" Width="22" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,6,0" />
                        <Border x:Name="SkySwatch" Width="22" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,6,0" />
                        <Border x:Name="FogSwatch" Width="22" Height="22" CornerRadius="11" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="330" MinWidth="220" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="400" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}">
                    <TabControl x:Name="LeftTabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                        <TabItem x:Name="GroupsTab" Header="{l:T EnvironmentWindow.Groups}">
                            <Grid Margin="0,6,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,6">
                                    <TextBox x:Name="FilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                    <TextBlock x:Name="FilterPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Text="{l:T EnvironmentWindow.FindSetting}" />
                                </Grid>
                                <CheckBox x:Name="SetOnlyCheck" Grid.Row="1" Content="{l:T EnvironmentWindow.OnlyWhatFileSets}" IsChecked="True" MinWidth="0" Margin="2,0,0,6"
                                          Click="SetOnlyCheck_Click" ToolTip="{l:T EnvironmentWindow.OnlyWhatFileSetsTip}" />
                                <TreeView x:Name="GroupTree" Grid.Row="2" SelectedItemChanged="GroupTree_SelectedItemChanged">
                                    <TreeView.ItemContainerStyle>
                                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                            <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}" />
                                            <Setter Property="IsSelected" Value="{Binding Selected, Mode=TwoWay}" />
                                        </Style>
                                    </TreeView.ItemContainerStyle>
                                    <TreeView.ItemTemplate>
                                        <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                            <StackPanel Orientation="Horizontal" Opacity="{Binding Opacity}">
                                                <Ellipse Width="7" Height="7" Fill="{Binding StateBrush}" Margin="0,0,7,0" VerticalAlignment="Center" ToolTip="{Binding StateText}" />
                                                <TextBlock Text="{Binding Title}" />
                                                <TextBlock Text="{Binding CountText}" Margin="8,0,0,0" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </HierarchicalDataTemplate>
                                    </TreeView.ItemTemplate>
                                </TreeView>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{l:T Common.Properties}">
                            <DockPanel Margin="4,8,0,0">
                                <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                                <local:PropertyListView x:Name="FileProperties" LinkClicked="Properties_LinkClicked" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="160" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="3*" MinHeight="150" />
                    </Grid.RowDefinitions>

                    <!-- the setting picked, over the day -->
                    <Border Style="{StaticResource Card}">
                        <DockPanel Margin="10,8,10,8">
                            <StackPanel DockPanel.Dock="Top" Margin="2,0,0,4">
                                <TextBlock x:Name="CurveTitle" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CurveDetail" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <local:CurveChart x:Name="Chart" TimePicked="Chart_TimePicked" />
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

                    <!-- the group's settings, as they are at the time -->
                    <Border Grid.Row="2" Style="{StaticResource Card}">
                        <DockPanel Margin="8">
                            <TextBlock x:Name="GroupTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="4,0,0,6" TextTrimming="CharacterEllipsis" />
                            <DataGrid x:Name="SettingGrid" Style="{StaticResource ViewerGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="SettingGrid_SelectionChanged">
                                <DataGrid.CellStyle>
                                    <Style TargetType="DataGridCell" BasedOn="{StaticResource ViewerGridCell}">
                                        <Setter Property="Opacity" Value="{Binding Opacity}" />
                                    </Style>
                                </DataGrid.CellStyle>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T Common.Name}" Binding="{Binding Title}" Width="230" />
                                    <DataGridTemplateColumn Header="{l:T EnvironmentWindow.AtThisTime}" SortMemberPath="ValueText" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="14" Height="14" CornerRadius="3" Background="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center"
                                                            Visibility="{Binding SwatchVisibility}" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" />
                                                    <TextBlock Text="{Binding ValueText}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T EnvironmentWindow.Keys}" Binding="{Binding KeysText}" Width="70" />
                                    <DataGridTextColumn Header="{l:T Common.Type}" Binding="{Binding TypeText}" Width="140" />
                                </DataGrid.Columns>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T EnvironmentWindow.CopyValue}" Click="CopyValue_Click" />
                                        <MenuItem Header="{l:T EnvironmentWindow.CopyKeys}" Click="CopyKeys_Click" />
                                        <MenuItem Header="{l:T EnvironmentWindow.CopyPath}" Click="CopyPath_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T EnvironmentWindow.Reading}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <DockPanel Grid.Row="1" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
