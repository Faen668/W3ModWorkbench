<Window x:Class="W3ModWorkbench.EntityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:vm="clr-namespace:W3ModWorkbench.ViewModels"
        Title="Entity" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1380" Height="900" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <!-- the tabs as small segments in a row, as Settings has them, rather than the theme's tall tabs -->
        <!-- the label's colour and cursor are set on the label alone: set on the tab, the page under it would take them too -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" CornerRadius="6" Padding="12,5" Margin="0,0,4,4" Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="Label" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a property: its name indented under what it's in, its type, and its value or the file it refers to -->
        <DataTemplate x:Key="PropertyTemplate" DataType="{x:Type vm:PropertyRow}">
            <Border x:Name="Row" CornerRadius="4" Padding="4,1" Background="Transparent">
            <Grid Opacity="{Binding Opacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                    <!-- the fold arrow, for a row with rows under it -->
                    <Button Style="{StaticResource LinkButton}" Click="Fold_Click" Width="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Focusable="False">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Type}"
                           VerticalAlignment="Center" Margin="8,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding ValueVisibility}">
                    <TextBlock Text="{Binding BoolGlyph}" Visibility="{Binding BoolVisibility}" Foreground="{Binding BoolBrush}" FontFamily="{StaticResource IconFont}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Visibility="{Binding LinkVisibility}"
                        Click="File_Click" Tag="{Binding Link}" ToolTip="{Binding Link}">
                    <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" FontSize="12" />
                </Button>
            </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- a class's heading is shaded, as REDkit has them -->
                <DataTrigger Binding="{Binding Heading}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="Row" Property="Margin" Value="0,6,0,2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- list rows as tight as REDkit's, rather than the theme's tall ones -->
        <Style x:Key="CompactItem" TargetType="ListBoxItem">
            <!-- the theme's own template gave rows its text colour; without it they'd be black -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PropertyList" TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactItem}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemTemplate" Value="{StaticResource PropertyTemplate}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <!-- the menus are made in code: a Click on a menu item inside a style or template is wired to the wrong element -->
            <Setter Property="ContextMenu" Value="{DynamicResource PropertyMenu}" />
        </Style>
        <DataTemplate x:Key="FileTemplate" DataType="{x:Type vm:CutsceneLinkItem}">
            <StackPanel Margin="0,0,0,6">
                <Button Style="{StaticResource LinkButton}" Click="File_Click" Tag="{Binding GamePath}" HorizontalAlignment="Left" ToolTip="{Binding GamePath}"
                        ContextMenu="{DynamicResource FileMenu}">
                    <TextBlock Text="{Binding GamePath}" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Role}" Style="{StaticResource Small}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.15*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- the entity's meshes put together, in the appearance picked -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="10,8,10,4">
                        <TextBlock Text="Appearance" VerticalAlignment="Center" Margin="2,0,8,0" Opacity="0.7" />
                        <ComboBox x:Name="AppearanceBox" MinWidth="180" Margin="0,0,12,4" SelectionChanged="AppearanceBox_SelectionChanged"
                                  ToolTip="Which of the entity's looks to show" />
                        <TextBlock Text="LOD" VerticalAlignment="Center" Margin="2,0,8,4" Opacity="0.7" />
                        <ComboBox x:Name="LodBox" MinWidth="70" Margin="0,0,12,4" SelectionChanged="LodBox_SelectionChanged"
                                  ToolTip="The level of detail shown: 0 is the most detailed (a mesh with fewer shows its least detailed)" />
                        <ToggleButton x:Name="TexturedToggle" Padding="10,5" Margin="0,0,6,4" IsChecked="True" Click="Textured_Click" ToolTip="Textures (T)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE790;" />
                                <TextBlock Margin="8,0,0,0" Text="Textures" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="WireToggle" Padding="10,5" Margin="0,0,6,4" Click="Wire_Click" ToolTip="Wireframe (W)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE809;" />
                                <TextBlock Margin="8,0,0,0" Text="Wireframe" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Padding="10,5" Margin="0,0,6,4" Click="Fit_Click" ToolTip="See all of it (F, or double-click the view)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" />
                                <TextBlock Margin="8,0,0,0" Text="Fit" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <local:MeshView x:Name="View" Grid.Row="1" Margin="1,0,1,1" PartClicked="View_PartClicked"
                                    ToolTip="Click a part to pick its component; drag to turn, right-drag to move, wheel to zoom, double-click to fit" />
                    <TextBlock x:Name="ViewText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" IsHitTestVisible="False" />
                    <TextBlock x:Name="SelectedText" Grid.Row="1" Margin="12,8" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                    <StackPanel Grid.Row="2">
                        <!-- an animation from the entity's animation sets, played on its rig -->
                        <WrapPanel x:Name="AnimationBar" Margin="10,6,10,0" Visibility="Collapsed">
                            <TextBlock Text="Animation" VerticalAlignment="Center" Margin="2,0,8,4" Opacity="0.7" />
                            <ComboBox x:Name="AnimsetBox" MinWidth="160" MaxWidth="260" Margin="0,0,8,4" SelectionChanged="AnimsetBox_SelectionChanged"
                                      ToolTip="The animation set, from the entity's animation settings" />
                            <ComboBox x:Name="AnimationBox" MinWidth="200" MaxWidth="320" Margin="0,0,12,4" IsEditable="True" IsTextSearchEnabled="True"
                                      SelectionChanged="AnimationBox_SelectionChanged" ToolTip="The animation to play; type to find one by name">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </WrapPanel>
                        <DockPanel x:Name="PlayBar" Margin="10,2,10,0" Visibility="Collapsed">
                            <Button x:Name="PlayButton" DockPanel.Dock="Left" Padding="10,5" Click="Play_Click" IsEnabled="False" ToolTip="Play or pause (Space)">
                                <TextBlock x:Name="PlayIcon" Style="{StaticResource IconText}" Text="&#xE768;" />
                            </Button>
                            <Button DockPanel.Dock="Left" Padding="10,5" Margin="6,0,0,0" Click="RestPose_Click" ToolTip="Stop and stand as bound, without the animation">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" />
                            </Button>
                            <TextBlock x:Name="TimeText" DockPanel.Dock="Left" Width="96" Margin="10,0,6,0" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />
                            <ComboBox x:Name="FpsBox" DockPanel.Dock="Right" MinWidth="86" Margin="10,0,0,0" SelectionChanged="FpsBox_SelectionChanged"
                                      ToolTip="How many times a second the animation is drawn as it plays. Fewer is lighter on the computer; Max draws as often as the screen does" />
                            <Slider x:Name="ScrubSlider" VerticalAlignment="Center" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="Scrub_ValueChanged"
                                    ToolTip="Where in the animation" />
                        </DockPanel>
                        <TextBlock x:Name="MeshesText" Style="{StaticResource Small}" Margin="12,4,12,8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="1.2*" MinHeight="200" />
                </Grid.RowDefinitions>

                <!-- the components as the entity editor lays them out -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- above the graph, rather than over it, so it never hides a component -->
                        <TextBlock x:Name="SummaryText" Margin="12,8,12,2" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <local:EntityGraph x:Name="Graph" Grid.Row="1" ComponentClicked="Graph_ComponentClicked" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <Border Grid.Row="2" Style="{StaticResource Card}">
                    <DockPanel>
                    <!-- one search for every property list, the way a find works across the editor's panels -->
                    <Grid DockPanel.Dock="Top" Margin="10,8,10,0">
                        <TextBox x:Name="PropertySearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="PropertySearch_TextChanged" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock x:Name="PropertySearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                   Text="Find properties by name or value  (Ctrl+F)" />
                    </Grid>
                    <TabControl x:Name="Tabs" Margin="6,4" Background="Transparent" BorderThickness="0">
                        <!-- the tabs wrap as they are, where the theme's strip would stretch them and move the picked row -->
                        <TabControl.Template>
                            <ControlTemplate TargetType="TabControl">
                                <DockPanel>
                                    <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" />
                                    <ContentPresenter ContentSource="SelectedContent" Margin="0,2,0,0" />
                                </DockPanel>
                            </ControlTemplate>
                        </TabControl.Template>
                        <TabItem Header="Component">
                            <DockPanel Margin="4,8,4,4">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock x:Name="ComponentTitle" FontWeight="SemiBold" Text="Click a component in the graph" />
                                    <TextBlock x:Name="ComponentDetail" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ListBox x:Name="ComponentProperties" Style="{StaticResource PropertyList}" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Components">
                            <ListBox x:Name="ComponentList" ItemContainerStyle="{StaticResource CompactItem}" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" SelectionChanged="ComponentList_SelectionChanged"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EntityComponentItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Small}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Small}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="Entity">
                            <ListBox x:Name="EntityProperties" Style="{StaticResource PropertyList}" Margin="0,8,0,0" />
                        </TabItem>
                        <TabItem Header="Template">
                            <Grid Margin="4,8,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="1.4*" MinHeight="60" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="Entity class" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Run x:Name="EntityClassRun" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="Included templates" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl x:Name="IncludeList" ItemTemplate="{StaticResource FileTemplate}" Margin="8,0,0,0" />
                                    <TextBlock x:Name="NoIncludesText" Text="none" Style="{StaticResource Small}" Margin="8,0,0,6" />
                                </StackPanel>
                                <DockPanel Grid.Row="1" Margin="0,6,0,4">
                                    <CheckBox x:Name="OnlyTemplatesCheck" DockPanel.Dock="Right" Content="Show only entity templates" Click="OnlyTemplates_Click" />
                                    <TextBlock x:Name="DependenciesHeading" Text="Dependencies" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                                <Border Grid.Row="2" BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="6,4">
                                    <ListBox x:Name="DependencyList" ItemContainerStyle="{StaticResource CompactItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Click="File_Click" Tag="{Binding}" HorizontalAlignment="Left" ToolTip="Open it">
                                                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <ListBox x:Name="TemplateProperties" Grid.Row="4" Style="{StaticResource PropertyList}" />
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="EffectsTab" Header="Effects">
                            <ListBox x:Name="EffectList" Style="{StaticResource PropertyList}" Margin="0,8,0,0" />
                        </TabItem>
                        <TabItem Header="Files">
                            <!-- a list with its own scrolling: an ItemsControl in a ScrollViewer here never settled on its layout -->
                            <ListBox x:Name="FileList" ItemTemplate="{StaticResource FileTemplate}" ItemContainerStyle="{StaticResource CompactItem}" Margin="0,8,0,0"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" />
                        </TabItem>
                    </TabControl>
                    </DockPanel>
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="BusyText" Text="Reading the entity…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />

        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
