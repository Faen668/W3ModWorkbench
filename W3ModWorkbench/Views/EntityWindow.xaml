<Window x:Class="W3ModWorkbench.EntityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:vm="clr-namespace:W3ModWorkbench.ViewModels"
        Title="{l:T EntityWindow.Entity}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1380" Height="900" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <!-- the tabs as small segments in a row, as Settings has them, rather than the theme's tall tabs -->
        <!-- the label's colour and cursor are set on the label alone: set on the tab, the page under it would take them too -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" CornerRadius="6" Padding="12,5" Margin="2,0,2,4" Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="Label" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="LinkButton" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a property: its name indented under what it's in, its type, and its value or the file it refers to -->
        <DataTemplate x:Key="PropertyTemplate" DataType="{x:Type vm:PropertyRow}">
            <Border x:Name="Row" CornerRadius="4" Padding="4,1" Background="Transparent">
            <Grid Opacity="{Binding Opacity}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="{Binding Indent}">
                    <!-- the fold arrow, for a row with rows under it -->
                    <Button Style="{StaticResource LinkButton}" Click="Fold_Click" Width="16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Focusable="False">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="9" VerticalAlignment="Center" />
                    </Button>
                    <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding Type}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Type}"
                           VerticalAlignment="Center" Margin="8,0" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Visibility="{Binding ValueVisibility}">
                    <TextBlock Text="{Binding BoolGlyph}" Visibility="{Binding BoolVisibility}" Foreground="{Binding BoolBrush}" FontFamily="{StaticResource IconFont}"
                               FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Value}" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                               VerticalAlignment="Center" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource LinkButton}" HorizontalAlignment="Left" Visibility="{Binding LinkVisibility}"
                        Click="File_Click" Tag="{Binding Link}" ToolTip="{Binding Link}">
                    <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" FontSize="12" />
                </Button>
            </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!-- a class's heading is shaded, as REDkit has them -->
                <DataTrigger Binding="{Binding Heading}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                    <Setter TargetName="Row" Property="Margin" Value="0,6,0,2" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!-- list rows as tight as REDkit's, rather than the theme's tall ones -->
        <Style x:Key="CompactItem" TargetType="ListBoxItem">
            <!-- the theme's own template gave rows its text colour; without it they'd be black -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- the effects' rows: the picked one a wash of the accent behind ordinary text, as the app's grids have -->
        <Style x:Key="WashItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="6,2" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid SnapsToDevicePixels="True" Background="Transparent" Margin="0,1">
                            <Border x:Name="Hover" CornerRadius="4" Background="{DynamicResource SubtleFillColorTertiaryBrush}" Visibility="Collapsed" />
                            <Border x:Name="Highlight" CornerRadius="4" Background="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PropertyList" TargetType="ListBox">
            <Setter Property="ItemContainerStyle" Value="{StaticResource CompactItem}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ItemTemplate" Value="{StaticResource PropertyTemplate}" />
            <!-- click a picked row again to unpick it -->
            <Setter Property="local:ListSelection.ClickToUnselect" Value="True" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <!-- the menus are made in code: a Click on a menu item inside a style or template is wired to the wrong element -->
            <Setter Property="ContextMenu" Value="{DynamicResource PropertyMenu}" />
        </Style>
        <DataTemplate x:Key="FileTemplate" DataType="{x:Type vm:CutsceneLinkItem}">
            <StackPanel Margin="0,0,0,6">
                <Button Style="{StaticResource LinkButton}" Click="File_Click" Tag="{Binding GamePath}" HorizontalAlignment="Left" ToolTip="{Binding GamePath}"
                        ContextMenu="{DynamicResource FileMenu}">
                    <TextBlock Text="{Binding GamePath}" TextTrimming="CharacterEllipsis" />
                </Button>
                <TextBlock Text="{Binding Role}" Style="{StaticResource Small}" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1.15*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- the entity's meshes put together, in the appearance picked -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <WrapPanel Margin="10,8,10,4">
                        <TextBlock Text="{l:T EntityWindow.Appearance}" VerticalAlignment="Center" Margin="2,0,8,0" Opacity="0.7" />
                        <ComboBox x:Name="AppearanceBox" MinWidth="180" Margin="0,0,12,4" SelectionChanged="AppearanceBox_SelectionChanged"
                                  ToolTip="{l:T EntityWindow.WhichEntitysLooksShow}" />
                        <TextBlock Text="{l:T EntityWindow.LOD}" VerticalAlignment="Center" Margin="2,0,8,4" Opacity="0.7" />
                        <ComboBox x:Name="LodBox" MinWidth="70" Margin="0,0,12,4" SelectionChanged="LodBox_SelectionChanged"
                                  ToolTip="{l:T EntityWindow.LevelDetailShownMost}" />
                        <ToggleButton x:Name="TexturedToggle" Padding="10,5" Margin="0,0,6,4" IsChecked="True" Click="Textured_Click" ToolTip="{l:T EntityWindow.TexturesT}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE790;" />
                                <TextBlock Margin="8,0,0,0" Text="{l:T Common.Textures}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="WireToggle" Padding="10,5" Margin="0,0,6,4" Click="Wire_Click" ToolTip="{l:T EntityWindow.WireframeW}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE809;" />
                                <TextBlock Margin="8,0,0,0" Text="{l:T Common.Wireframe}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="FloorToggle" Padding="10,5" Margin="0,0,6,4" Click="Floor_Click" ToolTip="{l:T EntityWindow.GridGroundUnderEntity}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE80A;" />
                                <TextBlock Margin="8,0,0,0" Text="{l:T EntityWindow.Floor}" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Padding="10,5" Margin="0,0,6,4" Click="Fit_Click" ToolTip="{l:T EntityWindow.SeeAllFDouble}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" />
                                <TextBlock Margin="8,0,0,0" Text="{l:T Common.Fit}" />
                            </StackPanel>
                        </Button>
                        <!-- the entity's effects, switched on and off where they play: in the view -->
                        <ToggleButton x:Name="EffectsButton" Padding="10,5" Margin="0,0,6,4" Visibility="Collapsed" ToolTip="{l:T EntityWindow.EffectsButtonTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE945;" />
                                <TextBlock x:Name="EffectsButtonText" Margin="8,0,0,0" Text="{l:T Common.Effects}" />
                            </StackPanel>
                        </ToggleButton>
                        <Popup x:Name="EffectsPopup" PlacementTarget="{Binding ElementName=EffectsButton}" Placement="Bottom" AllowsTransparency="True"
                               StaysOpen="False" PopupAnimation="Fade" IsOpen="{Binding IsChecked, ElementName=EffectsButton, Mode=TwoWay}">
                            <Border Margin="0,4,12,12">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35" />
                                </Border.Effect>
                                <Border x:Name="EffectsCard" Width="400" Padding="12,10" CornerRadius="8" BorderThickness="1"
                                        Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}"
                                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                            <Button DockPanel.Dock="Right" Padding="10,3" Content="{l:T EntityWindow.EffectsAllOff}" Click="EffectsOff_Click"
                                                    ToolTip="{l:T EntityWindow.EffectsAllOffTip}" />
                                            <TextBlock Text="{l:T Common.Effects}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock x:Name="EffectsPopupStatus" DockPanel.Dock="Bottom" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,8,0,0" />
                                        <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl x:Name="EffectSwitches">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type local:EffectRow}">
                                                        <CheckBox IsChecked="{Binding On, Mode=TwoWay}" MinWidth="0" Margin="0,2" VerticalContentAlignment="Top"
                                                                  ToolTip="{l:T EntityWindow.EffectOnTip}">
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                <TextBlock Text="{Binding Summary}" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </DockPanel>
                                </Border>
                            </Border>
                        </Popup>
                    </WrapPanel>
                    <local:MeshView x:Name="View" Grid.Row="1" Margin="1,0,1,1" PartClicked="View_PartClicked"
                                    ToolTip="{l:T EntityWindow.ClickPartPickComponent}" />
                    <TextBlock x:Name="ViewText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="380" IsHitTestVisible="False" />
                    <!-- what's being drawn and how fast, as a 3D view's overlay has it -->
                    <Border x:Name="InfoPanel" Grid.Row="1" Margin="10,8" Padding="8,5" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#88000000" IsHitTestVisible="False">
                        <TextBlock x:Name="InfoOverlay" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#E6E6EC" LineHeight="17" />
                    </Border>
                    <!-- a look the app puts together, which isn't in the game's files -->
                    <local:SourceNote x:Name="GeneratedNote" Grid.Row="1" Margin="10,8" MaxWidth="380" HorizontalAlignment="Right" VerticalAlignment="Top" />
                    <TextBlock x:Name="SelectedText" Grid.Row="1" Margin="12,8" VerticalAlignment="Bottom" HorizontalAlignment="Left" FontSize="12"
                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" IsHitTestVisible="False" Visibility="Collapsed" />
                    <StackPanel Grid.Row="2">
                        <!-- an animation from the entity's animation sets, played on its rig -->
                        <!-- the animation's name gets the room that's left, as the names are long -->
                        <Grid x:Name="AnimationBar" Margin="10,6,10,0" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{l:T Common.Animation}" VerticalAlignment="Center" Margin="2,0,8,4" Opacity="0.7" />
                            <ComboBox x:Name="AnimsetBox" Grid.Column="1" MinWidth="160" MaxWidth="260" Margin="0,0,8,4" SelectionChanged="AnimsetBox_SelectionChanged"
                                      ToolTip="{l:T EntityWindow.AnimationSetEntitysAnimation}" />
                            <ComboBox x:Name="AnimationBox" Grid.Column="2" MinWidth="200" Margin="0,0,0,4" IsTextSearchEnabled="True"
                                      SelectionChanged="AnimationBox_SelectionChanged" ToolTip="{l:T EntityWindow.AnimationPlayListOpen}">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel />
                                    </ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </Grid>
                        <DockPanel x:Name="PlayBar" Margin="10,2,10,0" Visibility="Collapsed">
                            <Button x:Name="PlayButton" DockPanel.Dock="Left" Padding="10,5" Click="Play_Click" IsEnabled="False" ToolTip="{l:T Common.PlayPauseSpace}">
                                <TextBlock x:Name="PlayIcon" Style="{StaticResource IconText}" Text="&#xE768;" />
                            </Button>
                            <Button DockPanel.Dock="Left" Padding="10,5" Margin="6,0,0,0" Click="RestPose_Click" ToolTip="{l:T EntityWindow.StopStandBoundWithout}">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" />
                            </Button>
                            <TextBlock x:Name="TimeText" DockPanel.Dock="Left" MinWidth="96" Margin="10,0,6,0" VerticalAlignment="Center"
                                       FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />
                            <ComboBox x:Name="SpeedBox" DockPanel.Dock="Right" MinWidth="86" Margin="8,0,0,0" SelectionChanged="SpeedBox_SelectionChanged"
                                      ToolTip="{l:T EntityWindow.HowFastAnimationPlays}" />
                            <ComboBox x:Name="FpsBox" DockPanel.Dock="Right" MinWidth="86" Margin="10,0,0,0" SelectionChanged="FpsBox_SelectionChanged"
                                      ToolTip="{l:T EntityWindow.HowManyTimesSecond}" />
                            <Slider x:Name="ScrubSlider" VerticalAlignment="Center" Minimum="0" Maximum="1" IsEnabled="False" ValueChanged="Scrub_ValueChanged"
                                    ToolTip="{l:T EntityWindow.WhereAnimation}" />
                        </DockPanel>
                        <TextBlock x:Name="MeshesText" Style="{StaticResource Small}" Margin="12,4,12,8" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="160" />
                    <RowDefinition Height="8" />
                    <RowDefinition Height="1.2*" MinHeight="200" />
                </Grid.RowDefinitions>

                <!-- the components as the entity editor lays them out -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- above the graph, rather than over it, so it never hides a component -->
                        <TextBlock x:Name="SummaryText" Margin="12,8,12,2" FontSize="11.5" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <local:EntityGraph x:Name="Graph" Grid.Row="1" ComponentClicked="Graph_ComponentClicked" />
                    </Grid>
                </Border>

                <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <TabControl x:Name="Tabs" Grid.Row="2" Background="Transparent" BorderThickness="0">
                    <!-- one search for every property list, the way a find works across the editor's panels; it sits above
                         the tabs in their card, handed to the template as the control's Tag -->
                    <TabControl.Tag>
                        <StackPanel>
                        <local:SourceNote x:Name="SourceNoteBar" Margin="0,0,0,8" />
                        <Grid>
                            <TextBox x:Name="PropertySearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="PropertySearch_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="PropertySearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{l:T EntityWindow.FindPropertiesNameValue}" />
                        </Grid>
                        </StackPanel>
                    </TabControl.Tag>
                    <!-- the search and the tabs in a card of their own, the tabs centred and wrapping as they are (the theme's
                         strip would stretch them and move the picked row), and the page picked in a card under it -->
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Style="{StaticResource Card}" Padding="10,8,10,4">
                                    <StackPanel>
                                        <ContentPresenter Content="{TemplateBinding Tag}" />
                                        <WrapPanel IsItemsHost="True" HorizontalAlignment="Center" Margin="0,8,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,8,0,0" Padding="8,2,8,6">
                                    <ContentPresenter ContentSource="SelectedContent" />
                                </Border>
                            </Grid>
                        </ControlTemplate>
                    </TabControl.Template>
                        <TabItem Header="{l:T EntityWindow.Component}">
                            <DockPanel Margin="4,8,4,4">
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                    <TextBlock x:Name="ComponentTitle" FontWeight="SemiBold" Text="{l:T EntityWindow.ClickComponentGraph}" />
                                    <TextBlock x:Name="ComponentDetail" Style="{StaticResource Small}" TextWrapping="Wrap" />
                                </StackPanel>
                                <ListBox x:Name="ComponentProperties" Style="{StaticResource PropertyList}" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="{l:T EntityWindow.Components}">
                            <ListBox x:Name="ComponentList" ItemContainerStyle="{StaticResource CompactItem}" Margin="0,8,0,0" BorderThickness="0" Background="Transparent" SelectionChanged="ComponentList_SelectionChanged"
                                     HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EntityComponentItem}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="1" Text="{Binding Kind}" Style="{StaticResource Small}" Margin="8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Grid.Column="2" Text="{Binding Detail}" Style="{StaticResource Small}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </TabItem>
                        <TabItem Header="{l:T EntityWindow.Entity}">
                            <ListBox x:Name="EntityProperties" Style="{StaticResource PropertyList}" Margin="0,8,0,0" />
                        </TabItem>
                        <TabItem Header="{l:T Common.Template}">
                            <Grid Margin="4,8,4,4">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" MinHeight="60" />
                                    <RowDefinition Height="8" />
                                    <RowDefinition Height="1.4*" MinHeight="60" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock>
                                        <Run Text="{l:T EntityWindow.EntityClass}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <Run x:Name="EntityClassRun" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    </TextBlock>
                                    <TextBlock Text="{l:T EntityWindow.IncludedTemplates}" Margin="0,10,0,4" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    <ItemsControl x:Name="IncludeList" ItemTemplate="{StaticResource FileTemplate}" Margin="8,0,0,0" />
                                    <TextBlock x:Name="NoIncludesText" Text="{l:T Common.None}" Style="{StaticResource Small}" Margin="8,0,0,6" />
                                </StackPanel>
                                <DockPanel Grid.Row="1" Margin="0,6,0,4">
                                    <CheckBox x:Name="OnlyTemplatesCheck" DockPanel.Dock="Right" Content="{l:T EntityWindow.ShowOnlyEntityTemplates}" Click="OnlyTemplates_Click" />
                                    <TextBlock x:Name="DependenciesHeading" Text="{l:T EntityWindow.Dependencies}" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                </DockPanel>
                                <Border Grid.Row="2" BorderThickness="1" CornerRadius="6" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Padding="6,4">
                                    <ListBox x:Name="DependencyList" ItemContainerStyle="{StaticResource CompactItem}" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             VirtualizingPanel.IsVirtualizing="True">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Button Style="{StaticResource LinkButton}" Click="File_Click" Tag="{Binding}" HorizontalAlignment="Left" ToolTip="{l:T EntityWindow.Open}">
                                                    <TextBlock Text="{Binding}" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                                <ListBox x:Name="TemplateProperties" Grid.Row="4" Style="{StaticResource PropertyList}" />
                            </Grid>
                        </TabItem>
                        <TabItem x:Name="EffectsTab" Header="{l:T Common.Effects}">
                            <!-- the effects, each switched on to play it in the 3D view, and the picked one's parts -->
                            <Grid Margin="0,8,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="3*" MinHeight="70" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="2*" MinHeight="50" />
                                </Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" Text="{l:T EntityWindow.EffectsHint}" />
                                    <DockPanel Margin="0,6,0,4">
                                        <Button DockPanel.Dock="Right" Padding="10,3" Margin="8,0,0,0" Content="{l:T EntityWindow.EffectsAllOff}" Click="EffectsOff_Click"
                                                ToolTip="{l:T EntityWindow.EffectsAllOffTip}" />
                                        <TextBlock x:Name="EffectsStatus" Style="{StaticResource Small}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                    </DockPanel>
                                </StackPanel>
                                <ListBox x:Name="EffectList" Grid.Row="1" ItemContainerStyle="{StaticResource WashItem}" BorderThickness="0" Background="Transparent"
                                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="EffectList_SelectionChanged">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:EffectRow}">
                                            <DockPanel Margin="0,2">
                                                <CheckBox DockPanel.Dock="Left" IsChecked="{Binding On, Mode=TwoWay}" MinWidth="0" Margin="0,0,4,0" VerticalAlignment="Top"
                                                          ToolTip="{l:T EntityWindow.EffectOnTip}" />
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Summary}" />
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="EffectPartsTitle" Grid.Row="2" Margin="0,10,0,4" FontWeight="SemiBold" Visibility="Collapsed" />
                                <ListBox x:Name="EffectParts" Grid.Row="3" BorderThickness="0" Background="Transparent" Visibility="Collapsed"
                                         ItemContainerStyle="{StaticResource WashItem}" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type local:EffectPartRow}">
                                            <Grid Opacity="{Binding Opacity}" ToolTip="{Binding Tip}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="92" />
                                                    <ColumnDefinition Width="80" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Time}" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </TabItem>
                        <TabItem Header="{l:T Common.Files}">
                            <!-- a list with its own scrolling: an ItemsControl in a ScrollViewer here never settled on its layout -->
                            <ListBox x:Name="FileList" ItemTemplate="{StaticResource FileTemplate}" ItemContainerStyle="{StaticResource CompactItem}" Margin="0,8,0,0"
                                     BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" />
                        </TabItem>
                </TabControl>
            </Grid>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T EntityWindow.ReadingEntity}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />

        <DockPanel Grid.Row="1" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
