<Window x:Class="W3ModWorkbench.Cr2wJsonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="CR2W and JSON" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1000" Height="860" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Width" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- the tabs, as a row of joined choices like Settings' theme mode: an icon (Tag) and a label, the chosen one in the accent colour -->
        <Style x:Key="SegmentTabs" TargetType="TabControl">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border HorizontalAlignment="Left" CornerRadius="8" BorderThickness="1" Padding="3"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- the colour is set on the header alone: the tab's page inherits from the tab, and would take the accent's text colour -->
        <Style x:Key="SegmentTab" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" CornerRadius="6" Padding="16,6" Background="Transparent">
                            <StackPanel x:Name="Header" Orientation="Horizontal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{TemplateBinding Tag}" VerticalAlignment="Center" FontSize="13" />
                                <ContentPresenter ContentSource="Header" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a converted or edited file: whether it worked, where it went, and what it said -->
        <DataTemplate x:Key="ResultRow" DataType="{x:Type local:Cr2wResultRow}">
            <Grid x:Name="Row" Margin="0,2" ToolTip="{Binding Tip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Opacity="0.65" TextWrapping="Wrap" FontSize="12"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- the files list both tabs have: what to work on -->
        <DataTemplate x:Key="InputRow" DataType="{x:Type local:Cr2wInputRow}">
            <StackPanel x:Name="Row" Orientation="Horizontal" ToolTip="{Binding Path}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" Margin="0,1,8,0" Opacity="0.75" />
                <TextBlock Text="{Binding Path}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- an edit waiting in the list -->
        <DataTemplate x:Key="EditRow" DataType="{x:Type local:Cr2wEditRow}">
            <TextBlock x:Name="Row" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="CR2W and JSON" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Opacity="0.65" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="Turn the game's resource files (.env, .w2mi, .w2ent and the rest) into JSON to edit by hand or with a script, and back, byte for byte. Or make the same edit to hundreds of them at once." />
            </StackPanel>

            <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource SegmentTabs}" ItemContainerStyle="{StaticResource SegmentTab}">
                <!-- ============================================================ convert -->
                <TabItem Header="Convert" Tag="&#xE8AB;">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="Files and folders" Style="{StaticResource Heading}" />
                                    <TextBlock Style="{StaticResource Note}"
                                               Text="Add or drop files and folders. In a folder, converting to JSON takes every CR2W file; converting back takes every .json file this tool made." />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Style="{StaticResource Small}" Content="Add files…" Click="ConvertAddFiles_Click" />
                                        <Button Style="{StaticResource Small}" Content="Add folder…" Click="ConvertAddFolder_Click" />
                                        <Button Style="{StaticResource Small}" Content="Remove" Click="ConvertRemove_Click" />
                                        <Button Style="{StaticResource Small}" Content="Clear" Click="ConvertClear_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="ConvertList" Height="110" SelectionMode="Extended" ItemTemplate="{StaticResource InputRow}" KeyDown="InputList_KeyDown" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Convert" Style="{StaticResource Label}" />
                                    <RadioButton x:Name="ToJsonRadio" Content="CR2W to JSON" IsChecked="True" GroupName="Direction" MinWidth="0" Margin="0,0,18,0" />
                                    <RadioButton x:Name="FromJsonRadio" Content="JSON back to CR2W" GroupName="Direction" MinWidth="0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Save" Style="{StaticResource Label}" />
                                    <RadioButton x:Name="ConvertBesideRadio" Content="Beside each file" GroupName="ConvertOut" MinWidth="0" Margin="0,0,18,0" IsChecked="True" />
                                    <RadioButton x:Name="ConvertFolderRadio" Content="Into a folder, keeping the folders below what was added" GroupName="ConvertOut" MinWidth="0" />
                                </StackPanel>
                                <DockPanel Margin="110,6,0,0" IsEnabled="{Binding IsChecked, ElementName=ConvertFolderRadio}">
                                    <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,4" Margin="6,0,0,0" Click="ConvertBrowse_Click" />
                                    <TextBox x:Name="ConvertOutputBox" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="110,8,0,0">
                                    <CheckBox x:Name="ConvertRecursiveCheck" Content="Look in subfolders" IsChecked="True" MinWidth="0" Margin="0,0,18,0" />
                                    <CheckBox x:Name="OverwriteCheck" Content="Replace files that are there already" MinWidth="0" />
                                </StackPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button x:Name="ConvertStopButton" Content="Stop" Padding="14,6" Margin="0,0,6,0" Click="Stop_Click" Visibility="Collapsed" />
                                        <Button x:Name="ConvertButton" Padding="18,6" Click="Convert_Click" Style="{DynamicResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8AB;" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="Convert" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="ConvertStatus" Opacity="0.75" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="ConvertProgress" Height="4" Margin="0,6,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="0" Content="Show in Explorer" Click="ConvertReveal_Click"
                                            ToolTip="Show the highlighted results (or all of them) in File Explorer" />
                                    <TextBlock Text="Results" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ListBox x:Name="ConvertResults" ItemTemplate="{StaticResource ResultRow}" SelectionMode="Extended"
                                         MouseDoubleClick="Results_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================================================ bulk edit -->
                <TabItem Header="Bulk edit" Tag="&#xE70F;">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,4,0">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="Files to edit" Style="{StaticResource Heading}" />
                                        <TextBlock Style="{StaticResource Note}"
                                                   Text="CR2W files or .json files this tool made, or folders of them. Each is saved in the form it's in. The game's own files are never changed: extract them first." />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Style="{StaticResource Small}" Content="Add files…" Click="BulkAddFiles_Click" />
                                            <Button Style="{StaticResource Small}" Content="Add folder…" Click="BulkAddFolder_Click" />
                                            <Button Style="{StaticResource Small}" Content="Remove" Click="BulkRemove_Click" />
                                            <Button Style="{StaticResource Small}" Content="Clear" Click="BulkClear_Click" />
                                            <CheckBox x:Name="BulkRecursiveCheck" Content="Look in subfolders" IsChecked="True" MinWidth="0" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ListBox x:Name="BulkList" Height="90" SelectionMode="Extended" ItemTemplate="{StaticResource InputRow}" KeyDown="InputList_KeyDown" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Edits" Style="{StaticResource Heading}" />
                                    <TextBlock Style="{StaticResource Note}"
                                               Text="Made in order, to every object of the class in every file. A path is property names from the object down, with [n] for an item of a list: envParams.m_toneMapping. Choose it from a file with Choose…" />

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="Edit" Style="{StaticResource Label}" />
                                        <ComboBox x:Name="KindBox" Width="300" SelectedIndex="0" SelectionChanged="Kind_Changed">
                                            <ComboBoxItem Content="Copy the value from another file" />
                                            <ComboBoxItem Content="Set a value" />
                                            <ComboBoxItem Content="Remove (the game uses its default)" />
                                            <ComboBoxItem Content="Multiply numbers" />
                                            <ComboBoxItem Content="Add to numbers" />
                                        </ComboBox>
                                    </StackPanel>

                                    <DockPanel x:Name="SourceRow" Margin="0,8,0,0">
                                        <TextBlock Text="From file" Style="{StaticResource Label}" />
                                        <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,4" Margin="6,0,0,0" Click="SourceBrowse_Click" />
                                        <TextBox x:Name="SourceBox" ToolTip="The file whose value is copied: a CR2W file or a .json file this tool made" />
                                    </DockPanel>

                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="Path" Style="{StaticResource Label}" />
                                        <Button DockPanel.Dock="Right" x:Name="ChooseButton" Content="Choose…" Padding="12,4" Margin="6,0,0,0" Click="Choose_Click"
                                                ToolTip="Pick the property from the source file (or the first file to edit)" />
                                        <TextBox x:Name="PathBox" Style="{StaticResource Mono}" />
                                    </DockPanel>

                                    <Border x:Name="PickerPanel" Margin="110,6,0,0" Height="260" Visibility="Collapsed" CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="8,6">
                                                <Button DockPanel.Dock="Right" Content="Close" Padding="10,2" Click="PickerClose_Click" />
                                                <TextBlock x:Name="PickerTitle" VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TreeView x:Name="PickerTree" BorderThickness="0" SelectedItemChanged="Picker_SelectedItemChanged">
                                                <TreeView.ItemTemplate>
                                                    <HierarchicalDataTemplate DataType="{x:Type local:Cr2wPathNode}" ItemsSource="{Binding Children}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" Opacity="0.55" />
                                                        </StackPanel>
                                                    </HierarchicalDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </DockPanel>
                                    </Border>

                                    <DockPanel x:Name="ValueRow" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Value" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                        <TextBox x:Name="ValueBox" Style="{StaticResource Mono}" AcceptsReturn="True" MinHeight="34" MaxHeight="160"
                                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                 ToolTip="JSON: 1.5, true, &quot;text&quot;, or an object or list. Plain text is taken as a string." />
                                    </DockPanel>

                                    <StackPanel x:Name="AmountRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="AmountLabel" Text="By" Style="{StaticResource Label}" />
                                        <TextBox x:Name="AmountBox" Style="{StaticResource Mono}" Width="110" Text="1" />
                                        <TextBlock Text="In properties" VerticalAlignment="Center" Opacity="0.8" Margin="18,0,10,0" />
                                        <TextBox x:Name="FieldsBox" Style="{StaticResource Mono}" Width="220" Text="value"
                                                 ToolTip="Only numbers in these properties change, at any depth below the path, comma separated: value for curves, X, Y, Z for colours and vectors. Empty for every number." />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="Only objects of" Style="{StaticResource Label}" />
                                        <TextBox x:Name="ClassBox" Style="{StaticResource Mono}" Width="300"
                                                 ToolTip="Edit only objects of this class (CEnvironmentDefinition). Empty for every object that has the path." />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="110,10,0,0">
                                        <Button Content="Add to the edits" Padding="14,5" Click="AddEdit_Click" />
                                        <Button Content="Remove edit" Padding="14,5" Margin="6,0,0,0" Click="RemoveEdit_Click" />
                                    </StackPanel>
                                    <ListBox x:Name="EditsList" Margin="110,8,0,0" MinHeight="60" MaxHeight="140" ItemTemplate="{StaticResource EditRow}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Save" Style="{StaticResource Label}" />
                                        <RadioButton x:Name="BulkFolderRadio" Content="Into a folder, keeping the folders below what was added" GroupName="BulkOut" MinWidth="0" Margin="0,0,18,0" IsChecked="True" />
                                        <RadioButton x:Name="BulkInPlaceRadio" Content="Over the files" GroupName="BulkOut" MinWidth="0" />
                                    </StackPanel>
                                    <DockPanel Margin="110,6,0,0" IsEnabled="{Binding IsChecked, ElementName=BulkFolderRadio}">
                                        <Button DockPanel.Dock="Right" Content="Browse…" Padding="12,4" Margin="6,0,0,0" Click="BulkBrowse_Click" />
                                        <TextBox x:Name="BulkOutputBox" />
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button x:Name="BulkStopButton" Content="Stop" Padding="14,6" Margin="0,0,6,0" Click="Stop_Click" Visibility="Collapsed" />
                                            <Button x:Name="CheckButton" Content="Check" Padding="14,6" Margin="0,0,6,0" Click="BulkCheck_Click"
                                                    ToolTip="Try the edits without saving anything: which files they'd change, and whether each could be saved" />
                                            <Button x:Name="ApplyButton" Padding="18,6" Click="BulkApply_Click" Style="{DynamicResource AccentButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" FontSize="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="Make the edits" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="BulkStatus" Opacity="0.75" TextWrapping="Wrap" />
                                            <ProgressBar x:Name="BulkProgress" Height="4" Margin="0,6,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="0" Content="Show in Explorer" Click="BulkReveal_Click" />
                                        <TextBlock Text="Results" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ListBox x:Name="BulkResults" Height="220" ItemTemplate="{StaticResource ResultRow}" SelectionMode="Extended"
                                             MouseDoubleClick="Results_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
