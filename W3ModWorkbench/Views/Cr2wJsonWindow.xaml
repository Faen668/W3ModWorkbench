<Window x:Class="W3ModWorkbench.Cr2wJsonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T Cr2wJsonWindow.CR2WJson}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1000" Height="860" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,2,0,8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Width" Value="110" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style x:Key="Mono" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style x:Key="Small" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>

        <!-- the tabs, as a row of joined choices like Settings' theme mode: an icon (Tag) and a label, the chosen one in the accent colour -->
        <Style x:Key="SegmentTabs" TargetType="TabControl">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border HorizontalAlignment="Left" CornerRadius="8" BorderThickness="1" Padding="3"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <StackPanel Orientation="Horizontal" IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- the colour is set on the header alone: the tab's page inherits from the tab, and would take the accent's text colour -->
        <Style x:Key="SegmentTab" TargetType="TabItem">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" CornerRadius="6" Padding="16,6" Background="Transparent">
                            <StackPanel x:Name="Header" Orientation="Horizontal" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="{TemplateBinding Tag}" VerticalAlignment="Center" FontSize="13" />
                                <ContentPresenter ContentSource="Header" Margin="8,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- a converted or edited file: whether it worked, where it went, and what it said -->
        <DataTemplate x:Key="ResultRow" DataType="{x:Type local:Cr2wResultRow}">
            <Grid x:Name="Row" Margin="0,2" ToolTip="{Binding Tip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" Foreground="{Binding Brush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Detail}" Opacity="0.65" TextWrapping="Wrap" FontSize="12"
                               Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    <Setter TargetName="Status" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- the files list both tabs have: what to work on -->
        <DataTemplate x:Key="InputRow" DataType="{x:Type local:Cr2wInputRow}">
            <StackPanel x:Name="Row" Orientation="Horizontal" ToolTip="{Binding Path}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" Margin="0,1,8,0" Opacity="0.75" />
                <TextBlock Text="{Binding Path}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- an edit waiting in the list -->
        <DataTemplate x:Key="EditRow" DataType="{x:Type local:Cr2wEditRow}">
            <TextBlock x:Name="Row" Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Row" Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- a saved recipe: its name, and what it does in a line -->
        <DataTemplate x:Key="RecipeRow" DataType="{x:Type local:Cr2wRecipeRow}">
            <Grid Margin="0,3" ToolTip="{Binding Tip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" Margin="0,2,10,0" VerticalAlignment="Top"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Summary}" Opacity="0.65" FontSize="12" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{l:T Cr2wJsonWindow.CR2WJson}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Opacity="0.65" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="{l:T Cr2wJsonWindow.TurnGamesResourceFiles}" />
            </StackPanel>

            <TabControl x:Name="Tabs" Grid.Row="1" Style="{StaticResource SegmentTabs}" ItemContainerStyle="{StaticResource SegmentTab}">
                <!-- ============================================================ convert -->
                <TabItem Header="{l:T Cr2wJsonWindow.Convert}" Tag="&#xE8AB;">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{l:T Cr2wJsonWindow.FilesFolders}" Style="{StaticResource Heading}" />
                                    <TextBlock Style="{StaticResource Note}"
                                               Text="{l:T Cr2wJsonWindow.AddDropFilesFolders}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                        <Button Style="{StaticResource Small}" Content="{l:T Cr2wJsonWindow.AddFiles}" Click="ConvertAddFiles_Click" />
                                        <Button Style="{StaticResource Small}" Content="{l:T Cr2wJsonWindow.AddFolder}" Click="ConvertAddFolder_Click" />
                                        <Button Style="{StaticResource Small}" Content="{l:T Common.Remove}" Click="ConvertRemove_Click" />
                                        <Button Style="{StaticResource Small}" Content="{l:T Cr2wJsonWindow.Clear}" Click="ConvertClear_Click" />
                                    </StackPanel>
                                </StackPanel>
                                <ListBox x:Name="ConvertList" Height="110" SelectionMode="Extended" ItemTemplate="{StaticResource InputRow}" KeyDown="InputList_KeyDown" />
                            </DockPanel>
                        </Border>

                        <Border Grid.Row="1" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{l:T Cr2wJsonWindow.Convert}" Style="{StaticResource Label}" />
                                    <RadioButton x:Name="ToJsonRadio" Content="{l:T Cr2wJsonWindow.CR2WJson2}" IsChecked="True" GroupName="Direction" MinWidth="0" Margin="0,0,18,0" />
                                    <RadioButton x:Name="FromJsonRadio" Content="{l:T Cr2wJsonWindow.JsonBackCR2W}" GroupName="Direction" MinWidth="0" Margin="0,0,18,0" />
                                    <RadioButton x:Name="ResaveRadio" Content="{l:T Cr2wJsonWindow.ResaveVersion}" GroupName="Direction" MinWidth="0"
                                                 ToolTip="{l:T Cr2wJsonWindow.SaveOlderCR2WFiles}" />
                                </StackPanel>
                                <CheckBox x:Name="AsLatestCheck" Margin="110,6,0,0" MinWidth="0" Content="{l:T Cr2wJsonWindow.SaveOlderFilesVersion}"
                                          IsEnabled="{Binding IsChecked, ElementName=FromJsonRadio}"
                                          ToolTip="{l:T Cr2wJsonWindow.JsonMadeOlderCR2W}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{l:T Common.Save}" Style="{StaticResource Label}" />
                                    <RadioButton x:Name="ConvertBesideRadio" Content="{l:T Cr2wJsonWindow.BesideEachFile}" GroupName="ConvertOut" MinWidth="0" Margin="0,0,18,0" IsChecked="True" />
                                    <RadioButton x:Name="ConvertFolderRadio" Content="{l:T Cr2wJsonWindow.IntoFolderKeepingFolders}" GroupName="ConvertOut" MinWidth="0" />
                                </StackPanel>
                                <DockPanel Margin="110,6,0,0" IsEnabled="{Binding IsChecked, ElementName=ConvertFolderRadio}">
                                    <Button DockPanel.Dock="Right" Content="{l:T Common.Browse}" Padding="12,4" Margin="6,0,0,0" Click="ConvertBrowse_Click" />
                                    <TextBox x:Name="ConvertOutputBox" />
                                </DockPanel>
                                <StackPanel Orientation="Horizontal" Margin="110,8,0,0">
                                    <CheckBox x:Name="ConvertRecursiveCheck" Content="{l:T Cr2wJsonWindow.LookSubfolders}" IsChecked="True" MinWidth="0" Margin="0,0,18,0" />
                                    <CheckBox x:Name="OverwriteCheck" Content="{l:T Cr2wJsonWindow.ReplaceFilesThereAlready}" MinWidth="0" />
                                </StackPanel>
                                <DockPanel Margin="0,12,0,0">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Content="{l:T Cr2wJsonWindow.SaveAsRecipe}" Padding="14,6" Margin="0,0,6,0" Click="ConvertSaveRecipe_Click"
                                                ToolTip="{l:T Cr2wJsonWindow.SaveAsRecipeTip}" />
                                        <Button x:Name="ConvertStopButton" Content="{l:T Cr2wJsonWindow.Stop}" Padding="14,6" Margin="0,0,6,0" Click="Stop_Click" Visibility="Collapsed" />
                                        <Button x:Name="ConvertButton" Padding="18,6" Click="Convert_Click" Style="{DynamicResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8AB;" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="{l:T Cr2wJsonWindow.Convert}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                        <TextBlock x:Name="ConvertStatus" Opacity="0.75" TextWrapping="Wrap" />
                                        <ProgressBar x:Name="ConvertProgress" Height="4" Margin="0,6,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="0" Content="{l:T Common.ShowExplorer}" Click="ConvertReveal_Click"
                                            ToolTip="{l:T Cr2wJsonWindow.ShowHighlightedResultsAll}" />
                                    <TextBlock Text="{l:T Cr2wJsonWindow.Results}" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                                </DockPanel>
                                <ListBox x:Name="ConvertResults" ItemTemplate="{StaticResource ResultRow}" SelectionMode="Extended"
                                         MouseDoubleClick="Results_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================================================ bulk edit -->
                <TabItem Header="{l:T Cr2wJsonWindow.BulkEdit}" Tag="&#xE70F;">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,10,4,0">
                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBlock Text="{l:T Cr2wJsonWindow.FilesEdit}" Style="{StaticResource Heading}" />
                                        <TextBlock Style="{StaticResource Note}"
                                                   Text="{l:T Cr2wJsonWindow.CR2WFilesJsonFiles}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                            <Button Style="{StaticResource Small}" Content="{l:T Cr2wJsonWindow.AddFiles}" Click="BulkAddFiles_Click" />
                                            <Button Style="{StaticResource Small}" Content="{l:T Cr2wJsonWindow.AddFolder}" Click="BulkAddFolder_Click" />
                                            <Button Style="{StaticResource Small}" Content="{l:T Common.Remove}" Click="BulkRemove_Click" />
                                            <Button Style="{StaticResource Small}" Content="{l:T Cr2wJsonWindow.Clear}" Click="BulkClear_Click" />
                                            <CheckBox x:Name="BulkRecursiveCheck" Content="{l:T Cr2wJsonWindow.LookSubfolders}" IsChecked="True" MinWidth="0" Margin="10,0,0,0" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ListBox x:Name="BulkList" Height="90" SelectionMode="Extended" ItemTemplate="{StaticResource InputRow}" KeyDown="InputList_KeyDown" />
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="{l:T Cr2wJsonWindow.Edits}" Style="{StaticResource Heading}" />
                                    <TextBlock Style="{StaticResource Note}"
                                               Text="{l:T Cr2wJsonWindow.MadeOrderEveryObject}" />

                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <TextBlock Text="{l:T Cr2wJsonWindow.Edit}" Style="{StaticResource Label}" />
                                        <ComboBox x:Name="KindBox" Width="300" SelectedIndex="0" SelectionChanged="Kind_Changed">
                                            <ComboBoxItem Content="{l:T Cr2wJsonWindow.CopyValueAnotherFile}" />
                                            <ComboBoxItem Content="{l:T Cr2wJsonWindow.SetValue}" />
                                            <ComboBoxItem Content="{l:T Cr2wJsonWindow.RemoveGameUsesDefault}" />
                                            <ComboBoxItem Content="{l:T Cr2wJsonWindow.MultiplyNumbers}" />
                                            <ComboBoxItem Content="{l:T Cr2wJsonWindow.AddNumbers}" />
                                        </ComboBox>
                                    </StackPanel>

                                    <DockPanel x:Name="SourceRow" Margin="0,8,0,0">
                                        <TextBlock Text="{l:T Cr2wJsonWindow.File}" Style="{StaticResource Label}" />
                                        <Button DockPanel.Dock="Right" Content="{l:T Common.Browse}" Padding="12,4" Margin="6,0,0,0" Click="SourceBrowse_Click" />
                                        <TextBox x:Name="SourceBox" ToolTip="{l:T Cr2wJsonWindow.FileWhoseValueCopied}" />
                                    </DockPanel>

                                    <DockPanel Margin="0,8,0,0">
                                        <TextBlock Text="{l:T Common.Path}" Style="{StaticResource Label}" />
                                        <Button DockPanel.Dock="Right" x:Name="ChooseButton" Content="{l:T Cr2wJsonWindow.Choose}" Padding="12,4" Margin="6,0,0,0" Click="Choose_Click"
                                                ToolTip="{l:T Cr2wJsonWindow.PickPropertySourceFile}" />
                                        <TextBox x:Name="PathBox" Style="{StaticResource Mono}" />
                                    </DockPanel>

                                    <Border x:Name="PickerPanel" Margin="110,6,0,0" Height="260" Visibility="Collapsed" CornerRadius="4" BorderThickness="1"
                                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                        <DockPanel>
                                            <DockPanel DockPanel.Dock="Top" Margin="8,6">
                                                <Button DockPanel.Dock="Right" Content="{l:T Common.Close}" Padding="10,2" Click="PickerClose_Click" />
                                                <TextBlock x:Name="PickerTitle" VerticalAlignment="Center" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                            <TreeView x:Name="PickerTree" BorderThickness="0" SelectedItemChanged="Picker_SelectedItemChanged">
                                                <TreeView.ItemTemplate>
                                                    <HierarchicalDataTemplate DataType="{x:Type local:Cr2wPathNode}" ItemsSource="{Binding Children}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" />
                                                            <TextBlock Text="{Binding Summary}" Margin="10,0,0,0" Opacity="0.55" />
                                                        </StackPanel>
                                                    </HierarchicalDataTemplate>
                                                </TreeView.ItemTemplate>
                                            </TreeView>
                                        </DockPanel>
                                    </Border>

                                    <DockPanel x:Name="ValueRow" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock Text="{l:T Cr2wJsonWindow.Value}" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                        <TextBox x:Name="ValueBox" Style="{StaticResource Mono}" AcceptsReturn="True" MinHeight="34" MaxHeight="160"
                                                 VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top"
                                                 ToolTip="{l:T Cr2wJsonWindow.JsonTrueTextObject}" />
                                    </DockPanel>

                                    <StackPanel x:Name="AmountRow" Orientation="Horizontal" Margin="0,8,0,0" Visibility="Collapsed">
                                        <TextBlock x:Name="AmountLabel" Text="{l:T Cr2wJsonWindow.By}" Style="{StaticResource Label}" />
                                        <TextBox x:Name="AmountBox" Style="{StaticResource Mono}" Width="110" Text="1" />
                                        <TextBlock Text="{l:T Cr2wJsonWindow.Properties}" VerticalAlignment="Center" Opacity="0.8" Margin="18,0,10,0" />
                                        <TextBox x:Name="FieldsBox" Style="{StaticResource Mono}" Width="220" Text="{l:T Cr2wJsonWindow.Value2}"
                                                 ToolTip="{l:T Cr2wJsonWindow.OnlyNumbersTheseProperties}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <TextBlock Text="{l:T Cr2wJsonWindow.OnlyObjects}" Style="{StaticResource Label}" />
                                        <TextBox x:Name="ClassBox" Style="{StaticResource Mono}" Width="300"
                                                 ToolTip="{l:T Cr2wJsonWindow.EditOnlyObjectsClass}" />
                                    </StackPanel>

                                    <StackPanel Orientation="Horizontal" Margin="110,10,0,0">
                                        <Button Content="{l:T Cr2wJsonWindow.AddEdits}" Padding="14,5" Click="AddEdit_Click" />
                                        <Button Content="{l:T Cr2wJsonWindow.RemoveEdit}" Padding="14,5" Margin="6,0,0,0" Click="RemoveEdit_Click" />
                                    </StackPanel>
                                    <ListBox x:Name="EditsList" Margin="110,8,0,0" MinHeight="60" MaxHeight="140" ItemTemplate="{StaticResource EditRow}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{l:T Common.Save}" Style="{StaticResource Label}" />
                                        <RadioButton x:Name="BulkFolderRadio" Content="{l:T Cr2wJsonWindow.IntoFolderKeepingFolders}" GroupName="BulkOut" MinWidth="0" Margin="0,0,18,0" IsChecked="True" />
                                        <RadioButton x:Name="BulkInPlaceRadio" Content="{l:T Cr2wJsonWindow.OverFiles}" GroupName="BulkOut" MinWidth="0" />
                                    </StackPanel>
                                    <DockPanel Margin="110,6,0,0" IsEnabled="{Binding IsChecked, ElementName=BulkFolderRadio}">
                                        <Button DockPanel.Dock="Right" Content="{l:T Common.Browse}" Padding="12,4" Margin="6,0,0,0" Click="BulkBrowse_Click" />
                                        <TextBox x:Name="BulkOutputBox" />
                                    </DockPanel>
                                    <DockPanel Margin="0,12,0,0">
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="{l:T Cr2wJsonWindow.SaveAsRecipe}" Padding="14,6" Margin="0,0,6,0" Click="BulkSaveRecipe_Click"
                                                    ToolTip="{l:T Cr2wJsonWindow.SaveAsRecipeTip}" />
                                            <Button x:Name="BulkStopButton" Content="{l:T Cr2wJsonWindow.Stop}" Padding="14,6" Margin="0,0,6,0" Click="Stop_Click" Visibility="Collapsed" />
                                            <Button x:Name="CheckButton" Content="{l:T Cr2wJsonWindow.Check}" Padding="14,6" Margin="0,0,6,0" Click="BulkCheck_Click"
                                                    ToolTip="{l:T Cr2wJsonWindow.TryEditsWithoutSaving}" />
                                            <Button x:Name="ApplyButton" Padding="18,6" Click="BulkApply_Click" Style="{DynamicResource AccentButtonStyle}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" FontSize="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="{l:T Cr2wJsonWindow.MakeEdits}" Margin="8,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                            <TextBlock x:Name="BulkStatus" Opacity="0.75" TextWrapping="Wrap" />
                                            <ProgressBar x:Name="BulkProgress" Height="4" Margin="0,6,0,0" Visibility="Collapsed" />
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="0" Content="{l:T Common.ShowExplorer}" Click="BulkReveal_Click" />
                                        <TextBlock Text="{l:T Cr2wJsonWindow.Results}" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                                    </DockPanel>
                                    <ListBox x:Name="BulkResults" Height="220" ItemTemplate="{StaticResource ResultRow}" SelectionMode="Extended"
                                             MouseDoubleClick="Results_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                </DockPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <!-- ============================================================ recipes -->
                <TabItem Header="{l:T Cr2wJsonWindow.Recipes}" Tag="&#xE8F1;">
                    <!-- the recipes and the results share the window, whatever recipe is chosen; the splitter moves the line -->
                    <!-- the recipes and the results share the window, whatever recipe is chosen; the splitter moves the line -->
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3*" MinHeight="280" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" MinHeight="100" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource Card}" Margin="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Style="{StaticResource Small}" Content="{l:T Cr2wJsonWindow.RecipeImport}" Click="RecipeImport_Click"
                                                ToolTip="{l:T Cr2wJsonWindow.RecipeImportTip}" />
                                        <Button Style="{StaticResource Small}" Margin="0" Content="{l:T Cr2wJsonWindow.RecipeOpenFolder}" Click="RecipeFolder_Click"
                                                ToolTip="{l:T Cr2wJsonWindow.RecipeOpenFolderTip}" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{l:T Cr2wJsonWindow.SavedRecipes}" Style="{StaticResource Heading}" />
                                        <TextBlock Style="{StaticResource Note}" Text="{l:T Cr2wJsonWindow.RecipesNote}" />
                                    </StackPanel>
                                </DockPanel>

                                <!-- what can be done with the chosen recipe, in one bar across the card -->
                                <DockPanel x:Name="RecipeActions" DockPanel.Dock="Bottom" Margin="0,12,0,0" Visibility="Collapsed">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                                        <Button x:Name="RecipeStopButton" Content="{l:T Cr2wJsonWindow.Stop}" Padding="14,6" Margin="0,0,6,0" Click="Stop_Click" Visibility="Collapsed" />
                                        <Button x:Name="RecipeCheckButton" Content="{l:T Cr2wJsonWindow.Check}" Padding="14,6" Margin="0,0,6,0" Click="RecipeCheck_Click"
                                                ToolTip="{l:T Cr2wJsonWindow.TryEditsWithoutSaving}" />
                                        <Button x:Name="RecipeRunButton" Padding="18,6" Click="RecipeRun_Click" Style="{DynamicResource AccentButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE768;" FontSize="13" VerticalAlignment="Center" />
                                                <TextBlock Text="{l:T Cr2wJsonWindow.RecipeRun}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <WrapPanel VerticalAlignment="Bottom" Margin="0,0,12,0">
                                        <Button Style="{StaticResource Small}" Margin="0,6,6,0" Content="{l:T Cr2wJsonWindow.RecipeLoad}" Click="RecipeLoad_Click"
                                                ToolTip="{l:T Cr2wJsonWindow.RecipeLoadTip}" />
                                        <Button Style="{StaticResource Small}" Margin="0,6,6,0" Click="RecipePython_Click" ToolTip="{l:T Cr2wJsonWindow.RecipePythonTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" VerticalAlignment="Center" />
                                                <TextBlock Text="{l:T Cr2wJsonWindow.RecipePython}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Small}" Margin="0,6,6,0" Click="RecipeBatch_Click" ToolTip="{l:T Cr2wJsonWindow.RecipeBatchTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE756;" VerticalAlignment="Center" />
                                                <TextBlock Text="{l:T Cr2wJsonWindow.RecipeBatch}" Margin="8,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource Small}" Margin="0,6,6,0" Content="{l:T Cr2wJsonWindow.RecipeCopyCommand}" Click="RecipeCopyCommand_Click"
                                                ToolTip="{l:T Cr2wJsonWindow.RecipeCopyCommandTip}" />
                                        <Button Style="{StaticResource Small}" Margin="0,6,6,0" Content="{l:T Cr2wJsonWindow.RecipeDelete}" Click="RecipeDelete_Click" />
                                    </WrapPanel>
                                </DockPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="280" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <ListBox x:Name="RecipeList" ItemTemplate="{StaticResource RecipeRow}" ItemContainerStyle="{StaticResource WashItem}" SelectionChanged="RecipeList_SelectionChanged"
                                                 KeyDown="RecipeList_KeyDown" MouseDoubleClick="RecipeList_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                        <TextBlock x:Name="RecipesEmpty" Margin="14" Opacity="0.65" TextWrapping="Wrap" IsHitTestVisible="False"
                                                   Text="{l:T Cr2wJsonWindow.NoRecipesYet}" />
                                    </Grid>

                                    <TextBlock x:Name="RecipeNone" Grid.Column="1" Margin="18,4,0,0" Opacity="0.65" TextWrapping="Wrap"
                                               Text="{l:T Cr2wJsonWindow.PickRecipe}" />
                                    <DockPanel x:Name="RecipeDetails" Grid.Column="1" Margin="18,0,0,0" Visibility="Collapsed">
                                        <DockPanel DockPanel.Dock="Top">
                                            <TextBlock Text="{l:T Common.Name}" Style="{StaticResource Label}" />
                                            <TextBox x:Name="RecipeNameBox" LostKeyboardFocus="RecipeText_LostFocus" KeyDown="RecipeNameBox_KeyDown" />
                                        </DockPanel>
                                        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,0">
                                            <TextBlock Text="{l:T Cr2wJsonWindow.RecipeNotes}" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                            <TextBox x:Name="RecipeNotesBox" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="34" MaxHeight="80"
                                                     VerticalScrollBarVisibility="Auto" VerticalContentAlignment="Top" LostKeyboardFocus="RecipeText_LostFocus"
                                                     ToolTip="{l:T Cr2wJsonWindow.RecipeNotesTip}" />
                                        </DockPanel>
                                        <!-- the steps as text to read, not wrapped: it scrolls when a path or an edit is long -->
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBlock Text="{l:T Cr2wJsonWindow.RecipeSteps}" Style="{StaticResource Label}" VerticalAlignment="Top" Margin="0,6,0,0" />
                                            <TextBlock x:Name="RecipeProblemsText" DockPanel.Dock="Bottom" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                            <Border CornerRadius="4" BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                                    Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                                <ScrollViewer x:Name="RecipeStepsScroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                                    <TextBlock x:Name="RecipeStepsText" FontFamily="Cascadia Mono, Consolas" Margin="10,8" />
                                                </ScrollViewer>
                                            </Border>
                                        </DockPanel>
                                    </DockPanel>
                                </Grid>
                            </DockPanel>
                        </Border>

                        <GridSplitter Grid.Row="1" Height="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Small}" Margin="0" Content="{l:T Common.ShowExplorer}" Click="RecipeReveal_Click"
                                            ToolTip="{l:T Cr2wJsonWindow.ShowHighlightedResultsAll}" />
                                    <TextBlock Text="{l:T Cr2wJsonWindow.Results}" Style="{StaticResource Heading}" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center" Margin="16,0,12,0">
                                        <TextBlock x:Name="RecipeStatus" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar x:Name="RecipeProgress" Height="4" Margin="0,4,0,0" Visibility="Collapsed" />
                                    </StackPanel>
                                </DockPanel>
                                <ListBox x:Name="RecipeResults" ItemTemplate="{StaticResource ResultRow}" SelectionMode="Extended"
                                         MouseDoubleClick="Results_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </DockPanel>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
