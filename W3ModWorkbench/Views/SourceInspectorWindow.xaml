<Window x:Class="W3ModWorkbench.SourceInspectorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="{l:T SourceInspectorWindow.SourceInspector}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="880" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="WrapCellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="6,4" />
        </Style>
        <Style x:Key="ResultCell" TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Rectangle x:Name="Highlight" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- how strongly two files match, coloured by how bad it looks -->
        <Style x:Key="LevelText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Identical">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Renamed">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="NearCopy">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Large">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Partial">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="OriginalBar">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <ProgressBar Value="{Binding OriginalPercent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding OriginalText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="SuspectBar">
            <Grid Margin="6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="42" />
                </Grid.ColumnDefinitions>
                <ProgressBar Value="{Binding SuspectPercent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding SuspectText}" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>
        </DataTemplate>
        <Style x:Key="Dropping" TargetType="Border" BasedOn="{StaticResource Card}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="drop">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- title -->
            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{l:T SourceInspectorWindow.SourceInspector}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Opacity="0.65" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="{l:T SourceInspectorWindow.CompareTwoModsLoose}" />
            </StackPanel>

            <!-- the two sources -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border x:Name="OriginalCard" Style="{StaticResource Dropping}" Padding="14,10,14,12" AllowDrop="True"
                        DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE73E;" Foreground="{DynamicResource SystemFillColorSuccessBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:T SourceInspectorWindow.Original}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:T SourceInspectorWindow.ModYouBelieveCame}" FontWeight="Normal" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="OriginalBox" VerticalContentAlignment="Center" TextChanged="Path_Changed" />
                                <TextBlock x:Name="OriginalHint" Margin="10,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="{l:T SourceInspectorWindow.DropFolderHereBrowse}" />
                            </Grid>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="12,5" Click="Browse_Click" Tag="Original" ToolTip="{l:T SourceInspectorWindow.ChooseOriginalModsFolder}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T SourceInspectorWindow.Browse}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="OriginalInfo" Margin="0,8,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" Text=" " />
                    </StackPanel>
                </Border>

                <Button x:Name="SwapButton" Grid.Column="1" Margin="10,22,10,0" VerticalAlignment="Center" Width="36" Height="36" Padding="0"
                        Click="Swap_Click" ToolTip="{l:T SourceInspectorWindow.SwapOriginalSuspect}">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8AB;" FontSize="15" />
                </Button>

                <Border x:Name="SuspectCard" Grid.Column="2" Style="{StaticResource Dropping}" Padding="14,10,14,12" AllowDrop="True"
                        DragOver="Card_DragOver" DragLeave="Card_DragLeave" Drop="Card_Drop">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:T SourceInspectorWindow.Suspect}" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Caption}" Text="{l:T SourceInspectorWindow.ModYouWantCheck}" FontWeight="Normal" Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <Grid Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid>
                                <TextBox x:Name="SuspectBox" VerticalContentAlignment="Center" TextChanged="Path_Changed" />
                                <TextBlock x:Name="SuspectHint" Margin="10,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="{l:T SourceInspectorWindow.DropFolderHereBrowse}" />
                            </Grid>
                            <Button Grid.Column="1" Margin="6,0,0,0" Padding="12,5" Click="Browse_Click" Tag="Suspect" ToolTip="{l:T SourceInspectorWindow.ChooseSuspectModsFolder}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T SourceInspectorWindow.Browse}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <TextBlock x:Name="SuspectInfo" Margin="0,8,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" Text=" " />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- options and actions -->
            <DockPanel Grid.Row="2" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="ExportButton" Padding="12,6" Click="Export_Click" IsEnabled="False" ToolTip="{l:T SourceInspectorWindow.SaveReportShareKeep}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                            <TextBlock Margin="8,0,0,0" Text="{l:T SourceInspectorWindow.SaveReport}" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="8,2,0,0" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="CancelButton" Margin="8,0,0,0" Padding="14,6" Click="Cancel_Click" Visibility="Collapsed" Content="{l:T Common.Cancel}" />
                    <Button x:Name="AnalyseButton" Margin="8,0,0,0" Padding="18,6" Click="Analyse_Click" IsEnabled="False"
                            Style="{DynamicResource AccentButtonStyle}" ToolTip="{l:T SourceInspectorWindow.CompareTwoSourcesCtrl}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" />
                            <TextBlock Margin="8,0,0,0" Text="{l:T SourceInspectorWindow.Analyse}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="IgnoreGameCheck" MinWidth="0" Content="{l:T SourceInspectorWindow.IgnoreGamesOwnScripts}" IsChecked="True"
                              ToolTip="{l:T SourceInspectorWindow.ModsWrapReplaceGame}" />
                    <TextBlock x:Name="GameNote" Margin="10,0,0,0" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <!-- progress -->
            <Border x:Name="ProgressCard" Grid.Row="3" Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,10" Visibility="Collapsed">
                <StackPanel>
                    <DockPanel>
                        <TextBlock x:Name="PhaseText" FontWeight="SemiBold" />
                        <TextBlock x:Name="PhaseDetail" Margin="12,0,0,0" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                    <ProgressBar x:Name="Progress" Margin="0,8,0,0" Height="4" Maximum="100" />
                </StackPanel>
            </Border>

            <!-- before the first analysis -->
            <ScrollViewer x:Name="WelcomePanel" Grid.Row="4" VerticalScrollBarVisibility="Auto">
                <Border Style="{StaticResource Card}" Padding="22,18">
                    <StackPanel>
                        <TextBlock Text="{l:T SourceInspectorWindow.FindOutWhatReused}" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Margin="0,4,0,14" Opacity="0.7" TextWrapping="Wrap"
                                   Text="{l:T SourceInspectorWindow.PickOriginalModOne}" />
                        <UniformGrid Columns="3">
                            <StackPanel Margin="0,0,18,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE943;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{l:T SourceInspectorWindow.Scripts}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                                           Text="{l:T SourceInspectorWindow.LooseWsFilesCompiled}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8D2;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{l:T SourceInspectorWindow.CodingStyle}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                                           Text="{l:T SourceInspectorWindow.NamesEasyChangeHabits}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{l:T SourceInspectorWindow.MenusXML}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                                           Text="{l:T SourceInspectorWindow.ModMenusComparedElement}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7B8;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{l:T SourceInspectorWindow.BundlesFiles}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                                           Text="{l:T SourceInspectorWindow.EveryFileInsideEvery}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,18,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE71E;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{l:T SourceInspectorWindow.TelltaleDetails}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                                           Text="{l:T SourceInspectorWindow.CommentsMessagesClassFunction}" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE72E;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{l:T SourceInspectorWindow.GamesOwnCode}" FontWeight="SemiBold" Margin="8,0,0,0" />
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" Opacity="0.7" TextWrapping="Wrap"
                                           Text="{l:T SourceInspectorWindow.CodeGameAlreadyHas}" />
                            </StackPanel>
                        </UniformGrid>
                        <Border Background="{DynamicResource SubtleFillColorSecondaryBrush}" CornerRadius="6" Padding="12,9">
                            <TextBlock TextWrapping="Wrap" Opacity="0.8"
                                       Text="{l:T SourceInspectorWindow.HighScoreEvidenceNot}" />
                        </Border>
                    </StackPanel>
                </Border>
            </ScrollViewer>

            <!-- results -->
            <TabControl x:Name="ResultTabs" Grid.Row="4" Visibility="Collapsed" Padding="0">
                <TabItem Header="{l:T SourceInspectorWindow.Summary}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="400" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:T SourceInspectorWindow.HOWMuchShared}" />
                                        <TextBlock x:Name="HeadlineText" FontSize="52" FontWeight="SemiBold" Margin="0,2,0,0" />
                                        <TextBlock x:Name="VerdictTitle" FontSize="17" FontWeight="SemiBold" />
                                        <TextBlock x:Name="VerdictBody" Margin="0,4,0,14" TextWrapping="Wrap" Opacity="0.75" />
                                        <DockPanel>
                                            <TextBlock x:Name="OriginalGaugeText" DockPanel.Dock="Right" FontWeight="SemiBold" />
                                            <TextBlock Text="{l:T SourceInspectorWindow.OriginalFoundSuspect}" />
                                        </DockPanel>
                                        <ProgressBar x:Name="OriginalGauge" Height="8" Maximum="100" Margin="0,5,0,12" />
                                        <DockPanel>
                                            <TextBlock x:Name="SuspectGaugeText" DockPanel.Dock="Right" FontWeight="SemiBold" />
                                            <TextBlock Text="{l:T SourceInspectorWindow.SuspectMadeOriginal}" />
                                        </DockPanel>
                                        <ProgressBar x:Name="SuspectGauge" Height="8" Maximum="100" Margin="0,5,0,0" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T SourceInspectorWindow.KeyFindings}" />
                                        <ItemsControl x:Name="FindingsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,0,0,7">
                                                        <TextBlock DockPanel.Dock="Left" Text="&#x2022;" Width="16" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="20,16">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T SourceInspectorWindow.KindContent}" />
                                    <DataGrid x:Name="CategoryGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                                              SelectionMode="Single" SelectionUnit="FullRow" CanUserResizeRows="False" CanUserSortColumns="False"
                                              CellStyle="{StaticResource ResultCell}" IsHitTestVisible="True" Focusable="False" RowHeight="36">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{l:T SourceInspectorWindow.Content}" Binding="{Binding Name}" Width="210" ElementStyle="{StaticResource CellText}" />
                                            <DataGridTextColumn Header="{l:T SourceInspectorWindow.Original2}" Binding="{Binding OriginalFiles}" Width="80" ElementStyle="{StaticResource CellText}" />
                                            <DataGridTextColumn Header="{l:T SourceInspectorWindow.Suspect2}" Binding="{Binding SuspectFiles}" Width="80" ElementStyle="{StaticResource CellText}" />
                                            <DataGridTemplateColumn Header="{l:T SourceInspectorWindow.OriginalSuspect}" Width="190" CellTemplate="{StaticResource OriginalBar}" />
                                            <DataGridTemplateColumn Header="{l:T SourceInspectorWindow.SuspectOriginal}" Width="190" CellTemplate="{StaticResource SuspectBar}" />
                                            <DataGridTextColumn Header="{l:T SourceInspectorWindow.Detail}" Binding="{Binding Detail}" Width="*" ElementStyle="{StaticResource CellText}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock x:Name="GameNoteResult" Margin="0,10,0,0" Opacity="0.65" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <TextBlock Margin="2,12,2,12" Opacity="0.6" TextWrapping="Wrap"
                                       Text="{l:T SourceInspectorWindow.HighScoreEvidenceNot2}" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="{l:T SourceInspectorWindow.MatchingFiles}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1.1*" MinHeight="140" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="170" />
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="MatchCount" DockPanel.Dock="Right" Opacity="0.7" VerticalAlignment="Center" />
                            <ComboBox x:Name="KindFilter" DockPanel.Dock="Left" Width="170" SelectionChanged="Filter_Changed" />
                            <ComboBox x:Name="LevelFilter" DockPanel.Dock="Left" Width="170" Margin="8,0,0,0" SelectionChanged="Filter_Changed" />
                            <Grid Margin="8,0,12,0">
                                <TextBox x:Name="MatchSearch" Padding="30,6,8,6" VerticalContentAlignment="Center" TextChanged="MatchSearch_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="MatchSearchHint" Margin="32,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" Text="{l:T SourceInspectorWindow.FilterFileNamePath}" />
                            </Grid>
                        </DockPanel>

                        <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                            <DataGrid x:Name="MatchGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                                      SelectionMode="Single" SelectionUnit="FullRow" CanUserResizeRows="False" RowHeight="34"
                                      EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                      CellStyle="{StaticResource ResultCell}" SelectionChanged="MatchGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T SourceInspectorWindow.Match}" Binding="{Binding LevelText}" Width="120" ElementStyle="{StaticResource LevelText}" />
                                    <DataGridTextColumn Header="{l:T Common.Type}" Binding="{Binding KindText}" Width="90" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="{l:T SourceInspectorWindow.OriginalFile}" Binding="{Binding OriginalName}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTextColumn Header="{l:T SourceInspectorWindow.SuspectFile}" Binding="{Binding SuspectName}" Width="*" MinWidth="140" ElementStyle="{StaticResource CellText}" />
                                    <DataGridTemplateColumn Header="{l:T SourceInspectorWindow.OriginalSuspect}" Width="150" CellTemplate="{StaticResource OriginalBar}" />
                                    <DataGridTemplateColumn Header="{l:T SourceInspectorWindow.SuspectOriginal}" Width="150" CellTemplate="{StaticResource SuspectBar}" />
                                    <DataGridTextColumn Header="{l:T SourceInspectorWindow.WhatMatched}" Binding="{Binding Note}" Width="2*" MinWidth="160" ElementStyle="{StaticResource CellText}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <GridSplitter Grid.Row="2" Height="10" HorizontalAlignment="Stretch" Background="Transparent" ResizeDirection="Rows" />

                        <Border Grid.Row="3" Style="{StaticResource Card}" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel Margin="12,8,12,6">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock x:Name="DiffLegend" Opacity="0.65" VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <ComboBox x:Name="HighlightMode" Width="176" SelectionChanged="HighlightMode_Changed" SelectedIndex="0">
                                            <ComboBoxItem Content="{l:T SourceInspectorWindow.ShowSharedLines}" />
                                            <ComboBoxItem Content="{l:T SourceInspectorWindow.ShowDifferences}" />
                                        </ComboBox>
                                    </StackPanel>
                                    <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                               Text="{l:T SourceInspectorWindow.SelectMatchCompareTwo}" />
                                </DockPanel>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="1" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="LeftHeader" Style="{StaticResource Caption}" Margin="12,0,0,4" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="RightHeader" Grid.Column="2" Style="{StaticResource Caption}" Margin="12,0,0,4" TextTrimming="CharacterEllipsis" />
                                    <avalonEdit:TextEditor x:Name="LeftEditor" Grid.Row="1" IsReadOnly="True" ShowLineNumbers="True"
                                                           FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5"
                                                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <Rectangle Grid.Row="1" Grid.Column="1" Fill="{DynamicResource CardStrokeColorDefaultBrush}" />
                                    <avalonEdit:TextEditor x:Name="RightEditor" Grid.Row="1" Grid.Column="2" IsReadOnly="True" ShowLineNumbers="True"
                                                           FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="12.5"
                                                           HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                                           Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                           LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}" />
                                    <TextBlock x:Name="BinaryNote" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" TextWrapping="Wrap"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="30" TextAlignment="Center" Opacity="0.8"
                                               Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:T SourceInspectorWindow.SharedDetails}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock x:Name="EvidenceCount" DockPanel.Dock="Right" Opacity="0.7" VerticalAlignment="Center" />
                            <ComboBox x:Name="EvidenceFilter" DockPanel.Dock="Left" Width="220" SelectionChanged="EvidenceFilter_Changed" />
                            <TextBlock Margin="12,0,0,0" Opacity="0.65" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{l:T SourceInspectorWindow.CommentsMessagesNamesFunctions}" />
                        </DockPanel>
                        <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                            <Grid>
                                <DataGrid x:Name="EvidenceGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                                          SelectionMode="Extended" SelectionUnit="FullRow" CanUserResizeRows="False" RowHeight="34"
                                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                          CellStyle="{StaticResource ResultCell}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{l:T SourceInspectorWindow.CopyItem}" Click="CopyEvidence_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{l:T Common.Kind}" Binding="{Binding Category}" Width="150" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="{l:T SourceInspectorWindow.SharedItem}" Binding="{Binding Text}" Width="3*" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="{l:T SourceInspectorWindow.Original3}" Binding="{Binding InOriginal}" Width="2*" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="{l:T SourceInspectorWindow.Suspect3}" Binding="{Binding InSuspect}" Width="2*" ElementStyle="{StaticResource CellText}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="EvidenceEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65"
                                           Text="{l:T SourceInspectorWindow.NoCommentsNamesFunctions}" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:T SourceInspectorWindow.CodingStyle}">
                    <Grid Margin="0,12,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Style="{StaticResource Card}" Padding="20,14" Margin="0,0,0,12">
                            <DockPanel>
                                <TextBlock x:Name="StyleScore" DockPanel.Dock="Left" FontSize="36" FontWeight="SemiBold" Margin="0,0,20,0" VerticalAlignment="Center" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{l:T SourceInspectorWindow.HowAlikeScriptsWritten}" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StyleNote" TextWrapping="Wrap" Opacity="0.75" Margin="0,2,0,0" />
                                    <TextBlock TextWrapping="Wrap" Opacity="0.55" Margin="0,6,0,0"
                                               Text="{l:T SourceInspectorWindow.HabitsSurviveRenamingBut}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                            <Grid>
                                <DataGrid x:Name="StyleGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                                          SelectionMode="Single" SelectionUnit="FullRow" CanUserResizeRows="False" RowHeight="34"
                                          CellStyle="{StaticResource ResultCell}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{l:T SourceInspectorWindow.Habit}" Binding="{Binding Name}" Width="190" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="{l:T SourceInspectorWindow.Measured}" Binding="{Binding Habit}" Width="*" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="{l:T SourceInspectorWindow.Original2}" Binding="{Binding Original}" Width="130" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTextColumn Header="{l:T SourceInspectorWindow.Suspect2}" Binding="{Binding Suspect}" Width="130" ElementStyle="{StaticResource CellText}" />
                                        <DataGridTemplateColumn Header="{l:T SourceInspectorWindow.Alike}" Width="190" CellTemplate="{StaticResource OriginalBar}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock x:Name="StyleEmpty" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.65"
                                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" />
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{l:T SourceInspectorWindow.Sources}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,12,8,0">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Card}" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:T SourceInspectorWindow.Original}" />
                                        <TextBlock x:Name="OriginalPathText" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />
                                        <TextBlock x:Name="OriginalFacts" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8" />
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20,16">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Caption}" Text="{l:T SourceInspectorWindow.Suspect}" />
                                        <TextBlock x:Name="SuspectPathText" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" />
                                        <TextBlock x:Name="SuspectFacts" Margin="0,10,0,0" TextWrapping="Wrap" Opacity="0.8" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Margin="2,10,2,0" Opacity="0.6" TextWrapping="Wrap"
                                       Text="{l:T SourceInspectorWindow.FileDatesHintBest}" />
                            <Border x:Name="WarningsCard" Style="{StaticResource Card}" Padding="20,16" Margin="0,12,0,12" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T SourceInspectorWindow.FilesCouldNotRead}" />
                                    <ItemsControl x:Name="WarningsList">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,4" FontFamily="Cascadia Mono, Consolas" FontSize="12" Opacity="0.8" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <TextBlock x:Name="StatusText" Grid.Row="5" Margin="2,8,2,0" Opacity="0.75" TextTrimming="CharacterEllipsis" />
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
