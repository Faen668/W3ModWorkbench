<Window x:Class="W3ModWorkbench.TextureArrayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T TextureArrayWindow.TextureArray}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="820" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF3A3A3A"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#FF4A4A4A">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="14,12,14,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock x:Name="SlotsText" VerticalAlignment="Center" FontWeight="SemiBold" />
                <TextBlock Text="{l:T TextureArrayWindow.DoubleClickTextureOpen}" VerticalAlignment="Center" Margin="16,0,0,0" Opacity="0.6" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="OpenButton" Padding="12,5" Click="Open_Click" IsEnabled="False" ToolTip="{l:T TextureArrayWindow.OpenTexturePickedTexture}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T TextureArrayWindow.OpenTexture}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SavePngsButton" Margin="6,0,0,0" Padding="12,5" Click="SavePngs_Click" IsEnabled="False" ToolTip="{l:T TextureArrayWindow.SaveEveryTextureArray}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T TextureArrayWindow.SavePNGs}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveDdsButton" Margin="6,0,0,0" Padding="12,5" Click="SaveDds_Click" IsEnabled="False" ToolTip="{l:T TextureArrayWindow.SaveWholeArrayEvery}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T TextureArrayWindow.SaveDDS}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <!-- the textures in the array, as REDkit's texture array editor shows them -->
        <ListBox x:Name="Slices" Grid.Row="1" Margin="14,0,14,10" Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                 SelectionChanged="Slices_SelectionChanged" MouseDoubleClick="Slices_MouseDoubleClick" KeyDown="Slices_KeyDown">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Width="112" Margin="2,4">
                        <Border Width="104" Height="104" Background="{StaticResource Checker}" CornerRadius="4" ClipToBounds="True">
                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                        </Border>
                        <TextBlock Text="{Binding Name}" HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="360" MinWidth="220" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Border x:Name="Backdrop" Margin="16" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource Checker}">
                        <Image x:Name="Picture" Stretch="Uniform" />
                    </Border>
                    <TextBlock x:Name="BusyText" Text="{l:T TextureArrayWindow.ReadingTextures}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
                </Grid>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                        <TextBox x:Name="PropertySearch" Padding="30,5,8,5" TextChanged="PropertySearch_TextChanged"
                                 ToolTip="{l:T TextureArrayWindow.ShowOnlyPropertiesWhose}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock x:Name="PropertySearchPlaceholder" Text="{l:T Common.SearchProperties}" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="10,0,10,6" />
                    <local:PropertyListView x:Name="Properties" NameColumnWidth="190" TypeColumnWidth="0" LinkClicked="Properties_LinkClicked" />
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="InfoText" Grid.Row="3" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />

        <local:MessageCard x:Name="Message" Grid.RowSpan="4" IsModal="True" />
    </Grid>
</Window>
