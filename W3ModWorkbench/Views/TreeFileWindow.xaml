<Window x:Class="W3ModWorkbench.TreeFileWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T TreeFileWindow.Tree}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1400" Height="900" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition x:Name="SideColumn" Width="460" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition x:Name="TablesSplitRow" Height="0" />
                <RowDefinition x:Name="TablesRow" Height="0" />
            </Grid.RowDefinitions>

            <!-- the tree -->
            <Border Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="10,8,10,4">
                        <Button DockPanel.Dock="Right" Padding="10,5" Margin="6,0,0,4" Click="Fit_Click" ToolTip="{l:T TreeFileWindow.SeeAllFDouble}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" />
                                <TextBlock Margin="8,0,0,0" Text="{l:T Common.Fit}" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Padding="10,5" Margin="6,0,0,4" Click="FileProperties_Click" ToolTip="{l:T TreeFileWindow.ShowFilesOwnProperties}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" />
                                <TextBlock x:Name="FileButtonText" Margin="8,0,0,0" Text="{l:T Common.File}" />
                            </StackPanel>
                        </Button>
                        <ComboBox x:Name="FoldBox" DockPanel.Dock="Right" MinWidth="150" Margin="6,0,0,4" SelectionChanged="FoldBox_SelectionChanged"
                                  ToolTip="{l:T TreeFileWindow.FoldBranchesBelowDepth}" />
                        <Grid Margin="0,0,0,4">
                            <TextBox x:Name="SearchBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" KeyDown="SearchBox_KeyDown" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{l:T TreeFileWindow.FindNodesNameClass}" />
                            <TextBlock x:Name="MatchText" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Small}" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                    <local:BehTreeGraph x:Name="Graph" Grid.Row="1" Margin="1,0,1,0" NodeClicked="Graph_NodeClicked"
                                        ToolTip="{l:T TreeFileWindow.ClickNodeSeeProperties}" />
                    <ItemsControl x:Name="Legend" Grid.Row="2" Margin="12,4,12,8">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                                    <Border Width="10" Height="10" CornerRadius="2" Background="{Binding Brush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding Name}" Margin="6,0,0,0" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>

            <GridSplitter x:Name="TablesSplitter" Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />

            <!-- tables the file keeps beside its tree -->
            <Border x:Name="TablesCard" Grid.Row="2" Style="{StaticResource Card}" Visibility="Collapsed">
                <TabControl x:Name="Tables" Margin="6,4,6,6" />
            </Border>

            <GridSplitter Grid.Column="1" Grid.RowSpan="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- a preview the kind of file has (a job tree's animations), over the node picked -->
            <Grid Grid.Column="2" Grid.RowSpan="3">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="ExtraRow" Height="0" />
                    <RowDefinition x:Name="ExtraSplitRow" Height="0" />
                    <RowDefinition Height="*" MinHeight="160" />
                </Grid.RowDefinitions>
                <Border x:Name="ExtraCard" Style="{StaticResource Card}" Visibility="Collapsed">
                    <ContentControl x:Name="ExtraHost" Margin="8" />
                </Border>
                <GridSplitter x:Name="ExtraSplitter" Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" Visibility="Collapsed" />
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel Margin="12,10,8,8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="NodeTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{l:T TreeFileWindow.ClickNodeTree}" />
                        <TextBlock x:Name="NodeDetail" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <TextBlock x:Name="NodeComment" TextWrapping="Wrap" Margin="0,6,0,0" FontStyle="Italic" Visibility="Collapsed" />
                        <Grid Margin="0,10,0,0">
                            <TextBox x:Name="PropertySearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="PropertySearch_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="PropertySearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{l:T Common.FindPropertiesNameValue}" />
                        </Grid>
                    </StackPanel>
                    <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                    <local:PropertyListView x:Name="Properties" LinkClicked="Properties_LinkClicked" />
                </DockPanel>
            </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T TreeFileWindow.ReadingFile}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <DockPanel Grid.Row="1" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
