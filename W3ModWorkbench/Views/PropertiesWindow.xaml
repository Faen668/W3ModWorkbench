<Window x:Class="W3ModWorkbench.PropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T Common.Properties}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1180" Height="800" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <!-- list rows as tight as REDkit's, rather than the theme's tall ones -->
        <Style x:Key="CompactItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="16,12,14,10">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                <Button Padding="12,5" Click="Json_Click" ToolTip="{l:T PropertiesWindow.OpenWholeFileJson}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE943;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.OpenJson}" />
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,0" Padding="12,5" Click="CopyPath_Click" ToolTip="{l:T PropertiesWindow.CopyFilesGamePath}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.CopyPath}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="HeadingText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="KindText" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" MinWidth="180" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- every object in the file, under the one it belongs to, as REDkit's object list has them -->
            <Border Style="{StaticResource Card}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="14,10,8,4">
                        <Button DockPanel.Dock="Right" Padding="6,3" Margin="4,0,0,0" Background="Transparent" BorderThickness="0" Click="CollapseAll_Click"
                                ToolTip="{l:T PropertiesWindow.CollapseEverythingUnderResource}">
                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE70E;" />
                        </Button>
                        <Button DockPanel.Dock="Right" Padding="6,3" Background="Transparent" BorderThickness="0" Click="ExpandAll_Click" ToolTip="{l:T PropertiesWindow.ExpandEveryObject}">
                            <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE70D;" />
                        </Button>
                        <TextBlock x:Name="ObjectsTitle" FontWeight="SemiBold" Text="{l:T PropertiesWindow.Objects}" VerticalAlignment="Center" />
                    </DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,2,10,6">
                        <TextBox x:Name="ObjectSearch" Padding="30,4,8,4" TextChanged="ObjectSearch_TextChanged"
                                 ToolTip="{l:T PropertiesWindow.ShowOnlyObjectsWhose}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock x:Name="ObjectSearchPlaceholder" Text="{l:T PropertiesWindow.SearchObjects}" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <ListBox x:Name="ObjectList" ItemContainerStyle="{StaticResource CompactItem}" BorderThickness="0" Background="Transparent" Margin="6,0,6,6"
                             HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             VirtualizingPanel.IsVirtualizing="True" SelectionChanged="ObjectList_SelectionChanged" PreviewKeyDown="ObjectList_PreviewKeyDown">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="{Binding Indent}">
                                    <!-- the objects under it open and close here, as a tree's do -->
                                    <Button DockPanel.Dock="Left" Width="18" Padding="0" Margin="0,0,4,0" VerticalAlignment="Top" Background="Transparent" BorderThickness="0"
                                            Click="Expander_Click" Visibility="{Binding ExpanderVisibility}" Focusable="False">
                                        <TextBlock Style="{StaticResource IconText}" FontSize="9" Text="{Binding Glyph}" Margin="0,3,0,0" />
                                    </Button>
                                    <Border DockPanel.Dock="Left" Width="22" Visibility="{Binding SpacerVisibility}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding ClassName}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" ToolTip="{Binding ToolTip}" />
                                        <TextBlock Text="{Binding Detail}" FontSize="11.5" Opacity="0.65" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding DetailVisibility}" />
                                    </StackPanel>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                        <TextBox x:Name="PropertySearch" Padding="30,5,8,5" TextChanged="PropertySearch_TextChanged"
                                 ToolTip="{l:T PropertiesWindow.ShowOnlyPropertiesWhose}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                        <TextBlock x:Name="PropertySearchPlaceholder" Text="{l:T Common.SearchProperties}" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" />
                    </Grid>
                    <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="10,0,10,6" />
                    <TextBlock x:Name="ObjectTitle" DockPanel.Dock="Top" Margin="14,4,12,4" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <Grid>
                        <local:PropertyListView x:Name="Properties" NameColumnWidth="230" LinkClicked="Properties_LinkClicked" />
                        <TextBlock x:Name="BusyText" Text="{l:T PropertiesWindow.ReadingFile}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" TextWrapping="Wrap" Margin="20" />
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <local:MessageCard x:Name="Message" Grid.RowSpan="3" IsModal="True" />
    </Grid>
</Window>
