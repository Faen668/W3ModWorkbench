<Window x:Class="W3ModWorkbench.SoundWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="Sound" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="980" Height="720" MinWidth="640" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0,6,0" />
        </Style>
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <!-- what it is -->
            <StackPanel DockPanel.Dock="Top" Margin="2,0,0,10">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,3,0,0" />
            </StackPanel>

            <!-- the sound, to play -->
            <Border DockPanel.Dock="Top" Style="{StaticResource Card}">
                <DockPanel Margin="10,8,10,8">
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="PlayButton" Padding="12,4" Click="PlayButton_Click" ToolTip="Play or pause (Space)">
                            <TextBlock x:Name="PlayIcon" Style="{StaticResource IconText}" Text="&#xE768;" />
                        </Button>
                        <Button Padding="10,4" Margin="6,0,0,0" Click="StopButton_Click" ToolTip="Stop, back to the start (Home)">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE71A;" />
                        </Button>
                        <TextBlock x:Name="TimeText" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Consolas" MinWidth="130" />
                        <CheckBox x:Name="LoopCheck" Content="Loop" MinWidth="0" Margin="8,0,0,0" VerticalAlignment="Center" Click="LoopCheck_Click"
                                  ToolTip="Play it again from the start when it ends (L)" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE767;" Margin="16,0,6,0" Opacity="0.7" />
                        <Slider x:Name="VolumeSlider" Width="110" Minimum="0" Maximum="1" Value="0.8" VerticalAlignment="Center" ValueChanged="VolumeSlider_ValueChanged" ToolTip="Volume" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="WavButton" Padding="10,4" Click="WavButton_Click" ToolTip="Save the sound as a WAV file anything can play">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" FontSize="12" Margin="0,0,6,0" />
                                    <TextBlock Text="Save as WAV" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="WemButton" Padding="10,4" Margin="6,0,0,0" Click="WemButton_Click" ToolTip="Save the sound as the game keeps it, a Wwise .wem" Content="Save .wem" />
                            <Button x:Name="CopyButton" Padding="10,4" Margin="6,0,0,0" Click="CopyButton_Click" ToolTip="Copy its ID (Ctrl+C)" Content="Copy ID" />
                        </StackPanel>
                    </DockPanel>
                    <Grid Height="170">
                        <local:Waveform x:Name="Wave" Seek="Wave_Seek" />
                        <TextBlock x:Name="WaveMessage" HorizontalAlignment="Center" VerticalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"
                                   MaxWidth="560" Opacity="0.8" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>

            <!-- a voice line's words -->
            <Border x:Name="SubtitleCard" DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,8,0,0" Visibility="Collapsed">
                <DockPanel Margin="12,8,12,10">
                    <DockPanel DockPanel.Dock="Top">
                        <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" MinWidth="90" SelectionChanged="LanguageBox_SelectionChanged"
                                  ToolTip="The language the words are shown in: the line's own, or another's" />
                        <TextBlock Text="Subtitle" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="SpeakerText" Style="{StaticResource Small}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock x:Name="SubtitleText" DockPanel.Dock="Top" FontSize="16" TextWrapping="Wrap" Margin="0,8,0,4" />
                    <TextBlock x:Name="LineText" Style="{StaticResource Small}" TextWrapping="Wrap" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,8,0,0">
                <TabControl x:Name="Tabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                    <TabItem x:Name="SoundsTab" Header="Sounds">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="SoundsNote" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,6" />
                            <DataGrid x:Name="SoundGrid" Style="{StaticResource ViewerGrid}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                      GridLinesVisibility="None" CanUserSortColumns="True" SelectionChanged="SoundGrid_SelectionChanged"
                                      ToolTip="Click a sound to play it; click a heading to sort by it">
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy ID" Click="CopySoundId_Click" />
                                        <MenuItem Header="Open in its own window" Click="OpenSound_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Sound" Binding="{Binding Id}" />
                                    <DataGridTextColumn Header="Kept" Binding="{Binding Kept}" />
                                    <DataGridTextColumn Header="Played by" Binding="{Binding Kind}" />
                                    <DataGridTextColumn Header="Codec" Binding="{Binding Codec}" />
                                    <DataGridTextColumn Header="Channels" Binding="{Binding Channels}" ElementStyle="{StaticResource Number}" />
                                    <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" SortMemberPath="Length" ElementStyle="{StaticResource Number}" />
                                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" ElementStyle="{StaticResource Number}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="DetailsTab" Header="Details">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ItemsControl x:Name="DetailList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Opacity="0.75" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem x:Name="BanksTab" Header="Played by">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="BanksNote" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,6" />
                            <DataGrid x:Name="BankGrid" Style="{StaticResource ViewerGrid}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                      GridLinesVisibility="None" MouseDoubleClick="BankGrid_MouseDoubleClick" ToolTip="Double-click a bank to open it">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Bank" Binding="{Binding Bank}" Width="*" />
                                    <DataGridTextColumn Header="Object" Binding="{Binding Object}" />
                                    <DataGridTextColumn Header="As" Binding="{Binding Kind}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem x:Name="ObjectsTab" Header="Objects">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ItemsControl x:Name="ObjectList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,2,0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" Opacity="0.75" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontFamily="Consolas" FontSize="13" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </DockPanel>

        <TextBlock x:Name="BusyText" Text="Reading the sound…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
