<Window x:Class="W3ModWorkbench.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:vm="clr-namespace:W3ModWorkbench.ViewModels"
        Title="{l:T Common.Preview2}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1000" Height="760" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <Grid>
    <Grid.RowDefinitions>
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
        <ColumnDefinition x:Name="BenchColumn" Width="0" />
        <ColumnDefinition x:Name="BenchSplitterColumn" Width="0" />
        <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- Script Bench: the project's scripts, the game's and the installed mods' -->
    <DockPanel x:Name="BenchPanel" Visibility="Collapsed" Margin="12,12,0,14">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button DockPanel.Dock="Right" Click="BenchHide_Click" Padding="8,5" Margin="4,0,0,0" ToolTip="{l:T PreviewWindow.HideScriptsPane}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE89F;" VerticalAlignment="Center" />
            </Button>
            <Button DockPanel.Dock="Right" Click="BenchCollapse_Click" Padding="8,5" Margin="4,0,0,0" ToolTip="{l:T PreviewWindow.CollapseEveryFolder}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C5;" VerticalAlignment="Center" />
            </Button>
            <Button DockPanel.Dock="Right" Click="BenchLocate_Click" Padding="8,5" Margin="4,0,0,0" ToolTip="{l:T PreviewWindow.ShowFileFrontTree}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81D;" VerticalAlignment="Center" />
            </Button>
            <Button DockPanel.Dock="Right" Click="BenchRefresh_Click" Padding="8,5" ToolTip="{l:T PreviewWindow.ReadScriptsAgain}">
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" VerticalAlignment="Center" />
            </Button>
            <Grid Margin="0,0,4,0">
                <TextBox x:Name="BenchFilter" TextChanged="BenchFilter_TextChanged" PreviewKeyDown="BenchFilter_PreviewKeyDown"
                         ToolTip="{l:T PreviewWindow.ShowOnlyScriptsWhose}" />
                <TextBlock Text="{l:T PreviewWindow.FilterScripts}" IsHitTestVisible="False" Margin="11,0,0,0" VerticalAlignment="Center" Opacity="0.5">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=BenchFilter}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
        <!-- naming a new script or folder, or renaming one -->
        <Border x:Name="BenchNameBar" DockPanel.Dock="Top" Visibility="Collapsed" Margin="0,0,0,8" Padding="10,8" CornerRadius="4"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
            <StackPanel>
                <TextBlock x:Name="BenchNameLabel" TextWrapping="Wrap" Margin="0,0,0,6" />
                <TextBox x:Name="BenchNameBox" PreviewKeyDown="BenchNameBox_PreviewKeyDown" />
                <TextBlock x:Name="BenchNameProblem" Visibility="Collapsed" Margin="0,6,0,0" TextWrapping="Wrap"
                           Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                <TextBlock Margin="0,6,0,0" Opacity="0.6" FontSize="11" Text="{l:T PreviewWindow.EnterAcceptEscCancel}" />
            </StackPanel>
        </Border>
        <TreeView x:Name="BenchTree" MouseDoubleClick="BenchTree_MouseDoubleClick" PreviewKeyDown="BenchTree_PreviewKeyDown"
                  ContextMenuOpening="BenchTree_ContextMenuOpening" PreviewMouseRightButtonDown="BenchTree_PreviewMouseRightButtonDown"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Standard">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <Setter Property="ToolTip" Value="{Binding ToolTip}" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.ItemTemplate>
                <HierarchicalDataTemplate DataType="{x:Type vm:BenchNode}" ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="Icon" FontFamily="{StaticResource IconFont}" Text="{Binding Glyph}" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="NameText" Text="{Binding Name}" VerticalAlignment="Center" />
                        <Border x:Name="BadgeBorder" Margin="7,0,0,0" CornerRadius="3" Padding="5,0,5,1" VerticalAlignment="Center"
                                Background="{DynamicResource SystemFillColorCautionBackgroundBrush}">
                            <TextBlock Text="{Binding Badge}" FontSize="10" FontWeight="Bold" />
                        </Border>
                        <TextBlock Text="{Binding Detail, StringFormat='  {0}'}" Opacity="0.6" VerticalAlignment="Center" />
                    </StackPanel>
                    <HierarchicalDataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Badge}" Value="{x:Null}">
                            <Setter TargetName="BadgeBorder" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsHeading}" Value="True">
                            <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsNote}" Value="True">
                            <Setter TargetName="NameText" Property="Opacity" Value="0.65" />
                            <Setter TargetName="NameText" Property="FontStyle" Value="Italic" />
                        </DataTrigger>
                    </HierarchicalDataTemplate.Triggers>
                </HierarchicalDataTemplate>
            </TreeView.ItemTemplate>
            <TreeView.ContextMenu>
                <ContextMenu x:Name="BenchMenu" />
            </TreeView.ContextMenu>
        </TreeView>
    </DockPanel>
    <!-- the tree folded away: a thin strip down the window's edge, all of it the button that slides it back out -->
    <Button x:Name="BenchShowButton" Visibility="Collapsed" Margin="0,12,0,14" Click="BenchShow_Click" Cursor="Hand"
            ToolTip="{l:T PreviewWindow.ShowScriptsPane}" Focusable="False">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Strip" CornerRadius="0,4,4,0" Background="Transparent">
                    <TextBlock x:Name="Arrow" FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="10"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Strip" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                        <Setter TargetName="Arrow" Property="Opacity" Value="1" />
                        <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Strip" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
    <GridSplitter x:Name="BenchSplitter" Grid.Column="1" Width="10" Visibility="Collapsed" HorizontalAlignment="Stretch"
                  ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" Background="Transparent" Focusable="False" />

    <Grid Grid.Column="2" Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" MinHeight="120" />
            <RowDefinition x:Name="ResultsSplitterRow" Height="0" />
            <RowDefinition x:Name="ResultsRow" Height="0" />
        </Grid.RowDefinitions>

        <!-- the file in the tab in use -->
        <DockPanel Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BackButton" Click="Back_Click" ToolTip="{l:T PreviewWindow.BackWhereYouJumped}" Padding="10,6">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="ForwardButton" Margin="4,0,0,0" Click="Forward_Click" ToolTip="{l:T PreviewWindow.ForwardAgainAltRight}" Padding="10,6">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72A;" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="HistoryButton" Margin="4,0,12,0" Click="History_Click" ToolTip="{l:T PreviewWindow.PlacesYouJumped}" Padding="10,6">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE81C;" VerticalAlignment="Center" />
                </Button>
                <!-- the commands that otherwise only have keys -->
                <Button x:Name="GoToSymbolButton" Click="GoToSymbol_Click" Padding="10,6" ToolTipService.ShowOnDisabled="True"
                        ToolTip="{l:T PreviewWindow.GoSymbolAnyClass}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8FD;" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="FindInFilesButton" Margin="4,0,0,0" Click="FindInFiles_Click" Padding="10,6"
                        ToolTip="{l:T PreviewWindow.FindFilesCtrlShift}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="SnippetButton" Margin="4,0,0,0" Click="Snippet_Click" Padding="10,6" ToolTipService.ShowOnDisabled="True"
                        ToolTip="{l:T PreviewWindow.InsertSnippetCommonWitcherScript}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" VerticalAlignment="Center" />
                </Button>
                <Button x:Name="StubButton" Margin="4,0,0,0" Click="Stub_Click" Padding="10,6"
                        ToolTip="{l:T PreviewWindow.StubGeneratorWriteWrap}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" VerticalAlignment="Center" />
                </Button>
                <ToggleButton x:Name="HintsButton" Margin="4,0,0,0" Click="Hints_Click" Padding="10,6">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8EC;" VerticalAlignment="Center" />
                </ToggleButton>
                <Button x:Name="BuildButton" Margin="4,0,0,0" Click="Build_Click" Padding="10,6" ToolTipService.ShowOnDisabled="True"
                        ToolTip="{l:T PreviewWindow.BuildModCtrlShift}">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE90F;" VerticalAlignment="Center" />
                </Button>
                <Rectangle x:Name="ScriptToolsDivider" Width="1" Margin="12,6" Fill="{DynamicResource DividerStrokeColorDefaultBrush}" />
                <Button x:Name="SplitButton" Click="Split_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="SplitRightItem" Header="{l:T PreviewWindow.SplitSideSide}" IsCheckable="True" Click="SplitRight_Click">
                                <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE90D;" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                            <MenuItem x:Name="SplitDownItem" Header="{l:T PreviewWindow.SplitTopBottom}" IsCheckable="True" Click="SplitDown_Click">
                                <MenuItem.Icon><TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE90E;" FontSize="14" /></MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SplitIcon" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SplitText" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="EditButton" Margin="6,0,0,0" Click="Edit_Click" Visibility="Collapsed"
                        ToolTip="{l:T PreviewWindow.DecompiledScriptsReadOnly}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70F;" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T PreviewWindow.EditProject}" />
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,0" Click="Copy_Click" ToolTip="{l:T PreviewWindow.CopyWholeText}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.Copy}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveButton" Margin="6,0,0,0" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}"
                        ToolTip="{l:T PreviewWindow.SaveFileCtrl}" ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" VerticalAlignment="Center" />
                        <TextBlock x:Name="SaveText" Margin="8,0,0,0" Text="{l:T Common.Save2}" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <DockPanel>
                    <Border x:Name="ProjectBadge" DockPanel.Dock="Left" Visibility="Collapsed" CornerRadius="3" Padding="6,1,6,2" Margin="0,0,8,0"
                            VerticalAlignment="Center" Background="{DynamicResource AccentFillColorDefaultBrush}">
                        <TextBlock x:Name="ProjectBadgeText" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </DockPanel>
                <TextBlock x:Name="DetailText" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- one group of tabs, or two when split -->
        <Grid x:Name="PaneGrid" Grid.Row="1" />
        <!-- Script Bench with no tab open -->
        <StackPanel x:Name="BenchEmpty" Grid.Row="1" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="460">
            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE943;" FontSize="40" Opacity="0.35" HorizontalAlignment="Center" />
            <TextBlock Margin="0,14,0,0" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Text="{l:T PreviewWindow.OpenScriptTree}" />
            <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.7"
                       Text="{l:T PreviewWindow.YourModsScriptsCan}" />
            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.55" FontSize="12"
                       Text="{l:T PreviewWindow.CtrlTGoesAny}" />
        </StackPanel>

        <!-- references, changes, the type hierarchy and find in files, under the files -->
        <GridSplitter x:Name="ResultsSplitter" Grid.Row="2" Height="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                      ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" Background="Transparent" Focusable="False" Visibility="Collapsed" />
        <local:ResultsPanel x:Name="Results" Grid.Row="3" Visibility="Collapsed" />

        <!-- go to symbol, the outline and the jump history -->
        <local:QuickPick x:Name="Picker" Grid.Row="0" Grid.RowSpan="4" Margin="0,46,0,0" />
    </Grid>

    <!-- Script Bench: what compiling reads, and with what -->
    <Border x:Name="BenchStatus" Grid.Row="1" Grid.ColumnSpan="3" Visibility="Collapsed" Padding="14,6"
            Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
        <DockPanel>
            <Button x:Name="BenchCompileButton" DockPanel.Dock="Right" Click="BenchCompile_Click" Padding="10,4" ToolTipService.ShowOnDisabled="True"
                    ToolTip="{l:T PreviewWindow.CompileProjectsScriptsCheck}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE9F5;" VerticalAlignment="Center" />
                    <TextBlock Margin="8,0,0,0" Text="{l:T PreviewWindow.Compile}" />
                </StackPanel>
            </Button>
            <!-- what checking as you type found, a click from the list of it -->
            <Button x:Name="ProblemsButton" DockPanel.Dock="Right" Click="Problems_Click" Padding="10,4" Margin="0,0,8,0" Visibility="Collapsed">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="ProblemsIcon" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProblemsText" Margin="8,0,0,0" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="BenchStatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
        </DockPanel>
    </Border>

    <local:MessageCard x:Name="BenchMessage" Grid.RowSpan="2" Grid.ColumnSpan="3" IsModal="True" />
    </Grid>
</Window>
