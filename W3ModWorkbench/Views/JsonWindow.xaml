<Window x:Class="W3ModWorkbench.JsonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
        Title="JSON" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1400" Height="820" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="SearchIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="SearchToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- AvalonEdit's search bar, restyled to match the Fluent theme -->
        <Style TargetType="search:SearchPanel">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type search:SearchPanel}">
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,18,0" Padding="6" Cursor="Arrow"
                                CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Name="PART_searchTextBox" Width="230" VerticalContentAlignment="Center"
                                         Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                <ToggleButton Style="{StaticResource SearchToggle}" Content="Aa" ToolTip="Match case"
                                              IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}" Margin="6,0,0,0" />
                                <ToggleButton Style="{StaticResource SearchToggle}" Content="ab" ToolTip="Whole words only"
                                              IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ToggleButton Style="{StaticResource SearchToggle}" Content=".*" ToolTip="Regular expression"
                                              IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Button Style="{StaticResource SearchIconButton}" Command="search:SearchCommands.FindPrevious" ToolTip="Previous match (Shift+F3)" Margin="8,0,0,0">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource SearchIconButton}" Command="search:SearchCommands.FindNext" ToolTip="Next match (F3)">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource SearchIconButton}" Command="search:SearchCommands.CloseSearchPanel" ToolTip="Close (Esc)">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="11" />
                                </Button>
                                <!-- AvalonEdit looks this part up; the options live in the toggles instead -->
                                <Popup Name="PART_dropdownPopup" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- the file, and what can be done with it -->
            <DockPanel Margin="0,0,0,10" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <ToggleButton x:Name="OutlineToggle" Margin="0,0,6,0" Click="OutlineToggle_Click" ToolTip="Show or hide the outline of the file's objects and lists (Ctrl+Shift+O)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8FD;" />
                            <TextBlock Margin="8,0,0,0" Text="Outline" />
                        </StackPanel>
                    </ToggleButton>
                    <Button x:Name="EmbeddedButton" Margin="0,0,6,0" Click="Embedded_Click" IsEnabled="False"
                            ToolTip="Put the cursor on a buffer that holds a whole CR2W file (one starting &quot;Q1IyV…&quot;) to open it in a window of its own; saving there writes it back here (Ctrl+E)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" />
                            <TextBlock Margin="8,0,0,0" Text="Open embedded file" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="FormatButton" Margin="0,0,6,0" Click="Format_Click" ToolTip="Indent the JSON, with small objects and lists kept on one line (Ctrl+Shift+F)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8E3;" />
                            <TextBlock Margin="8,0,0,0" Text="Format" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveCr2wButton" Margin="0,0,6,0" Click="SaveCr2w_Click" Visibility="Collapsed"
                            ToolTip="Write the game file this JSON was converted from, such as name.env from name.env.json">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8AB;" />
                            <TextBlock x:Name="SaveCr2wText" Margin="8,0,0,0" Text="Save as CR2W" />
                        </StackPanel>
                    </Button>
                    <Button Click="SaveAs_Click" ToolTip="Save as a file somewhere else (Ctrl+Shift+S)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE792;" />
                            <TextBlock Margin="8,0,0,0" Text="Save as" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SaveButton" Margin="6,0,0,0" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                            <TextBlock Margin="8,0,0,0" Text="Save" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="DetailText" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition x:Name="OutlineSplitterColumn" Width="0" />
                    <ColumnDefinition x:Name="OutlineColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="0,6,0,0" ClipToBounds="True">
                    <AdornerDecorator>
                        <avalonEdit:TextEditor x:Name="Editor" ShowLineNumbers="True"
                                               FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                                               HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                               Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}" />
                    </AdornerDecorator>
                </Border>

                <GridSplitter x:Name="OutlineSplitter" Grid.Column="1" Width="6" HorizontalAlignment="Center" Background="Transparent" Focusable="False"
                              Visibility="Collapsed" DragCompleted="OutlineSplitter_DragCompleted" />
                <Border x:Name="OutlineHost" Grid.Column="2" Style="{StaticResource Card}" Padding="0,8,0,0" ClipToBounds="True" Visibility="Collapsed">
                    <local:OutlinePanel x:Name="Outline" />
                </Border>
            </Grid>

            <DockPanel Grid.Row="2" Margin="2,8,2,0">
                <TextBlock x:Name="PositionText" DockPanel.Dock="Right" Opacity="0.65" Margin="12,0,0,0" />
                <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" MouseLeftButtonUp="Status_Click" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
