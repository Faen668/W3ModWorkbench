<Window x:Class="W3ModWorkbench.LoadOrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T LoadOrderWindow.LoadOrderAnalyser}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <!-- the severity icon, coloured by how bad it is -->
        <Style x:Key="SeverityIcon" TargetType="TextBlock" BasedOn="{StaticResource IconText}">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Text" Value="&#xE946;" />
            <Setter Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Severity}" Value="Error">
                    <Setter Property="Text" Value="&#xEA39;" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                    <Setter Property="Text" Value="&#xE7BA;" />
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- list rows: a faint wash of the accent when picked, not a solid block -->
        <Style TargetType="ListBoxItem">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Rectangle x:Name="Wash" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <Rectangle x:Name="Bar" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" Width="3" HorizontalAlignment="Left" Margin="0,6" RadiusX="1.5" RadiusY="1.5" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.07" /></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Wash" Property="Opacity" Value="0.14" />
                                <Setter TargetName="Bar" Property="Opacity" Value="0.8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- filter toggles: quiet outline, a faint wash when on -->
        <Style TargetType="ToggleButton">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Box" CornerRadius="4" BorderThickness="1" Padding="{TemplateBinding Padding}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="Transparent">
                            <Grid>
                                <Rectangle x:Name="Wash" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" RadiusX="3" RadiusY="3" Margin="-10,-5" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Wash" Property="Opacity" Value="0.16" /></Trigger>
                            <Trigger Property="IsChecked" Value="False"><Setter Property="Opacity" Value="0.6" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CountBadge" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{l:T LoadOrderWindow.LoadOrderAnalyser}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Opacity="0.65" Margin="0,2,0,0" TextWrapping="Wrap"
                           Text="{l:T LoadOrderWindow.ReadsEveryInstalledMod}" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <Button x:Name="AnalyseButton" DockPanel.Dock="Right" Padding="14,6" Margin="8,0,0,0" Click="Analyse_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" />
                        <TextBlock x:Name="AnalyseLabel" Margin="8,0,0,0" Text="{l:T LoadOrderWindow.Analyse}" />
                    </StackPanel>
                </Button>
                <Button x:Name="CheckButton" DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Click="Check_Click" ToolTip="{l:T LoadOrderWindow.CheckTip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE896;" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T LoadOrderWindow.CheckMod}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="10" Margin="8,1,0,0" />
                    </StackPanel>
                </Button>
                <Button DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Content="{l:T Common.Browse}" Click="Browse_Click" />
                <CheckBox x:Name="DlcCheck" DockPanel.Dock="Right" Content="{l:T LoadOrderWindow.IncludeDLC}" MinWidth="0" Margin="12,0,0,0" IsChecked="True" VerticalAlignment="Center"
                          ToolTip="{l:T LoadOrderWindow.ModsInstalledDLCDlc}" />
                <Grid>
                    <TextBox x:Name="FolderBox" Padding="8,6" VerticalContentAlignment="Center" TextChanged="FolderBox_TextChanged" />
                    <TextBlock x:Name="FolderHint" Margin="11,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{l:T LoadOrderWindow.GamesModsFolderE}" />
                </Grid>
            </DockPanel>

            <!-- a mod being checked before it's installed -->
            <Border x:Name="CandidateBar" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="10,4" Margin="12,0,0,0" VerticalAlignment="Center" Content="{l:T LoadOrderWindow.StopChecking}" Click="StopChecking_Click"
                            ToolTip="{l:T LoadOrderWindow.StopCheckingTip}" />
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource IconText}" Text="&#xE896;" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="CandidateText" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <!-- the mods, in load order -->
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Caption}" Margin="14,10,14,6"
                                   Text="{l:T LoadOrderWindow.LoadOrderFirstHighest}" />
                        <ListBox x:Name="ModList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0" SelectionChanged="ModList_SelectionChanged"
                                 SelectionMode="Extended" ToolTip="{l:T LoadOrderWindow.PickSeveralTip}" ToolTipService.InitialShowDelay="1500"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ModItem}">
                                    <Grid Margin="2,3" Opacity="{Binding Opacity}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="30" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Order}" Opacity="0.55" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Tooltip}" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource CountBadge}" Text="{Binding Problems}" Visibility="{Binding ProblemsVisibility}"
                                                       Foreground="{DynamicResource SystemFillColorCriticalBrush}" ToolTip="{l:T Common.Problems}" />
                                            <TextBlock Style="{StaticResource CountBadge}" Text="{Binding Warnings}" Visibility="{Binding WarningsVisibility}"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}" ToolTip="{l:T LoadOrderWindow.Warnings}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" Focusable="False" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.2*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <!-- filters -->
                    <DockPanel Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <ToggleButton x:Name="ProblemsToggle" IsChecked="True" Click="Filter_Changed" ToolTip="{l:T LoadOrderWindow.ThingsWillBreakOne}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xEA39;" Foreground="{DynamicResource SystemFillColorCriticalBrush}" />
                                    <TextBlock x:Name="ProblemsText" Margin="6,0,0,0" Text="{l:T Common.Problems}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="WarningsToggle" IsChecked="True" Margin="6,0,0,0" Click="Filter_Changed" ToolTip="{l:T LoadOrderWindow.ThingsMayBreakDepending}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                                    <TextBlock x:Name="WarningsText" Margin="6,0,0,0" Text="{l:T LoadOrderWindow.Warnings}" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="NotesToggle" IsChecked="False" Margin="6,0,0,0" Click="Filter_Changed" ToolTip="{l:T LoadOrderWindow.GoodKnowButNot}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                                    <TextBlock x:Name="NotesText" Margin="6,0,0,0" Text="{l:T LoadOrderWindow.Notes}" />
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <Button x:Name="ClearModButton" DockPanel.Dock="Right" Padding="10,5" Margin="8,0,0,0" Content="{l:T LoadOrderWindow.AllMods}" Click="ClearMod_Click" Visibility="Collapsed"
                                ToolTip="{l:T LoadOrderWindow.ShowFindingsEveryMod}" />
                        <ComboBox x:Name="CategoryFilter" DockPanel.Dock="Right" Width="170" Margin="8,0,0,0" SelectionChanged="Filter_Changed" />
                        <Grid Margin="8,0,0,0">
                            <TextBox x:Name="SearchBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchHint" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" Text="{l:T LoadOrderWindow.SearchFindingsCtrlF}" />
                        </Grid>
                    </DockPanel>

                    <!-- findings -->
                    <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                        <Grid>
                            <ListBox x:Name="FindingList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0" SelectionChanged="FindingList_SelectionChanged"
                                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type local:FindingItem}">
                                        <Grid Margin="2,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SeverityIcon}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding WinnerText}" Visibility="{Binding WinnerVisibility}" FontSize="12" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                <TextBlock Text="{Binding Caption}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" ToolTip="{Binding Caption}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" MaxWidth="420">
                                <TextBlock x:Name="EmptyTitle" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                                <TextBlock x:Name="EmptyText" Opacity="0.65" Margin="0,4,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Row="2" Height="8" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent" Focusable="False" />

                    <!-- the picked finding -->
                    <Border Grid.Row="3" Style="{StaticResource Card}" Padding="16,12" ClipToBounds="True">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="DetailPanel" Visibility="Collapsed" Margin="0,0,14,0">
                                <TextBlock x:Name="DetailTitle" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="DetailMods" Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap" />
                                <Border x:Name="DetailWinner" Visibility="Collapsed" Margin="0,10,0,0" Padding="12,8" CornerRadius="6" HorizontalAlignment="Left"
                                        BorderThickness="1" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="{l:T LoadOrderWindow.Winner}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                        <Run x:Name="DetailWinnerName" FontWeight="SemiBold" />
                                        <Run x:Name="DetailWinnerWhy" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </TextBlock>
                                </Border>
                                <TextBlock x:Name="DetailSummary" Margin="0,10,0,0" TextWrapping="Wrap" />
                                <TextBlock x:Name="ItemsCaption" Style="{StaticResource Caption}" Margin="0,12,0,4" Text="{l:T LoadOrderWindow.Details}" />
                                <TextBox x:Name="DetailItems" IsReadOnly="True" TextWrapping="NoWrap" FontFamily="Cascadia Mono, Consolas" FontSize="12.5"
                                         MaxHeight="190" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"
                                         Background="Transparent" BorderThickness="0" Padding="0,0,0,14" />
                                <TextBlock Style="{StaticResource Caption}" Margin="0,12,0,4" Text="{l:T LoadOrderWindow.WhatDO}" />
                                <TextBlock x:Name="DetailAdvice" TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <DockPanel Grid.Row="4" Margin="2,10,2,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MergerButton" Padding="12,6" Margin="0,0,8,0" Content="{l:T LoadOrderWindow.OpenScriptMerger}" Click="Merger_Click"
                            ToolTip="{l:T LoadOrderWindow.StartScriptMergerRemastered}" />
                    <Button x:Name="OpenFolderButton" Padding="12,6" Margin="0,0,8,0" Content="{l:T LoadOrderWindow.OpenModFolder}" Click="OpenFolder_Click" IsEnabled="False" />
                    <Button x:Name="ExportButton" Padding="12,6" Click="Export_Click" IsEnabled="False" ToolTip="{l:T LoadOrderWindow.SaveWholeReportMarkdown}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                            <TextBlock Margin="8,0,0,0" Text="{l:T LoadOrderWindow.SaveReport}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="StatusText" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
