<Window x:Class="W3ModWorkbench.SimplexTreeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T SimplexTreeWindow.SimplexTree}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1400" Height="900" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- compact tabs, as the scene viewer's, so every tab fits in a row -->
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <!-- what's in a tab takes its text colour from the tab: the theme's, not the plain black a tab has without the theme's style -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,0,14,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="560" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- the map, from above -->
            <Border Style="{StaticResource Card}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button Padding="10,3" Click="FitButton_Click" ToolTip="{l:T SimplexTreeWindow.FrameAreasF}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T Common.Fit}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="WorldButton" Margin="8,0,0,0" Padding="10,3" Click="WorldButton_Click" ToolTip="{l:T SimplexTreeWindow.FrameWholeWorldW}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE909;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T SimplexTreeWindow.World}" />
                            </StackPanel>
                        </Button>
                        <CheckBox x:Name="LinesCheck" Content="{l:T SimplexTreeWindow.EveryLine}" IsChecked="True" MinWidth="0" Margin="16,0,0,0" VerticalAlignment="Center"
                                  Click="Overlay_Click" ToolTip="{l:T SimplexTreeWindow.DrawLinesCutNoArea}" />
                        <CheckBox x:Name="NumbersCheck" Content="{l:T SimplexTreeWindow.Numbers}" IsChecked="True" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center"
                                  Click="Overlay_Click" ToolTip="{l:T SimplexTreeWindow.NumberEachAreasPieces}" />
                    </WrapPanel>
                    <TextBlock x:Name="HoverText" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextTrimming="CharacterEllipsis"
                               Text="{l:T SimplexTreeWindow.DragWheelClick}" />
                    <Border CornerRadius="6" Background="{DynamicResource SolidBackgroundFillColorBaseBrush}">
                        <local:SimplexMap x:Name="Map" PointerMoved="Map_PointerMoved" MapClicked="Map_MapClicked" />
                    </Border>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl x:Name="Tabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                    <TabItem x:Name="AreasTab" Header="{l:T SimplexTreeWindow.Areas}">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="PurposeText" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,8" />
                            <DataGrid x:Name="AreaGrid" Grid.Row="1" Style="{StaticResource ViewerGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="AreaGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="{l:T SimplexTreeWindow.Area}" SortMemberPath="Area" Width="80">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="12" Height="12" CornerRadius="3" Background="{Binding Swatch}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Area}" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T SimplexTreeWindow.Pieces}" Binding="{Binding Pieces}" Width="70" />
                                    <DataGridTextColumn Header="{l:T SimplexTreeWindow.Size}" Binding="{Binding SizeText}" SortMemberPath="Size" Width="110" />
                                    <DataGridTextColumn Header="{l:T SimplexTreeWindow.Centre}" Binding="{Binding CentreText}" Width="*" />
                                </DataGrid.Columns>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T SimplexTreeWindow.CopyCentre}" Click="CopyCentre_Click" />
                                        <MenuItem Header="{l:T SimplexTreeWindow.CopyOutlines}" Click="CopyOutlines_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                            <Border x:Name="PiecePanel" Grid.Row="2" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="PieceTitle" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,2" />
                                    <TextBlock x:Name="PieceDetail" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock x:Name="PiecePath" Style="{StaticResource Figure}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="SplitsTab" Header="{l:T SimplexTreeWindow.Splits}">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,8"
                                       Text="{l:T SimplexTreeWindow.EachSplitLineExplained}" />
                            <DataGrid x:Name="SplitGrid" Style="{StaticResource ViewerGrid}" AutoGenerateColumns="False" IsReadOnly="True"
                                      SelectionMode="Single" SelectionChanged="SplitGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Index}" Width="44" />
                                    <DataGridTextColumn Header="{l:T SimplexTreeWindow.From}" Binding="{Binding ParentText}" Width="54" />
                                    <DataGridTextColumn Header="{l:T SimplexTreeWindow.Normal}" Binding="{Binding NormalText}" Width="130" />
                                    <DataGridTextColumn Header="{l:T SimplexTreeWindow.Offset}" Binding="{Binding OffsetText}" SortMemberPath="Offset" Width="80" />
                                    <DataGridTextColumn Header="{l:T SimplexTreeWindow.InFront}" Binding="{Binding PositiveText}" Width="*" />
                                    <DataGridTextColumn Header="{l:T SimplexTreeWindow.Behind}" Binding="{Binding NegativeText}" Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{l:T Common.Properties}">
                        <DockPanel Margin="4,8,0,0">
                            <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                            <local:PropertyListView x:Name="FileProperties" LinkClicked="Properties_LinkClicked" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T SimplexTreeWindow.Reading}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <DockPanel Grid.Row="1" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
