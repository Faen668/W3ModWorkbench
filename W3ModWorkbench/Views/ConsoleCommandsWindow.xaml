<Window x:Class="W3ModWorkbench.ConsoleCommandsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:scripts="clr-namespace:W3ModWorkbench.Core.Scripts"
        Title="{l:T ConsoleCommandsWindow.ConsoleCommands}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1100" Height="720" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{l:T ConsoleCommandsWindow.ConsoleCommands}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText" Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Text="{l:T ConsoleCommandsWindow.EveryExecFunctionGame}" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <CheckBox x:Name="ModsCheck" Content="{l:T Common.InstalledMods}" IsChecked="True" MinWidth="0" Click="Sources_Click"
                              ToolTip="{l:T ConsoleCommandsWindow.GameModsFolderEach}" />
                </StackPanel>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="32,6,8,6" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="11,0,0,0" Opacity="0.6"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchPlaceholder" Margin="33,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{l:T ConsoleCommandsWindow.SearchNameParameterMod}" />
                </Grid>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.1*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <ListBox x:Name="ResultList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0"
                             SelectionChanged="ResultList_SelectionChanged" MouseDoubleClick="ResultList_MouseDoubleClick"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type scripts:ConsoleCommand}">
                                <StackPanel Margin="4,3">
                                    <TextBlock Text="{Binding Signature}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               FontFamily="Cascadia Mono, Consolas" />
                                    <TextBlock Text="{Binding File.File.Source}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" Focusable="False" />

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16,12">
                    <Grid>
                        <StackPanel x:Name="DetailPanel" Visibility="Collapsed">
                            <TextBlock x:Name="NameText" FontSize="18" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" TextWrapping="Wrap" />
                            <TextBlock x:Name="WhereText" Opacity="0.7" Margin="0,2,0,0" TextWrapping="Wrap" />

                            <TextBlock Text="{l:T ConsoleCommandsWindow.TypeConsole}" Style="{StaticResource Label}" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="6,0,0,0" Padding="12,6" Click="Copy_Click" Style="{DynamicResource AccentButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="13" />
                                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.Copy}" />
                                    </StackPanel>
                                </Button>
                                <TextBox x:Name="CommandBox" FontFamily="Cascadia Mono, Consolas" VerticalContentAlignment="Center" Padding="8,6" />
                            </DockPanel>
                            <CheckBox x:Name="OptionalCheck" Content="{l:T ConsoleCommandsWindow.IncludeOptionalParameters}" MinWidth="0" Margin="0,8,0,0"
                                      Click="Optional_Click" />

                            <TextBlock Text="{l:T ConsoleCommandsWindow.Parameters}" Style="{StaticResource Label}" />
                            <ItemsControl x:Name="ParameterList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type scripts:CommandParameter}">
                                        <StackPanel Orientation="Horizontal" Margin="0,2">
                                            <TextBlock Text="{Binding Name}" FontFamily="Cascadia Mono, Consolas" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Type, StringFormat=' : {0}'}" FontFamily="Cascadia Mono, Consolas" Opacity="0.8" />
                                            <TextBlock x:Name="Optional" Text="{l:T ConsoleCommandsWindow.Optional}" Opacity="0.55" Visibility="Collapsed" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Optional}" Value="True">
                                                <Setter TargetName="Optional" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock x:Name="NoParameters" Text="{l:T ConsoleCommandsWindow.None}" Opacity="0.65" Visibility="Collapsed" />

                            <Button Margin="0,16,0,0" Padding="12,6" HorizontalAlignment="Left" Click="OpenSource_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A5;" FontSize="13" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T ConsoleCommandsWindow.OpenWhereDeclared}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="EmptyText" Opacity="0.65" TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center"
                                   TextAlignment="Center" Text="{l:T ConsoleCommandsWindow.PickCommandSeeWhat}" />
                    </Grid>
                </Border>
            </Grid>

            <DockPanel Grid.Row="3" Margin="2,10,2,0">
                <TextBlock DockPanel.Dock="Right" Opacity="0.6" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Text="{l:T ConsoleCommandsWindow.ConsoleNeedsDebugScripts}" />
                <TextBlock x:Name="StatusText" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
