<Window x:Class="W3ModWorkbench.QuestStubWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T QuestStub.Title}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1180" Height="820" MinWidth="860" MinHeight="520"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Margin="14,12,14,8">
            <TextBlock Text="{l:T QuestStub.Title}" FontSize="16" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" Text="{l:T QuestStub.Explain}" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- what to make -->
            <Border Style="{StaticResource Card}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,0,2,0">
                <StackPanel Margin="14,4,12,12">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T QuestStub.ModName}" />
                        <TextBox x:Name="ModNameBox" Padding="8,5" TextChanged="Options_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0" Text="{l:T QuestStub.ModNameHint}" />
                        <TextBlock x:Name="NamesText" Style="{StaticResource Hint}" Margin="0,2,0,0" FontFamily="Consolas" />

                        <TextBlock Style="{StaticResource SectionTitle}" Text="{l:T QuestStub.Events}" />
                        <!-- loc-ignore: a script event's own name -->
                        <CheckBox x:Name="FinishedCheck" Content="OnBlockFinished" Click="Options_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Margin="26,0,0,6" Text="{l:T QuestStub.FinishedHint}" />
                        <!-- loc-ignore: a script event's own name -->
                        <CheckBox x:Name="ActivatedCheck" Content="OnBlockActivated" Click="Options_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Margin="26,0,0,6" Text="{l:T QuestStub.ActivatedHint}" />
                        <!-- loc-ignore: a script event's own name -->
                        <CheckBox x:Name="ActiveCheck" Content="OnBlockActive" Click="Options_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Margin="26,0,0,6" Text="{l:T QuestStub.ActiveHint}" />
                        <!-- loc-ignore: a script event's own name -->
                        <CheckBox x:Name="StoppedCheck" Content="OnBlockStopped" Click="Options_Changed" />
                        <TextBlock Style="{StaticResource Hint}" Margin="26,0,0,0" Text="{l:T QuestStub.StoppedHint}" />

                        <TextBlock x:Name="BlocksTitle" Style="{StaticResource SectionTitle}" />
                    </StackPanel>
                    <DataGrid x:Name="BlockList" Style="{StaticResource ViewerGrid}" MaxHeight="260">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T QuestGraph.Col.Name}" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="{l:T QuestGraph.Col.Outputs}" Binding="{Binding OutputsText}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the script -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel Margin="12,10,12,12">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="FileText" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBox x:Name="ScriptText" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5" AcceptsReturn="True" AcceptsTab="True"
                             HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap" Padding="8" />
                </DockPanel>
            </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="14,10,14,12">
            <Button DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Click="SaveAs_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE792;" FontSize="13" />
                    <TextBlock Margin="8,0,0,0" Text="{l:T QuestStub.SaveAs}" />
                </StackPanel>
            </Button>
            <Button x:Name="SaveProjectButton" DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Click="SaveProject_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" FontSize="13" />
                    <TextBlock Margin="8,0,0,0" Text="{l:T QuestStub.SaveProject}" />
                </StackPanel>
            </Button>
            <Button DockPanel.Dock="Right" Padding="12,6" Margin="8,0,0,0" Click="Copy_Click" Style="{StaticResource AccentButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="13" />
                    <TextBlock Margin="8,0,0,0" Text="{l:T QuestStub.Copy}" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="3" IsModal="True" />
    </Grid>
</Window>
