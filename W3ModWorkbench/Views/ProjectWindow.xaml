<Window x:Class="W3ModWorkbench.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New project" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="620" Height="680" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,5" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="New project" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="IntroText" Style="{StaticResource Hint}"
                       Text="A project is where you make your mod: a folder of your own with a .w3bench file, the mod's scripts, and its workspace, where copies of the game's files you change go at their game paths. Build makes the mod from it, ready to install. The game's own files are never changed." />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Style="{StaticResource Label}" Text="Name" Margin="0,10,0,5" />
                <TextBox x:Name="NameBox" Padding="8,6" TextChanged="Field_Changed" />

                <TextBlock Style="{StaticResource Label}" Text="Mod name" />
                <TextBox x:Name="ModBox" Padding="8,6" TextChanged="Field_Changed" />
                <TextBlock x:Name="ModHint" Style="{StaticResource Hint}" Text="The name of the mod's folder under the game's mods folder. The game only loads folders that start with mod." />

                <TextBlock Style="{StaticResource Label}" Text="Project folder" />
                <Grid>
                    <TextBox x:Name="RootBox" Padding="8,6,40,6" TextChanged="Field_Changed" />
                    <Button x:Name="RootBrowse" HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                            Click="BrowseRoot_Click" ToolTip="Choose the mod's folder">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                    </Button>
                </Grid>
                <TextBlock x:Name="RootHint" Style="{StaticResource Hint}" Text="A folder of your own, outside the game's folders. The .w3bench file is saved here, with the scripts and workspace folders in it." />

                <TextBlock Style="{StaticResource Label}" Text="Scripts folder" />
                <Grid>
                    <TextBox x:Name="ScriptsBox" Padding="8,6,40,6" TextChanged="Field_Changed" />
                    <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                            Click="BrowseScripts_Click" ToolTip="Choose the scripts folder">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                    </Button>
                </Grid>
                <TextBlock x:Name="ScriptsHint" Style="{StaticResource Hint}" Text="Every .ws file in it is part of the project, and it's what Compile and Build compile. It's made if it isn't there yet." />

                <TextBlock Style="{StaticResource Label}" Text="Compile scripts to…" />
                <Grid>
                    <TextBox x:Name="OutputBox" Padding="8,6,40,6" />
                    <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                            Click="BrowseOutput_Click" ToolTip="Choose where Compile scripts to… writes the .rsblob">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                    </Button>
                </Grid>
                <TextBlock Style="{StaticResource Hint}" Text="Where Project > Compile scripts to… writes a .rsblob, to try the scripts somewhere of your own. Script Bench's Compile only checks them, and Build puts them in the mod. Leave it empty to be asked." />

                <TextBlock Style="{StaticResource Label}" Text="When the mod is built" />
                <CheckBox x:Name="BuildLooseCheck" Content="Also ship the loose scripts in content\scripts" MinWidth="0" Margin="0,2,0,0"
                          ToolTip="The .ws files go in the mod beside the compiled scripts, as its source for others to read or merge. An info.json tells the game to run the compiled ones" />
                <TextBlock Style="{StaticResource Hint}" Text="Build always compiles the scripts into content\precompiled.rsblob, the way REDkit publishes a mod: they're checked as the mod is built, and the game loads them as they are." />

                <TextBlock Style="{StaticResource Label}" Text="Author and version" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AuthorBox" Padding="8,6" />
                    <TextBox x:Name="VersionBox" Grid.Column="2" Padding="8,6" />
                </Grid>

                <TextBlock Style="{StaticResource Label}" Text="Description" />
                <TextBox x:Name="DescriptionBox" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120" VerticalScrollBarVisibility="Auto" />

                <StackPanel x:Name="FilesPanel">
                    <TextBlock Style="{StaticResource Label}" Text="Other files in the project" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="FilesList" MinHeight="90" MaxHeight="170" SelectionMode="Extended" SelectionChanged="FilesList_SelectionChanged" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Button Click="AddFiles_Click" Content="Add files…" HorizontalAlignment="Stretch" />
                            <Button Click="AddFolder_Click" Content="Add folder…" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                            <Button x:Name="RemoveFilesButton" Click="RemoveFiles_Click" Content="Remove" Margin="0,6,0,0" HorizontalAlignment="Stretch" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="Menus, strings and notes that belong to the mod. A folder adds everything inside it. Removing a file only takes it off this list: the file itself is never deleted." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="ProblemText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" MaxWidth="320" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Padding="22,7" Content="Create project" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" />
            <Button DockPanel.Dock="Right" Padding="18,7" Margin="0,0,8,0" Content="Cancel" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
