<Window x:Class="W3ModWorkbench.ProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        Title="{l:T ProjectWindow.NewProject}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="620" Height="680" MinWidth="500" MinHeight="460"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,14,0,5" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,5,0,0" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="{l:T ProjectWindow.NewProject}" FontSize="20" FontWeight="SemiBold" />
            <TextBlock x:Name="IntroText" Style="{StaticResource Hint}"
                       Text="{l:T ProjectWindow.ProjectWhereYouMake}" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-14,0">
            <StackPanel Margin="0,0,14,0">
                <TextBlock Style="{StaticResource Label}" Text="{l:T Common.Name}" Margin="0,10,0,5" />
                <TextBox x:Name="NameBox" Padding="8,6" TextChanged="Field_Changed" />

                <TextBlock Style="{StaticResource Label}" Text="{l:T ProjectWindow.ModName}" />
                <TextBox x:Name="ModBox" Padding="8,6" TextChanged="Field_Changed" />
                <TextBlock x:Name="ModHint" Style="{StaticResource Hint}" Text="{l:T ProjectWindow.NameModsFolderUnder}" />

                <TextBlock Style="{StaticResource Label}" Text="{l:T ProjectWindow.ProjectFolder}" />
                <Grid>
                    <TextBox x:Name="RootBox" Padding="8,6,40,6" TextChanged="Field_Changed" />
                    <Button x:Name="RootBrowse" HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                            Click="BrowseRoot_Click" ToolTip="{l:T ProjectWindow.ChooseModsFolder}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                    </Button>
                </Grid>
                <TextBlock x:Name="RootHint" Style="{StaticResource Hint}" Text="{l:T ProjectWindow.FolderYourOwnOutside}" />

                <TextBlock Style="{StaticResource Label}" Text="{l:T ProjectWindow.ScriptsFolder}" />
                <Grid>
                    <TextBox x:Name="ScriptsBox" Padding="8,6,40,6" TextChanged="Field_Changed" />
                    <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                            Click="BrowseScripts_Click" ToolTip="{l:T ProjectWindow.ChooseScriptsFolder}">
                        <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                    </Button>
                </Grid>
                <TextBlock x:Name="ScriptsHint" Style="{StaticResource Hint}" Text="{l:T ProjectWindow.EveryWsFilePart}" />

                <TextBlock Style="{StaticResource Label}" Text="{l:T ProjectWindow.WhenModBuilt}" />
                <CheckBox x:Name="BuildLooseCheck" Content="{l:T ProjectWindow.AlsoShipLooseScripts}" MinWidth="0" Margin="0,2,0,0"
                          ToolTip="{l:T ProjectWindow.WsFilesGoMod}" />
                <TextBlock Style="{StaticResource Hint}" Text="{l:T ProjectWindow.BuildAlwaysCompilesScripts}" />

                <TextBlock Style="{StaticResource Label}" Text="{l:T ProjectWindow.AuthorVersion}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="140" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="AuthorBox" Padding="8,6" />
                    <TextBox x:Name="VersionBox" Grid.Column="2" Padding="8,6" />
                </Grid>

                <TextBlock Style="{StaticResource Label}" Text="{l:T ProjectWindow.Description}" />
                <TextBox x:Name="DescriptionBox" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="120" VerticalScrollBarVisibility="Auto" />

                <StackPanel x:Name="FilesPanel">
                    <TextBlock Style="{StaticResource Label}" Text="{l:T ProjectWindow.OtherFilesProject}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ListBox x:Name="FilesList" MinHeight="90" MaxHeight="170" SelectionMode="Extended" SelectionChanged="FilesList_SelectionChanged" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                            <Button Click="AddFiles_Click" Content="{l:T ProjectWindow.AddFiles}" HorizontalAlignment="Stretch" />
                            <Button Click="AddFolder_Click" Content="{l:T ProjectWindow.AddFolder}" Margin="0,6,0,0" HorizontalAlignment="Stretch" />
                            <Button x:Name="RemoveFilesButton" Click="RemoveFiles_Click" Content="{l:T Common.Remove}" Margin="0,6,0,0" HorizontalAlignment="Stretch" IsEnabled="False" />
                        </StackPanel>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="{l:T ProjectWindow.MenusStringsNotesBelong}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2" Margin="0,14,0,0" LastChildFill="False">
            <TextBlock x:Name="ProblemText" DockPanel.Dock="Left" VerticalAlignment="Center" Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                       TextWrapping="Wrap" MaxWidth="320" />
            <Button x:Name="OkButton" DockPanel.Dock="Right" Padding="22,7" Content="{l:T ProjectWindow.CreateProject}" IsDefault="True"
                    Style="{DynamicResource AccentButtonStyle}" Click="Ok_Click" />
            <Button DockPanel.Dock="Right" Padding="18,7" Margin="0,0,8,0" Content="{l:T Common.Cancel}" IsCancel="True" />
        </DockPanel>
    </Grid>
</Window>
