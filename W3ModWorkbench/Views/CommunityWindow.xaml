<Window x:Class="W3ModWorkbench.CommunityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="Community" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1500" Height="900" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <!-- each entry's rows together: a line above its first, every other entry shaded -->
        <Style x:Key="GroupRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shade}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="420" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel Margin="10,8,10,8">
                    <!-- the spawnset's type, what's in it, and finding rows -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Community spawnset type" VerticalAlignment="Center" Opacity="0.75" />
                            <Border Margin="8,0,0,0" Padding="8,3" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="TypeText" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="CountsText" Margin="14,0,14,0" VerticalAlignment="Center" Style="{StaticResource Small}" />
                        </StackPanel>
                        <Grid>
                            <TextBox x:Name="SearchBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="Show only the rows with these words: an entry, a template, a story phase, a timetable, a tag  (Ctrl+F)" />
                            <TextBlock x:Name="MatchText" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Small}" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                    <TabControl x:Name="Tabs">
                        <TabItem x:Name="SpawnsetTab" Header="Spawnset">
                            <DataGrid x:Name="SpawnsetGrid" CellStyle="{StaticResource ViewerGridCell}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FrozenColumnCount="2"
                                      GridLinesVisibility="Vertical" RowStyle="{StaticResource GroupRow}" SelectionMode="Single" CanUserSortColumns="False"
                                      SelectionChanged="SpawnsetGrid_SelectionChanged" MouseDoubleClick="SpawnsetGrid_MouseDoubleClick"
                                      ToolTip="Click a row to see its entry, entity and story phase; double-click to open the entity template">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Comment" Binding="{Binding Comment}" />
                                    <DataGridTextColumn Header="Entry ID" Binding="{Binding EntryId}" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Entity template" Binding="{Binding Template}" />
                                    <DataGridTextColumn Header="Appearances" Binding="{Binding Appearances}" />
                                    <DataGridTextColumn Header="Entity spawn tags" Binding="{Binding SpawnTags}" />
                                    <DataGridTextColumn Header="Mappin tag" Binding="{Binding MappinTag}" />
                                    <DataGridTextColumn Header="Mappin type" Binding="{Binding MappinType}" />
                                    <DataGridTextColumn Header="Initializers" Binding="{Binding EntityInitializers}" />
                                    <DataGridTextColumn Header="Despawners" Binding="{Binding Despawners}" />
                                    <DataGridTextColumn Header="Commentary" Binding="{Binding PhaseComment}" />
                                    <DataGridTextColumn Header="Story phase" Binding="{Binding StoryPhase}" FontWeight="SemiBold" />
                                    <DataGridTemplateColumn Header="Hidden spawn">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding HiddenSpawn, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Phase initializers" Binding="{Binding PhaseInitializers}" />
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity}" />
                                    <DataGridTextColumn Header="Respawn delay" Binding="{Binding RespawnDelay}" />
                                    <DataGridTemplateColumn Header="Respawn">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding Respawn, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Timetable" Binding="{Binding Timetable}" />
                                    <DataGridTextColumn Header="Spawn delay" Binding="{Binding SpawnDelay}" />
                                    <DataGridTextColumn Header="Spawn point tags" Binding="{Binding SpawnPointTags}" />
                                    <DataGridTextColumn Header="Despawn point tags" Binding="{Binding DespawnPointTags}" />
                                    <DataGridTemplateColumn Header="Start in AP">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding StartInAP, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Use last AP">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding UseLastAP, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Always spawned">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding AlwaysSpawned, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Spawn strategy" Binding="{Binding SpawnStrategy}" />
                                    <DataGridTextColumn Header="Cached map pin" Binding="{Binding MapPin}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="TimetablesTab" Header="Timetables">
                            <DataGrid x:Name="TimetableGrid" CellStyle="{StaticResource ViewerGridCell}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical" RowStyle="{StaticResource GroupRow}" SelectionMode="Single" CanUserSortColumns="False"
                                      SelectionChanged="TimetableGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="Time" Binding="{Binding Time}" />
                                    <DataGridTextColumn Header="Layer" Binding="{Binding Layer}" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category}" />
                                    <DataGridTextColumn Header="Weight" Binding="{Binding Weight}" />
                                    <DataGridTextColumn Header="AP tags" Binding="{Binding ApTags}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the row picked -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel Margin="12,10,8,8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="PickedTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="Click a row" />
                        <TextBlock x:Name="PickedDetail" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="OpenTemplateButton" Padding="10,5" Margin="0,0,6,0" Click="OpenTemplate_Click" IsEnabled="False"
                                    ToolTip="Open the row's entity template in the entity viewer (or double-click the row)">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" />
                                    <TextBlock Margin="8,0,0,0" Text="Open the template" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TimetableButton" Padding="10,5" Margin="0,0,6,0" Click="ShowTimetable_Click" IsEnabled="False"
                                    ToolTip="Show the story phase's timetable on the Timetables tab">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE823;" />
                                    <TextBlock Margin="8,0,0,0" Text="Its timetable" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <Grid Margin="0,10,0,0">
                            <TextBox x:Name="PropertySearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="PropertySearch_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="PropertySearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="Find properties by name or value" />
                        </Grid>
                    </StackPanel>
                    <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                    <local:PropertyListView x:Name="Properties" LinkClicked="Properties_LinkClicked" />
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="Reading the community…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
