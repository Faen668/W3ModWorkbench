<Window x:Class="W3ModWorkbench.CommunityWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T CommunityWindow.Community}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1500" Height="900" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <!-- each entry's rows together: a line above its first, every other entry shaded -->
        <Style x:Key="GroupRow" TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Shade}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding First}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="0,1,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="Check" TargetType="CheckBox">
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="400" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="420" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <DockPanel Margin="10,8,10,8">
                    <!-- the spawnset's type, what's in it, and finding rows -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="{l:T CommunityWindow.CommunitySpawnsetType}" VerticalAlignment="Center" Opacity="0.75" />
                            <Border Margin="8,0,0,0" Padding="8,3" CornerRadius="4" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                <TextBlock x:Name="TypeText" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock x:Name="CountsText" Margin="14,0,14,0" VerticalAlignment="Center" Style="{StaticResource Small}" />
                        </StackPanel>
                        <Grid>
                            <TextBox x:Name="SearchBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{l:T CommunityWindow.ShowOnlyRowsThese}" />
                            <TextBlock x:Name="MatchText" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0" Style="{StaticResource Small}" IsHitTestVisible="False" />
                        </Grid>
                    </DockPanel>
                    <TabControl x:Name="Tabs">
                        <TabItem x:Name="SpawnsetTab" Header="{l:T CommunityWindow.Spawnset}">
                            <DataGrid x:Name="SpawnsetGrid" CellStyle="{StaticResource ViewerGridCell}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FrozenColumnCount="2"
                                      GridLinesVisibility="Vertical" RowStyle="{StaticResource GroupRow}" SelectionMode="Single" CanUserSortColumns="False"
                                      SelectionChanged="SpawnsetGrid_SelectionChanged" MouseDoubleClick="SpawnsetGrid_MouseDoubleClick"
                                      ToolTip="{l:T CommunityWindow.ClickRowSeeEntry}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Comment}" Binding="{Binding Comment}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.EntryID}" Binding="{Binding EntryId}" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.EntityTemplate}" Binding="{Binding Template}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Appearances}" Binding="{Binding Appearances}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.EntitySpawnTags}" Binding="{Binding SpawnTags}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.MappinTag}" Binding="{Binding MappinTag}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.MappinType}" Binding="{Binding MappinType}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Initializers}" Binding="{Binding EntityInitializers}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Despawners}" Binding="{Binding Despawners}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Commentary}" Binding="{Binding PhaseComment}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.StoryPhase}" Binding="{Binding StoryPhase}" FontWeight="SemiBold" />
                                    <DataGridTemplateColumn Header="{l:T CommunityWindow.HiddenSpawn}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding HiddenSpawn, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T CommunityWindow.PhaseInitializers}" Binding="{Binding PhaseInitializers}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Time}" Binding="{Binding Time}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Quantity}" Binding="{Binding Quantity}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.RespawnDelay}" Binding="{Binding RespawnDelay}" />
                                    <DataGridTemplateColumn Header="{l:T CommunityWindow.Respawn}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding Respawn, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Timetable}" Binding="{Binding Timetable}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.SpawnDelay}" Binding="{Binding SpawnDelay}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.SpawnPointTags}" Binding="{Binding SpawnPointTags}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.DespawnPointTags}" Binding="{Binding DespawnPointTags}" />
                                    <DataGridTemplateColumn Header="{l:T CommunityWindow.StartAP}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding StartInAP, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{l:T CommunityWindow.UseLastAP}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding UseLastAP, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="{l:T CommunityWindow.AlwaysSpawned}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><CheckBox IsChecked="{Binding AlwaysSpawned, Mode=OneWay}" Style="{StaticResource Check}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="{l:T CommunityWindow.SpawnStrategy}" Binding="{Binding SpawnStrategy}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.CachedMapPin}" Binding="{Binding MapPin}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                        <TabItem x:Name="TimetablesTab" Header="{l:T CommunityWindow.Timetables}">
                            <DataGrid x:Name="TimetableGrid" CellStyle="{StaticResource ViewerGridCell}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                      GridLinesVisibility="Vertical" RowStyle="{StaticResource GroupRow}" SelectionMode="Single" CanUserSortColumns="False"
                                      SelectionChanged="TimetableGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T Common.Name}" Binding="{Binding Name}" FontWeight="SemiBold" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Time}" Binding="{Binding Time}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Layer}" Binding="{Binding Layer}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Category}" Binding="{Binding Category}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.Weight}" Binding="{Binding Weight}" />
                                    <DataGridTextColumn Header="{l:T CommunityWindow.APTags}" Binding="{Binding ApTags}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the row picked -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel Margin="12,10,8,8">
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <TextBlock x:Name="PickedTitle" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{l:T CommunityWindow.ClickRow}" />
                        <TextBlock x:Name="PickedDetail" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <WrapPanel Margin="0,8,0,0">
                            <Button x:Name="OpenTemplateButton" Padding="10,5" Margin="0,0,6,0" Click="OpenTemplate_Click" IsEnabled="False"
                                    ToolTip="{l:T CommunityWindow.OpenRowsEntityTemplate}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T CommunityWindow.OpenTemplate}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="TimetableButton" Padding="10,5" Margin="0,0,6,0" Click="ShowTimetable_Click" IsEnabled="False"
                                    ToolTip="{l:T CommunityWindow.ShowStoryPhasesTimetable}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE823;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T CommunityWindow.Timetable2}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                        <Grid Margin="0,10,0,0">
                            <TextBox x:Name="PropertySearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="PropertySearch_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="PropertySearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{l:T Common.FindPropertiesNameValue}" />
                        </Grid>
                    </StackPanel>
                    <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                    <local:PropertyListView x:Name="Properties" LinkClicked="Properties_LinkClicked" />
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T CommunityWindow.ReadingCommunity}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <DockPanel Grid.Row="1" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
