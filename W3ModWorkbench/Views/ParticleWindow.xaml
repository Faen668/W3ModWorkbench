<Window x:Class="W3ModWorkbench.ParticleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T ParticleWindow.ParticleSystem}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1500" Height="950" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- compact tabs, as the scene viewer's, so every tab fits in a row -->
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="5*" MinHeight="220" />
                <RowDefinition Height="8" />
                <RowDefinition Height="4*" MinHeight="200" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="3*" MinWidth="360" />
            </Grid.ColumnDefinitions>

            <!-- the effect playing -->
            <Border Style="{StaticResource Card}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Button x:Name="PlayButton" Padding="10,3" Click="PlayButton_Click" ToolTip="{l:T ParticleWindow.PlayPauseSpace}">
                            <TextBlock x:Name="PlayIcon" Style="{StaticResource IconText}" Text="&#xE769;" FontSize="12" />
                        </Button>
                        <Button Margin="6,0,0,0" Padding="10,3" Click="RestartButton_Click" ToolTip="{l:T ParticleWindow.RestartR}">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE72C;" FontSize="12" />
                        </Button>
                        <ComboBox x:Name="SpeedBox" Margin="10,0,0,0" MinWidth="80" SelectionChanged="SpeedBox_SelectionChanged" ToolTip="{l:T ParticleWindow.SpeedTip}" />
                        <ComboBox x:Name="LodBox" Margin="8,0,0,0" MinWidth="110" SelectionChanged="LodBox_SelectionChanged" ToolTip="{l:T ParticleWindow.LodTip}" />
                        <CheckBox x:Name="GridCheck" Content="{l:T ParticleWindow.Grid}" IsChecked="True" MinWidth="0" Margin="12,0,0,0" VerticalAlignment="Center" Click="GridCheck_Click" />
                        <Button Margin="10,0,0,0" Padding="10,3" Click="FitButton_Click" ToolTip="{l:T ParticleWindow.FitF}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T Common.Fit}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextWrapping="Wrap" />
                    <Border CornerRadius="6" ClipToBounds="True">
                        <local:ParticlePreview x:Name="Preview" Ticked="Preview_Ticked" />
                    </Border>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the module picked: its values' curves over a particle's life -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel Margin="10,8,10,8">
                    <Grid DockPanel.Dock="Top" Margin="2,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="CurveTitle" FontWeight="SemiBold" FontSize="15" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="CurveDetail" Style="{StaticResource Small}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <ComboBox x:Name="ValueBox" Grid.Column="1" MinWidth="140" VerticalAlignment="Top" SelectionChanged="ValueBox_SelectionChanged"
                                  ToolTip="{l:T ParticleWindow.ValueTip}" />
                    </Grid>
                    <local:CurveChart x:Name="Chart" />
                </DockPanel>
            </Border>

            <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Rows" />

            <!-- the properties of what's picked -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <TabControl x:Name="Tabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                    <TabItem x:Name="ModuleTab" Header="{l:T ParticleWindow.Module}">
                        <DataGrid x:Name="ValueGrid" Margin="0,6,0,0" Style="{StaticResource ViewerGrid}" SelectionChanged="ValueGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{l:T Common.Name}" Binding="{Binding Name}" Width="130" />
                                <DataGridTextColumn Header="{l:T ParticleWindow.Evaluator}" Binding="{Binding Kind}" Width="150" />
                                <DataGridTextColumn Header="{l:T ParticleWindow.Value}" Binding="{Binding Text}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem x:Name="EmitterTab" Header="{l:T ParticleWindow.Emitter}">
                        <local:PropertyListView x:Name="EmitterProperties" Margin="4,8,0,0" LinkClicked="Properties_LinkClicked" />
                    </TabItem>
                    <TabItem x:Name="MaterialTab" Header="{l:T ParticleWindow.Material}">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock x:Name="MaterialText" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="4,0,0,6" />
                            <DataGrid x:Name="MaterialGrid" Style="{StaticResource ViewerGrid}" MouseDoubleClick="MaterialGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T Common.Name}" Binding="{Binding Name}" Width="170" />
                                    <DataGridTextColumn Header="{l:T Common.Type}" Binding="{Binding Type}" Width="130" />
                                    <DataGridTextColumn Header="{l:T ParticleWindow.Value}" Binding="{Binding Text}" Width="*" />
                                    <DataGridTextColumn Header="{l:T ParticleWindow.From}" Binding="{Binding From}" Width="130" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{l:T ParticleWindow.System}">
                        <DockPanel Margin="4,8,0,0">
                            <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                            <local:PropertyListView x:Name="SystemProperties" LinkClicked="Properties_LinkClicked" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <!-- the emitters, each a box of its modules, as REDkit lays them out -->
            <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel Margin="8">
                    <TextBlock x:Name="EmittersTitle" DockPanel.Dock="Top" FontWeight="SemiBold" Margin="4,0,0,6" />
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="EmitterList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="190" Margin="0,0,10,0" CornerRadius="6" BorderThickness="1" BorderBrush="{Binding Edge}" Background="{DynamicResource SubtleFillColorSecondaryBrush}"
                                            VerticalAlignment="Top">
                                        <StackPanel>
                                            <Border Background="{Binding HeaderBrush}" CornerRadius="5,5,0,0" Padding="8,5" Cursor="Hand" MouseLeftButtonDown="EmitterHeader_MouseLeftButtonDown">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                                    <CheckBox Grid.Column="1" IsChecked="{Binding Showing, Mode=TwoWay}" MinWidth="0" Margin="6,0,0,0" ToolTip="{l:T ParticleWindow.ShowEmitter}" />
                                                </Grid>
                                            </Border>
                                            <Grid Margin="8,6,8,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="52" Height="52" CornerRadius="4" Background="#FF1A1A1A">
                                                    <Image Source="{Binding Thumb}" Stretch="Uniform" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Info}" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="8,0,0,0" />
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Modules}" Margin="4,0,4,6">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border CornerRadius="3" Padding="4,2" Background="{Binding Back}" Cursor="Hand" MouseLeftButtonDown="Module_MouseLeftButtonDown">
                                                            <StackPanel Orientation="Horizontal">
                                                                <CheckBox IsChecked="{Binding Enabled, Mode=TwoWay}" MinWidth="0" Margin="0,0,4,0" ToolTip="{l:T ParticleWindow.ModuleOnOff}">
                                                                    <CheckBox.LayoutTransform>
                                                                        <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                                                    </CheckBox.LayoutTransform>
                                                                </CheckBox>
                                                                <TextBlock Text="{Binding Title}" FontSize="12" VerticalAlignment="Center" Opacity="{Binding TextOpacity}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T ParticleWindow.Reading}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
