<Window x:Class="W3ModWorkbench.MeshWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:vm="clr-namespace:W3ModWorkbench.ViewModels"
        Title="{l:T MeshWindow.Mesh}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1380" Height="860" MinWidth="820" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <!-- the tabs as small segments in a row, as the entity viewer has them; the label's colour is set on the label alone -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" CornerRadius="6" Padding="10,4" Margin="2,0,2,4" Background="Transparent" Cursor="Hand">
                            <ContentPresenter x:Name="Label" ContentSource="Header" VerticalAlignment="Center"
                                              TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Label" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,4,0,8" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="14,12,14,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <TextBlock Text="{l:T MeshWindow.LOD}" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.7" />
                <ComboBox x:Name="LodBox" MinWidth="190" SelectionChanged="Lod_SelectionChanged" ToolTip="{l:T MeshWindow.LevelDetailShownMost}" />
                <ToggleButton x:Name="TexturedToggle" Margin="14,0,0,0" Padding="12,5" Content="{l:T Common.Textures}" IsChecked="True" Click="Textured_Click" ToolTip="{l:T MeshWindow.ShowMaterialsColourTextures}" />
                <ToggleButton x:Name="WireToggle" Margin="6,0,0,0" Padding="12,5" Content="{l:T Common.Wireframe}" Click="Wire_Click" ToolTip="{l:T MeshWindow.DrawTrianglesEdgesOver}" />
                <ToggleButton x:Name="FloorToggle" Margin="6,0,0,0" Padding="12,5" Content="{l:T MeshWindow.Floor}" Click="Floor_Click" ToolTip="{l:T MeshWindow.GridGroundUnderMesh}" />
                <Button x:Name="ShowButton" Margin="6,0,0,0" Padding="12,5" Click="Show_Click" ToolTip="{l:T MeshWindow.DrawHowMeshMade}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{l:T MeshWindow.Show}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="8,2,0,0" />
                    </StackPanel>
                    <Button.ContextMenu>
                        <ContextMenu x:Name="ShowMenu">
                            <MenuItem x:Name="BoundsItem" Header="{l:T MeshWindow.BoundingBox}" InputGestureText="B" IsCheckable="True" />
                            <MenuItem x:Name="ColorsItem" Header="{l:T MeshWindow.VertexColours}" InputGestureText="V" IsCheckable="True" />
                            <MenuItem x:Name="NormalsItem" Header="{l:T MeshWindow.Normals}" InputGestureText="N" IsCheckable="True" />
                            <MenuItem x:Name="BonesItem" Header="{l:T Common.Bones}" InputGestureText="K" IsCheckable="True" />
                            <MenuItem x:Name="CollisionItem" Header="{l:T MeshWindow.Collision}" InputGestureText="C" IsCheckable="True" />
                            <Separator />
                            <MenuItem x:Name="InfoItem" Header="{l:T MeshWindow.InfoPanel}" InputGestureText="I" IsCheckable="True" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
                <Button Margin="14,0,0,0" Padding="12,5" Click="Fit_Click" ToolTip="{l:T MeshWindow.FitMeshViewF}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.Fit}" />
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,0" Padding="10,5" Content="{l:T MeshWindow.Front}" Click="Front_Click" ToolTip="{l:T MeshWindow.LookFront}" />
                <Button Margin="2,0,0,0" Padding="10,5" Content="{l:T MeshWindow.Side}" Click="Side_Click" ToolTip="{l:T MeshWindow.LookRightSide}" />
                <Button Margin="2,0,0,0" Padding="10,5" Content="{l:T MeshWindow.Top}" Click="Top_Click" ToolTip="{l:T MeshWindow.LookAbove}" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="SaveButton" Padding="12,5" Margin="0,0,6,0" Click="Save_Click" IsEnabled="False" Style="{StaticResource AccentButtonStyle}"
                        ToolTip="{l:T MeshWindow.SaveChangedMaterialsInto}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T Common.SaveProject}" />
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Padding="12,5" Click="Export_Click" IsEnabled="False" ToolTip="{l:T MeshWindow.SaveLODShownChunks}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T MeshWindow.ExportOBJ}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="460" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#FF4A4F57" Offset="0" />
                            <GradientStop Color="#FF2A2D32" Offset="1" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <local:MeshView x:Name="View" />
                    <!-- what's being drawn, as a 3D view's overlay has it -->
                    <Border x:Name="InfoPanel" Margin="10,8" Padding="8,5" CornerRadius="4" HorizontalAlignment="Left" VerticalAlignment="Top"
                            Background="#88000000" IsHitTestVisible="False" Visibility="Collapsed">
                        <TextBlock x:Name="InfoOverlay" FontFamily="Cascadia Mono, Consolas" FontSize="11.5" Foreground="#E6E6EC" LineHeight="17" />
                    </Border>
                    <TextBlock x:Name="BusyText" Text="{l:T MeshWindow.ReadingMesh}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Opacity="0.8"
                               TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" IsHitTestVisible="False" />
                    <TextBlock Text="{l:T MeshWindow.DragTurnRightDrag}" Foreground="White" Opacity="0.55"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8" FontSize="11" IsHitTestVisible="False" />
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl x:Name="Tabs" Margin="6,8,6,6" Background="Transparent" BorderThickness="0">
                    <TabControl.Template>
                        <ControlTemplate TargetType="TabControl">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" HorizontalAlignment="Center" />
                                <ContentPresenter ContentSource="SelectedContent" Margin="0,4,0,0" />
                            </DockPanel>
                        </ControlTemplate>
                    </TabControl.Template>
                    <TabItem Header="{l:T MeshWindow.Materials}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="12,10">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Heading}" Text="{l:T MeshWindow.Chunks}" />
                                <ItemsControl x:Name="ChunkList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MeshChunkItem}">
                                            <CheckBox IsChecked="{Binding IsVisible}" Margin="0,0,0,2" ToolTip="{Binding Detail}">
                                                <TextBlock TextTrimming="CharacterEllipsis">
                                                    <Run Text="{Binding Title, Mode=OneWay}" />
                                                    <Run Text="{Binding Detail, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                                </TextBlock>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Style="{StaticResource Heading}" Text="{l:T MeshWindow.Materials}" Margin="2,16,0,8" />
                                <ItemsControl x:Name="MaterialList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:MeshMaterialItem}">
                                            <Border BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Source}" Opacity="0.75" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding SourceTip}" Margin="0,2,0,2" />
                                                    <Button HorizontalAlignment="Left" Margin="0,0,0,6" Cursor="Hand" Click="OpenMaterial_Click" Tag="{Binding MaterialLink}"
                                                            Visibility="{Binding MaterialLinkVisibility}" ToolTip="{l:T MeshWindow.OpenMaterialViewerEvery}">
                                                        <Button.Template>
                                                            <ControlTemplate TargetType="Button">
                                                                <TextBlock Text="{Binding MaterialLinkText}" FontSize="11" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                                            </ControlTemplate>
                                                        </Button.Template>
                                                    </Button>
                                                    <TextBlock Text="{l:T MeshWindow.ColourTexture}" Opacity="0.7" FontSize="11" Margin="0,0,0,3" />
                                                    <ComboBox ItemsSource="{Binding Options}" SelectedItem="{Binding Selected}" DisplayMemberPath="Label" ToolTip="{Binding Selected.Path}" />
                                                    <TextBlock Text="{Binding Status}" Opacity="0.7" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                        <Button Padding="10,3" Content="{l:T MeshWindow.OtherTexture}" Click="OtherTexture_Click" Tag="{Binding}" ToolTip="{l:T MeshWindow.PutAnyTextureGame}" />
                                                        <Button Margin="6,0,0,0" Padding="10,3" Content="{l:T MeshWindow.OtherMaterial}" Click="OtherMaterial_Click" Tag="{Binding}" ToolTip="{l:T MeshWindow.UseAnotherMaterialInstance}" />
                                                    </StackPanel>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                        <Button Padding="10,3" Content="{l:T MeshWindow.SaveNewMaterial}" Click="SaveNewMaterial_Click" Tag="{Binding}"
                                                                ToolTip="{l:T MeshWindow.SaveMaterialChangesNew}" />
                                                        <Button Margin="6,0,0,0" Padding="10,3" Content="{l:T MeshWindow.BackOwn}" Click="ResetMaterial_Click" Tag="{Binding}"
                                                                Visibility="{Binding ResetVisibility}" ToolTip="{l:T MeshWindow.UndoChangesUseMeshs}" />
                                                    </StackPanel>
                                                    <Expander Header="{Binding ParametersHeader}" Margin="0,6,0,0" FontSize="11">
                                                        <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,4,0,0">
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:MaterialParameterItem}">
                                                                    <StackPanel Margin="0,0,0,6">
                                                                        <DockPanel>
                                                                            <Border DockPanel.Dock="Left" Width="10" Height="10" Margin="0,0,5,0" CornerRadius="2" Background="{Binding Swatch}"
                                                                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1" Visibility="{Binding SwatchVisibility}" />
                                                                            <TextBlock Text="{Binding Name}" FontWeight="{Binding Weight}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Detail}" />
                                                                        </DockPanel>
                                                                        <DockPanel Margin="0,2,0,0">
                                                                            <Button DockPanel.Dock="Right" Padding="6,1" Margin="4,0,0,0" Content="&#xE7A7;" FontFamily="{StaticResource IconFont}"
                                                                                    Click="ResetParameter_Click" Tag="{Binding}" Visibility="{Binding ResetVisibility}" ToolTip="{l:T MeshWindow.TakeOwnValueAway}" />
                                                                            <Button DockPanel.Dock="Right" Padding="6,1" Margin="4,0,0,0" Content="…" Click="PickParameterTexture_Click" Tag="{Binding}"
                                                                                    Visibility="{Binding PickVisibility}" ToolTip="{l:T MeshWindow.PickTexture}" />
                                                                            <TextBox Text="{Binding Text, UpdateSourceTrigger=LostFocus}" IsReadOnly="{Binding IsReadOnly, Mode=OneWay}"
                                                                                     FontSize="11" Padding="4,2" MinHeight="0" KeyDown="ParameterBox_KeyDown" ToolTip="{Binding Detail}" />
                                                                        </DockPanel>
                                                                        <TextBlock Text="{Binding Error}" Foreground="#FFE0564B" FontSize="11" TextWrapping="Wrap" Visibility="{Binding ErrorVisibility}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </Expander>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{l:T Common.Properties}">
                        <DockPanel Margin="6,4,2,2">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <TextBox x:Name="PropertySearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="PropertySearch_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="PropertySearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="{l:T Common.FindPropertiesNameValue}" />
                            </Grid>
                            <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                            <local:PropertyListView x:Name="Properties" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="{l:T MeshWindow.LODs}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                            <StackPanel x:Name="LodPanel" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{l:T MeshWindow.Report}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                            <StackPanel x:Name="ReportPanel" />
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{l:T MeshWindow.Collision}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="8,4">
                            <StackPanel x:Name="CollisionPanel" />
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock x:Name="InfoText" Grid.Row="2" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />

        <local:QuickPick x:Name="Picker" Grid.RowSpan="3" Margin="0,46,0,0" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="3" IsModal="True" />
    </Grid>
</Window>
