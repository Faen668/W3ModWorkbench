<Window x:Class="W3ModWorkbench.TextureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T TextureWindow.Texture}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="800" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <!-- one of a row of joined choices -->
        <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF3A3A3A"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#FF4A4A4A">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel x:Name="Toolbar" Grid.Row="0" Margin="14,12,14,10" LastChildFill="False" SizeChanged="Toolbar_SizeChanged">
            <StackPanel x:Name="LeftTools" Orientation="Horizontal" DockPanel.Dock="Left" SizeChanged="Toolbar_SizeChanged">
                <RadioButton x:Name="ChannelRgba" Style="{StaticResource Segment}" GroupName="Channel" Content="{l:T TextureWindow.Rgba}" IsChecked="True" Checked="Channel_Checked" ToolTip="{l:T TextureWindow.AllChannelsOverChequerboard}" />
                <RadioButton x:Name="ChannelRgb" Style="{StaticResource Segment}" GroupName="Channel" Content="{l:T TextureWindow.RGB}" Checked="Channel_Checked" ToolTip="{l:T TextureWindow.ColourWithoutTransparency}" />
                <RadioButton x:Name="ChannelR" Style="{StaticResource Segment}" GroupName="Channel" Content="R" Checked="Channel_Checked" />
                <RadioButton x:Name="ChannelG" Style="{StaticResource Segment}" GroupName="Channel" Content="G" Checked="Channel_Checked" />
                <RadioButton x:Name="ChannelB" Style="{StaticResource Segment}" GroupName="Channel" Content="B" Checked="Channel_Checked" />
                <RadioButton x:Name="ChannelA" Style="{StaticResource Segment}" GroupName="Channel" Content="A" Checked="Channel_Checked" ToolTip="{l:T TextureWindow.AlphaChannelGrey}" />
                <TextBlock Text="{l:T TextureWindow.Mip}" VerticalAlignment="Center" Margin="18,0,8,0" Opacity="0.7" />
                <ComboBox x:Name="MipBox" MinWidth="150" SelectionChanged="Mip_SelectionChanged" />
                <TextBlock x:Name="SliceLabel" Text="{l:T TextureWindow.Slice}" VerticalAlignment="Center" Margin="14,0,8,0" Opacity="0.7" Visibility="Collapsed" />
                <ComboBox x:Name="SliceBox" Width="110" SelectionChanged="Mip_SelectionChanged" Visibility="Collapsed" />
                <RadioButton x:Name="View2D" Style="{StaticResource Segment}" GroupName="View" Margin="18,0,2,0" Content="{l:T TextureWindow.D}" IsChecked="True" Checked="View_Checked" ToolTip="{l:T TextureWindow.TexturePicture}" />
                <RadioButton x:Name="View3D" Style="{StaticResource Segment}" GroupName="View" Content="{l:T TextureWindow.D2}" Checked="View_Checked" ToolTip="{l:T TextureWindow.TextureShapeLitREDkits}" />
                <ToggleButton x:Name="FitToggle" Margin="12,0,0,0" Padding="12,5" Content="{l:T Common.Fit}" IsChecked="True" Click="Fit_Click" ToolTip="{l:T TextureWindow.FitWindowShowSize}" />
                <StackPanel x:Name="ShapeBar" Orientation="Horizontal" Visibility="Collapsed">
                    <ComboBox x:Name="ShapeBox" Margin="12,0,0,0" Width="110" SelectionChanged="Shape_SelectionChanged" ToolTip="{l:T TextureWindow.ShapePutTextureCube}">
                        <ComboBoxItem Content="{l:T TextureWindow.Sphere}" IsSelected="True" />
                        <ComboBoxItem Content="{l:T TextureWindow.Box}" />
                        <ComboBoxItem Content="{l:T TextureWindow.Cylinder}" />
                        <ComboBoxItem Content="{l:T TextureWindow.Plane}" />
                    </ComboBox>
                    <TextBlock Text="{l:T TextureWindow.Light}" VerticalAlignment="Center" Margin="14,0,8,0" Opacity="0.7" />
                    <Slider x:Name="LightSlider" Width="110" Minimum="-180" Maximum="180" Value="45" VerticalAlignment="Center"
                            ValueChanged="Light_ValueChanged" ToolTip="{l:T TextureWindow.WhereLightComesRound}" />
                </StackPanel>
            </StackPanel>
            <StackPanel x:Name="RightTools" Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="ReplaceButton" Margin="0,0,6,0" Padding="12,5" Click="Replace_Click" Visibility="Collapsed" ToolTip="{l:T TextureReplacer.Tip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xEB9F;" Margin="0,1,0,0" />
                        <TextBlock x:Name="ReplaceLabel" Margin="8,0,0,0" Text="{l:T TextureReplacer.Button}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SavePngButton" Padding="12,5" Click="SavePng_Click" IsEnabled="False" ToolTip="{l:T TextureWindow.SaveMipLevelShown}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,1,0,0" />
                        <TextBlock x:Name="SavePngLabel" Margin="8,0,0,0" Text="{l:T TextureWindow.SavePNG}" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveDdsButton" Margin="6,0,0,0" Padding="12,5" Click="SaveDds_Click" IsEnabled="False" ToolTip="{l:T TextureWindow.SaveWholeTextureEvery}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,1,0,0" />
                        <TextBlock x:Name="SaveDdsLabel" Margin="8,0,0,0" Text="{l:T TextureWindow.SaveDDS}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="360" MinWidth="220" />
            </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <local:TexturePreview3D x:Name="Preview3D" Visibility="Collapsed" />
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Scroller_PreviewMouseWheel"
                              Background="Transparent">
                    <Border x:Name="Backdrop" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,12,26,26" Background="{StaticResource Checker}">
                        <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </ScrollViewer>
                <TextBlock x:Name="BusyText" Text="{l:T TextureWindow.ReadingTexture}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                    <TextBox x:Name="PropertySearch" Padding="30,5,8,5" TextChanged="PropertySearch_TextChanged"
                             ToolTip="{l:T TextureWindow.ShowOnlyPropertiesWhose}" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="PropertySearchPlaceholder" Text="{l:T Common.SearchProperties}" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="10,0,10,6" />
                <local:PropertyListView x:Name="Properties" NameColumnWidth="190" TypeColumnWidth="0" LinkClicked="Properties_LinkClicked" />
            </DockPanel>
        </Border>
        </Grid>

        <DockPanel Grid.Row="2" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <local:MessageCard x:Name="Message" Grid.RowSpan="3" IsModal="True" />
    </Grid>
</Window>
