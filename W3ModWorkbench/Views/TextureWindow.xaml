<Window x:Class="W3ModWorkbench.TextureWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="Texture" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="800" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <!-- one of a row of joined choices -->
        <Style x:Key="Segment" TargetType="RadioButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
        <DrawingBrush x:Key="Checker" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
            <DrawingBrush.Drawing>
                <DrawingGroup>
                    <GeometryDrawing Brush="#FF3A3A3A"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry></GeometryDrawing>
                    <GeometryDrawing Brush="#FF4A4A4A">
                        <GeometryDrawing.Geometry>
                            <GeometryGroup>
                                <RectangleGeometry Rect="0,0,8,8" />
                                <RectangleGeometry Rect="8,8,8,8" />
                            </GeometryGroup>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingBrush.Drawing>
        </DrawingBrush>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="14,12,14,10" LastChildFill="False">
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                <RadioButton x:Name="ChannelRgba" Style="{StaticResource Segment}" GroupName="Channel" Content="RGBA" IsChecked="True" Checked="Channel_Checked" ToolTip="All channels, over a chequerboard" />
                <RadioButton x:Name="ChannelRgb" Style="{StaticResource Segment}" GroupName="Channel" Content="RGB" Checked="Channel_Checked" ToolTip="Colour without transparency" />
                <RadioButton x:Name="ChannelR" Style="{StaticResource Segment}" GroupName="Channel" Content="R" Checked="Channel_Checked" />
                <RadioButton x:Name="ChannelG" Style="{StaticResource Segment}" GroupName="Channel" Content="G" Checked="Channel_Checked" />
                <RadioButton x:Name="ChannelB" Style="{StaticResource Segment}" GroupName="Channel" Content="B" Checked="Channel_Checked" />
                <RadioButton x:Name="ChannelA" Style="{StaticResource Segment}" GroupName="Channel" Content="A" Checked="Channel_Checked" ToolTip="The alpha channel, as grey" />
                <TextBlock Text="Mip" VerticalAlignment="Center" Margin="18,0,8,0" Opacity="0.7" />
                <ComboBox x:Name="MipBox" Width="150" SelectionChanged="Mip_SelectionChanged" />
                <TextBlock x:Name="SliceLabel" Text="Slice" VerticalAlignment="Center" Margin="14,0,8,0" Opacity="0.7" Visibility="Collapsed" />
                <ComboBox x:Name="SliceBox" Width="110" SelectionChanged="Mip_SelectionChanged" Visibility="Collapsed" />
                <RadioButton x:Name="View2D" Style="{StaticResource Segment}" GroupName="View" Margin="18,0,2,0" Content="2D" IsChecked="True" Checked="View_Checked" ToolTip="The texture as a picture" />
                <RadioButton x:Name="View3D" Style="{StaticResource Segment}" GroupName="View" Content="3D" Checked="View_Checked" ToolTip="The texture on a shape, lit, as REDkit's texture viewer shows it" />
                <ToggleButton x:Name="FitToggle" Margin="12,0,0,0" Padding="12,5" Content="Fit" IsChecked="True" Click="Fit_Click" ToolTip="Fit the window, or show at its size (Ctrl+wheel zooms)" />
                <StackPanel x:Name="ShapeBar" Orientation="Horizontal" Visibility="Collapsed">
                    <ComboBox x:Name="ShapeBox" Margin="12,0,0,0" Width="110" SelectionChanged="Shape_SelectionChanged" ToolTip="The shape to put the texture on (a cube map goes round it, each part showing the face it looks at)">
                        <ComboBoxItem Content="Sphere" IsSelected="True" />
                        <ComboBoxItem Content="Box" />
                        <ComboBoxItem Content="Cylinder" />
                        <ComboBoxItem Content="Plane" />
                    </ComboBox>
                    <TextBlock Text="Light" VerticalAlignment="Center" Margin="14,0,8,0" Opacity="0.7" />
                    <Slider x:Name="LightSlider" Width="110" Minimum="-180" Maximum="180" Value="45" VerticalAlignment="Center"
                            ValueChanged="Light_ValueChanged" ToolTip="Where the light comes from, round the shape" />
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <Button x:Name="SavePngButton" Padding="12,5" Click="SavePng_Click" IsEnabled="False" ToolTip="Save the mip level shown as a PNG">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="Save PNG" />
                    </StackPanel>
                </Button>
                <Button x:Name="SaveDdsButton" Margin="6,0,0,0" Padding="12,5" Click="SaveDds_Click" IsEnabled="False" ToolTip="Save the whole texture, every mip level, as a .dds">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="Save DDS" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1" Margin="14,0,14,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="360" MinWidth="220" />
            </Grid.ColumnDefinitions>
        <Border Style="{StaticResource Card}" ClipToBounds="True">
            <Grid>
                <local:TexturePreview3D x:Name="Preview3D" Visibility="Collapsed" />
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" PreviewMouseWheel="Scroller_PreviewMouseWheel"
                              Background="Transparent">
                    <Border x:Name="Backdrop" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="12,12,26,26" Background="{StaticResource Checker}">
                        <Image x:Name="Picture" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                    </Border>
                </ScrollViewer>
                <TextBlock x:Name="BusyText" Text="Reading the texture…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.7" />
            </Grid>
        </Border>
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
        <Border Grid.Column="2" Style="{StaticResource Card}">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="10,10,10,6">
                    <TextBox x:Name="PropertySearch" Padding="30,5,8,5" TextChanged="PropertySearch_TextChanged"
                             ToolTip="Show only the properties whose name or value has this" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="PropertySearchPlaceholder" Text="Search properties" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="10,0,10,6" />
                <local:PropertyListView x:Name="Properties" NameColumnWidth="190" TypeColumnWidth="0" LinkClicked="Properties_LinkClicked" />
            </DockPanel>
        </Border>
        </Grid>

        <TextBlock x:Name="InfoText" Grid.Row="2" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />

        <local:MessageCard x:Name="Message" Grid.RowSpan="3" IsModal="True" />
    </Grid>
</Window>
