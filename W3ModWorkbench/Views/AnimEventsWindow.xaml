<Window x:Class="W3ModWorkbench.AnimEventsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T AnimEventsWindow.AnimationEvents}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1500" Height="950" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="260" />
                <RowDefinition Height="8" />
                <RowDefinition Height="280" MinHeight="120" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="640" MinWidth="320" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- the animation, in 3D -->
                <Border Style="{StaticResource Card}">
                    <DockPanel Margin="8">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="{l:T Common.Preview}" VerticalAlignment="Center" Opacity="0.75" Margin="2,0,8,0" />
                            <ComboBox x:Name="EntityBox" MinWidth="110" SelectionChanged="EntityBox_SelectionChanged" ToolTip="{l:T AnimEventsWindow.CharacterAnimationsPlay}" />
                            <TextBlock Text="{l:T Common.AnimationSet}" VerticalAlignment="Center" Opacity="0.75" Margin="12,0,8,0" />
                            <ComboBox x:Name="SetBox" IsTextSearchEnabled="True" SelectionChanged="SetBox_SelectionChanged"
                                      ToolTip="{l:T AnimEventsWindow.AnimationSetEventsFound}" />
                        </DockPanel>
                        <local:AnimationPreview x:Name="Preview" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <TabControl x:Name="Tabs" Margin="6,4,6,6">
                        <TabItem x:Name="AnimationsTab" Header="{l:T Common.Animations}">
                            <DockPanel Margin="0,6,0,0">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBox x:Name="FilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                    <TextBlock x:Name="FilterPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Text="{l:T AnimEventsWindow.ShowOnlyAnimationsThese}" />
                                </Grid>
                                <TextBlock x:Name="SetNote" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,6" />
                                <ListBox x:Name="AnimationList" SelectionChanged="AnimationList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Vertical" />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" MinWidth="300" ToolTip="{Binding Tip}">
                                                <TextBlock Text="{Binding Name}" Opacity="{Binding Opacity}" />
                                                <TextBlock Text="{Binding Note}" Margin="8,0,0,0" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="EventTab" Header="{l:T AnimEventsWindow.Event}">
                            <DockPanel Margin="4,8,0,0">
                                <TextBlock x:Name="EventTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{l:T AnimEventsWindow.ClickEventTimeline}" />
                                <TextBlock x:Name="EventDetail" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <local:PropertyListView x:Name="EventProperties" LinkClicked="Properties_LinkClicked" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="{l:T Common.File}">
                            <DockPanel Margin="4,8,0,0">
                                <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                                <local:PropertyListView x:Name="FileProperties" LinkClicked="Properties_LinkClicked" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the animation's events, along its length -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel Margin="8,6,8,6">
                    <TextBlock x:Name="TimelineTitle" DockPanel.Dock="Top" Style="{StaticResource Small}" Margin="2,0,0,4"
                               Text="{l:T AnimEventsWindow.PickAnimationSeeEvents}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <local:EventTimeline x:Name="Timeline" EventClicked="Timeline_EventClicked" EventOpened="Timeline_EventOpened" TimePicked="Timeline_TimePicked" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T AnimEventsWindow.ReadingEvents}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <DockPanel Grid.Row="1" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
