<Window x:Class="W3ModWorkbench.AssetBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:vm="clr-namespace:W3ModWorkbench.ViewModels"
        Title="Asset Browser" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="820" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="NameCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
        </Style>
        <Style x:Key="DimCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- a soft accent tint marks the selection, as in the main window's file list -->
        <Style x:Key="FileGridCell" TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Rectangle x:Name="Highlight" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- search, class filter, bookmarks, and whether to ask which copy to open -->
        <DockPanel Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!-- search, then file type, then class, as in the main window -->
                <TextBlock Text="File type" VerticalAlignment="Center" Margin="12,0,8,0" Opacity="0.7" />
                <ComboBox x:Name="FileTypeBox" Width="150" IsTextSearchEnabled="True" TextSearch.TextPath="Name" SelectionChanged="FileTypeBox_SelectionChanged"
                          ToolTip="Show only files of one type (.w2mesh, .xbm, .w2ent…)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding CountText}" Opacity="0.5" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="Class" VerticalAlignment="Center" Margin="12,0,8,0" Opacity="0.7" />
                <ComboBox x:Name="ClassBox" Width="230" IsTextSearchEnabled="True" TextSearch.TextPath="Name" SelectionChanged="ClassBox_SelectionChanged"
                          ToolTip="Show only files that hold one class of resource, as REDkit's asset browser does (CMesh, CBitmapTexture, CEntityTemplate…)">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding CountText}" Opacity="0.5" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="BookmarkButton" Margin="8,0,0,0" Padding="8,6" Click="Bookmark_Click" IsEnabled="False"
                        ToolTip="Bookmark the folder you're in, to come back to it from the bookmarks list">
                    <TextBlock x:Name="BookmarkGlyph" Style="{StaticResource IconText}" Text="&#xE734;" />
                </Button>
                <Button x:Name="BookmarksButton" Margin="4,0,0,0" Padding="8,6" Click="Bookmarks_Click" ToolTip="Go to a bookmarked folder or file">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8A4;" Margin="0,1,0,0" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="6,2,0,0" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="AskToggle" Margin="8,0,0,0" Padding="10,6" Click="Ask_Click"
                              ToolTip="When a file is in more than one place (a mod, a DLC, the game), ask which copy to open">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                        <TextBlock Margin="8,0,0,0" Text="Ask which copy" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <Grid>
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="34,6,10,6" TextChanged="SearchBox_TextChanged"
                         ToolTip="Words must all appear in the path. Use * and ? to match file names, e.g. *.w2mesh" />
                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" Margin="12,0,0,0" Opacity="0.6" IsHitTestVisible="False" HorizontalAlignment="Left" />
                <TextBlock x:Name="SearchPlaceholder" Text="Search the game's files (Ctrl+F)" Margin="36,0,0,0"
                           VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="180" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="2,6">
                <TreeView x:Name="FolderTree" BorderThickness="0" Background="Transparent" VirtualizingPanel.IsVirtualizing="False"
                          SelectedItemChanged="FolderTree_SelectedItemChanged">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Icon" Style="{StaticResource IconText}" Text="{Binding Glyph}" Margin="0,0,8,0" />
                                <TextBlock x:Name="NameText" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding TotalFiles, StringFormat='  {0:N0}'}" Opacity="0.5" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Game files and Mods stand out from what's under them -->
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                              SelectionMode="Extended" SelectionUnit="FullRow" CanUserResizeRows="False" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              CellStyle="{StaticResource FileGridCell}" MouseDoubleClick="FileGrid_MouseDoubleClick"
                              ContextMenuOpening="FileGrid_ContextMenuOpening">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*" MinWidth="140" ElementStyle="{StaticResource NameCellText}" />
                            <DataGridTextColumn Header="Folder" Binding="{Binding Folder}" Width="3*" MinWidth="120" ElementStyle="{StaticResource DimCellText}" />
                            <DataGridTextColumn Header="Class" Binding="{Binding ResourceClass}" Width="150" ElementStyle="{StaticResource DimCellText}" />
                            <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightText}" />
                            <DataGridTextColumn Header="From" Binding="{Binding BundleName}" Width="210" ElementStyle="{StaticResource DimCellText}" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Open" InputGestureText="Enter" Click="Open_Click" FontWeight="SemiBold" />
                                <MenuItem x:Name="OpenCopyItem" Header="Open another copy…" Click="OpenCopy_Click" />
                                <MenuItem Header="Preview" Click="Preview_Click" />
                                <MenuItem Header="Properties" Click="Properties_Click" />
                                <MenuItem Header="Open as JSON" Click="Json_Click" />
                                <Separator />
                                <MenuItem Header="Copy to project" Click="CopyToProject_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="Extract highlighted" Click="Extract_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE896;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="BookmarkItem" Header="Bookmark" Click="BookmarkFiles_Click" />
                                <MenuItem Header="Other copies of this file…" Click="Copies_Click" />
                                <Separator />
                                <MenuItem Header="Copy">
                                    <MenuItem Header="Path" InputGestureText="Ctrl+C" Click="CopyPath_Click" />
                                    <MenuItem Header="Name" Click="CopyName_Click" />
                                    <MenuItem Header="Folder" Click="CopyFolder_Click" />
                                    <MenuItem Header="Location on disk" Click="CopyLocation_Click" />
                                </MenuItem>
                                <MenuItem Header="Show in Explorer" Click="Reveal_Click" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <TextBlock x:Name="NoMatchesText" Text="No files match." HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                               Visibility="Collapsed" IsHitTestVisible="False" />
                </Grid>
            </Border>
            <!-- the game's files are read the first time it opens -->
            <local:LoadingPanel x:Name="Loading" Grid.ColumnSpan="3" Visibility="Collapsed" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,8,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
