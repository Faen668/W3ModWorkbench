<Window x:Class="W3ModWorkbench.AssetBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:vm="clr-namespace:W3ModWorkbench.ViewModels"
        Title="{l:T AssetBrowserWindow.AssetBrowser}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="820" MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <Style x:Key="NameCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="ToolTip" Value="{Binding ToolTip}" />
            <Setter Property="ToolTipService.InitialShowDelay" Value="600" />
        </Style>
        <Style x:Key="DimCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style x:Key="RightText" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <!-- a soft accent tint marks the selection, as in the main window's file list -->
        <Style x:Key="FileGridCell" TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Rectangle x:Name="Highlight" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <ContentPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- search, class filter, bookmarks, and whether to ask which copy to open; then the folder, regex and part of the game -->
        <StackPanel Margin="0,0,0,10">
        <DockPanel LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <!-- search, then file type, then class, as in the main window -->
                <TextBlock Text="{l:T AssetBrowserWindow.FileType}" VerticalAlignment="Center" Margin="12,0,8,0" Opacity="0.7" />
                <ComboBox x:Name="FileTypeBox" Width="150" IsTextSearchEnabled="True" TextSearch.TextPath="Name" SelectionChanged="FileTypeBox_SelectionChanged"
                          ToolTip="{l:T AssetBrowserWindow.ShowOnlyFilesOne}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding CountText}" Opacity="0.5" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBlock Text="{l:T AssetBrowserWindow.Class}" VerticalAlignment="Center" Margin="12,0,8,0" Opacity="0.7" />
                <ComboBox x:Name="ClassBox" Width="230" IsTextSearchEnabled="True" TextSearch.TextPath="Name" SelectionChanged="ClassBox_SelectionChanged"
                          ToolTip="{l:T AssetBrowserWindow.ShowOnlyFilesHold}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding CountText}" Opacity="0.5" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="ViewButton" Margin="8,0,0,0" Click="View_Click"
                        ToolTip="{l:T AssetBrowserWindow.ShowFilesListThumbnails}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8FD;" Margin="0,1,0,0" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T AssetBrowserWindow.View}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="8,2,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="BookmarkButton" Margin="8,0,0,0" Padding="8,6" Click="Bookmark_Click" IsEnabled="False"
                        ToolTip="{l:T AssetBrowserWindow.BookmarkFolderYoureCome}">
                    <TextBlock x:Name="BookmarkGlyph" Style="{StaticResource IconText}" Text="&#xE734;" />
                </Button>
                <Button x:Name="BookmarksButton" Margin="4,0,0,0" Padding="8,6" Click="Bookmarks_Click" ToolTip="{l:T AssetBrowserWindow.GoBookmarkedFolderFile}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE728;" Margin="0,1,0,0" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="6,2,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="RecentButton" Margin="4,0,0,0" Padding="8,6" Click="Recent_Click" ToolTip="{l:T AssetBrowserWindow.GoFileYouOpened}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE81C;" Margin="0,1,0,0" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="6,2,0,0" />
                    </StackPanel>
                </Button>
                <ToggleButton x:Name="AskToggle" Margin="8,0,0,0" Padding="10,6" Click="Ask_Click"
                              ToolTip="{l:T AssetBrowserWindow.WhenFileMoreThan}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                        <TextBlock Margin="8,0,0,0" Text="{l:T AssetBrowserWindow.AskWhichCopy}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>
            <Grid>
                <TextBox x:Name="SearchBox" VerticalContentAlignment="Center" Padding="34,6,10,6" TextChanged="SearchBox_TextChanged"
                         ToolTip="{l:T AssetBrowserWindow.WordsMustAllAppear}" />
                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" Margin="12,0,0,0" Opacity="0.6" IsHitTestVisible="False" HorizontalAlignment="Left" />
                <TextBlock x:Name="SearchPlaceholder" Text="{l:T AssetBrowserWindow.SearchGamesFilesCtrl}" Margin="36,0,0,0"
                           VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False" />
            </Grid>
        </DockPanel>
        <DockPanel Margin="0,8,0,0" LastChildFill="False">
            <!-- EasyAssetBrowser is off until the user agrees to it going online -->
            <Button x:Name="EabOffButton" DockPanel.Dock="Right" Click="EabOff_Click"
                    ToolTip="{l:T AssetBrowserWindow.CategoriesTagsGamesAssets}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8EC;" Margin="0,1,0,0" />
                    <TextBlock Margin="8,0,0,0" Text="{l:T AssetBrowserWindow.EasyAssetBrowserTags}" />
                </StackPanel>
            </Button>
            <!-- EasyAssetBrowser's categories and tags, named as its own -->
            <StackPanel x:Name="EabPanel" DockPanel.Dock="Right" Orientation="Horizontal">
                <TextBlock Text="{l:T AssetBrowserWindow.EABCategory}" VerticalAlignment="Center" Margin="12,0,8,0" Opacity="0.7" />
                <ComboBox x:Name="EabCategoryBox" Width="170" SelectionChanged="EabCategoryBox_SelectionChanged" IsEnabled="False"
                          ToolTip="{l:T AssetBrowserWindow.ShowOnlyFilesEasyAssetBrowser}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" />
                                <TextBlock Text="{Binding CountText}" Opacity="0.5" Margin="8,0,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button x:Name="EabTagsButton" Margin="8,0,0,0" Click="EabTags_Click" IsEnabled="False"
                        ToolTip="{l:T AssetBrowserWindow.ShowOnlyFilesEasyAssetBrowser2}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE8EC;" Margin="0,1,0,0" />
                        <TextBlock x:Name="EabTagsText" Margin="8,0,0,0" Text="{l:T AssetBrowserWindow.EABTags}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="8,2,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="EabButton" Margin="4,0,0,0" Padding="8,6" Click="EabMenu_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" Margin="0,1,0,0" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="6,2,0,0" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <Grid Width="360">
                <TextBox x:Name="FolderBox" VerticalContentAlignment="Center" Padding="34,6,10,6" TextChanged="FolderBox_TextChanged" />
                <TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" Margin="12,0,0,0" Opacity="0.6" IsHitTestVisible="False" HorizontalAlignment="Left" />
                <TextBlock x:Name="FolderPlaceholder" Text="{l:T Common.Folder}" Margin="36,0,0,0" VerticalAlignment="Center" Opacity="0.5" IsHitTestVisible="False" />
            </Grid>
            <ToggleButton x:Name="RegexToggle" Margin="8,0,0,0" Padding="10,6" Click="Regex_Click"
                          ToolTip="{l:T AssetBrowserWindow.ReadSearchRegularExpression}">
                <TextBlock Text="{l:T AssetBrowserWindow.Regex}" />
            </ToggleButton>
            <Button x:Name="SourcesButton" Margin="8,0,0,0" Click="Sources_Click"
                    ToolTip="{l:T AssetBrowserWindow.ShowOnlySomeParts}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE71C;" Margin="0,1,0,0" />
                    <TextBlock x:Name="SourcesText" Margin="8,0,0,0" Text="{l:T AssetBrowserWindow.WholeGame}" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE70D;" FontSize="9" Margin="8,2,0,0" />
                </StackPanel>
            </Button>
            <!-- only while something narrows the list -->
            <Button x:Name="ClearFiltersButton" Margin="8,0,0,0" Click="ClearFilters_Click" Visibility="Collapsed"
                    ToolTip="{l:T AssetBrowserWindow.TakeOffEveryFilter}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE894;" Margin="0,1,0,0" />
                    <TextBlock Margin="8,0,0,0" Text="{l:T AssetBrowserWindow.ClearFilters}" />
                </StackPanel>
            </Button>
        </DockPanel>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" MinWidth="180" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition x:Name="PreviewSplitterColumn" Width="0" />
                <ColumnDefinition x:Name="PreviewColumn" Width="0" MinWidth="0" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="2,6">
                <TreeView x:Name="FolderTree" BorderThickness="0" Background="Transparent" VirtualizingPanel.IsVirtualizing="False"
                          SelectedItemChanged="FolderTree_SelectedItemChanged" PreviewMouseLeftButtonDown="FolderTree_PreviewMouseLeftButtonDown">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate DataType="{x:Type vm:FolderNode}" ItemsSource="{Binding Children}">
                            <StackPanel x:Name="Row" Orientation="Horizontal" ToolTip="{Binding ToolTip}" ToolTipService.InitialShowDelay="500">
                                <TextBlock x:Name="Icon" Style="{StaticResource IconText}" Text="{Binding Glyph}" Margin="0,0,8,0" />
                                <TextBlock x:Name="NameText" Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                <TextBlock x:Name="CountText" Text="{Binding TotalFiles, StringFormat='  {0:N0}'}" Opacity="0.5" VerticalAlignment="Center" />
                            </StackPanel>
                            <!-- Game files and Mods stand out from what's under them -->
                            <HierarchicalDataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsHeading}" Value="True">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <!-- REDkit before Settings has it: greyed, its tooltip saying how to set it up -->
                                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                                    <Setter TargetName="Row" Property="Opacity" Value="0.45" />
                                    <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </HierarchicalDataTemplate.Triggers>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </Border>
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                <Grid>
                    <DataGrid x:Name="FileGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                              SelectionMode="Extended" SelectionUnit="FullRow" CanUserResizeRows="False" CanUserAddRows="False"
                              EnableRowVirtualization="True" EnableColumnVirtualization="True"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                              CellStyle="{StaticResource FileGridCell}" MouseDoubleClick="FileGrid_MouseDoubleClick"
                              ContextMenuOpening="FileGrid_ContextMenuOpening" SelectionChanged="FileGrid_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{l:T Common.Name}" Binding="{Binding Name}" Width="3*" MinWidth="140" ElementStyle="{StaticResource NameCellText}" />
                            <DataGridTextColumn Header="{l:T Common.Folder}" Binding="{Binding Folder}" Width="3*" MinWidth="120" ElementStyle="{StaticResource DimCellText}" />
                            <DataGridTextColumn Header="{l:T AssetBrowserWindow.Class}" Binding="{Binding ResourceClass}" Width="150" ElementStyle="{StaticResource DimCellText}" />
                            <DataGridTextColumn Header="{l:T Common.Size}" Binding="{Binding SizeText}" SortMemberPath="Size" Width="90" ElementStyle="{StaticResource RightText}" />
                            <DataGridTextColumn Header="{l:T Common.From}" Binding="{Binding BundleName}" Width="210" ElementStyle="{StaticResource DimCellText}" />
                            <DataGridTextColumn x:Name="EabCategoryColumn" Header="{l:T AssetBrowserWindow.EABCategory}" Binding="{Binding EabCategory}" Width="100" ElementStyle="{StaticResource DimCellText}" Visibility="Collapsed" />
                            <DataGridTextColumn x:Name="EabTagsColumn" Header="{l:T AssetBrowserWindow.EABTags}" Binding="{Binding EabTags}" Width="160" ElementStyle="{StaticResource DimCellText}" Visibility="Collapsed" />
                        </DataGrid.Columns>
                        <DataGrid.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="{l:T Common.Open}" InputGestureText="Enter" Click="Open_Click" FontWeight="SemiBold">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" FontWeight="Normal" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="OpenCopyItem" Header="{l:T AssetBrowserWindow.OpenAnotherCopy}" Click="OpenCopy_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE7AC;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T Common.Preview2}" Click="Preview_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE890;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T Common.Properties}" Click="Properties_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE713;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T Common.OpenJson}" Click="Json_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE943;" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{l:T Common.CopyProject}" Click="CopyToProject_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="CompareItem" Header="{l:T MainWindow.CompareTwo}" Click="Compare_Click" ToolTip="{l:T CompareWindow.TwoTip}">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8F1;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T ModMaker.MenuItem}" Click="MakeMod_Click" ToolTip="{l:T ModMaker.ButtonTip}">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE896;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T AssetBrowserWindow.ExtractHighlighted}" Click="Extract_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE896;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="BookmarkItem" Header="{l:T AssetBrowserWindow.Bookmark}" Click="BookmarkFiles_Click">
                                    <MenuItem.Icon><TextBlock x:Name="BookmarkItemGlyph" Style="{StaticResource IconText}" Text="&#xE734;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T AssetBrowserWindow.OtherCopiesFile}" Click="Copies_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8F1;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="{l:T AssetBrowserWindow.WhatUsesFile}" Click="WhatUses_Click"
                                          ToolTip="{l:T AssetBrowserWindow.FilesReferEntityMesh}">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE71B;" /></MenuItem.Icon>
                                </MenuItem>
                                <MenuItem x:Name="EabDetailsItem" Header="{l:T AssetBrowserWindow.ViewEABDetails}" Click="EabDetails_Click"
                                          ToolTip="{l:T AssetBrowserWindow.WhatEasyAssetBrowserHasFiles}">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE946;" /></MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="{l:T Common.Copy}">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE77F;" /></MenuItem.Icon>
                                    <MenuItem Header="{l:T Common.Path}" InputGestureText="Ctrl+C" Click="CopyPath_Click">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE7C3;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:T Common.Name}" Click="CopyName_Click">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8AC;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:T Common.Folder}" Click="CopyFolder_Click">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE8B7;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:T AssetBrowserWindow.LocationDisk}" Click="CopyLocation_Click">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xEDA2;" /></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="{l:T AssetBrowserWindow.LinkOpenW3Mod}" Click="CopyAppLink_Click"
                                              ToolTip="{l:T AssetBrowserWindow.W3modworkbenchLinkShowsFile}">
                                        <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xE71B;" /></MenuItem.Icon>
                                    </MenuItem>
                                </MenuItem>
                                <MenuItem Header="{l:T Common.ShowExplorer}" Click="Reveal_Click">
                                    <MenuItem.Icon><TextBlock Style="{StaticResource IconText}" Text="&#xEC50;" /></MenuItem.Icon>
                                </MenuItem>
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                    </DataGrid>
                    <!-- the same files as pictures, in rows -->
                    <local:FileThumbnails x:Name="FileThumbs" Visibility="Collapsed" ShowChecks="False" ContextMenuOpening="FileGrid_ContextMenuOpening" />
                    <TextBlock x:Name="NoMatchesText" Text="{l:T AssetBrowserWindow.NoFilesMatch}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.6"
                               Visibility="Collapsed" IsHitTestVisible="False" />
                    <!-- REDkit picked before Settings has it -->
                    <StackPanel x:Name="RedkitSetupPanel" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="Collapsed">
                        <TextBlock Text="{l:T AssetBrowserWindow.REDkitIsntSetUp}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" TextAlignment="Center" Opacity="0.75"
                                   Text="{l:T AssetBrowserWindow.REDkitKeepsOwnCopies}" />
                        <Button Margin="0,14,0,0" HorizontalAlignment="Center" Padding="14,6" Click="RedkitSetup_Click" Style="{DynamicResource AccentButtonStyle}" Content="{l:T AssetBrowserWindow.SetUpREDkitSettings}" />
                    </StackPanel>
                </Grid>
            </Border>
            <GridSplitter x:Name="PreviewSplitter" Grid.Column="3" Width="8" HorizontalAlignment="Stretch" Background="Transparent"
                          Visibility="Collapsed" DragCompleted="PreviewSplitter_DragCompleted" />
            <!-- the file highlighted, as in the main window's preview pane -->
            <local:FilePreview x:Name="PreviewPane" Grid.Column="4" Visibility="Collapsed" />
            <!-- the game's files are read the first time it opens -->
            <local:LoadingPanel x:Name="Loading" Grid.ColumnSpan="5" Visibility="Collapsed" />
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Margin="2,8,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis" />
    </Grid>
</Window>
