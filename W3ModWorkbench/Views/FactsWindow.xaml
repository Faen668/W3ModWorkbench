<Window x:Class="W3ModWorkbench.FactsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:scripts="clr-namespace:W3ModWorkbench.Core.Scripts"
        Title="{l:T FactsWindow.QuestFacts}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1180" Height="740" MinWidth="780" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,10">
                <TextBlock Text="{l:T FactsWindow.QuestFacts}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock x:Name="DetailText" Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Text="{l:T FactsWindow.EveryFactScriptsSet}" />
            </StackPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ComboBox x:Name="FilterBox" Width="190" SelectionChanged="Filter_Changed" Margin="0,0,12,0">
                        <ComboBoxItem Content="{l:T FactsWindow.AllFacts}" IsSelected="True" />
                        <ComboBoxItem Content="{l:T FactsWindow.UsedProjectMods}" ToolTip="{l:T FactsWindow.FactsModYourProject}" />
                        <ComboBoxItem Content="{l:T FactsWindow.SetButNeverRead}" ToolTip="{l:T FactsWindow.NoScriptReadsThem}" />
                        <ComboBoxItem Content="{l:T FactsWindow.ReadButNeverSet}" ToolTip="{l:T FactsWindow.NoScriptSetsThem}" />
                        <ComboBoxItem Content="{l:T FactsWindow.NamesBuiltCode}" ToolTip="{l:T FactsWindow.CallsWhoseFactName}" />
                    </ComboBox>
                    <CheckBox x:Name="ModsCheck" Content="{l:T Common.InstalledMods}" IsChecked="True" MinWidth="0" Click="Sources_Click"
                              ToolTip="{l:T FactsWindow.GameModsFolderEach}" />
                </StackPanel>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="32,6,8,6" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="11,0,0,0" Opacity="0.6"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchPlaceholder" Margin="33,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{l:T FactsWindow.SearchFactNamesE}" />
                </Grid>
            </DockPanel>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="1.4*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <ListBox x:Name="FactList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0" SelectionChanged="FactList_SelectionChanged"
                             VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type local:FactRow}">
                                <StackPanel Margin="4,3">
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FontFamily="Cascadia Mono, Consolas" />
                                    <TextBlock Text="{Binding Detail}" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" Focusable="False" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel x:Name="FactHeader" Margin="2,0,0,8" Visibility="Collapsed">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Padding="10,5" Click="CopyName_Click" ToolTip="{l:T FactsWindow.CopyFactsName}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="12" />
                                    <TextBlock Margin="6,0,0,0" Text="{l:T Common.Name}" />
                                </StackPanel>
                            </Button>
                            <Button Margin="6,0,0,0" Padding="10,5" Click="CopyQuery_Click" ToolTip="{l:T FactsWindow.CopyFactsQuerySumNameRead}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" FontSize="12" />
                                    <TextBlock Margin="6,0,0,0" Text="FactsQuerySum" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock x:Name="FactName" FontSize="15" FontWeight="SemiBold" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="FactSummary" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                    <Border Grid.Row="1" Style="{StaticResource Card}" ClipToBounds="True">
                        <ListBox x:Name="UseList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0" MouseDoubleClick="UseList_MouseDoubleClick"
                                 KeyDown="UseList_KeyDown" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                 ToolTip="{l:T FactsWindow.DoubleClickLineOpen}">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type scripts:FactUse}">
                                    <StackPanel Margin="4,3">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Badge" CornerRadius="3" Padding="5,0,5,1" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                                <TextBlock Text="{Binding Function}" FontSize="11" />
                                            </Border>
                                            <TextBlock Text="{Binding File.File.Source}" Opacity="0.7" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding File.File.Path, StringFormat='  ·  {0}'}" Opacity="0.55" FontSize="12" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Hit.Line, StringFormat=' : {0}'}" Opacity="0.55" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Hit.LineText}" FontFamily="Cascadia Mono, Consolas" FontSize="12.5" Margin="0,3,0,0"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding Access}" Value="Write">
                                            <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                            <Setter TargetName="Badge" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </Grid>
            </Grid>

            <DockPanel Grid.Row="3" Margin="2,10,2,0">
                <TextBlock DockPanel.Dock="Right" Opacity="0.6" FontSize="12" VerticalAlignment="Center"
                           Text="{l:T FactsWindow.QuestsScenesSetFacts}" />
                <TextBlock x:Name="StatusText" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
