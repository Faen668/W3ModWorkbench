<Window x:Class="W3ModWorkbench.JournalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T JournalWindow.Journal}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1450" Height="900" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" MinWidth="260" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <!-- every entry of the journal -->
            <Border Style="{StaticResource Card}">
                <DockPanel Margin="10,8,10,8">
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <Menu DockPanel.Dock="Right" VerticalAlignment="Center" Margin="6,0,0,0">
                            <MenuItem ToolTip="{l:T JournalWindow.CheckJournalMistakesREDkits}">
                                <MenuItem.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource IconText}" Text="&#xE90F;" />
                                        <TextBlock Margin="6,0,0,0" Text="{l:T JournalWindow.Tools}" />
                                    </StackPanel>
                                </MenuItem.Header>
                                <MenuItem Header="{l:T JournalWindow.CheckDuplicatedUniqueScript}" Click="CheckTags_Click" />
                                <MenuItem Header="{l:T JournalWindow.CheckDuplicatedGUIDs}" Click="CheckGuids_Click" />
                                <MenuItem Header="{l:T JournalWindow.FindEntriesWithoutUnique}" Click="MissingTags_Click" />
                            </MenuItem>
                        </Menu>
                        <Grid>
                            <TextBox x:Name="SearchBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="SearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{l:T JournalWindow.FindEntriesNameScript}" />
                        </Grid>
                    </DockPanel>
                    <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="2,6,0,0" Style="{StaticResource Small}" TextWrapping="Wrap" />
                    <Grid>
                        <TreeView x:Name="Tree" SelectedItemChanged="Tree_SelectedItemChanged">
                            <TreeView.ItemContainerStyle>
                                <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                                </Style>
                            </TreeView.ItemContainerStyle>
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                    <StackPanel Orientation="Horizontal" ToolTip="{Binding Tip}">
                                        <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" FontSize="13" Foreground="{Binding Brush}" />
                                        <TextBlock Margin="7,0,0,0" Text="{Binding Name}" VerticalAlignment="Center" FontWeight="{Binding Weight}" />
                                        <TextBlock Margin="8,0,0,0" Text="{Binding Note}" VerticalAlignment="Center" Style="{StaticResource Small}" />
                                    </StackPanel>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                        <!-- what a search finds, over the tree -->
                        <ListBox x:Name="Results" Visibility="Collapsed" SelectionChanged="Results_SelectionChanged">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,2">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource IconText}" Text="{Binding Glyph}" FontSize="13" Foreground="{Binding Brush}" />
                                            <TextBlock Margin="7,0,0,0" Text="{Binding Name}" FontWeight="SemiBold" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Where}" Style="{StaticResource Small}" Margin="20,1,0,0" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the entry picked -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid Margin="16,12,10,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="120" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="EntryTitle" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Text="{l:T JournalWindow.PickEntry}" />
                        <TextBlock x:Name="EntryDetail" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <WrapPanel x:Name="EntryButtons" Margin="0,8,0,0" Visibility="Collapsed">
                            <Button x:Name="OpenPhaseButton" Padding="10,5" Margin="0,0,6,6" Click="OpenPhase_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8A7;" />
                                    <TextBlock x:Name="OpenPhaseText" Margin="8,0,0,0" Text="{l:T JournalWindow.OpenQuestPhase}" />
                                </StackPanel>
                            </Button>
                            <Button Padding="10,5" Margin="0,0,6,6" Click="CopyTag_Click" ToolTip="{l:T JournalWindow.CopyEntrysUniqueScript}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T JournalWindow.CopyScriptTag}" />
                                </StackPanel>
                            </Button>
                            <Button Padding="10,5" Margin="0,0,6,6" Click="CopyPath_Click" ToolTip="{l:T JournalWindow.CopyPathJournalFile}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE8C8;" />
                                    <TextBlock Margin="8,0,0,0" Text="{l:T JournalWindow.CopyFilesPath}" />
                                </StackPanel>
                            </Button>
                        </WrapPanel>
                    </StackPanel>

                    <!-- its texts, in words -->
                    <ItemsControl x:Name="Texts" Grid.Row="1" Margin="0,6,0,8">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4,0,4" Padding="12,8" CornerRadius="6" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Label}" Style="{StaticResource Small}" />
                                        <TextBox Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent"
                                                 Padding="0" Margin="0,3,0,0" FontSize="{Binding Size}" MaxHeight="260" VerticalScrollBarVisibility="Auto" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <DockPanel Grid.Row="2">
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBox x:Name="PropertySearch" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="PropertySearch_TextChanged" />
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                            <TextBlock x:Name="PropertySearchPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                       Text="{l:T Common.FindPropertiesNameValue}" />
                        </Grid>
                        <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                        <local:PropertyListView x:Name="Properties" LinkClicked="Properties_LinkClicked" />
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T JournalWindow.ReadingJournal}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
