<Window x:Class="W3ModWorkbench.GameStringsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T GameStringsWindow.GameStrings}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1180" Height="760" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CellText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="6,0" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>
        <Style x:Key="CodeCellText" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style x:Key="ResultCell" TargetType="DataGridCell">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Grid SnapsToDevicePixels="True" Background="Transparent">
                            <Rectangle x:Name="Highlight" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{l:T GameStringsWindow.Read}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="SourceBox" Width="190" Margin="0,0,16,0" SelectionChanged="SourceBox_SelectionChanged"
                              ToolTip="{l:T GameStringsWindow.GamesW3stringsFilesREDkits}">
                        <ComboBoxItem x:Name="GameItem" Content="{l:T GameStringsWindow.GameFilesW3strings}" Tag="Game" />
                        <ComboBoxItem x:Name="RedkitItem" Content="{l:T GameStringsWindow.REDkitDatabase}" Tag="REDkit" />
                        <ComboBoxItem x:Name="FileItem" Content="{l:T GameStringsWindow.DatabaseFile}" Tag="File" />
                    </ComboBox>
                    <TextBlock Text="{l:T Common.Language}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="LanguageBox" Width="90" SelectionChanged="LanguageBox_SelectionChanged" />
                </StackPanel>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{l:T GameStringsWindow.GameStrings}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="DetailText" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"
                               Text="{l:T GameStringsWindow.SearchTextIDsKeys}" />
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10" LastChildFill="True">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="WholeWordCheck" MinWidth="0" Content="{l:T GameStringsWindow.WholeWords}" Checked="Option_Changed" Unchecked="Option_Changed"
                              ToolTip="{l:T GameStringsWindow.OnlyMatchWordsTheyre}" />
                    <CheckBox x:Name="ModsCheck" Margin="14,0,0,0" MinWidth="0" Content="{l:T GameStringsWindow.IncludeDLCMods}" IsChecked="True"
                              Checked="Source_Changed" Unchecked="Source_Changed"
                              ToolTip="{l:T GameStringsWindow.AlsoReadStringsDLC}" />
                </StackPanel>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="32,6,8,6" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="11,0,0,0" Opacity="0.6"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchPlaceholder" Margin="33,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{l:T GameStringsWindow.SearchTextIDKey}" />
                </Grid>
            </DockPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                          HeadersVisibility="Column" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                          SelectionMode="Extended" SelectionUnit="FullRow" CanUserResizeRows="False"
                          EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          CellStyle="{StaticResource ResultCell}" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:T GameStringsWindow.CopyID}" Click="CopyId_Click" />
                            <MenuItem x:Name="CopyKeyItem" Header="{l:T GameStringsWindow.CopyKey}" Click="CopyKey_Click" />
                            <MenuItem Header="{l:T GameStringsWindow.CopyText}" Click="CopyText_Click" />
                            <MenuItem Header="{l:T GameStringsWindow.CopyGetLocStringById}" Click="CopyScript_Click" />
                            <MenuItem x:Name="CopyKeyScriptItem" Header="{l:T GameStringsWindow.CopyGetLocStringByKeyExt}" Click="CopyKeyScript_Click" />
                            <MenuItem Header="{l:T GameStringsWindow.CopyStringsCSVLine}" Click="CopyCsv_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{l:T GameStringsWindow.ID}" Binding="{Binding Id}" Width="110" ElementStyle="{StaticResource CodeCellText}" />
                        <DataGridTextColumn x:Name="KeyColumn" Header="{l:T GameStringsWindow.KeyHash}" Binding="{Binding Key}" Width="90" ElementStyle="{StaticResource CodeCellText}" />
                        <DataGridTextColumn Header="{l:T Common.Text}" Binding="{Binding Text}" Width="*" ElementStyle="{StaticResource CellText}" />
                        <DataGridTextColumn x:Name="KindColumn" Header="{l:T Common.Kind}" Binding="{Binding Kind}" Width="110" ElementStyle="{StaticResource CellText}" Visibility="Collapsed" />
                        <DataGridTextColumn x:Name="UsedInColumn" Header="{l:T GameStringsWindow.Used}" Binding="{Binding UsedIn}" Width="230" ElementStyle="{StaticResource CellText}" Visibility="Collapsed" />
                        <DataGridTextColumn x:Name="VoiceoverColumn" Header="{l:T GameStringsWindow.Voiceover}" Binding="{Binding Voiceover}" Width="150" ElementStyle="{StaticResource CodeCellText}" Visibility="Collapsed" />
                        <DataGridTextColumn Header="{l:T Common.From}" Binding="{Binding Source}" Width="150" ElementStyle="{StaticResource CellText}" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <DockPanel Grid.Row="3" Margin="2,8,2,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="CopyIdButton" Padding="12,4" Click="CopyId_Click" IsEnabled="False" Content="{l:T GameStringsWindow.CopyID}" />
                    <Button x:Name="CopyScriptButton" Margin="6,0,0,0" Padding="12,4" Click="CopyScript_Click" IsEnabled="False" Content="{l:T GameStringsWindow.CopyGetLocStringById2}" />
                </StackPanel>
                <TextBlock x:Name="StatusText" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
