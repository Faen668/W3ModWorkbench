<Window x:Class="W3ModWorkbench.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        Title="{l:T UpdateWindow.Title}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="680" Height="620" MinWidth="520" MinHeight="400"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Margin="24,20,24,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- what there is: checking, the latest already, a new version, downloading, installed, or a problem -->
            <DockPanel>
                <TextBlock x:Name="StateIcon" DockPanel.Dock="Left" Style="{StaticResource Icon}" FontSize="32" Margin="0,0,16,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Text="&#xE895;" />
                <StackPanel>
                    <TextBlock x:Name="HeadText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock x:Name="SubText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <!-- the release's notes, drawn as the guide draws its pages -->
            <Border x:Name="NotesCard" Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="0">
                <DockPanel>
                    <TextBlock x:Name="NotesTitle" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="18,14,18,4" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,4,18,10">
                        <StackPanel x:Name="NotesPanel" />
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- under the heading: how the download goes, and why this copy only downloads -->
            <StackPanel Grid.Row="1" Margin="0,14,0,0">
                <StackPanel x:Name="ProgressPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <ProgressBar x:Name="Progress" Height="4" />
                    <TextBlock x:Name="ProgressText" Style="{StaticResource Hint}" />
                </StackPanel>
                <DockPanel x:Name="BlockedPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Icon}" VerticalAlignment="Top" Margin="0,2,8,0" Text="&#xE946;" />
                    <TextBlock x:Name="BlockedText" TextWrapping="Wrap" />
                </DockPanel>
            </StackPanel>

            <StackPanel Grid.Row="3">
                <CheckBox x:Name="AutoCheck" Content="{l:T UpdateWindow.CheckAtStart}" Click="AutoCheck_Click" />
                <TextBlock Style="{StaticResource Hint}">
                    <Run Text="{l:T UpdateWindow.CheckAtStartHint}" />
                    <Hyperlink Click="Privacy_Click"><Run Text="{l:T UpdateWindow.PrivacyNotice}" /></Hyperlink>
                </TextBlock>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Padding="18,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button x:Name="PageButton" Padding="12,6" Click="Page_Click" ToolTip="{l:T UpdateWindow.ReleasePageTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" Text="&#xE774;" />
                            <TextBlock Margin="8,0,0,0" Text="{l:T UpdateWindow.ReleasePage}" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SkipButton" Padding="12,6" Margin="8,0,0,0" Click="Skip_Click" ToolTip="{l:T UpdateWindow.SkipTip}"
                            Content="{l:T UpdateWindow.Skip}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CloseButton" Padding="18,6" Click="Close_Click" IsCancel="True" Content="{l:T UpdateWindow.Close}" />
                    <Button x:Name="ActionButton" Padding="18,6" Margin="8,0,0,0" Click="Action_Click" IsDefault="True"
                            Style="{DynamicResource AccentButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="ActionIcon" Style="{StaticResource Icon}" Text="&#xE896;" />
                            <TextBlock x:Name="ActionText" Margin="8,0,0,0" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
