<Window x:Class="W3ModWorkbench.AnimSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T Common.AnimationSet}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1500" Height="950" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- compact tabs, as the scene viewer's, so every tab fits in a row -->
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <!-- what's in a tab takes its text colour from the tab: the theme's, not the plain black a tab has without the theme's style -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0,6,0" />
        </Style>
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="8" />
                <RowDefinition Height="220" MinHeight="110" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="640" MinWidth="320" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- the animation, in 3D -->
                <Border Style="{StaticResource Card}">
                    <DockPanel Margin="8">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="{l:T Common.Preview}" VerticalAlignment="Center" Opacity="0.75" Margin="2,0,8,0" />
                            <ComboBox x:Name="EntityBox" MinWidth="130" MaxWidth="260" SelectionChanged="EntityBox_SelectionChanged"
                                      ToolTip="{l:T AnimSetWindow.CharacterAnimationsPlayKind}" />
                            <CheckBox x:Name="BonesCheck" Content="{l:T Common.Bones}" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="Overlay_Click"
                                      ToolTip="{l:T AnimSetWindow.DrawSkeletonOverCharacter}" />
                            <CheckBox x:Name="NamesCheck" Content="{l:T AnimSetWindow.Names}" MinWidth="0" Margin="10,0,0,0" VerticalAlignment="Center" Click="Overlay_Click"
                                      ToolTip="{l:T AnimSetWindow.WriteEachBonesName}" />
                            <TextBlock Text="{l:T AnimSetWindow.Trace}" VerticalAlignment="Center" Opacity="0.75" Margin="14,0,8,0" />
                            <ComboBox x:Name="TraceBox" MinWidth="120" MaxWidth="200" IsTextSearchEnabled="True" SelectionChanged="TraceBox_SelectionChanged"
                                      ToolTip="{l:T AnimSetWindow.DrawPathBoneTakes}" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <CheckBox x:Name="LoopCheck" Content="{l:T AnimSetWindow.Loop}" MinWidth="0" IsChecked="True" VerticalAlignment="Center" Margin="2,0,0,0" Click="LoopCheck_Click"
                                      ToolTip="{l:T AnimSetWindow.StartAnimationAgainWhen}" />
                            <TextBlock Text="{l:T AnimSetWindow.Blend}" VerticalAlignment="Center" Opacity="0.75" Margin="14,0,8,0" />
                            <ComboBox x:Name="BlendBox" MinWidth="150" MaxWidth="240" IsTextSearchEnabled="True" SelectionChanged="BlendBox_SelectionChanged"
                                      ToolTip="{l:T AnimSetWindow.WhatAnimationBlendsStart}" />
                            <TextBlock Text="{l:T AnimSetWindow.In}" VerticalAlignment="Center" Opacity="0.75" Margin="10,0,6,0" />
                            <TextBox x:Name="BlendInBox" Width="48" Text="0.2" VerticalContentAlignment="Center" LostFocus="BlendBox_LostFocus" KeyDown="BlendText_KeyDown"
                                     ToolTip="{l:T AnimSetWindow.SecondsAnimationTakesBlend}" />
                            <TextBlock Text="{l:T AnimSetWindow.Out}" VerticalAlignment="Center" Opacity="0.75" Margin="8,0,6,0" />
                            <TextBox x:Name="BlendOutBox" Width="48" Text="0.2" VerticalContentAlignment="Center" LostFocus="BlendBox_LostFocus" KeyDown="BlendText_KeyDown"
                                     ToolTip="{l:T AnimSetWindow.SecondsAnimationTakesBlend2}" />
                            <TextBlock Text="s" VerticalAlignment="Center" Opacity="0.75" Margin="4,0,0,0" />
                        </WrapPanel>
                        <TextBlock x:Name="MotionText" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextWrapping="Wrap"
                                   ToolTip="{l:T AnimSetWindow.HowAnimationMovesCharacter}" />
                        <local:AnimationPreview x:Name="Preview" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <TabControl x:Name="Tabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                        <TabItem x:Name="AnimationsTab" Header="{l:T Common.Animations}">
                            <DockPanel Margin="0,6,0,0">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBox x:Name="FilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                    <TextBlock x:Name="FilterPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Text="{l:T AnimSetWindow.ShowOnlyAnimationsThese}" />
                                </Grid>
                                <TextBlock x:Name="SetNote" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,6" />
                                <DataGrid x:Name="AnimationGrid" Style="{StaticResource ViewerGrid}" AutoGenerateColumns="False" ContextMenuOpening="AnimationGrid_ContextMenuOpening" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                          GridLinesVisibility="None" CanUserSortColumns="True" SelectionChanged="AnimationGrid_SelectionChanged"
                                          ToolTip="{l:T AnimSetWindow.ClickAnimationPlayClick}">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{l:T Common.CopyName}" Click="CopyName_Click" InputGestureText="Ctrl+C" />
                                            <MenuItem Header="{l:T AnimSetWindow.CopyEveryNameShown}" Click="CopyNames_Click" />
                                            <Separator />
                                            <MenuItem x:Name="BlendFromMenu" Header="{l:T AnimSetWindow.BlendOthersOne}" Click="BlendFromThis_Click" />
                                            <MenuItem x:Name="OpenEventsMenu" Header="{l:T AnimSetWindow.OpenEventsFile}" Click="OpenEvents_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{l:T Common.Animation}" Binding="{Binding Name}" Width="*" MinWidth="200" />
                                        <DataGridTextColumn Header="{l:T Common.Length}" Binding="{Binding LengthText}" SortMemberPath="Length" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="{l:T AnimSetWindow.Frames}" Binding="{Binding Frames}" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="{l:T Common.Events}" Binding="{Binding Events}" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="{l:T AnimSetWindow.Moves}" Binding="{Binding MovesText}" SortMemberPath="Moves" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="{l:T AnimSetWindow.Turns}" Binding="{Binding TurnsText}" SortMemberPath="Turns" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="{l:T Common.Bones}" Binding="{Binding Bones}" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="{l:T AnimSetWindow.Data}" Binding="{Binding SizeText}" SortMemberPath="Size" ElementStyle="{StaticResource Number}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="AnimationTab" Header="{l:T Common.Animation}">
                            <DockPanel Margin="4,8,0,0">
                                <TextBlock x:Name="AnimationTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{l:T AnimSetWindow.PickAnimation}" />
                                <TextBlock x:Name="AnimationDetail" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <Border DockPanel.Dock="Top" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="{l:T AnimSetWindow.MotionExtraction}" Grid.ColumnSpan="2" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="1" Text="{l:T AnimSetWindow.End}" Opacity="0.75" Margin="0,0,14,2" />
                                        <TextBlock x:Name="MotionEnd" Grid.Row="1" Grid.Column="1" Style="{StaticResource Figure}" />
                                        <TextBlock Grid.Row="2" Text="{l:T AnimSetWindow.TimeShown}" Opacity="0.75" Margin="0,0,14,0" />
                                        <TextBlock x:Name="MotionNow" Grid.Row="2" Grid.Column="1" Style="{StaticResource Figure}" />
                                    </Grid>
                                </Border>
                                <local:PropertyListView x:Name="AnimationProperties" LinkClicked="Properties_LinkClicked" />
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="EntitySetsTab" Header="{l:T AnimSetWindow.CharactersSets}">
                            <DockPanel Margin="4,8,0,0">
                                <TextBlock x:Name="EntitySetsTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="EntitySetsNote" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <ListBox x:Name="EntitySetsList" MouseDoubleClick="EntitySetsList_MouseDoubleClick" KeyDown="EntitySetsList_KeyDown"
                                         ToolTip="{l:T AnimSetWindow.DoubleClickSetPress}">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="{l:T Common.Open}" Click="OpenEntitySet_Click" />
                                            <MenuItem Header="{l:T Common.CopyPath}" Click="CopyEntitySet_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Path}" FontWeight="{Binding Weight}" />
                                                <TextBlock Text="{Binding Note}" Margin="8,0,0,0" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="EventTab" Header="{l:T AnimSetWindow.Event}">
                            <DockPanel Margin="4,8,0,0">
                                <TextBlock x:Name="EventTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{l:T AnimSetWindow.ClickEventTimeline}" />
                                <TextBlock x:Name="EventDetail" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <local:PropertyListView x:Name="EventProperties" LinkClicked="Properties_LinkClicked" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="{l:T Common.Properties}">
                            <DockPanel Margin="4,8,0,0">
                                <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                                <local:PropertyListView x:Name="FileProperties" LinkClicked="Properties_LinkClicked" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the animation's events, along its length -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel Margin="8,6,8,6">
                    <TextBlock x:Name="TimelineTitle" DockPanel.Dock="Top" Style="{StaticResource Small}" Margin="2,0,0,4"
                               Text="{l:T AnimSetWindow.PickAnimationSeeEvents}" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <local:EventTimeline x:Name="Timeline" EventClicked="Timeline_EventClicked" EventOpened="Timeline_EventOpened" TimePicked="Timeline_TimePicked" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T AnimSetWindow.ReadingAnimationSet}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <DockPanel Grid.Row="1" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
