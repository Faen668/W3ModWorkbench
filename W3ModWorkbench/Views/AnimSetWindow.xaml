<Window x:Class="W3ModWorkbench.AnimSetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="Animation set" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1500" Height="950" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- compact tabs, as the scene viewer's, so every tab fits in a row -->
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <!-- what's in a tab takes its text colour from the tab: the theme's, not the plain black a tab has without the theme's style -->
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Number" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0,6,0" />
        </Style>
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="300" />
                <RowDefinition Height="8" />
                <RowDefinition Height="220" MinHeight="110" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="640" MinWidth="320" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!-- the animation, in 3D -->
                <Border Style="{StaticResource Card}">
                    <DockPanel Margin="8">
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Preview on" VerticalAlignment="Center" Opacity="0.75" Margin="2,0,8,0" />
                            <ComboBox x:Name="EntityBox" MinWidth="130" MaxWidth="260" SelectionChanged="EntityBox_SelectionChanged"
                                      ToolTip="The character the animations play on: the kind the set's folder is for, picked for you" />
                            <CheckBox x:Name="BonesCheck" Content="Bones" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="Overlay_Click"
                                      ToolTip="Draw the skeleton over the character, as it moves" />
                            <CheckBox x:Name="NamesCheck" Content="Names" MinWidth="0" Margin="10,0,0,0" VerticalAlignment="Center" Click="Overlay_Click"
                                      ToolTip="Write each bone's name beside it" />
                            <TextBlock Text="Trace" VerticalAlignment="Center" Opacity="0.75" Margin="14,0,8,0" />
                            <ComboBox x:Name="TraceBox" MinWidth="120" MaxWidth="200" IsTextSearchEnabled="True" SelectionChanged="TraceBox_SelectionChanged"
                                      ToolTip="Draw the path a bone takes over the whole animation, as REDkit's trajectory tool does" />
                        </WrapPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <CheckBox x:Name="LoopCheck" Content="Loop" MinWidth="0" IsChecked="True" VerticalAlignment="Center" Margin="2,0,0,0" Click="LoopCheck_Click"
                                      ToolTip="Start the animation again when it ends, or stop on its last frame" />
                            <TextBlock Text="Blend from" VerticalAlignment="Center" Opacity="0.75" Margin="14,0,8,0" />
                            <ComboBox x:Name="BlendBox" MinWidth="150" MaxWidth="240" IsTextSearchEnabled="True" SelectionChanged="BlendBox_SelectionChanged"
                                      ToolTip="What the animation blends in from at its start and back to at its end, as the game blends one animation into the next: another of the set's animations (an idle), the pose the rig rests in, or no blending" />
                            <TextBlock Text="in" VerticalAlignment="Center" Opacity="0.75" Margin="10,0,6,0" />
                            <TextBox x:Name="BlendInBox" Width="48" Text="0.2" VerticalContentAlignment="Center" LostFocus="BlendBox_LostFocus" KeyDown="BlendText_KeyDown"
                                     ToolTip="Seconds the animation takes to blend in (REDkit's default is 0.2)" />
                            <TextBlock Text="out" VerticalAlignment="Center" Opacity="0.75" Margin="8,0,6,0" />
                            <TextBox x:Name="BlendOutBox" Width="48" Text="0.2" VerticalContentAlignment="Center" LostFocus="BlendBox_LostFocus" KeyDown="BlendText_KeyDown"
                                     ToolTip="Seconds the animation takes to blend back out at its end" />
                            <TextBlock Text="s" VerticalAlignment="Center" Opacity="0.75" Margin="4,0,0,0" />
                        </WrapPanel>
                        <TextBlock x:Name="MotionText" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextWrapping="Wrap"
                                   ToolTip="How the animation moves the character as a whole (its motion extraction): the game moves the character along this, rather than the animation moving its body" />
                        <local:AnimationPreview x:Name="Preview" />
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

                <Border Grid.Column="2" Style="{StaticResource Card}">
                    <TabControl x:Name="Tabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                        <TabItem x:Name="AnimationsTab" Header="Animations">
                            <DockPanel Margin="0,6,0,0">
                                <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                    <TextBox x:Name="FilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                    <TextBlock x:Name="FilterPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Text="Show only the animations with these letters  (Ctrl+F)" />
                                </Grid>
                                <TextBlock x:Name="SetNote" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,6" />
                                <DataGrid x:Name="AnimationGrid" AutoGenerateColumns="False" ContextMenuOpening="AnimationGrid_ContextMenuOpening" IsReadOnly="True" HeadersVisibility="Column" SelectionMode="Single"
                                          GridLinesVisibility="None" CanUserSortColumns="True" SelectionChanged="AnimationGrid_SelectionChanged"
                                          ToolTip="Click an animation to play it; click a heading to sort by it">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Copy name" Click="CopyName_Click" InputGestureText="Ctrl+C" />
                                            <MenuItem Header="Copy every name shown" Click="CopyNames_Click" />
                                            <Separator />
                                            <MenuItem x:Name="BlendFromMenu" Header="Blend the others from this one" Click="BlendFromThis_Click" />
                                            <MenuItem x:Name="OpenEventsMenu" Header="Open the events file" Click="OpenEvents_Click" />
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Animation" Binding="{Binding Name}" Width="*" MinWidth="200" />
                                        <DataGridTextColumn Header="Length" Binding="{Binding LengthText}" SortMemberPath="Length" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="Frames" Binding="{Binding Frames}" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="Events" Binding="{Binding Events}" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="Moves" Binding="{Binding MovesText}" SortMemberPath="Moves" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="Turns" Binding="{Binding TurnsText}" SortMemberPath="Turns" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="Bones" Binding="{Binding Bones}" ElementStyle="{StaticResource Number}" />
                                        <DataGridTextColumn Header="Data" Binding="{Binding SizeText}" SortMemberPath="Size" ElementStyle="{StaticResource Number}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="AnimationTab" Header="Animation">
                            <DockPanel Margin="4,8,0,0">
                                <TextBlock x:Name="AnimationTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="Pick an animation" />
                                <TextBlock x:Name="AnimationDetail" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <Border DockPanel.Dock="Top" CornerRadius="6" Padding="10,8" Margin="0,0,0,8" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Motion extraction" Grid.ColumnSpan="2" FontWeight="SemiBold" Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="1" Text="By the end" Opacity="0.75" Margin="0,0,14,2" />
                                        <TextBlock x:Name="MotionEnd" Grid.Row="1" Grid.Column="1" Style="{StaticResource Figure}" />
                                        <TextBlock Grid.Row="2" Text="At the time shown" Opacity="0.75" Margin="0,0,14,0" />
                                        <TextBlock x:Name="MotionNow" Grid.Row="2" Grid.Column="1" Style="{StaticResource Figure}" />
                                    </Grid>
                                </Border>
                                <local:PropertyListView x:Name="AnimationProperties" LinkClicked="Properties_LinkClicked" />
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="EntitySetsTab" Header="Character's sets">
                            <DockPanel Margin="4,8,0,0">
                                <TextBlock x:Name="EntitySetsTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock x:Name="EntitySetsNote" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <ListBox x:Name="EntitySetsList" MouseDoubleClick="EntitySetsList_MouseDoubleClick" KeyDown="EntitySetsList_KeyDown"
                                         ToolTip="Double-click a set, or press Enter, to open it">
                                    <ListBox.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Open" Click="OpenEntitySet_Click" />
                                            <MenuItem Header="Copy path" Click="CopyEntitySet_Click" />
                                        </ContextMenu>
                                    </ListBox.ContextMenu>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Path}" FontWeight="{Binding Weight}" />
                                                <TextBlock Text="{Binding Note}" Margin="8,0,0,0" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </TabItem>
                        <TabItem x:Name="EventTab" Header="Event">
                            <DockPanel Margin="4,8,0,0">
                                <TextBlock x:Name="EventTitle" DockPanel.Dock="Top" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="Click an event on the timeline" />
                                <TextBlock x:Name="EventDetail" DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                <local:PropertyListView x:Name="EventProperties" LinkClicked="Properties_LinkClicked" />
                            </DockPanel>
                        </TabItem>
                        <TabItem Header="Properties">
                            <DockPanel Margin="4,8,0,0">
                                <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                                <local:PropertyListView x:Name="FileProperties" LinkClicked="Properties_LinkClicked" />
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Border>
            </Grid>

            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <!-- the animation's events, along its length -->
            <Border Grid.Row="2" Style="{StaticResource Card}">
                <DockPanel Margin="8,6,8,6">
                    <TextBlock x:Name="TimelineTitle" DockPanel.Dock="Top" Style="{StaticResource Small}" Margin="2,0,0,4"
                               Text="Pick an animation to see its events; click an event for its properties, the ruler to go to a moment, the wheel to zoom" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <local:EventTimeline x:Name="Timeline" EventClicked="Timeline_EventClicked" TimePicked="Timeline_TimePicked" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="Reading the animation set…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
