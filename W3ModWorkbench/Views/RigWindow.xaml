<Window x:Class="W3ModWorkbench.RigWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="Rig" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1400" Height="900" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
        <Style x:Key="Figure" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,2" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="Margin" Value="0,0,14,2" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="560" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- the skeleton, in 3D -->
            <Border Style="{StaticResource Card}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <CheckBox x:Name="NamesCheck" Content="Bone names" MinWidth="0" Margin="2,0,0,0" VerticalAlignment="Center" Click="Overlay_Click"
                                  ToolTip="Write each bone's name beside it" />
                        <CheckBox x:Name="AxesCheck" Content="Bone axes" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="Overlay_Click"
                                  ToolTip="Draw each bone's axes: X red, Y green, Z blue" />
                        <CheckBox x:Name="CharacterCheck" Content="On a character" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="CharacterCheck_Click"
                                  ToolTip="Show the skeleton inside a character made on it, to see where its bones sit in the body" />
                        <Button x:Name="FitButton" Margin="14,0,0,0" Padding="10,3" Click="FitButton_Click" ToolTip="Frame the whole skeleton (F)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="Fit" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="ViewNote" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextWrapping="Wrap"
                               Text="Click a bone in the list to pick it out. Drag to turn the view, the wheel to zoom." />
                    <Grid>
                        <local:MeshView x:Name="View" />
                        <TextBlock x:Name="ViewMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl x:Name="Tabs" Margin="6,4,6,6">
                    <TabItem x:Name="BonesTab" Header="Bones">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <TextBox x:Name="FilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="FilterPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="Show only the bones with these letters  (Ctrl+F)" />
                            </Grid>
                            <TreeView x:Name="BoneTree" Grid.Row="1" SelectedItemChanged="BoneTree_SelectedItemChanged">
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Copy name" Click="CopyBone_Click" InputGestureText="Ctrl+C" />
                                        <MenuItem Header="Copy its chain from the root" Click="CopyChain_Click" />
                                        <MenuItem Header="Copy every bone, numbered" Click="CopyAll_Click" />
                                        <Separator />
                                        <MenuItem Header="Open every branch" Click="ExpandAll_Click" />
                                        <MenuItem Header="Close every branch" Click="CollapseAll_Click" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}" />
                                        <Setter Property="IsSelected" Value="{Binding Selected, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" />
                                            <TextBlock Text="{Binding IndexText}" Margin="8,0,0,0" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                            </TreeView>
                            <Border x:Name="BonePanel" Grid.Row="2" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock x:Name="BoneTitle" Grid.ColumnSpan="2" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,2" />
                                    <TextBlock x:Name="BoneDetail" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                    <TextBlock Grid.Row="2" Text="Position" Style="{StaticResource Label}" ToolTip="Where the bone is from its parent, in metres" />
                                    <TextBlock x:Name="BonePosition" Grid.Row="2" Grid.Column="1" Style="{StaticResource Figure}" />
                                    <TextBlock Grid.Row="3" Text="Rotation" Style="{StaticResource Label}" ToolTip="How the bone is turned from its parent: about X, Y and Z, in degrees" />
                                    <TextBlock x:Name="BoneRotation" Grid.Row="3" Grid.Column="1" Style="{StaticResource Figure}" />
                                    <TextBlock Grid.Row="4" Text="Quaternion" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="BoneQuaternion" Grid.Row="4" Grid.Column="1" Style="{StaticResource Figure}" />
                                    <TextBlock Grid.Row="5" Text="Scale" Style="{StaticResource Label}" />
                                    <TextBlock x:Name="BoneScale" Grid.Row="5" Grid.Column="1" Style="{StaticResource Figure}" />
                                    <TextBlock Grid.Row="6" Text="In the model" Style="{StaticResource Label}" ToolTip="Where the bone is in the character, from its feet, in metres (Z up, Y forward)" />
                                    <TextBlock x:Name="BoneModel" Grid.Row="6" Grid.Column="1" Style="{StaticResource Figure}" />
                                </Grid>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="TracksTab" Header="Tracks">
                        <DockPanel Margin="0,6,0,0">
                            <TextBlock DockPanel.Dock="Top" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,0,0,6"
                                       Text="Float tracks animations can drive beside the bones (a camera's field of view, a blend weight)." />
                            <ListBox x:Name="TrackList" />
                        </DockPanel>
                    </TabItem>
                    <TabItem Header="Properties">
                        <DockPanel Margin="4,8,0,0">
                            <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                            <local:PropertyListView x:Name="FileProperties" LinkClicked="Properties_LinkClicked" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="Reading the rig…" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
