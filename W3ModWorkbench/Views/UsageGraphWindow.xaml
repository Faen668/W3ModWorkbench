<Window x:Class="W3ModWorkbench.UsageGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Usage graph" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="Levels" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
                <ComboBox x:Name="LevelsBox" Width="64" SelectionChanged="Levels_Changed"
                          ToolTip="How many steps out to follow the callers: what calls it, what calls those, and so on" />
                <Button Content="Stretch" Margin="8,0,0,0" Padding="14,5" Click="Stretch_Click"
                        ToolTip="Fill the window: spread the columns across its width and fit the height" />
                <Button Content="Fit" Margin="8,0,0,0" Padding="14,5" Click="Fit_Click" ToolTip="Fit the whole graph in the window (Ctrl+0)" />
                <Button Content="Refresh" Margin="8,0,0,0" Padding="14,5" Click="Refresh_Click" ToolTip="Look through the scripts again (F5)" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="Usage graph" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Text="Callers on the left, the thing itself on the right. Click a box to follow its chain; double-click to open it" />
            </StackPanel>
        </DockPanel>

        <!-- shown while the installed mods' scripts aren't searched yet, with a button for each way to add them -->
        <Border x:Name="ModsNotice" Grid.Row="1" Visibility="Collapsed" CornerRadius="8" BorderThickness="1" Padding="14,10" Margin="0,0,0,10"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
            <DockPanel>
                <StackPanel x:Name="ModsButtons" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" />
                <TextBlock x:Name="ModsNoticeText" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="Scroller_MouseWheel" PreviewMouseLeftButtonDown="Scroller_MouseDown"
                              PreviewMouseMove="Scroller_MouseMove" PreviewMouseLeftButtonUp="Scroller_MouseUp"
                              PreviewMouseRightButtonDown="Scroller_MouseDown" PreviewMouseRightButtonUp="Scroller_MouseUp"
                              ContextMenuOpening="Scroller_ContextMenuOpening">
                    <!-- the right padding keeps the scroll bar from covering the last column -->
                    <Grid x:Name="Pad" Margin="600,600,614,614">
                        <Canvas x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                            </Canvas.LayoutTransform>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="BusyText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Opacity="0.75"
                           Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,8,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis"
                   ToolTip="Drag with either mouse button to pan, Ctrl+wheel to zoom" />
    </Grid>
</Window>
