<Window x:Class="W3ModWorkbench.UsageGraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        Title="{l:T UsageGraphWindow.UsageGraph}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="760" MinWidth="640" MinHeight="400"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="14,12,14,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                <TextBlock Text="{l:T UsageGraphWindow.Levels}" VerticalAlignment="Center" Opacity="0.7" Margin="0,0,8,0" />
                <ComboBox x:Name="LevelsBox" Width="64" SelectionChanged="Levels_Changed"
                          ToolTip="{l:T UsageGraphWindow.HowManyStepsOut}" />
                <Button Content="{l:T UsageGraphWindow.Stretch}" Margin="8,0,0,0" Padding="14,5" Click="Stretch_Click"
                        ToolTip="{l:T UsageGraphWindow.FillWindowSpreadColumns}" />
                <Button Content="{l:T Common.Fit}" Margin="8,0,0,0" Padding="14,5" Click="Fit_Click" ToolTip="{l:T UsageGraphWindow.FitWholeGraphWindow}" />
                <Button Content="{l:T UsageGraphWindow.Refresh}" Margin="8,0,0,0" Padding="14,5" Click="Refresh_Click" ToolTip="{l:T UsageGraphWindow.LookThroughScriptsAgain}" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="{l:T UsageGraphWindow.UsageGraph}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Text="{l:T UsageGraphWindow.CallersLeftThingItself}" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="2" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <Grid>
                <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="Scroller_MouseWheel" PreviewMouseLeftButtonDown="Scroller_MouseDown"
                              PreviewMouseMove="Scroller_MouseMove" PreviewMouseLeftButtonUp="Scroller_MouseUp"
                              PreviewMouseRightButtonDown="Scroller_MouseDown" PreviewMouseRightButtonUp="Scroller_MouseUp"
                              ContextMenuOpening="Scroller_ContextMenuOpening">
                    <!-- the right padding keeps the scroll bar from covering the last column -->
                    <Grid x:Name="Pad" Margin="600,600,614,614">
                        <Canvas x:Name="Surface" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Canvas.LayoutTransform>
                                <ScaleTransform x:Name="Zoom" ScaleX="1" ScaleY="1" />
                            </Canvas.LayoutTransform>
                        </Canvas>
                    </Grid>
                </ScrollViewer>
                <TextBlock x:Name="BusyText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14" Opacity="0.75"
                           Visibility="Collapsed" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="600" />
            </Grid>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="2,8,0,0" Opacity="0.7" TextTrimming="CharacterEllipsis"
                   ToolTip="{l:T UsageGraphWindow.DragEitherMouseButton}" />
    </Grid>
</Window>
