<Window x:Class="W3ModWorkbench.LoadingDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Loading" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="460" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="22,18,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="StepText" Grid.Row="1" Margin="0,10,0,0" TextTrimming="CharacterEllipsis" />
        <ProgressBar x:Name="Bar" Grid.Row="2" Height="6" Margin="0,10,0,0" Maximum="1" />
        <DockPanel Grid.Row="3" Margin="0,6,0,0">
            <TextBlock x:Name="CountText" DockPanel.Dock="Right" Margin="12,0,0,0" Opacity="0.75" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
            <TextBlock x:Name="DetailText" Opacity="0.65" FontSize="12" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Button x:Name="CancelButton" Grid.Row="4" HorizontalAlignment="Right" Margin="0,16,0,0" Padding="18,5" Content="Cancel" Click="Cancel_Click"
                ToolTip="Stop loading" />
    </Grid>
</Window>
