<Window x:Class="W3ModWorkbench.WorldWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T WorldWindow.World}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1500" Height="950" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- compact tabs, as the scene viewer's, so every tab fits in a row -->
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="360" MinWidth="240" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="*" MinWidth="400" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}">
                <TabControl x:Name="Tabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                    <TabItem x:Name="LayersTab" Header="{l:T WorldWindow.Layers}">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <TextBox x:Name="FilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="FilterPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="{l:T WorldWindow.FindLayer}" />
                            </Grid>
                            <TreeView x:Name="LayerTree" Grid.Row="1" SelectedItemChanged="LayerTree_SelectedItemChanged">
                                <TreeView.ItemContainerStyle>
                                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                        <Setter Property="IsExpanded" Value="{Binding Expanded, Mode=TwoWay}" />
                                    </Style>
                                </TreeView.ItemContainerStyle>
                                <TreeView.ItemTemplate>
                                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                        <StackPanel Orientation="Horizontal">
                                            <CheckBox IsChecked="{Binding Shown, Mode=TwoWay}" MinWidth="0" Margin="0,0,4,0" Focusable="False">
                                                <CheckBox.LayoutTransform>
                                                    <ScaleTransform ScaleX="0.8" ScaleY="0.8" />
                                                </CheckBox.LayoutTransform>
                                            </CheckBox>
                                            <Border Width="9" Height="9" CornerRadius="2" Background="{Binding Swatch}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding CountText}" Margin="8,0,0,0" Style="{StaticResource Small}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </HierarchicalDataTemplate>
                                </TreeView.ItemTemplate>
                                <TreeView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T WorldWindow.ShowOnlyThis}" Click="ShowOnly_Click" />
                                        <MenuItem Header="{l:T WorldWindow.ShowAll}" Click="ShowAll_Click" />
                                        <MenuItem Header="{l:T WorldWindow.OpenLayerFile}" Click="OpenLayer_Click" />
                                        <MenuItem Header="{l:T WorldWindow.CopyPath}" Click="CopyLayerPath_Click" />
                                    </ContextMenu>
                                </TreeView.ContextMenu>
                            </TreeView>
                            <TextBlock x:Name="LayerNote" Grid.Row="2" Style="{StaticResource Small}" TextWrapping="Wrap" Margin="2,6,0,0" />
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="EntitiesTab" Header="{l:T WorldWindow.EntitiesTab}">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <TextBox x:Name="EntityFilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="EntityFilterBox_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="EntityFilterPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="{l:T WorldWindow.FindEntity}" />
                            </Grid>
                            <DataGrid x:Name="EntityGrid" Grid.Row="1" Style="{StaticResource ViewerGrid}" SelectionChanged="EntityGrid_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T Common.Name}" Binding="{Binding Title}" Width="*" />
                                    <DataGridTextColumn Header="{l:T Common.Type}" Binding="{Binding Entity.ClassName}" Width="110" />
                                    <DataGridTextColumn Header="{l:T WorldWindow.Layer}" Binding="{Binding Layer.ShortName}" Width="100" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </TabItem>
                    <TabItem x:Name="WorldTab" Header="{l:T WorldWindow.WorldTab}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                            <ItemsControl x:Name="FactsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Opacity="0.75" TextWrapping="Wrap" />
                                            <TextBlock Grid.Column="1" TextWrapping="Wrap">
                                                <Hyperlink Click="FactLink_Click" Tag="{Binding Link}" IsEnabled="{Binding HasLink}">
                                                    <Run Text="{Binding Value}" />
                                                </Hyperlink>
                                            </TextBlock>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="{l:T Common.Properties}">
                        <DockPanel Margin="4,8,0,0">
                            <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                            <local:PropertyListView x:Name="FileProperties" LinkClicked="Properties_LinkClicked" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <ComboBox x:Name="LookBox" MinWidth="130" SelectionChanged="LookBox_SelectionChanged" ToolTip="{l:T WorldWindow.LookTip}" />
                        <ComboBox x:Name="AreasBox" MinWidth="170" Margin="8,0,0,0" SelectionChanged="AreasBox_SelectionChanged" ToolTip="{l:T WorldWindow.AreasTip}" />
                        <CheckBox x:Name="EntitiesCheck" Content="{l:T WorldWindow.Entities}" IsChecked="True" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="Overlay_Click" />
                        <CheckBox x:Name="NavigationCheck" Content="{l:T WorldWindow.Navigation}" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="NavigationCheck_Click"
                                  ToolTip="{l:T WorldWindow.NavigationTip}" />
                        <CheckBox x:Name="TilesCheck" Content="{l:T WorldWindow.Tiles}" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="Overlay_Click"
                                  ToolTip="{l:T WorldWindow.TilesTip}" />
                        <CheckBox x:Name="OcclusionCheck" Content="{l:T WorldWindow.Occlusion}" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center" Click="Overlay_Click"
                                  ToolTip="{l:T WorldWindow.OcclusionTip}" />
                        <Button Margin="14,0,0,0" Padding="10,3" Click="FitButton_Click" ToolTip="{l:T WorldWindow.FitTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T Common.Fit}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <Border x:Name="PickedPanel" DockPanel.Dock="Bottom" CornerRadius="6" Padding="10,8" Margin="0,6,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="PickedTitle" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PickedDetail" Style="{StaticResource Small}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="OpenTemplateButton" Padding="10,3" Click="OpenTemplate_Click" Content="{l:T WorldWindow.OpenTemplate}" />
                                <Button Margin="8,0,0,0" Padding="10,3" Click="OpenPickedLayer_Click" Content="{l:T WorldWindow.OpenLayer}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="HoverText" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextTrimming="CharacterEllipsis"
                               Text="{l:T WorldWindow.MouseHint}" />
                    <Border CornerRadius="6" ClipToBounds="True">
                        <Grid>
                            <local:WorldMap x:Name="Map" PointerMoved="Map_PointerMoved" DotPicked="Map_DotPicked" />
                            <TextBlock x:Name="MapProgress" Margin="12" HorizontalAlignment="Left" VerticalAlignment="Top" Padding="8,4"
                                       Background="{DynamicResource SolidBackgroundFillColorBaseBrush}" />
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T WorldWindow.Reading}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <TextBlock x:Name="InfoText" Grid.Row="1" Margin="18,10,18,12" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
