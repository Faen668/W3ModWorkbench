<Window x:Class="W3ModWorkbench.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        xmlns:scripts="clr-namespace:W3ModWorkbench.Core.Scripts"
        Title="{l:T LogWindow.ScriptsLog}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1180" Height="760" MinWidth="760" MinHeight="420"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Padding="10,5" Click="Pick_Click" ToolTip="{l:T LogWindow.WatchAnotherLogFile}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE8E5;" FontSize="13" />
                            <TextBlock Margin="8,0,0,0" Text="{l:T LogWindow.OpenLog}" />
                        </StackPanel>
                    </Button>
                    <Button Margin="6,0,0,0" Padding="10,5" Click="Reveal_Click" ToolTip="{l:T LogWindow.ShowLogFileExplorer}">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE838;" FontSize="13" />
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="{l:T LogWindow.ScriptsLog}" FontSize="16" FontWeight="SemiBold" />
                    <TextBlock x:Name="FileText" Opacity="0.65" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </DockPanel>

            <DockPanel Grid.Row="1" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <ComboBox x:Name="ChannelBox" Width="210" SelectionChanged="Filter_Changed" ToolTip="{l:T LogWindow.ShowOneChannelName}" />
                    <ToggleButton x:Name="ProblemsToggle" Margin="6,0,0,0" Padding="10,5" Click="Filter_Changed"
                                  ToolTip="{l:T LogWindow.OnlyAssertsLinesMention}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" FontSize="13" />
                            <TextBlock Margin="6,0,0,0" Text="{l:T Common.Problems}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="FollowToggle" Margin="6,0,0,0" Padding="10,5" IsChecked="True" Click="Follow_Click"
                                  ToolTip="{l:T LogWindow.KeepNewestLineView}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74B;" FontSize="13" />
                            <TextBlock Margin="6,0,0,0" Text="{l:T LogWindow.Follow}" />
                        </StackPanel>
                    </ToggleButton>
                    <ToggleButton x:Name="PauseToggle" Margin="6,0,0,0" Padding="10,5" Click="Pause_Click" ToolTip="{l:T LogWindow.StopReadingNewLines}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE769;" FontSize="13" />
                            <TextBlock Margin="6,0,0,0" Text="{l:T LogWindow.Pause}" />
                        </StackPanel>
                    </ToggleButton>
                    <Button Margin="6,0,0,0" Padding="10,5" Click="Clear_Click" ToolTip="{l:T LogWindow.HideLinesSoFar}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE894;" FontSize="13" />
                            <TextBlock Margin="6,0,0,0" Text="{l:T LogWindow.Clear}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <Grid>
                    <TextBox x:Name="SearchBox" Padding="32,6,8,6" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE71C;" FontSize="13" Margin="11,0,0,0" Opacity="0.6"
                               HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="SearchPlaceholder" Margin="33,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                               Text="{l:T LogWindow.FilterWordsLineMust}" />
                </Grid>
            </DockPanel>

            <Border Grid.Row="2" Style="{StaticResource Card}" ClipToBounds="True">
                <ListBox x:Name="LineList" BorderThickness="0" Background="Transparent" Padding="0,0,14,0"
                         FontFamily="Cascadia Mono, Consolas" FontSize="12.5" SelectionMode="Extended"
                         MouseDoubleClick="LineList_MouseDoubleClick" KeyDown="LineList_KeyDown"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Item">
                    <ListBox.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="{l:T LogWindow.FindScriptWrote}" InputGestureText="Enter" Click="FindSource_Click" />
                            <MenuItem Header="{l:T LogWindow.ShowOnlyChannel}" Click="OnlyChannel_Click" />
                            <Separator />
                            <MenuItem Header="{l:T Common.Copy}" InputGestureText="Ctrl+C" Click="Copy_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="6,1" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type scripts:LogLine}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Number}" Width="58" Opacity="0.45" TextAlignment="Right" Margin="0,0,10,0" />
                                <TextBlock x:Name="Channel" Text="{Binding Channel}" Width="150" Opacity="0.75" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" ToolTip="{Binding Channel}" />
                                <TextBlock x:Name="MessageText" Text="{Binding Message}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                    <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                    <Setter TargetName="Channel" Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <DockPanel Grid.Row="3" Margin="2,10,2,0">
                <TextBlock DockPanel.Dock="Right" Opacity="0.6" FontSize="12" VerticalAlignment="Center"
                           Text="{l:T LogWindow.GameWritesWhenStarted}" />
                <TextBlock x:Name="StatusText" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,16,0" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
