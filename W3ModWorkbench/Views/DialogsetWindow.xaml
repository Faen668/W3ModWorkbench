<Window x:Class="W3ModWorkbench.DialogsetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T DialogsetWindow.Dialogset}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1400" Height="900" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <!-- compact tabs, as the scene viewer's, so every tab fits in a row -->
        <Style x:Key="PanelTabs" TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <DockPanel>
                            <WrapPanel DockPanel.Dock="Top" IsItemsHost="True" Margin="2,0,2,4" />
                            <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource CardStrokeColorDefaultBrush}" Margin="0,0,0,2" />
                            <ContentPresenter ContentSource="SelectedContent" TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                        </DockPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PanelTab" TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Back" Padding="9,4" Margin="0,0,2,4" CornerRadius="5" Background="Transparent" Cursor="Hand"
                                TextElement.Foreground="{DynamicResource TextFillColorSecondaryBrush}">
                            <ContentPresenter ContentSource="Header" TextElement.FontSize="12.5" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource SubtleFillColorTertiaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Back" Property="TextElement.Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:Name="Body" Margin="14,12,14,0" Visibility="Hidden">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="320" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="600" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <!-- the set in 3D: stand-ins in its slots, its cameras -->
            <Border Style="{StaticResource Card}">
                <DockPanel Margin="8">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                        <TextBlock Text="{l:T DialogsetWindow.StandIns}" VerticalAlignment="Center" Margin="2,0,8,0" />
                        <ComboBox x:Name="StandInBox" MinWidth="120" SelectionChanged="StandInBox_SelectionChanged" ToolTip="{l:T DialogsetWindow.StandInsTip}" />
                        <CheckBox x:Name="NamesCheck" Content="{l:T DialogsetWindow.Names}" IsChecked="True" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center"
                                  Click="Overlay_Click" ToolTip="{l:T DialogsetWindow.NamesTip}" />
                        <CheckBox x:Name="CamerasCheck" Content="{l:T DialogsetWindow.CamerasCheck}" IsChecked="True" MinWidth="0" Margin="14,0,0,0" VerticalAlignment="Center"
                                  Click="Overlay_Click" ToolTip="{l:T DialogsetWindow.CamerasTip}" />
                        <ToggleButton x:Name="ThroughToggle" Margin="14,0,0,0" Padding="10,3" Click="ThroughToggle_Click" ToolTip="{l:T DialogsetWindow.ThroughTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE722;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T DialogsetWindow.ThroughCamera}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="PlayToggle" Margin="8,0,0,0" Padding="10,3" Click="PlayToggle_Click" ToolTip="{l:T DialogsetWindow.PlayTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE768;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T DialogsetWindow.Idles}" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Margin="8,0,0,0" Padding="10,3" Click="FitButton_Click" ToolTip="{l:T DialogsetWindow.FitTip}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE9A6;" FontSize="12" Margin="0,0,6,0" />
                                <TextBlock Text="{l:T Common.Fit}" />
                            </StackPanel>
                        </Button>
                    </WrapPanel>
                    <TextBlock x:Name="ViewNote" DockPanel.Dock="Bottom" Style="{StaticResource Small}" Margin="4,6,0,0" TextWrapping="Wrap" />
                    <Grid>
                        <local:MeshView x:Name="View" />
                        <TextBlock x:Name="ViewMessage" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8" TextWrapping="Wrap" Visibility="Collapsed" />
                    </Grid>
                </DockPanel>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" Background="Transparent" ResizeBehavior="PreviousAndNext" />

            <Border Grid.Column="2" Style="{StaticResource Card}">
                <TabControl x:Name="Tabs" Margin="8,8,8,6" Style="{StaticResource PanelTabs}" ItemContainerStyle="{StaticResource PanelTab}">
                    <TabItem x:Name="SlotsTab" Header="{l:T DialogsetWindow.Slots}">
                        <DataGrid x:Name="SlotGrid" Margin="0,6,0,0" Style="{StaticResource ViewerGrid}" SelectionChanged="SlotGrid_SelectionChanged">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="36" />
                                <DataGridTextColumn Header="{l:T Common.Name}" Binding="{Binding Name}" Width="100" />
                                <DataGridTextColumn Header="{l:T DialogsetWindow.Where}" Binding="{Binding WhereText}" Width="140" />
                                <DataGridTextColumn Header="{l:T DialogsetWindow.Facing}" Binding="{Binding FacingText}" Width="64" />
                                <DataGridTextColumn Header="{l:T DialogsetWindow.Stance}" Binding="{Binding StanceText}" Width="*" />
                                <DataGridTextColumn Header="{l:T DialogsetWindow.Face}" Binding="{Binding FaceText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </TabItem>
                    <TabItem x:Name="CamerasTab" Header="{l:T DialogsetWindow.Cameras}">
                        <Grid Margin="0,6,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="FilterBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="12" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="FilterPlaceholder" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="{l:T DialogsetWindow.FindCamera}" />
                                <ComboBox x:Name="SlotFilter" Grid.Column="1" MinWidth="130" Margin="8,0,0,0" SelectionChanged="SlotFilter_SelectionChanged"
                                          ToolTip="{l:T DialogsetWindow.SlotFilterTip}" />
                            </Grid>
                            <DataGrid x:Name="CameraGrid" Grid.Row="1" Style="{StaticResource ViewerGrid}" SelectionChanged="CameraGrid_SelectionChanged"
                                      MouseDoubleClick="CameraGrid_MouseDoubleClick">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{l:T Common.Name}" Binding="{Binding Name}" Width="*" />
                                    <DataGridTextColumn Header="{l:T DialogsetWindow.Shot}" Binding="{Binding Plane}" Width="100" />
                                    <DataGridTextColumn Header="{l:T DialogsetWindow.FromTo}" Binding="{Binding FromToText}" Width="110" />
                                    <DataGridTextColumn Header="{l:T DialogsetWindow.Fov}" Binding="{Binding FovText}" SortMemberPath="Camera.FieldOfView" Width="50" />
                                    <DataGridTextColumn Header="{l:T DialogsetWindow.Tags}" Binding="{Binding TagsText}" Width="80" />
                                </DataGrid.Columns>
                                <DataGrid.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="{l:T DialogsetWindow.LookThrough}" Click="LookThrough_Click" />
                                        <MenuItem Header="{l:T DialogsetWindow.CopyName}" Click="CopyCameraName_Click" />
                                        <MenuItem Header="{l:T DialogsetWindow.CopyTransform}" Click="CopyTransform_Click" />
                                    </ContextMenu>
                                </DataGrid.ContextMenu>
                            </DataGrid>
                            <Border x:Name="CameraPanel" Grid.Row="2" CornerRadius="6" Padding="10,8" Margin="0,8,0,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="CameraTitle" FontWeight="SemiBold" FontSize="15" Margin="0,0,0,4" />
                                    <TextBlock x:Name="CameraDetail" FontFamily="Consolas" FontSize="12.5" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </TabItem>
                    <TabItem Header="{l:T Common.Properties}">
                        <DockPanel Margin="4,8,0,0">
                            <local:SourceNote x:Name="SourceNoteBar" DockPanel.Dock="Top" Margin="0,0,0,6" />
                            <local:PropertyListView x:Name="FileProperties" LinkClicked="Properties_LinkClicked" />
                        </DockPanel>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <TextBlock x:Name="BusyText" Text="{l:T DialogsetWindow.Reading}" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.8"
                   TextWrapping="Wrap" TextAlignment="Center" MaxWidth="520" />
        <DockPanel Grid.Row="1" Margin="18,6,14,8">
            <local:MakeModButton x:Name="MakeModBtn" DockPanel.Dock="Right" Margin="12,0,0,0" />
            <TextBlock x:Name="InfoText" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
