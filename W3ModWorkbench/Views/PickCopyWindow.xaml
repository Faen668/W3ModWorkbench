<Window x:Class="W3ModWorkbench.PickCopyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        Title="{l:T PickCopyWindow.WhichCopy}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="620" SizeToContent="Height" MaxHeight="620" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock x:Name="FileTitle" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
        <TextBlock x:Name="Summary" Grid.Row="1" Margin="0,8,0,10" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        <ListBox x:Name="Copies" Grid.Row="2" MaxHeight="380" MouseDoubleClick="Copies_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 Background="Transparent" BorderThickness="0">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="OverridesDefaultStyle" Value="True" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="8,4" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Grid SnapsToDevicePixels="True" Background="Transparent">
                                    <Rectangle x:Name="Hover" Fill="{DynamicResource SubtleFillColorSecondaryBrush}" Opacity="0" RadiusX="4" RadiusY="4" />
                                    <Rectangle x:Name="Highlight" Fill="{DynamicResource AccentFillColorDefaultBrush}" Opacity="0" RadiusX="4" RadiusY="4" />
                                    <ContentPresenter Margin="{TemplateBinding Padding}" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Highlight" Property="Opacity" Value="0.22" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="2,4">
                        <TextBlock DockPanel.Dock="Left" Width="34" Text="{Binding Rank}" Opacity="0.6" FontFamily="Cascadia Mono, Consolas" VerticalAlignment="Center" />
                        <Border DockPanel.Dock="Right" CornerRadius="3" Padding="6,1,6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                                Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="{Binding WinsVisibility}">
                            <TextBlock Text="{l:T PickCopyWindow.GameLoadsOne}" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                        </Border>
                        <StackPanel>
                            <TextBlock>
                                <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                <Run Text="{Binding Kind, Mode=OneWay}" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </TextBlock>
                            <TextBlock Text="{Binding Detail}" FontSize="12" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <DockPanel Grid.Row="3" Margin="0,14,0,0" LastChildFill="False">
            <CheckBox x:Name="AlwaysWinner" DockPanel.Dock="Left" VerticalAlignment="Center"
                      Content="{l:T PickCopyWindow.DontAskAgainOpen}"
                      ToolTip="{l:T PickCopyWindow.AskWhichCopyAsset}" />
            <Button DockPanel.Dock="Right" Margin="8,0,0,0" Padding="16,5" Content="{l:T Common.Cancel}" IsCancel="True" />
            <Button DockPanel.Dock="Right" Padding="16,5" Content="{l:T Common.Open}" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Open_Click" />
        </DockPanel>
    </Grid>
</Window>
