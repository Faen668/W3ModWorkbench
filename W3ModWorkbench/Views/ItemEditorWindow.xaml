<Window x:Class="W3ModWorkbench.ItemEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:W3ModWorkbench.Localisation"
        xmlns:local="clr-namespace:W3ModWorkbench"
        Title="{l:T ItemEditor.Title}" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="860" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="IconText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource WashItem}" />
    </Window.Resources>

    <Grid>
        <Grid Margin="14,12,14,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,8">
                <TextBlock Text="{l:T ItemEditor.Title}" FontSize="16" FontWeight="SemiBold" />
                <TextBlock Opacity="0.65" Margin="0,2,0,0" TextWrapping="Wrap" Text="{l:T ItemEditor.Explain}" />
            </StackPanel>

            <!-- no project: changes need one to go in -->
            <Border x:Name="ProjectBar" Grid.Row="1" Visibility="Collapsed" Margin="0,0,0,10" Padding="12,8" CornerRadius="6" BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" Background="{DynamicResource ControlFillColorSecondaryBrush}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Padding="10,4" Margin="12,0,0,0" Content="{l:T ItemEditor.MakeProject}" Click="Project_Click" />
                    <TextBlock Style="{StaticResource IconText}" Text="&#xE946;" Margin="0,0,10,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                    <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{l:T ItemEditor.NoProject}" />
                </DockPanel>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="340" MinWidth="240" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="420" />
                </Grid.ColumnDefinitions>

                <!-- the items -->
                <Border Style="{StaticResource Card}" ClipToBounds="True">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="10,10,10,6">
                            <Grid>
                                <TextBox x:Name="SearchBox" Padding="30,5,8,5" VerticalContentAlignment="Center" TextChanged="Search_TextChanged" />
                                <TextBlock Style="{StaticResource IconText}" Text="&#xE721;" FontSize="13" Margin="10,0,0,0" Opacity="0.6" HorizontalAlignment="Left" IsHitTestVisible="False" />
                                <TextBlock x:Name="SearchHint" Margin="31,0,0,0" Opacity="0.55" VerticalAlignment="Center" IsHitTestVisible="False" Text="{l:T ItemEditor.Search}" />
                            </Grid>
                            <DockPanel Margin="0,6,0,0">
                                <ToggleButton x:Name="ChangedToggle" DockPanel.Dock="Right" Margin="6,0,0,0" Padding="10,4" Content="{l:T ItemEditor.ChangedOnly}" Click="Filter_Changed"
                                              ToolTip="{l:T ItemEditor.ChangedOnlyTip}" />
                                <ComboBox x:Name="CategoryBox" SelectionChanged="Filter_Changed" />
                            </DockPanel>
                        </StackPanel>
                        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="12,4,12,8" Opacity="0.6" FontSize="12" />
                        <ListBox x:Name="ItemList" BorderThickness="0" Background="Transparent" SelectionChanged="ItemList_SelectionChanged"
                                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:ItemRow}">
                                    <DockPanel Margin="2,2">
                                        <TextBlock DockPanel.Dock="Right" Text="&#x25CF;" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding ChangedVisibility}" ToolTip="{l:T ItemEditor.ChangedTip}" Margin="6,0,0,0" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Detail}" Opacity="0.6" FontSize="12" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" Background="Transparent" Focusable="False" />

                <!-- the item picked -->
                <Border Grid.Column="2" Style="{StaticResource Card}" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="CardScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="Card" Margin="18,14,18,18" />
                        </ScrollViewer>
                        <StackPanel x:Name="Busy" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ProgressBar IsIndeterminate="True" Width="220" Height="4" />
                            <TextBlock x:Name="BusyText" Margin="0,10,0,0" HorizontalAlignment="Center" Opacity="0.75" Text="{l:T ItemEditor.Reading}" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <DockPanel Grid.Row="3" Margin="2,10,2,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <CheckBox x:Name="PlusCheck" Content="{l:T ItemEditor.AlsoNewGamePlus}" IsChecked="True" VerticalAlignment="Center" MinWidth="0" Margin="0,0,14,0"
                              ToolTip="{l:T ItemEditor.AlsoNewGamePlusTip}" />
                    <Button x:Name="SaveButton" Padding="14,6" Click="Save_Click" IsEnabled="False" Style="{DynamicResource AccentButtonStyle}" ToolTip="{l:T ItemEditor.SaveTip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource IconText}" Text="&#xE74E;" />
                            <TextBlock Margin="8,0,0,0" Text="{l:T ItemEditor.Save}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock x:Name="StatusText" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Grid>

        <local:MessageCard x:Name="Message" IsModal="True" />
    </Grid>
</Window>
