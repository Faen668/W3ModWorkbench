<Window x:Class="W3ModWorkbench.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="W3 Mod Workbench Help" Icon="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico"
        Width="1280" Height="880" MinWidth="820" MinHeight="500"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" PreviewMouseDown="Window_PreviewMouseDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="NavColumn" Width="320" MinWidth="230" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- the guide's contents, or a search's results -->
        <DockPanel Margin="14,16,4,12">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,14">
                <Image Source="pack://application:,,,/W3ModWorkbench;component/Assets/app.ico" Width="30" Height="30"
                       RenderOptions.BitmapScalingMode="HighQuality" />
                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="W3 Mod Workbench" FontWeight="SemiBold" FontSize="15" />
                    <TextBlock Text="Help and guide" Opacity="0.65" FontSize="12" />
                </StackPanel>
            </StackPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,10,10">
                <TextBox x:Name="SearchBox" Padding="32,7,30,7" VerticalContentAlignment="Center" TextChanged="SearchBox_TextChanged"
                         PreviewKeyDown="SearchBox_PreviewKeyDown" ToolTip="Search every page (Ctrl+F). Enter opens the best match" />
                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Margin="11,0,0,0" Opacity="0.6"
                           VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                <TextBlock x:Name="SearchPlaceholder" Text="Search the guide" Margin="33,0,0,0" Opacity="0.55"
                           VerticalAlignment="Center" IsHitTestVisible="False" />
                <Button x:Name="ClearSearchButton" HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" MinWidth="0" MinHeight="0"
                        Background="Transparent" BorderThickness="0" Visibility="Collapsed" Click="ClearSearch_Click" ToolTip="Clear the search (Esc)">
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="10" />
                </Button>
            </Grid>
            <DockPanel DockPanel.Dock="Top" Margin="4,0,10,6">
                <Button DockPanel.Dock="Right" x:Name="ExpandAllButton" Click="ExpandAll_Click" Padding="6,2" MinWidth="0" MinHeight="0"
                        Background="Transparent" BorderThickness="0" FontSize="12" ToolTip="Open or close every category">
                    <TextBlock x:Name="ExpandAllText" Text="Expand all" Opacity="0.75" />
                </Button>
                <TextBlock x:Name="NavHeading" Text="CONTENTS" FontSize="11" FontWeight="SemiBold" Opacity="0.6" VerticalAlignment="Center" />
            </DockPanel>
            <ScrollViewer x:Name="NavScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,10,0">
                <StackPanel x:Name="NavPanel" />
            </ScrollViewer>
        </DockPanel>
        <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Stretch" ResizeBehavior="PreviousAndNext" />

        <!-- the page -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <DockPanel Margin="20,14,24,4">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button x:Name="BackButton" Click="Back_Click" Padding="9,5" ToolTip="Back (Alt+Left)" IsEnabled="False">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72B;" />
                    </Button>
                    <Button x:Name="ForwardButton" Click="Forward_Click" Padding="9,5" Margin="4,0,0,0" ToolTip="Forward (Alt+Right)" IsEnabled="False">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72A;" />
                    </Button>
                    <Button Click="Home_Click" Padding="9,5" Margin="4,0,14,0" ToolTip="The start of the guide (Alt+Home)">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE80F;" />
                    </Button>
                </StackPanel>
                <TextBlock x:Name="Breadcrumb" VerticalAlignment="Center" Opacity="0.7" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <ScrollViewer x:Name="PageScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="44,12,40,40">
                <StackPanel x:Name="PageColumn" MaxWidth="900" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <Border Width="44" Height="44" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
                            <TextBlock x:Name="TitleIcon" FontFamily="{StaticResource IconFont}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                        </Border>
                        <TextBlock x:Name="TitleText" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock x:Name="SummaryText" FontSize="16" Opacity="0.75" TextWrapping="Wrap" Margin="0,4,0,16" LineHeight="24" />
                    <!-- the page's sections, to jump to -->
                    <Border x:Name="OnThisPage" CornerRadius="8" BorderThickness="1" Padding="14,10,14,6" Margin="0,0,0,18"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock Text="ON THIS PAGE" FontSize="11" FontWeight="SemiBold" Opacity="0.6" Margin="0,0,0,6" />
                            <WrapPanel x:Name="SectionLinks" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="PageBody" />
                    <!-- the pages either side -->
                    <Grid x:Name="Footer" Margin="0,28,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="PreviousCard" CornerRadius="8" BorderThickness="1" Padding="16,12" Cursor="Hand" MouseLeftButtonUp="PreviousCard_Click"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Opacity="0.6">
                                    <TextBlock Text="&#xE72B;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="0,1,6,0" />
                                    <TextBlock Text="Previous" FontSize="12" />
                                </StackPanel>
                                <TextBlock x:Name="PreviousTitle" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="NextCard" Grid.Column="2" CornerRadius="8" BorderThickness="1" Padding="16,12" Cursor="Hand" MouseLeftButtonUp="NextCard_Click"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <StackPanel HorizontalAlignment="Right">
                                <StackPanel Orientation="Horizontal" Opacity="0.6" HorizontalAlignment="Right">
                                    <TextBlock Text="Next" FontSize="12" />
                                    <TextBlock Text="&#xE72A;" FontFamily="{StaticResource IconFont}" FontSize="11" Margin="6,1,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="NextTitle" FontWeight="SemiBold" FontSize="15" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" HorizontalAlignment="Right" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- a screenshot at full size -->
        <Grid x:Name="Lightbox" Grid.ColumnSpan="3" Visibility="Collapsed" Background="#E8101010" Cursor="Hand" MouseLeftButtonUp="Lightbox_Click">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image x:Name="LightboxImage" Margin="28,28,28,8" Stretch="Uniform" StretchDirection="DownOnly" RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="LightboxCaption" Grid.Row="1" Foreground="White" HorizontalAlignment="Center" TextWrapping="Wrap" Margin="28,0,28,6" FontSize="14" />
            <TextBlock Grid.Row="1" Foreground="White" Opacity="0.6" HorizontalAlignment="Center" Margin="0,30,0,14" FontSize="12"
                       Text="Click anywhere or press Esc to close" />
        </Grid>
    </Grid>
</Window>
