<Window x:Class="W3BundleExplorer.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:search="clr-namespace:ICSharpCode.AvalonEdit.Search;assembly=ICSharpCode.AvalonEdit"
        Title="Preview" Icon="pack://application:,,,/W3BundleExplorer;component/Assets/app.ico"
        Width="1000" Height="760" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <Style x:Key="SearchIconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="SearchToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- AvalonEdit's search bar, restyled to match the Fluent theme -->
        <Style TargetType="search:SearchPanel">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type search:SearchPanel}">
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,18,0" Padding="6" Cursor="Arrow"
                                CornerRadius="8" BorderThickness="1"
                                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
                            </Border.Effect>
                            <StackPanel Orientation="Horizontal">
                                <TextBox Name="PART_searchTextBox" Width="230" VerticalContentAlignment="Center"
                                         Text="{Binding SearchPattern, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                <ToggleButton Style="{StaticResource SearchToggle}" Content="Aa" ToolTip="Match case"
                                              IsChecked="{Binding MatchCase, RelativeSource={RelativeSource TemplatedParent}}" Margin="6,0,0,0" />
                                <ToggleButton Style="{StaticResource SearchToggle}" Content="ab" ToolTip="Whole words only"
                                              IsChecked="{Binding WholeWords, RelativeSource={RelativeSource TemplatedParent}}" />
                                <ToggleButton Style="{StaticResource SearchToggle}" Content=".*" ToolTip="Regular expression"
                                              IsChecked="{Binding UseRegex, RelativeSource={RelativeSource TemplatedParent}}" />
                                <Button Style="{StaticResource SearchIconButton}" Command="search:SearchCommands.FindPrevious" ToolTip="Previous match (Shift+F3)" Margin="8,0,0,0">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70E;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource SearchIconButton}" Command="search:SearchCommands.FindNext" ToolTip="Next match (F3)">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="12" />
                                </Button>
                                <Button Style="{StaticResource SearchIconButton}" Command="search:SearchCommands.CloseSearchPanel" ToolTip="Close (Esc)">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE711;" FontSize="11" />
                                </Button>
                                <!-- AvalonEdit looks this part up; the options live in the toggles instead -->
                                <Popup Name="PART_dropdownPopup" />
                            </StackPanel>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Click="Copy_Click" ToolTip="Copy the whole text">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,0" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" ToolTip="Save this file (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="Save as" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="1" CornerRadius="8" BorderThickness="1" Padding="0,6,0,0" ClipToBounds="True"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <avalonEdit:TextEditor x:Name="Editor" IsReadOnly="True" ShowLineNumbers="True"
                                   FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                                   HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                   Background="Transparent" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   LineNumbersForeground="{DynamicResource TextFillColorTertiaryBrush}" />
        </Border>
    </Grid>
</Window>
