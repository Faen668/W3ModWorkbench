<Window x:Class="W3BundleExplorer.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Icon="pack://application:,,,/W3BundleExplorer;component/Assets/app.ico"
        Width="1000" Height="760" MinWidth="520" MinHeight="320"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
    <Grid Margin="14,12,14,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- the file in the tab in use -->
        <DockPanel Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SplitButton" Click="Split_Click">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem x:Name="SplitRightItem" Header="Split side by side" IsCheckable="True" Click="SplitRight_Click" />
                            <MenuItem x:Name="SplitDownItem" Header="Split top and bottom" IsCheckable="True" Click="SplitDown_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="SplitIcon" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" />
                        <TextBlock x:Name="SplitText" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,0" Click="Copy_Click" ToolTip="Copy the whole text">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="Copy" />
                    </StackPanel>
                </Button>
                <Button Margin="6,0,0,0" Click="Save_Click" Style="{DynamicResource AccentButtonStyle}" ToolTip="Save this file (Ctrl+S)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE74E;" VerticalAlignment="Center" />
                        <TextBlock Margin="8,0,0,0" Text="Save as" />
                    </StackPanel>
                </Button>
            </StackPanel>
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="DetailText" Opacity="0.65" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <!-- one group of tabs, or two when split -->
        <Grid x:Name="PaneGrid" Grid.Row="1" />
    </Grid>
</Window>
