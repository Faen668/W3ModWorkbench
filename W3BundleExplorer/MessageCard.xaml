<UserControl x:Class="W3BundleExplorer.MessageCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle">
    <!-- a modal card dims the window behind it and takes its clicks; the scrim is set in code -->
    <Grid x:Name="Scrim">
        <Border x:Name="Card" MaxWidth="420" Padding="14,12" Cursor="Arrow"
                CornerRadius="8" BorderThickness="1"
                Background="{DynamicResource SolidBackgroundFillColorBaseBrush}"
                BorderBrush="{DynamicResource SurfaceStrokeColorFlyoutBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock x:Name="CardIcon" FontFamily="{StaticResource IconFont}" FontSize="16" Margin="0,1,12,0"
                           VerticalAlignment="Top" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="CardTitle" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="CardMessage" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
                <StackPanel x:Name="CardButtons" Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                            HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="CardSecondary" MinWidth="80" Click="CardSecondary_Click" />
                    <Button x:Name="CardPrimary" MinWidth="80" Margin="8,0,0,0" Style="{DynamicResource AccentButtonStyle}"
                            Click="CardPrimary_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
