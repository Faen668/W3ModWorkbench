<Window x:Class="W3BundleExplorer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:W3BundleExplorer"
        Title="Settings" Icon="pack://application:,,,/W3BundleExplorer;component/Assets/app.ico"
        Width="620" Height="700" MinWidth="480" MinHeight="420"
        WindowStartupLocation="CenterOwner" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="18,14" />
            <Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="Icon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,16,18,4">
            <StackPanel>
                <!-- Appearance -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Appearance" />
                        <TextBlock Text="Theme" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="ThemeSystem" GroupName="Theme" Content="Use Windows setting" Margin="0,0,20,0" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeLight" GroupName="Theme" Content="Light" Margin="0,0,20,0" Checked="Theme_Checked" />
                            <RadioButton x:Name="ThemeDark" GroupName="Theme" Content="Dark" Checked="Theme_Checked" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Extraction -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Extraction" />
                        <TextBlock Text="Default output folder" Margin="0,0,0,6" />
                        <Grid>
                            <TextBox x:Name="OutputBox" VerticalContentAlignment="Center" Padding="8,6,40,6" />
                            <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                                    Click="BrowseOutput_Click" ToolTip="Choose a folder">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                            </Button>
                        </Grid>
                        <CheckBox x:Name="KeepStructureCheck" Content="Keep folder structure" Margin="0,12,0,0" />
                        <CheckBox x:Name="OpenWhenDoneCheck" Content="Open the folder when extraction finishes" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <!-- Compiled scripts -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}">
                            <Run Text="Game folder" />
                            <Run Text="(optional)" FontWeight="Normal" FontSize="13" />
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap"
                                   Text="Where The Witcher 3 is installed. Decompiled scripts use it to show readable names instead of plain numbers:" />

                        <!-- before / after example -->
                        <Border CornerRadius="6" Padding="12,8" Margin="0,10,0,10" BorderThickness="1"
                                Background="{DynamicResource SubtleFillColorSecondaryBrush}" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <TextBlock Text="Without it" Opacity="0.65" Margin="0,0,14,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="if (type == 1)" FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock Grid.Row="1" Text="With it" Opacity="0.65" Margin="0,4,14,0" VerticalAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="if (type == EACIT_Potion)" FontFamily="Cascadia Mono, Consolas" Margin="0,4,0,0" />
                            </Grid>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="GameFolderBox" VerticalContentAlignment="Center" Padding="8,6,40,6" />
                            <Button HorizontalAlignment="Right" Margin="0,0,4,0" Padding="6,3" Background="Transparent" BorderThickness="0"
                                    Click="BrowseGame_Click" ToolTip="Choose the game folder">
                                <TextBlock Style="{StaticResource Icon}" Text="&#xE8DA;" />
                            </Button>
                            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,6" Click="DetectGame_Click"
                                    ToolTip="Look for The Witcher 3 in your Steam and GOG libraries">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Icon}" Text="&#xE721;" />
                                    <TextBlock Margin="8,0,0,0" Text="Find automatically" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <TextBlock x:Name="GameFolderIcon" Style="{StaticResource Icon}" Margin="0,0,8,0" />
                            <TextBlock x:Name="GameFolderStatus" TextWrapping="Wrap" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource Hint}" Margin="0,10,0,0"
                                   Text="You can leave this empty if you only open scripts from inside your game's mods folder, because those find the game on their own. Set it if you open scripts from anywhere else, like a mod's release folder or a download." />
                    </StackPanel>
                </Border>

                <!-- About -->
                <Border Style="{StaticResource Card}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/W3BundleExplorer;component/Assets/app.ico" Width="56" Height="56"
                               VerticalAlignment="Top" Margin="0,2,16,0" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="W3 Bundle Explorer" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock x:Name="VersionText" Opacity="0.7" Margin="0,2,0,0" />
                            <TextBlock Style="{StaticResource Hint}"
                                       Text="Browse and extract Witcher 3 .bundle archives, and open REDkit precompiled.rsblob files as decompiled WitcherScript." />
                            <TextBlock x:Name="CopyrightText" Margin="0,10,0,0" />
                            <TextBlock Margin="0,2,0,0">
                                <Run Text="Free and open source under the MIT Licence." />
                                <Hyperlink Click="ViewLicence_Click">View licence</Hyperlink>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                       Text="Developed with AI assistance (Claude, by Anthropic), most of all in reverse-engineering the compiled script format and building the decompiler. The results were checked against real mods and their original source." />
                            <TextBlock Style="{StaticResource Hint}" FontSize="12">
                                <Run Text="WitcherScript syntax highlighting by WebSpam, from his witcherscript-vscode extension, used with permission. Code view by AvalonEdit. Decompiler gaps filled with help from Aelto's tw3-cahirb." />
                                <Hyperlink Click="ViewNotices_Click">Third-party notices</Hyperlink>
                            </TextBlock>
                            <TextBlock Style="{StaticResource Hint}" FontSize="12"
                                       Text="An unofficial fan-made tool, not affiliated with or endorsed by CD PROJEKT RED. The Witcher, REDkit and REDengine are trademarks of CD PROJEKT S.A." />
                            <TextBlock x:Name="SettingsPathText" Style="{StaticResource Hint}" FontSize="12" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Padding="18,12" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Padding="18,6" Click="Cancel_Click" IsCancel="True" />
                <Button Content="Save" Padding="22,6" Margin="8,0,0,0" Click="Save_Click" IsDefault="True"
                        Style="{DynamicResource AccentButtonStyle}" />
            </StackPanel>
        </Border>

        <local:MessageCard x:Name="Message" Grid.RowSpan="2" IsModal="True" />
    </Grid>
</Window>
