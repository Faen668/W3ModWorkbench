<Window x:Class="W3BundleExplorer.Help.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="W3 Bundle Explorer Help" Icon="pack://application:,,,/W3BundleExplorer;component/Assets/app.ico"
        Width="1080" Height="780" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner" PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Topics -->
        <Border BorderThickness="0,0,1,0" BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <DockPanel Margin="14,16,10,14">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,14">
                    <Image Source="pack://application:,,,/W3BundleExplorer;component/Assets/app.ico" Width="28" Height="28"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="W3 Bundle Explorer" FontWeight="SemiBold" />
                        <TextBlock Text="Help and guide" Opacity="0.65" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <TextBox x:Name="FilterBox" Padding="32,6,8,6" VerticalContentAlignment="Center" TextChanged="FilterBox_TextChanged" />
                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE721;" Margin="11,0,0,0" Opacity="0.6"
                               VerticalAlignment="Center" HorizontalAlignment="Left" IsHitTestVisible="False" />
                    <TextBlock x:Name="FilterPlaceholder" Text="Search help" Margin="33,0,0,0" Opacity="0.55"
                               VerticalAlignment="Center" IsHitTestVisible="False" />
                </Grid>
                <ListBox x:Name="TopicList" BorderThickness="0" Background="Transparent"
                         SelectionChanged="TopicList_SelectionChanged" ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <!-- Page -->
        <ScrollViewer x:Name="PageScroller" Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="40,28,40,36">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
                <TextBlock x:Name="GroupText" Opacity="0.65" FontSize="13" />
                <TextBlock x:Name="TitleText" FontSize="28" FontWeight="SemiBold" Margin="0,2,0,18" TextWrapping="Wrap" />
                <StackPanel x:Name="PageBody" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
