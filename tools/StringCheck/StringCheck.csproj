<Project Sdk="Microsoft.NET.Sdk">

  <!-- Finds user-facing text still written into the app's XAML and C# instead of its string tables, and checks the
       tables themselves. LOCALISATION.md says how to run it. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <!-- C# parser (MIT), to tell text from code -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.11.0" />
  </ItemGroup>

</Project>
